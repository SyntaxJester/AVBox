    &quot;&amp;ft=playlist&amp;rn=20&amp;pn=&quot; + pn + &quot;&amp;rformat=json&amp;encoding=utf8&amp;mobi=1&quot;;
  return ADAPTER_request(url, {
    headers: { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Referer&quot;: &quot;https://www.kuwo.cn/&quot;, &quot;Accept&quot;: &quot;application/json&quot; },
    timeout: 12, credentials: &quot;omit&quot;
  }).then(function(txt){
    var d = (typeof _parseKuwoBody === &quot;function&quot;) ? _parseKuwoBody(txt) : jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.abslist) || (d &amp;&amp; d.data &amp;&amp; d.data.list) || [];
    return (list || []).map(function(it){
      var id = String(it.PLAYLISTID || it.playlistid || it.pid || it.id || it.DC_TARGETID || &quot;&quot;);
      var name = it.NAME || it.name || it.PLAYLIST || it.title || &quot;&quot;;
      var pic = it.hts_PIC || it.PIC || it.pic || it.img || it.image || &quot;&quot;;
      if (pic &amp;&amp; String(pic).indexOf(&quot;http&quot;) !== 0){
        pic = &quot;https://img1.kuwo.cn/star/starheads/&quot; + String(pic).replace(/^\//, &quot;&quot;);
      }
      return {
        dissid: &quot;kw_pl_&quot; + id, id: id, dissname: name, title: name,
        imgurl: fixCover(pic), logo: fixCover(pic), cover: fixCover(pic),
        nickname: it.uname || it.USERNAME || &quot;&quot;,
        source: &quot;kuwo&quot;
      };
    }).filter(function(p){ return p.id &amp;&amp; p.title; });
  }).catch(function(){ return []; });
};

API.kugouSearchAlbums = function(kw){
  kw = (kw || &quot;&quot;).trim();
  if (!kw) return Promise.resolve([]);
  var url = &quot;https://mobilecdn.kugou.com/api/v3/search/album?format=json&amp;keyword=&quot; +
    encodeURIComponent(kw) + &quot;&amp;page=1&amp;pagesize=30&quot;;
  return ADAPTER_request(url, {
    headers: { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Referer&quot;: &quot;https://www.kugou.com/&quot;, &quot;Accept&quot;: &quot;application/json&quot; },
    timeout: 12, credentials: &quot;omit&quot;
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.data &amp;&amp; d.data.info) || [];
    return (list || []).map(function(it){
      var id = String(it.albumid || it.albumId || &quot;&quot;);
      var pic = it.imgurl || it.icon || &quot;&quot;;
      if (pic) pic = String(pic).replace(/\{size\}/g, &quot;240&quot;).replace(/^http:/, &quot;https:&quot;);
      return {
        mid: id,
        albumId: id,
        name: it.albumname || it.albumName || &quot;&quot;,
        singer: it.singername || it.singerName || &quot;&quot;,
        cover: fixCover(pic),
        pubTime: it.publishtime || it.publish_time || &quot;&quot;,
        company: &quot;&quot;,
        source: &quot;kugou&quot;,
        songcount: it.songcount || 0
      };
    }).filter(function(a){ return a.mid &amp;&amp; a.name; });
  }).catch(function(){ return []; });
}
API.kugouAlbumSongs = function(albumId){
  albumId = String(albumId || &quot;&quot;).replace(/^kg_al_/, &quot;&quot;);
  if (!albumId) return Promise.resolve({ songs: [] });
  // 酷狗专辑歌曲
  var url = &quot;https://mobilecdn.kugou.com/api/v3/album/song?albumid=&quot; + encodeURIComponent(albumId) +
    &quot;&amp;page=1&amp;pagesize=50&amp;format=json&quot;;
  return ADAPTER_request(url, {
    headers: { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Referer&quot;: &quot;https://www.kugou.com/&quot;, &quot;Accept&quot;: &quot;application/json&quot; },
    timeout: 12, credentials: &quot;omit&quot;
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.data &amp;&amp; (d.data.info || d.data.list)) || [];
    var songs = (list || []).map(function(it){
      var hash = it.hash || it.FileHash || it.hqhash || &quot;&quot;;
      var name = (it.songname || it.filename || &quot;&quot;).replace(/&lt;[^&gt;]+&gt;/g, &quot;&quot;);
      // filename 常为 &quot;歌手 - 歌名&quot;
      if (it.filename &amp;&amp; !it.songname){
        var parts = String(it.filename).split(&quot; - &quot;);
        if (parts.length &gt;= 2) name = parts.slice(1).join(&quot; - &quot;);
      }
      var singer = it.singername || it.author_name || &quot;&quot;;
      if (!singer &amp;&amp; it.filename){
        var p2 = String(it.filename).split(&quot; - &quot;);
        if (p2.length &gt;= 2) singer = p2[0];
      }
      var dur = Number(it.duration || it.timeLength || 0) || 0;
      if (dur &gt; 10000) dur = Math.round(dur / 1000);
      var img = it.img || it.album_img || &quot;&quot;;
      if (img) img = String(img).replace(/\{size\}/g, &quot;240&quot;).replace(/^http:/, &quot;https:&quot;);
      if (!hash || !name) return null;
      return {
        songmid: &quot;kg_&quot; + hash,
        media_mid: hash,
        hash: hash,
        kgHash: hash,
        name: name,
        singer: singer || &quot;酷狗&quot;,
        albumname: it.album_name || it.albumname || &quot;&quot;,
        cover: fixCover(img),
        interval: dur,
        isVip: false,
        playUrl: &quot;&quot;,
        source: &quot;kugou&quot;
      };
    }).filter(Boolean);
    return { songs: songs };
  }).catch(function(){ return { songs: [] }; });
}
API.neteaseSearchAlbums = function(kw){
  kw = (kw || &quot;&quot;).trim();
  if (!kw) return Promise.resolve([]);
  var url = &quot;https://music.163.com/api/search/get?s=&quot; + encodeURIComponent(kw) + &quot;&amp;type=10&amp;limit=30&amp;offset=0&quot;;
  return ADAPTER_request(url, {
    headers: { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Referer&quot;: &quot;https://music.163.com/&quot; },
    timeout: 12
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.result &amp;&amp; d.result.albums) || [];
    return (list || []).map(function(a){
      var pic = a.picUrl || a.blurPicUrl || &quot;&quot;;
      var artist = (a.artist &amp;&amp; a.artist.name) || ((a.artists || []).map(function(x){ return x.name; }).join(&quot;/&quot;)) || &quot;&quot;;
      return {
        mid: String(a.id),
        albumId: String(a.id),
        name: a.name || &quot;&quot;,
        singer: artist,
        cover: pic ? String(pic).replace(/^http:/, &quot;https:&quot;) : &quot;&quot;,
        pubTime: a.publishTime ? new Date(a.publishTime).toISOString().slice(0, 10) : &quot;&quot;,
        company: (a.company) || &quot;&quot;,
        source: &quot;netease&quot;
      };
    }).filter(function(a){ return a.mid &amp;&amp; a.name; });
  }).catch(function(){ return []; });
}
API.neteaseAlbumSongs = function(albumId){
  albumId = String(albumId || &quot;&quot;).replace(/^ne_al_/, &quot;&quot;);
  if (!albumId) return Promise.resolve({ songs: [] });
  var url = &quot;https://music.163.com/api/album/&quot; + encodeURIComponent(albumId);
  return ADAPTER_request(url, {
    headers: { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Referer&quot;: &quot;https://music.163.com/&quot; },
    timeout: 12
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var album = (d &amp;&amp; d.album) || {};
    var list = album.songs || (d &amp;&amp; d.songs) || [];
    var songs = (list || []).map(function(s){
      var artists = (s.artists || s.ar || []).map(function(a){ return a.name; }).join(&quot;/&quot;) || &quot;&quot;;
      var pic = (s.album &amp;&amp; (s.album.picUrl || s.album.blurPicUrl)) || album.picUrl || &quot;&quot;;
      var dur = Math.round(((s.duration || s.dt || 0) / 1000)) || 0;
      return {
        songmid: &quot;ne_&quot; + s.id,
        media_mid: String(s.id),
        neteaseId: String(s.id),
        name: s.name || &quot;&quot;,
        singer: artists,
        albumname: album.name || (s.album &amp;&amp; s.album.name) || &quot;&quot;,
        cover: pic ? String(pic).replace(/^http:/, &quot;https:&quot;) : &quot;&quot;,
        interval: dur,
        isVip: !!(s.fee === 1 || s.fee === 4 || s.fee === 8),
        playUrl: &quot;&quot;,
        source: &quot;netease&quot;
      };
    }).filter(function(s){ return s.neteaseId &amp;&amp; s.name; });
    return {
      songs: songs,
      info: { title: album.name || &quot;&quot;, cover: (album.picUrl || &quot;&quot;).replace(/^http:/, &quot;https:&quot;) }
    };
  }).catch(function(){ return { songs: [] }; });
}
/* netease */
API.neteaseSearch = function(kw, page){
  kw = (kw || &quot;&quot;).trim();
  page = page || 1;
  if (!kw) return Promise.resolve({ list: [], singers: [] });
  var offset = (page - 1) * 20;
  var hdr = {
    &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;],
    &quot;Referer&quot;: &quot;https://music.163.com/&quot;
  };
  var songUrl = &quot;https://music.163.com/api/search/get?s=&quot; + encodeURIComponent(kw) +
    &quot;&amp;type=1&amp;limit=20&amp;offset=&quot; + offset;
  var artistUrl = &quot;https://music.163.com/api/search/get?s=&quot; + encodeURIComponent(kw) +
    &quot;&amp;type=100&amp;limit=12&amp;offset=0&quot;;

  function mapSongs(d){
    var songs = (d &amp;&amp; d.result &amp;&amp; d.result.songs) || [];
    return songs.map(function(s){
      var artists = (s.artists || s.ar || []).map(function(a){ return a.name; }).join(&quot;/&quot;) || &quot;&quot;;
      var album = (s.album &amp;&amp; s.album.name) || (s.al &amp;&amp; s.al.name) || &quot;&quot;;
      var pic = (s.album &amp;&amp; (s.album.picUrl || s.album.blurPicUrl)) ||
        (s.al &amp;&amp; (s.al.picUrl || s.al.blurPicUrl)) || &quot;&quot;;
      var dur = Math.round(((s.duration || s.dt || 0) / 1000)) || 0;
      return {
        songmid: &quot;ne_&quot; + s.id,
        media_mid: String(s.id),
        neteaseId: String(s.id),
        name: s.name || &quot;&quot;,
        singer: artists,
        albumname: album,
        albummid: String((s.album &amp;&amp; s.album.id) || (s.al &amp;&amp; s.al.id) || &quot;&quot;),
        cover: pic ? String(pic).replace(/^http:/, &quot;https:&quot;) : &quot;&quot;,
        interval: dur,
        isVip: !!(s.fee === 1 || s.fee === 4 || s.fee === 8),
        playUrl: &quot;&quot;,
        source: &quot;netease&quot;
      };
    }).filter(function(s){ return s.neteaseId &amp;&amp; s.name; });
  }
  function mapArtists(d){
    var arts = (d &amp;&amp; d.result &amp;&amp; d.result.artists) || [];
    return (arts || []).map(function(a){
      var pic = a.picUrl || a.img1v1Url || &quot;&quot;;
      return {
        mid: &quot;ne_ar_&quot; + a.id,
        name: a.name || &quot;&quot;,
        cover: pic ? String(pic).replace(/^http:/, &quot;https:&quot;) : &quot;&quot;,
        source: &quot;netease&quot;,
        neteaseId: String(a.id)
      };
    }).filter(function(a){ return a.name; });
  }
  function fillCovers(list){
    if (!list.length) return Promise.resolve(list);
    var ids = list.map(function(s){ return s.neteaseId; }).join(&quot;,&quot;);
    var detailUrl = &quot;https://music.163.com/api/song/detail/?ids=[&quot; + ids + &quot;]&quot;;
    return ADAPTER_request(detailUrl, { headers: hdr, timeout: 12 }).then(function(txt2){
      var d2 = jsonp_safeParse(txt2);
      var details = (d2 &amp;&amp; d2.songs) || [];
      var map = {};
      details.forEach(function(ds){
        var pic = (ds.album &amp;&amp; (ds.album.picUrl || ds.album.blurPicUrl)) ||
          (ds.al &amp;&amp; (ds.al.picUrl || ds.al.blurPicUrl)) || &quot;&quot;;
        if (pic) map[String(ds.id)] = String(pic).replace(/^http:/, &quot;https:&quot;);
        var al = (ds.album &amp;&amp; ds.album.name) || (ds.al &amp;&amp; ds.al.name) || &quot;&quot;;
        if (al) map[String(ds.id) + &quot;_al&quot;] = al;
      });
      list.forEach(function(s){
        if (map[s.neteaseId]) s.cover = map[s.neteaseId];
        if (!s.albumname &amp;&amp; map[s.neteaseId + &quot;_al&quot;]) s.albumname = map[s.neteaseId + &quot;_al&quot;];
      });
      return list;
    }).catch(function(){ return list; });
  }
  function singersFromSongs(songs){
    var seen = {}, out = [];
    (songs || []).forEach(function(s){
      var n = ((s.singer || &quot;&quot;).split(/[\/、,&amp;]/)[0] || &quot;&quot;).trim();
      if (!n || seen[n]) return;
      seen[n] = 1;
      out.push({ mid: &quot;ne_ar_&quot; + n, name: n, cover: s.cover || &quot;&quot;, source: &quot;netease&quot;, fromSong: true });
    });
    return out;
  }

  return Promise.all([
    ADAPTER_request(songUrl, { headers: hdr, timeout: 15 }).then(function(txt){
      return mapSongs(jsonp_safeParse(txt));
    }).catch(function(){ return []; }),
    ADAPTER_request(artistUrl, { headers: hdr, timeout: 12 }).then(function(txt){
      return mapArtists(jsonp_safeParse(txt));
    }).catch(function(){ return []; })
  ]).then(function(arr){
    var list = arr[0] || [];
    var singers = arr[1] || [];
    return fillCovers(list).then(function(list2){
      if (singers.length &lt; 3){
        var extra = singersFromSongs(list2);
        var seen = {};
        singers.forEach(function(a){ if (a.name) seen[a.name] = 1; });
        extra.forEach(function(a){ if (!seen[a.name]){ seen[a.name] = 1; singers.push(a); } });
      }
      return { list: list2, singers: singers.slice(0, 12) };
    });
  }).catch(function(){ return { list: [], singers: [] }; });
}
API.neteaseUrl = function(song){
  var id = (song &amp;&amp; (song.neteaseId || String(song.songmid || &quot;&quot;).replace(/^ne_/, &quot;&quot;))) || &quot;&quot;;
  if (!id) return Promise.resolve(null);
  /** 试听 / 权益限制：一律当失败，交给洛雪/长青/跨源拿完整曲 */
  function isTrialOrBlocked(item){
    if (!item) return true;
    if (!item.url) return true;
    if (item.freeTrialInfo) return true;
    if (item.freeTrialPrivilege &amp;&amp; (item.freeTrialPrivilege.resConsumable || item.freeTrialPrivilege.userConsumable)) return true;
    // type: 0=正常 1=试听；flag 含试听位
    if (item.type === 1 || item.type === &quot;1&quot;) return true;
    // 时长明显短于曲目（约 &lt;40% 且 &lt;60s）视为试听片段
    var fullDur = (song &amp;&amp; song.interval) ? Number(song.interval) : 0;
    if (fullDur &gt; 90 &amp;&amp; item.time &amp;&amp; item.time &gt; 0 &amp;&amp; item.time &lt; Math.min(60, fullDur * 0.4) * 1000) return true;
    return false;
  }
  function pickUrl(item){
    if (isTrialOrBlocked(item)) return null;
    return String(item.url).replace(/^http:/, &quot;https:&quot;);
  }
  // 优先 320k，再 128k；两路都拒试听
  var brList = [320000, 128000];
  function tryBr(i){
    if (i &gt;= brList.length) return Promise.resolve(null);
    var url = &quot;https://music.163.com/api/song/enhance/player/url?id=&quot; + id + &quot;&amp;ids=[&quot; + id + &quot;]&amp;br=&quot; + brList[i];
    return ADAPTER_request(url, {
      headers: { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Referer&quot;: &quot;https://music.163.com/&quot; },
      timeout: 12
    }).then(function(txt){
      var d = jsonp_safeParse(txt);
      var item = d &amp;&amp; d.data &amp;&amp; d.data[0];
      var u = pickUrl(item);
      if (u) return u;
      return tryBr(i + 1);
    }).catch(function(){ return tryBr(i + 1); });
  }
  return tryBr(0);
}
API.neteaseLyric = function(id){
  if (!id) return Promise.resolve({ lyric: &quot;&quot;, trans: &quot;&quot; });
  id = String(id).replace(/^ne_/, &quot;&quot;).replace(/\D/g, &quot;&quot;);
  if (!id) return Promise.resolve({ lyric: &quot;&quot;, trans: &quot;&quot; });
  var hdr = {
    &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;],
    &quot;Referer&quot;: &quot;https://music.163.com/&quot;,
    &quot;Accept&quot;: &quot;application/json, text/plain, */*&quot;
  };
  // 官方公开接口（os=pc 更稳）；v1 作备选
  var urls = [
    &quot;https://music.163.com/api/song/lyric?os=pc&amp;id=&quot; + id + &quot;&amp;lv=-1&amp;kv=-1&amp;tv=-1&quot;,
    &quot;https://music.163.com/api/song/lyric?id=&quot; + id + &quot;&amp;lv=-1&amp;kv=-1&amp;tv=-1&quot;,
    &quot;https://music.163.com/api/song/lyric/v1?id=&quot; + id + &quot;&amp;lv=-1&amp;kv=-1&amp;tv=-1&quot;
  ];
  function parseNe(txt){
    var d = jsonp_safeParse(txt);
    if (!d) return null;
    var lyric = (d.lrc &amp;&amp; d.lrc.lyric) || (d.lyric) || &quot;&quot;;
    var trans = (d.tlyric &amp;&amp; d.tlyric.lyric) || (d.tlyric) || &quot;&quot;;
    if (typeof lyric !== &quot;string&quot;) lyric = &quot;&quot;;
    if (typeof trans !== &quot;string&quot;) trans = &quot;&quot;;
    if (!lyric.trim() &amp;&amp; !trans.trim()) return null;
    return { lyric: lyric, trans: trans };
  }
  function tryOne(i){
    if (i &gt;= urls.length) return Promise.resolve({ lyric: &quot;&quot;, trans: &quot;&quot; });
    return ADAPTER_request(urls[i], { headers: hdr, timeout: 12, credentials: &quot;omit&quot; }).then(function(txt){
      var got = parseNe(txt);
      if (got) return got;
      return tryOne(i + 1);
    }).catch(function(){ return tryOne(i + 1); });
  }
  return tryOne(0);
};


function _neHdr(){
  return { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Referer&quot;: &quot;https://music.163.com/&quot; };
}
function _mapNeteaseSong(s){
  if (!s || !s.id) return null;
  var artists = (s.ar || s.artists || []).map(function(a){ return a.name; }).join(&quot;/&quot;) || &quot;&quot;;
  var album = (s.al &amp;&amp; s.al.name) || (s.album &amp;&amp; s.album.name) || &quot;&quot;;
  var pic = (s.al &amp;&amp; (s.al.picUrl || s.al.blurPicUrl)) ||
    (s.album &amp;&amp; (s.album.picUrl || s.album.blurPicUrl)) || &quot;&quot;;
  var dur = Math.round(((s.dt || s.duration || 0) / 1000)) || 0;
  return {
    songmid: &quot;ne_&quot; + s.id, media_mid: String(s.id), neteaseId: String(s.id),
    name: s.name || &quot;&quot;, singer: artists, albumname: album,
    albummid: String((s.al &amp;&amp; s.al.id) || (s.album &amp;&amp; s.album.id) || &quot;&quot;),
    cover: pic ? String(pic).replace(/^http:/, &quot;https:&quot;) : &quot;&quot;,
    interval: dur, isVip: !!(s.fee === 1 || s.fee === 4 || s.fee === 8),
    playUrl: &quot;&quot;, source: &quot;netease&quot;
  };
}

/** 网易云热门歌单（支持分类 + 分页 offset，换一批用） */
API.neteaseHotPlaylists = function(cat, limit, offset){
  cat = cat || &quot;全部&quot;;
  limit = limit || 30;
  offset = Math.max(0, offset || 0);
  var url = &quot;https://music.163.com/api/playlist/list?cat=&quot; + encodeURIComponent(cat) +
    &quot;&amp;order=hot&amp;limit=&quot; + limit + &quot;&amp;offset=&quot; + offset;
  return ADAPTER_request(url, { headers: _neHdr(), timeout: 15 }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.playlists) || [];
    var total = (d &amp;&amp; d.total) || 0;
    var mapped = list.map(function(p){
      var id = String(p.id || &quot;&quot;);
      return {
        dissid: &quot;ne_pl_&quot; + id, id: &quot;ne_pl_&quot; + id, neteaseId: id,
        title: p.name || &quot;&quot;, dissname: p.name || &quot;&quot;,
        cover: (p.coverImgUrl || p.picUrl || &quot;&quot;).replace(/^http:/, &quot;https:&quot;),
        playCount: p.playCount || 0,
        creator: (p.creator &amp;&amp; p.creator.nickname) || &quot;&quot;,
        source: &quot;netease&quot;
      };
    }).filter(function(p){ return p.neteaseId &amp;&amp; p.title; });
    mapped._neTotal = total;
    mapped._neMore = (offset + mapped.length) &lt; total;
    return mapped;
  }).catch(function(){ return []; });
};

API.neteasePlaylistDetail = function(playlistId, pageNo, pageSize){
  pageNo = Math.max(0, pageNo || 0);
  pageSize = pageSize || 50;
  var id = String(playlistId || &quot;&quot;).replace(/^ne_pl_/, &quot;&quot;).replace(/\D/g, &quot;&quot;);
  if (!id) return Promise.resolve({ info: {}, songs: [], hasMore: false, pageNo: pageNo });
  return ADAPTER_request(&quot;https://music.163.com/api/v6/playlist/detail?id=&quot; + id + &quot;&amp;n=100000&quot;, { headers: _neHdr(), timeout: 18 }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var pl = (d &amp;&amp; d.playlist) || null;
    if (!pl) return { info: {}, songs: [], hasMore: false, pageNo: pageNo };
    var info = {
      title: pl.name || &quot;&quot;, cover: (pl.coverImgUrl || &quot;&quot;).replace(/^http:/, &quot;https:&quot;),
      desc: (pl.description || &quot;&quot;).replace(/\n+/g, &quot; &quot;).slice(0, 200),
      playCount: pl.playCount || 0, creator: (pl.creator &amp;&amp; pl.creator.nickname) || &quot;&quot;,
      songCount: pl.trackCount || 0, source: &quot;netease&quot;
    };
    var trackIds = (pl.trackIds || []).map(function(t){ return t &amp;&amp; (t.id || t); }).filter(Boolean);
    if (!trackIds.length &amp;&amp; pl.tracks &amp;&amp; pl.tracks.length) trackIds = pl.tracks.map(function(t){ return t.id; }).filter(Boolean);
    info.songCount = info.songCount || trackIds.length;
    var start = pageNo * pageSize;
    var sliceIds = trackIds.slice(start, start + pageSize);
    var hasMore = (start + sliceIds.length) &lt; trackIds.length;
    // 始终按 trackIds 顺序拉详情，避免有时用 pl.tracks（常只有前 20 首）导致两次打开列表不一致
    var trackMap = {};
    if (pl.tracks &amp;&amp; pl.tracks.length){
      pl.tracks.forEach(function(t){
        if (t &amp;&amp; t.id) trackMap[String(t.id)] = t;
      });
    }
    if (!sliceIds.length) return { info: info, songs: [], hasMore: false, pageNo: pageNo };
    var missing = sliceIds.filter(function(tid){ return !trackMap[String(tid)]; });
    function buildPage(fullMap){
      var songs = sliceIds.map(function(tid){
        var raw = fullMap[String(tid)] || trackMap[String(tid)];
        return _mapNeteaseSong(raw);
      }).filter(Boolean);
      return { info: info, songs: songs, hasMore: hasMore, pageNo: pageNo };
    }
    if (!missing.length) return buildPage(trackMap);
    return ADAPTER_request(&quot;https://music.163.com/api/song/detail/?ids=[&quot; + missing.join(&quot;,&quot;) + &quot;]&quot;, { headers: _neHdr(), timeout: 15 }).then(function(txt2){
      var d2 = jsonp_safeParse(txt2);
      var map = Object.assign({}, trackMap);
      ((d2 &amp;&amp; d2.songs) || []).forEach(function(s){ if (s &amp;&amp; s.id) map[String(s.id)] = s; });
      return buildPage(map);
    }).catch(function(){ return buildPage(trackMap); });
  }).catch(function(){ return { info: {}, songs: [], hasMore: false, pageNo: pageNo }; });
};

/** 网易请求头：尽量带登录 Cookie（与 QQ 同标准的个性化前提） */
function _neHdrDaily(){
  var h = {
    &quot;User-Agent&quot;: &quot;Mozilla/5.0 (iPhone; CPU iPhone OS 16_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 CloudMusic/8.9.0&quot;,
    &quot;Referer&quot;: &quot;https://music.163.com/&quot;,
    &quot;Origin&quot;: &quot;https://music.163.com&quot;,
    &quot;Accept&quot;: &quot;*/*&quot;
  };
  // 若本地存了网易 Cookie / 或用户对象里有
  try {
    var c = storeGet(&quot;neCookie&quot;, &quot;&quot;) || storeGet(&quot;neteaseCookie&quot;, &quot;&quot;) || &quot;&quot;;
    if (!c &amp;&amp; state.user &amp;&amp; state.user.neCookie) c = state.user.neCookie;
    if (!c &amp;&amp; state.user &amp;&amp; state.user.cookie &amp;&amp; /MUSIC_U=/.test(state.user.cookie)) c = state.user.cookie;
    if (c) h.Cookie = c;
  } catch(e) {}
  return h;
}
function _parseNeteaseDailySongs(txt){
  var d = jsonp_safeParse(txt);
  if (!d) return [];
  // 官方日推常见结构
  var list = (d.data &amp;&amp; d.data.dailySongs)
    || (d.data &amp;&amp; d.data.songs)
    || d.recommend
    || d.dailySongs
    || d.songs
    || d.result
    || [];
  if (!Array.isArray(list)) list = [];
  return list.map(function(item){
    return _mapNeteaseSong(item.song || item.songInfo || item);
  }).filter(Boolean);
}
function _nePostOrGet(url, isPost){
  var opts = { headers: _neHdrDaily(), timeout: 15 };
  if (isPost){
    opts.method = &quot;POST&quot;;
    opts.body = &quot;{}&quot;;
    opts.headers = Object.assign({}, opts.headers, { &quot;Content-Type&quot;: &quot;application/x-www-form-urlencoded&quot; });
  }
  return ADAPTER_request(url + (url.indexOf(&quot;?&quot;) &gt;= 0 ? &quot;&amp;&quot; : &quot;?&quot;) + &quot;t=&quot; + Date.now(), opts)
    .then(_parseNeteaseDailySongs)
    .catch(function(){ return []; });
}
/** 并行多接口，取最长个性化列表（对齐 QQ 日推策略） */
function _fetchNeteasePersonalizedDaily(limit){
  limit = limit || 30;
  var urls = [
    // 官方每日推荐（需登录 Cookie；未登录常空）
    { u: &quot;https://music.163.com/api/v3/discovery/recommend/songs&quot;, post: false },
    { u: &quot;https://music.163.com/api/recommend/songs&quot;, post: false },
    { u: &quot;https://music.163.com/api/v1/discovery/recommend/songs&quot;, post: false },
    { u: &quot;https://music.163.com/api/v3/discovery/recommend/songs?limit=&quot; + limit, post: false },
    // 新歌作弱个性化兜底（不打乱）
    { u: &quot;https://music.163.com/api/personalized/newsong?limit=&quot; + Math.max(limit, 30), post: false }
  ];
  return Promise.all(urls.map(function(it){
    return _nePostOrGet(it.u, it.post).catch(function(){ return []; });
  })).then(function(parts){
    var best = [];
    var bestSrc = &quot;netease-newsong&quot;;
    parts.forEach(function(list, i){
      if (list &amp;&amp; list.length &gt; best.length){
        best = list;
        bestSrc = i &lt; 4 ? &quot;netease-daily&quot; : &quot;netease-newsong&quot;;
      }
    });
    // 优先接近 30 首的官方日推
    parts.forEach(function(list, i){
      if (i &gt;= 4) return;
      if (list &amp;&amp; list.length &gt;= 20 &amp;&amp; list.length &lt;= 35 &amp;&amp; list.length &gt;= best.length - 3){
        best = list;
        bestSrc = &quot;netease-daily&quot;;
      }
    });
    return { songs: (best || []).slice(0, limit), source: bestSrc };
  });
}
function _enrichNeteaseCovers(songs){
  songs = songs || [];
  var need = songs.filter(function(s){ return s &amp;&amp; s.neteaseId &amp;&amp; !s.cover; }).slice(0, 30);
  if (!need.length) return Promise.resolve(songs);
  var ids = need.map(function(s){ return s.neteaseId; });
  return ADAPTER_request(&quot;https://music.163.com/api/song/detail/?ids=[&quot; + ids.join(&quot;,&quot;) + &quot;]&amp;t=&quot; + Date.now(), {
    headers: _neHdrDaily(), timeout: 15
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var map = {};
    ((d &amp;&amp; d.songs) || []).forEach(function(s){
      if (!s || !s.id) return;
      var m = _mapNeteaseSong(s);
      if (m) map[String(s.id)] = m;
    });
    songs.forEach(function(s){
      if (!s || s.cover) return;
      var m = map[String(s.neteaseId)];
      if (m){
        if (m.cover) s.cover = m.cover;
        if (m.albummid) s.albummid = m.albummid;
        if (m.albumname) s.albumname = m.albumname;
      }
    });
    return songs;
  }).catch(function(){ return songs; });
}


/** 网易云官方榜单一览 */
API.neteaseToplistOverview = function(){
  var FALLBACK = [
    { id: &quot;19723756&quot;, name: &quot;飙升榜&quot;, updateFrequency: &quot;每天更新&quot; },
    { id: &quot;3779629&quot;, name: &quot;新歌榜&quot;, updateFrequency: &quot;每天更新&quot; },
    { id: &quot;3778678&quot;, name: &quot;热歌榜&quot;, updateFrequency: &quot;每周更新&quot; },
    { id: &quot;2884035&quot;, name: &quot;原创榜&quot;, updateFrequency: &quot;每周更新&quot; },
    { id: &quot;1978921795&quot;, name: &quot;电音榜&quot;, updateFrequency: &quot;每周更新&quot; },
    { id: &quot;5059661515&quot;, name: &quot;网络热歌榜&quot;, updateFrequency: &quot;每周更新&quot; },
    { id: &quot;991319590&quot;, name: &quot;说唱榜&quot;, updateFrequency: &quot;每周更新&quot; },
    { id: &quot;71385702&quot;, name: &quot;古典音乐榜&quot;, updateFrequency: &quot;每周更新&quot; },
    { id: &quot;180106&quot;, name: &quot;UK排行榜&quot;, updateFrequency: &quot;每周更新&quot; },
    { id: &quot;60198&quot;, name: &quot;美国Billboard&quot;, updateFrequency: &quot;每周更新&quot; },
    { id: &quot;11641012&quot;, name: &quot;iTunes榜&quot;, updateFrequency: &quot;每周更新&quot; },
    { id: &quot;120001&quot;, name: &quot;Hit FM Top&quot;, updateFrequency: &quot;每周更新&quot; }
  ];
  function normalize(list){
    return (list || []).map(function(t){
      var id = String(t.id || t.playlistId || &quot;&quot;);
      if (!id) return null;
      return {
        id: id,
        name: t.name || t.title || &quot;榜单&quot;,
        cover: t.coverImgUrl || t.cover || t.picUrl || &quot;&quot;,
        updateFrequency: t.updateFrequency || t.updateFreq || t.description || &quot;&quot;,
        playCount: t.playCount || 0
      };
    }).filter(Boolean);
  }
  return ADAPTER_request(&quot;https://music.163.com/api/toplist&quot;, {
    headers: _neHdrDaily(), timeout: 12
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; (d.list || d.toplist || (d.data &amp;&amp; d.data.list))) || [];
    var out = normalize(list);
    if (out.length &gt;= 4) return out.slice(0, 24);
    return normalize(FALLBACK);
  }).catch(function(){ return normalize(FALLBACK); });
};

/** 网易云听书 / 电台：免费（可用接口：djradio/hot + recommend/v1 + search type=1009） */
API.neteaseVoiceFree = function(){
  var urls = [
    &quot;https://music.163.com/api/djradio/hot?limit=30&amp;offset=0&amp;cateId=10001&quot;,
    &quot;https://music.163.com/api/djradio/hot?limit=24&amp;offset=0&amp;cateId=3080097&quot;,
    &quot;https://music.163.com/api/djradio/hot?limit=24&amp;offset=0&amp;cateId=3088097&quot;,
    &quot;https://music.163.com/api/djradio/recommend/v1&quot;,
    &quot;https://music.163.com/api/search/get?s=&quot; + encodeURIComponent(&quot;免费有声书&quot;) + &quot;&amp;type=1009&amp;limit=24&amp;offset=0&quot;
  ];
  function mapRadio(r){
    if (!r) return null;
    var base = r.radio || r.djRadio || r;
    var id = base.id || r.id || r.radioId;
    if (!id) return null;
    var price = base.price != null ? base.price : (r.price != null ? r.price : null);
    var fee = base.fee != null ? base.fee : r.fee;
    var name = base.name || r.name || r.title || &quot;电台&quot;;
    var isTrialName = /试听|限免|免费/.test(String(name));
    var free = (price === 0 || price === &quot;0&quot;) || fee === 0 || fee === &quot;0&quot; || isTrialName || price == null;
    return {
      id: String(id),
      title: name,
      cover: base.picUrl || base.coverUrl || r.picUrl || r.coverUrl || &quot;&quot;,
      desc: r.rcmdText || r.rcmdtext || base.desc || base.category || r.category || &quot;&quot;,
      dj: (base.dj &amp;&amp; base.dj.nickname) || (r.dj &amp;&amp; r.dj.nickname) || &quot;&quot;,
      playCount: base.playCount || r.playCount || base.subCount || 0,
      fee: fee,
      price: price,
      free: !!free,
      trial: !!isTrialName &amp;&amp; !!(price === 0 || price == null),
      category: base.category || r.category || &quot;&quot;
    };
  }
  function extractList(d){
    if (!d) return [];
    var list = d.djRadios || d.radios || d.list || d.programs || d.data
      || (d.result &amp;&amp; (d.result.djRadios || d.result.djradios || d.result.list))
      || [];
    if (!Array.isArray(list) &amp;&amp; list &amp;&amp; Array.isArray(list.list)) list = list.list;
    if (!Array.isArray(list)) list = [];
    return list;
  }
  return Promise.all(urls.map(function(u){
    var full = u + (u.indexOf(&quot;?&quot;) &gt;= 0 ? &quot;&amp;&quot; : &quot;?&quot;) + &quot;t=&quot; + Date.now();
    return ADAPTER_request(full, { headers: _neHdrDaily(), timeout: 12 }).then(function(txt){
      var d = jsonp_safeParse(txt);
      if (d &amp;&amp; d.code &amp;&amp; d.code !== 200 &amp;&amp; !extractList(d).length) return [];
      return extractList(d).map(mapRadio).filter(Boolean);
    }).catch(function(){ return []; });
  })).then(function(parts){
    var seen = {}, out = [];
    parts.forEach(function(arr){
      (arr || []).forEach(function(x){
        if (!x || !x.id || seen[x.id]) return;
        // 尽量保留免费/0 元；若全部被滤空则后面会放宽
        if (!(x.free || x.trial || x.price === 0 || x.fee === 0 || x.price == null)) return;
        seen[x.id] = 1;
        out.push(x);
      });
    });
    // 仍无数据：放宽过滤，直接合并
    if (!out.length){
      parts.forEach(function(arr){
        (arr || []).forEach(function(x){
          if (!x || !x.id || seen[x.id]) return;
          seen[x.id] = 1;
          out.push(x);
        });
      });
    }
    return out.slice(0, 30);
  });
};

/** 网易云听书：限免 / 试听（有声书分类 + 搜索试听） */
API.neteaseVoiceTrial = function(){
  var urls = [
    &quot;https://music.163.com/api/djradio/hot?limit=30&amp;offset=0&amp;cateId=10001&quot;,
    &quot;https://music.163.com/api/djradio/hot?limit=24&amp;offset=0&amp;cateId=3088097&quot;,
    &quot;https://music.163.com/api/search/get?s=&quot; + encodeURIComponent(&quot;试听有声书&quot;) + &quot;&amp;type=1009&amp;limit=24&amp;offset=0&quot;,
    &quot;https://music.163.com/api/search/get?s=&quot; + encodeURIComponent(&quot;限免有声书&quot;) + &quot;&amp;type=1009&amp;limit=24&amp;offset=0&quot;,
    &quot;https://music.163.com/api/djradio/recommend/v1&quot;
  ];
  function mapRadio(r){
    if (!r) return null;
    var base = r.radio || r.djRadio || r;
    var id = base.id || r.id || r.radioId;
    if (!id) return null;
    var name = base.name || r.name || &quot;限免听书&quot;;
    var price = base.price != null ? base.price : r.price;
    return {
      id: String(id),
      title: name,
      cover: base.picUrl || base.coverUrl || r.picUrl || &quot;&quot;,
      desc: r.rcmdText || r.rcmdtext || base.desc || base.category || &quot;限时免费&quot;,
      dj: (base.dj &amp;&amp; base.dj.nickname) || (r.dj &amp;&amp; r.dj.nickname) || &quot;&quot;,
      playCount: base.playCount || r.playCount || 0,
      fee: base.fee,
      price: price,
      free: price === 0 || price == null,
      trial: true,
      category: base.category || r.category || &quot;&quot;
    };
  }
  function extractList(d){
    if (!d) return [];
    var list = d.djRadios || d.radios || d.list || d.data
      || (d.result &amp;&amp; (d.result.djRadios || d.result.djradios || d.result.list))
      || [];
    if (!Array.isArray(list) &amp;&amp; list &amp;&amp; Array.isArray(list.list)) list = list.list;
    if (!Array.isArray(list)) list = [];
    return list;
  }
  return Promise.all(urls.map(function(u){
    var full = u + (u.indexOf(&quot;?&quot;) &gt;= 0 ? &quot;&amp;&quot; : &quot;?&quot;) + &quot;t=&quot; + Date.now();
    return ADAPTER_request(full, { headers: _neHdrDaily(), timeout: 12 }).then(function(txt){
      var d = jsonp_safeParse(txt);
      return extractList(d).map(mapRadio).filter(Boolean);
    }).catch(function(){ return []; });
  })).then(function(parts){
    var seen = {}, out = [], prefer = [];
    parts.forEach(function(arr){
      (arr || []).forEach(function(x){
        if (!x || !x.id || seen[x.id]) return;
        seen[x.id] = 1;
        if (/试听|限免|免费/.test(String(x.title || &quot;&quot;)) || x.price === 0 || x.price == null){
          prefer.push(x);
        } else {
          out.push(x);
        }
      });
    });
    var merged = prefer.concat(out);
    if (merged.length &lt; 4){
      return API.neteaseVoiceFree().then(function(free){
        (free || []).forEach(function(x){
          if (!x || seen[x.id]) return;
          seen[x.id] = 1;
          x.trial = true;
          merged.push(x);
        });
        return merged.slice(0, 30);
      });
    }
    return merged.slice(0, 30);
  });
};

/* ---------- 喜马拉雅：搞笑频道 + 其它免费专辑 ---------- */
function _xmHdr(){
  return {
    &quot;User-Agent&quot;: &quot;Mozilla/5.0 (iPhone; CPU iPhone OS 16_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.0 Mobile/15E148 Safari/604.1&quot;,
    &quot;Referer&quot;: &quot;https://www.ximalaya.com/&quot;,
    &quot;Accept&quot;: &quot;application/json, text/plain, */*&quot;,
    &quot;Accept-Language&quot;: &quot;zh-CN,zh;q=0.9&quot;
  };
}
function _xmMobHdr(){
  return {
    &quot;User-Agent&quot;: &quot;ting_9.1.36(Redmi_K30,Android29)&quot;,
    &quot;Accept&quot;: &quot;application/json&quot;,
    &quot;Accept-Language&quot;: &quot;zh-CN,zh;q=0.9&quot;,
    &quot;Cookie&quot;: &quot;1&amp;_device=android&amp;_appVersion=9.1.36&quot;
  };
}
function _xmCover(path){
  if (!path) return &quot;&quot;;
  var p = String(path).trim();
  if (!p) return &quot;&quot;;
  if (p.indexOf(&quot;//&quot;) === 0) return &quot;https:&quot; + p;
  if (/^https?:\/\//i.test(p)) return p;
  // 喜马封面常见两种 CDN
  p = p.replace(/^\//, &quot;&quot;);
  if (/^storages\//i.test(p) || /^group/i.test(p) || /\.(jpg|jpeg|png|webp)/i.test(p)){
    return &quot;https://imagev2.xmcdn.com/&quot; + p;
  }
  return &quot;https://imagev2.xmcdn.com/&quot; + p;
}
/** 从专辑对象里尽量抠出封面字段 */
function _xmPickCover(a){
  if (!a) return &quot;&quot;;
  var keys = [
    &quot;albumCoverPath&quot;,&quot;album_cover_path&quot;,&quot;coverPath&quot;,&quot;cover_path&quot;,&quot;cover_path_large&quot;,
    &quot;coverLarge&quot;,&quot;cover_large&quot;,&quot;coverMiddle&quot;,&quot;cover_middle&quot;,
    &quot;coverSmall&quot;,&quot;cover_small&quot;,&quot;cover&quot;,&quot;img&quot;,
    &quot;pic&quot;,&quot;picture&quot;,&quot;image&quot;,&quot;coverUrl&quot;,&quot;cover_url&quot;,&quot;albumCover&quot;,&quot;album_cover&quot;
  ];
  var i, v;
  for (i = 0; i &lt; keys.length; i++){
    v = a[keys[i]];
    if (v &amp;&amp; typeof v === &quot;string&quot; &amp;&amp; v.length &gt; 4) return _xmCover(v);
  }
  // 嵌套
  if (a.cover &amp;&amp; typeof a.cover === &quot;object&quot;){
    return _xmPickCover(a.cover);
  }
  if (a.album &amp;&amp; typeof a.album === &quot;object&quot;){
    return _xmPickCover(a.album);
  }
  return &quot;&quot;;
}
function _mapXmAlbum(a, tag, badgeCls){
  if (!a) return null;
  var id = a.albumId || a.album_id || a.id || a.albumID || (a.album &amp;&amp; (a.album.albumId || a.album.id));
  if (!id) return null;
  // 明确付费且不可免费听：跳过
  var price = a.price != null ? Number(a.price) : (a.albumPrice != null ? Number(a.albumPrice) : 0);
  var isPaid = a.isPaid === true || a.is_paid === true || a.paid === true || a.isPaid === 1;
  var isFree = a.isFree === true || a.is_free === true || a.paidType === 0 || a.paid_type === 0 ||
    a.isPaid === false || a.price_type_id === 0 || a.price_type_id === &quot;0&quot;;
  if (isPaid &amp;&amp; !isFree &amp;&amp; price &gt; 0) return null;
  // 分类接口字段：albumCoverPath / albumTitle / albumUserNickName / albumPlayCount
  var cover = _xmPickCover(a) || _xmCover(a.albumCoverPath || a.cover_path || &quot;&quot;);
  var title = a.albumTitle || a.title || a.album_title || a.albumName || a.album_name || a.custom_title || a.name || &quot;喜马拉雅&quot;;
  var dj = a.albumUserNickName || a.anchorName || a.uidNickName || a.nickname || &quot;&quot;;
  if (!dj &amp;&amp; a.announcer) dj = a.announcer.nickname || a.announcer.nickName || &quot;&quot;;
  if (!dj &amp;&amp; a.anchor) dj = a.anchor.nickname || &quot;&quot;;
  if (!dj) dj = &quot;喜马拉雅&quot;;
  return {
    id: &quot;xm_&quot; + id,
    xmAlbumId: String(id),
    title: title,
    cover: cover,
    desc: a.intro || a.customTitle || a.custom_title || a.shortIntro || a.description || a.subtitle || tag || &quot;喜马拉雅&quot;,
    dj: dj,
    playCount: a.albumPlayCount || a.playCount || a.playsCount || a.play_count || a.plays || a.play || 0,
    free: true,
    trial: false,
    source: &quot;ximalaya&quot;,
    category: tag || &quot;喜马拉雅&quot;,
    badge: tag || &quot;喜马&quot;,
    badgeCls: badgeCls || &quot;xm&quot;
  };
}
/** 分类专辑：同时打网页端 + 移动端两个接口，封面/数量更全 */
API.ximalayaCategoryAlbums = function(categoryId, pageNum, pageSize){
  pageNum = pageNum || 1;
  pageSize = pageSize || 40;
  var ts = Date.now();
  // web 分类接口稳定；旧 mobile discovery 多数已 404
  var webUrl = &quot;https://www.ximalaya.com/revision/category/v2/albums?categoryId=&quot; + encodeURIComponent(categoryId) +
    &quot;&amp;pageNum=&quot; + pageNum + &quot;&amp;pageSize=&quot; + pageSize + &quot;&amp;metadataValues=&amp;metadataId=-1&amp;sort=1&amp;t=&quot; + ts;
  var webUrl2 = &quot;https://www.ximalaya.com/revision/category/v2/albums?categoryId=&quot; + encodeURIComponent(categoryId) +
    &quot;&amp;pageNum=&quot; + pageNum + &quot;&amp;pageSize=&quot; + pageSize + &quot;&amp;sort=0&amp;t=&quot; + ts;
  function parseList(txt){
    var d = jsonp_safeParse(txt);
    if (!d) return [];
    var list = [];
    if (d.data){
      list = d.data.albums || d.data.list || d.data.albumList || d.data.items || [];
      if (!Array.isArray(list) &amp;&amp; d.data.values) list = d.data.values;
    }
    if (!Array.isArray(list) || !list.length){
      list = d.albums || d.list || d.items || [];
    }
    if (!Array.isArray(list)) list = [];
    return list;
  }
  return Promise.all([
    ADAPTER_request(webUrl, { headers: _xmHdr(), timeout: 10, credentials: &quot;omit&quot; }).then(parseList).catch(function(){ return []; }),
    ADAPTER_request(webUrl2, { headers: _xmHdr(), timeout: 10, credentials: &quot;omit&quot; }).then(parseList).catch(function(){ return []; })
  ]).then(function(parts){
    var seen = {}, out = [];
    parts.forEach(function(arr){
      (arr || []).forEach(function(x){
        if (!x) return;
        var id = x.albumId || x.album_id || x.id;
        if (!id || seen[id]){
          if (id &amp;&amp; seen[id] &amp;&amp; seen[id].__raw){
            var prev = seen[id];
            if (!_xmPickCover(prev.__raw) &amp;&amp; _xmPickCover(x)){
              seen[id].__raw = x;
            }
          }
          return;
        }
        seen[id] = { __raw: x };
        out.push(x);
      });
    });
    return out;
  }).catch(function(){ return []; });
};
API.ximalayaSearchFree = function(kw, page, rows){
  page = page || 1;
  rows = rows || 30;
  var mob = &quot;https://search.ximalaya.com/front/v1?core=album&amp;kw=&quot; + encodeURIComponent(kw) +
    &quot;&amp;page=&quot; + page + &quot;&amp;rows=&quot; + rows + &quot;&amp;device=iPhone&amp;version=9.0.0&amp;t=&quot; + Date.now();
  var web = &quot;https://www.ximalaya.com/revision/search?core=album&amp;kw=&quot; + encodeURIComponent(kw) +
    &quot;&amp;page=&quot; + page + &quot;&amp;spellchecker=true&amp;rows=&quot; + rows +
    &quot;&amp;conditions=&quot; + encodeURIComponent('{&quot;paidType&quot;:0}') +
    &quot;&amp;fq=&amp;paidFilter=true&amp;t=&quot; + Date.now();
  function parseMob(txt){
    var d = jsonp_safeParse(txt);
    var docs = (d &amp;&amp; d.response &amp;&amp; d.response.docs) || (d &amp;&amp; d.docs) || [];
    if (!Array.isArray(docs)) docs = [];
    // 只要免费/非付费
    return docs.filter(function(x){
      if (!x) return false;
      if (x.is_paid === true || x.isPaid === true) return false;
      var pt = x.price_type_id;
      if (pt != null &amp;&amp; Number(pt) !== 0 &amp;&amp; Number(pt) !== 2) return false;
      return true;
    });
  }
  function parseWeb(txt){
    var d = jsonp_safeParse(txt);
    var docs = (d &amp;&amp; d.data &amp;&amp; d.data.result &amp;&amp; d.data.result.docs) ||
      (d &amp;&amp; d.data &amp;&amp; d.data.docs) || (d &amp;&amp; d.result &amp;&amp; d.result.docs) ||
      (d &amp;&amp; d.data &amp;&amp; d.data.albums) || [];
    if (!Array.isArray(docs)) docs = [];
    return docs;
  }
  return ADAPTER_request(mob, { headers: _xmHdr(), timeout: 12, credentials: &quot;omit&quot; }).then(function(txt){
    var list = parseMob(txt);
    if (list.length) return list;
    return ADAPTER_request(web, { headers: _xmHdr(), timeout: 12, credentials: &quot;omit&quot; })
      .then(parseWeb).catch(function(){ return []; });
  }).catch(function(){
    return ADAPTER_request(web, { headers: _xmHdr(), timeout: 12, credentials: &quot;omit&quot; })
      .then(parseWeb).catch(function(){ return []; });
  });
};
/** 按 tab 拉取一页喜马内容（带分页） */
API.ximalayaVoicePage = function(tabId, page){
  page = page || 1;
  /* 官方分类（revision/category/allCategoryInfo）：
   * 3有声书 4娱乐 6儿童 9历史 12相声评书 13个人成长 17教育培训 23影视
   * 注意：15=广播剧；23/17 分类页常为空，靠搜索补 */
  var map = {
    funny:  { cat: 12, tag: &quot;相声评书&quot;, cls: &quot;funny&quot;, kws: [&quot;相声&quot;,&quot;评书&quot;,&quot;相声评书&quot;,&quot;郭德纲&quot;] },
    ent:    { cat: 4,  tag: &quot;娱乐&quot;, cls: &quot;funny&quot;, kws: [&quot;娱乐&quot;,&quot;段子来了&quot;,&quot;段子&quot;] },
    book:   { cat: 3,  tag: &quot;有声书&quot;, cls: &quot;xm&quot;, kws: [&quot;有声书&quot;,&quot;免费有声书&quot;] },
    kids:   { cat: 6,  tag: &quot;儿童&quot;, cls: &quot;xm&quot;, kws: [&quot;儿童&quot;,&quot;儿童故事&quot;,&quot;睡前故事&quot;] },
    history:{ cat: 9,  tag: &quot;历史&quot;, cls: &quot;xm&quot;, kws: [&quot;历史&quot;,&quot;百家讲坛&quot;] },
    growth: { cat: 13, tag: &quot;个人成长&quot;, cls: &quot;xm&quot;, kws: [&quot;个人成长&quot;,&quot;成长&quot;] },
    edu:    { cat: 17, tag: &quot;教育培训&quot;, cls: &quot;xm&quot;, kws: [&quot;教育培训&quot;,&quot;英语听力&quot;,&quot;英语学习&quot;,&quot;教育&quot;,&quot;公开课&quot;] },
    film:   { cat: 23, tag: &quot;影视&quot;, cls: &quot;xm&quot;, kws: [&quot;电影解说&quot;,&quot;影视原声&quot;,&quot;影视&quot;,&quot;电影&quot;] }
  };
  var cfg = map[tabId];
  if (!cfg){
    // 全部：多分类并行第一页
    return Promise.all([
      API.ximalayaVoicePage(&quot;funny&quot;, page),
      API.ximalayaVoicePage(&quot;ent&quot;, page),
      API.ximalayaVoicePage(&quot;book&quot;, page),
      API.ximalayaVoicePage(&quot;kids&quot;, page),
      API.ximalayaVoicePage(&quot;history&quot;, page),
      API.ximalayaVoicePage(&quot;growth&quot;, page),
      API.ximalayaVoicePage(&quot;edu&quot;, page),
      API.ximalayaVoicePage(&quot;film&quot;, page)
    ]).then(function(parts){
      var seen = {}, out = [];
      parts.forEach(function(arr){
        (arr || []).forEach(function(x){
          if (!x || !x.id || seen[x.id]) return;
          seen[x.id] = 1;
          out.push(x);
        });
      });
      return out;
    });
  }
    // 影视/教育：分类常空，走搜索；其它：先分类（快），不足时再补搜索
  if (cfg.cat === 23 || cfg.cat === 17){
    var tasks = (cfg.kws || []).map(function(kw){ return API.ximalayaSearchFree(kw, page, 30); });
    return Promise.all(tasks).then(function(parts){
      var seen = {}, out = [];
      parts.forEach(function(arr){
        (arr || []).forEach(function(raw){
          var item = _mapXmAlbum(raw, cfg.tag, cfg.cls);
          if (!item || seen[item.id]) return;
          seen[item.id] = 1;
          out.push(item);
        });
      });
      return out;
    }).catch(function(){ return []; });
  }
  // 娱乐/相声/有声书等：分类接口一次即可（官方很快），仅分类结果偏少时再补 1 个关键词
  return API.ximalayaCategoryAlbums(cfg.cat, page, 40).then(function(list){
    list = list || [];
    if (list.length &gt;= 12 || !cfg.kws || !cfg.kws.length){
      var seen0 = {}, out0 = [];
      list.forEach(function(raw){
        var item = _mapXmAlbum(raw, cfg.tag, cfg.cls);
        if (!item || seen0[item.id]) return;
        seen0[item.id] = 1;
        out0.push(item);
      });
      return out0;
    }
    var kw = cfg.kws[0];
    return API.ximalayaSearchFree(kw, page, 30).then(function(extra){
      var seen = {}, out = [];
      list.concat(extra || []).forEach(function(raw){
        var item = _mapXmAlbum(raw, cfg.tag, cfg.cls);
        if (!item || seen[item.id]) return;
        seen[item.id] = 1;
        out.push(item);
      });
      return out;
    }).catch(function(){
      var seen = {}, out = [];
      list.forEach(function(raw){
        var item = _mapXmAlbum(raw, cfg.tag, cfg.cls);
        if (!item || seen[item.id]) return;
        seen[item.id] = 1;
        out.push(item);
      });
      return out;
    });
  }).catch(function(){
    var tasks = (cfg.kws || []).slice(0, 2).map(function(kw){ return API.ximalayaSearchFree(kw, page, 30); });
    if (!tasks.length) return [];
    return Promise.all(tasks).then(function(parts){
      var seen = {}, out = [];
      parts.forEach(function(arr){
        (arr || []).forEach(function(raw){
          var item = _mapXmAlbum(raw, cfg.tag, cfg.cls);
          if (!item || seen[item.id]) return;
          seen[item.id] = 1;
          out.push(item);
        });
      });
      return out;
    }).catch(function(){ return []; });
  });
};

/** 首页用的一次性聚合（多页多分类，尽量多拉） */
API.ximalayaVoiceFree = function(){
  var tabs = [&quot;funny&quot;,&quot;ent&quot;,&quot;book&quot;,&quot;kids&quot;,&quot;history&quot;,&quot;growth&quot;,&quot;edu&quot;,&quot;film&quot;];
  var tasks = [];
  tabs.forEach(function(t){
    tasks.push(API.ximalayaVoicePage(t, 1));
    tasks.push(API.ximalayaVoicePage(t, 2));
  });
  return Promise.all(tasks).then(function(parts){
    var seen = {}, out = [];
    parts.forEach(function(arr){
      (arr || []).forEach(function(x){
        if (!x || !x.id || seen[x.id]) return;
        seen[x.id] = 1;
        out.push(x);
      });
    });
    return out;
  }).catch(function(){ return []; });
};
/** 专辑节目列表：多接口兜底，尽量列出可点的集数 */
API.ximalayaAlbumTracks = function(albumId, pageNum, pageSize){
  pageNum = pageNum || 1;
  pageSize = pageSize || 50;
  var aid = String(albumId).replace(/^xm_/, &quot;&quot;);
  var ts = Date.now();

  function extractTracks(d){
    if (!d) return [];
    var list = [];
    if (d.data){
      list = d.data.tracks || d.data.list || d.data.trackList || d.data.items ||
        (d.data.albumPage &amp;&amp; (d.data.albumPage.tracks || d.data.albumPage.list)) ||
        (d.data.tracksInfo &amp;&amp; d.data.tracksInfo.tracks) || [];
      if (!Array.isArray(list) &amp;&amp; d.data.audioInfo) list = [d.data];
    }
    if (!Array.isArray(list) || !list.length){
      // mobwsa 直接顶层 list
      list = d.tracks || d.list || d.items || [];
    }
    if (!Array.isArray(list)) list = [];
    return list;
  }
  function mapTrack(t){
    if (!t) return null;
    var node = t.track || t.trackInfo || t;
    var tid = node.trackId || node.track_id || node.id || t.trackId || t.id;
    if (!tid) return null;
    var isPaid = node.isPaid === true || node.is_paid === true || t.isPaid === true;
    var isFree = node.isFree === true || node.is_free === true || node.isFree === 1 ||
      node.isTryOut === true || node.is_try_out === true || t.isTryOut === true ||
      node.sampleDuration &gt; 0 || node.isSample === true ||
      node.paidType === 0 || node.paid_type === 0 || node.isAuthorized === true;
    var cover = _xmPickCover(node) || _xmPickCover(t) || &quot;&quot;;
    var dur = node.duration || node.trackDuration || t.duration || node.length || 0;
    if (dur &gt; 10000) dur = Math.round(dur / 1000);
    var playUrl = node.playUrl64 || node.playUrl32 || node.playPathAacv164 || node.playPathAacv224 ||
      node.playPathHq || node.play_path_64 || node.play_path_32 || node.playUrl || node.play_path ||
      t.playUrl64 || t.playUrl32 || &quot;&quot;;
    if (playUrl &amp;&amp; String(playUrl).indexOf(&quot;//&quot;) === 0) playUrl = &quot;https:&quot; + playUrl;
    if (playUrl &amp;&amp; String(playUrl).indexOf(&quot;http://&quot;) === 0) playUrl = &quot;https://&quot; + playUrl.slice(7);
    return {
      songmid: &quot;xm_&quot; + tid,
      media_mid: String(tid),
      xmTrackId: String(tid),
      xmAlbumId: String(aid),
      name: node.title || node.trackName || node.name || t.title || t.trackName || &quot;节目&quot;,
      singer: node.anchorName || node.nickname || t.anchorName || t.nickname || &quot;喜马拉雅&quot;,
      cover: cover,
      interval: dur || 0,
      source: &quot;ximalaya&quot;,
      playUrl: playUrl || &quot;&quot;,
      playUrlAt: playUrl ? Date.now() : 0,
      playUrlTs: playUrl ? Date.now() : 0,
      isDjProgram: true,
      isPaid: !!(isPaid &amp;&amp; !isFree)
    };
  }
  function toSongs(tracks){
    var seen = {}, uniq = [];
    (tracks || []).map(mapTrack).filter(Boolean).forEach(function(s){
      if (!s || !s.xmTrackId || seen[s.xmTrackId]) return;
      seen[s.xmTrackId] = 1;
      uniq.push(s);
    });
    return uniq;
  }

  // ===== 主路径：官方移动端同款（列表内直接带 playUrl，一次请求秒开）=====
  // https://mobwsa.ximalaya.com/mobile/playlist/album/page?albumId=&amp;pageId=
  var mobwsa = &quot;https://mobwsa.ximalaya.com/mobile/playlist/album/page?albumId=&quot; +
    encodeURIComponent(aid) + &quot;&amp;pageId=&quot; + pageNum;
  return ADAPTER_request(mobwsa, {
    headers: _xmMobHdr ? _xmMobHdr() : _xmHdr(),
    timeout: 8,
    credentials: &quot;omit&quot;
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var songs = toSongs(extractTracks(d));
    if (songs.length) return { songs: songs, info: { title: &quot;&quot;, cover: &quot;&quot; } };

    // 兜底：旧 web 列表 + mobile v1 并行
    var urls = [
      {
        url: &quot;https://www.ximalaya.com/revision/album/getTracksList?albumId=&quot; + encodeURIComponent(aid) +
          &quot;&amp;pageNum=&quot; + pageNum + &quot;&amp;pageSize=&quot; + pageSize + &quot;&amp;sort=1&quot;,
        hdr: _xmHdr, timeout: 10
      },
      {
        url: &quot;https://mobile.ximalaya.com/mobile/v1/album/track/ts-&quot; + ts +
          &quot;?albumId=&quot; + encodeURIComponent(aid) + &quot;&amp;device=android&amp;isAsc=true&amp;pageSize=&quot; + pageSize +
          &quot;&amp;pageId=&quot; + pageNum + &quot;&amp;ac=WIFI&quot;,
        hdr: (_xmMobHdr || _xmHdr), timeout: 10
      }
    ];
    return Promise.all(urls.map(function(u){
      return ADAPTER_request(u.url, { headers: u.hdr(), timeout: u.timeout, credentials: &quot;omit&quot; })
        .then(function(t2){
          var d2 = jsonp_safeParse(t2);
          if (d2 &amp;&amp; (d2.ret === 407 || d2.code === 5 || d2.ret === 924)) return [];
          return toSongs(extractTracks(d2));
        }).catch(function(){ return []; });
    })).then(function(parts){
      var best = [];
      parts.forEach(function(arr){ if (arr &amp;&amp; arr.length &gt; best.length) best = arr; });
      return { songs: best, info: { title: &quot;&quot;, cover: &quot;&quot; } };
    });
  }).catch(function(){
    // mobwsa 失败：走旧并行兜底
    var urls = [
      &quot;https://www.ximalaya.com/revision/album/getTracksList?albumId=&quot; + encodeURIComponent(aid) +
        &quot;&amp;pageNum=&quot; + pageNum + &quot;&amp;pageSize=&quot; + pageSize + &quot;&amp;sort=1&quot;,
      &quot;https://mobile.ximalaya.com/mobile/v1/album/track/ts-&quot; + ts +
        &quot;?albumId=&quot; + encodeURIComponent(aid) + &quot;&amp;device=android&amp;isAsc=true&amp;pageSize=&quot; + pageSize +
        &quot;&amp;pageId=&quot; + pageNum + &quot;&amp;ac=WIFI&quot;
    ];
    return Promise.all(urls.map(function(url){
      return ADAPTER_request(url, { headers: (_xmMobHdr &amp;&amp; url.indexOf(&quot;mobile&quot;)&gt;=0 ? _xmMobHdr() : _xmHdr()), timeout: 10, credentials: &quot;omit&quot; })
        .then(function(t2){ return toSongs(extractTracks(jsonp_safeParse(t2))); })
        .catch(function(){ return []; });
    })).then(function(parts){
      var best = [];
      parts.forEach(function(arr){ if (arr &amp;&amp; arr.length &gt; best.length) best = arr; });
      return { songs: best, info: { title: &quot;&quot;, cover: &quot;&quot; } };
    });
  });
};
/** 取单集播放直链 */
API.ximalayaTrackUrl = function(song){
  var tid = (song &amp;&amp; (song.xmTrackId || String(song.songmid || &quot;&quot;).replace(/^xm_/, &quot;&quot;))) || &quot;&quot;;
  if (!tid) return Promise.resolve(null);
  if (song.playUrl &amp;&amp; /^https?:\/\//i.test(song.playUrl) &amp;&amp; isPlayUrlFresh(song)){
    return Promise.resolve(song.playUrl);
  }
  function normalizeSrc(src){
    if (!src) return &quot;&quot;;
    src = String(src);
    if (src.indexOf(&quot;//&quot;) === 0) src = &quot;https:&quot; + src;
    if (src.indexOf(&quot;http://&quot;) === 0) src = &quot;https://&quot; + src.slice(7);
    return src;
  }
  function applySrc(src){
    src = normalizeSrc(src);
    if (src &amp;&amp; song){
      song.playUrl = src;
      var now = Date.now();
      song.playUrlAt = now;
      song.playUrlTs = now;
    }
    return src || null;
  }
  // 1) 官方 web 批量播放接口（稳定、免 webtk）
  var webUrl = &quot;https://www.ximalaya.com/revision/play/tracks?trackIds=&quot; + encodeURIComponent(tid);
  // 2) 移动端单集详情（含 playUrl64 / aac）
  var mobUrl = &quot;https://mobile.ximalaya.com/v1/track/baseInfo?device=android&amp;trackId=&quot; + encodeURIComponent(tid) + &quot;&amp;trackQualityLevel=1&quot;;
  // 3) 旧 v1 audio 兜底
  var v1Url = &quot;https://www.ximalaya.com/revision/play/v1/audio?id=&quot; + encodeURIComponent(tid) + &quot;&amp;ptype=1&amp;t=&quot; + Date.now();

  var pWeb = ADAPTER_request(webUrl, { headers: _xmHdr(), timeout: 10, credentials: &quot;omit&quot; }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var arr = (d &amp;&amp; d.data &amp;&amp; d.data.tracksForAudioPlay) || [];
    var item = arr[0] || {};
    return applySrc(item.src || item.playUrl || item.url || &quot;&quot;);
  }).catch(function(){ return null; });

  var pMob = ADAPTER_request(mobUrl, { headers: _xmMobHdr(), timeout: 10, credentials: &quot;omit&quot; }).then(function(txt){
    var d = jsonp_safeParse(txt) || {};
    var node = d.data || d;
    var src = node.playUrl64 || node.playUrl32 || node.playPathAacv164 || node.playPathAacv224 ||
      node.downloadUrl || node.playUrl || &quot;&quot;;
    return applySrc(src);
  }).catch(function(){ return null; });

  return Promise.all([pWeb, pMob]).then(function(parts){
    for (var i = 0; i &lt; parts.length; i++){
      if (parts[i]) return parts[i];
    }
    return ADAPTER_request(v1Url, { headers: _xmHdr(), timeout: 8, credentials: &quot;omit&quot; }).then(function(txt){
      var d = jsonp_safeParse(txt);
      var data = (d &amp;&amp; d.data) || d || {};
      var src = data.src || data.playUrl || data.url || data.trackUrl ||
        (data.playUrlList &amp;&amp; data.playUrlList[0] &amp;&amp; (data.playUrlList[0].url || data.playUrlList[0])) || &quot;&quot;;
      return applySrc(src);
    }).catch(function(){ return null; });
  });
};


/** 电台节目 → 可播列表（注意参数名必须是 radioId，rid 会 400）
 *  asc: true=正序（旧→新），false=倒序（新→旧，默认） */
API.neteaseDjPrograms = function(radioId, limit, asc){
  limit = limit || 40;
  var rid = encodeURIComponent(radioId);
  var ascParam = (asc === true) ? &quot;true&quot; : &quot;false&quot;;
  var urls = [
    &quot;https://music.163.com/api/dj/program/byradio?radioId=&quot; + rid + &quot;&amp;limit=&quot; + limit + &quot;&amp;offset=0&amp;asc=&quot; + ascParam,
    &quot;https://music.163.com/api/dj/program/byradio?radioId=&quot; + rid + &quot;&amp;limit=&quot; + limit + &quot;&amp;offset=0&quot;
  ];
  function mapPrograms(txt){
    var d = jsonp_safeParse(txt);
    var programs = (d &amp;&amp; (d.programs || d.data || d.list)) || [];
    if (!Array.isArray(programs)) programs = [];
    var songs = [];
    programs.forEach(function(p){
      if (!p) return;
      var main = p.mainSong || p.song || null;
      var mapped = null;
      if (main &amp;&amp; typeof _mapNeteaseSong === &quot;function&quot;){
        mapped = _mapNeteaseSong(main);
      }
      if (!mapped &amp;&amp; (p.id || p.mainTrackId)){
        mapped = {
          songmid: &quot;ne_&quot; + (main &amp;&amp; main.id ? main.id : p.mainTrackId || p.id),
          neteaseId: String(main &amp;&amp; main.id ? main.id : p.mainTrackId || p.id),
          name: p.name || (main &amp;&amp; main.name) || &quot;节目&quot;,
          singer: (p.dj &amp;&amp; p.dj.nickname) || (main &amp;&amp; main.artists &amp;&amp; main.artists[0] &amp;&amp; main.artists[0].name) || &quot;&quot;,
          cover: p.coverUrl || (main &amp;&amp; main.album &amp;&amp; main.album.picUrl) || &quot;&quot;,
          interval: Math.round(((p.duration || (main &amp;&amp; main.duration) || 0) / 1000)) || 0,
          source: &quot;netease&quot;,
          isDjProgram: true,
          programId: p.id
        };
      }
      if (mapped){
        if (!mapped.cover &amp;&amp; p.coverUrl) mapped.cover = p.coverUrl;
        if (!mapped.singer &amp;&amp; p.dj &amp;&amp; p.dj.nickname) mapped.singer = p.dj.nickname;
        mapped.source = &quot;netease&quot;;
        mapped.isDjProgram = true;
        if (p.id) mapped.programId = p.id;
        songs.push(mapped);
      }
    });
    return { songs: songs, info: { title: &quot;&quot;, cover: &quot;&quot; } };
  }
  // 依次尝试，任一成功且有节目即返回
  return ADAPTER_request(urls[0] + &quot;&amp;t=&quot; + Date.now(), { headers: _neHdrDaily(), timeout: 15 }).then(function(txt){
    var res = mapPrograms(txt);
    if (res.songs &amp;&amp; res.songs.length) return res;
    return ADAPTER_request(urls[1] + &quot;&amp;t=&quot; + Date.now(), { headers: _neHdrDaily(), timeout: 15 }).then(mapPrograms);
  }).catch(function(){
    return ADAPTER_request(urls[1] + &quot;&amp;t=&quot; + Date.now(), { headers: _neHdrDaily(), timeout: 15 })
      .then(mapPrograms)
      .catch(function(){ return { songs: [], info: {} }; });
  });
};

// 网易云每日推荐：官方日推优先，失败回退新歌；不本地轮转
API.neteaseDailyRecommend = function(periodKey){
  return _fetchNeteasePersonalizedDaily(30).then(function(res){
    return _enrichNeteaseCovers(res.songs || []).then(function(songs){
      return { songs: songs, source: res.source || &quot;netease-daily&quot; };
    });
  }).catch(function(){ return { songs: [], source: &quot;netease-newsong&quot; }; });
};

// 网易云每日30：固定「云音乐热歌榜」前 30 首 + 当日本地快照，保证多次点开一致
API.neteaseDaily30 = function(periodKey){
  var meta = { id: 3778678, title: &quot;热歌榜&quot; };
  var day = &quot;&quot;;
  try {
    var pi = getDailyPeriodInfo();
    day = (pi &amp;&amp; pi.day) || &quot;&quot;;
  } catch(eD) {}
  var snapKey = &quot;neDaily30Snap|&quot; + day;

  // 当日已有快照：直接用，不再请求（避免榜单接口两次返回不一致）
  try {
    var raw = storeGet(snapKey, &quot;&quot;);
    if (raw){
      var snap = JSON.parse(raw);
      if (snap &amp;&amp; Array.isArray(snap.songs) &amp;&amp; snap.songs.length &gt;= 8){
        return Promise.resolve({ songs: snap.songs, title: snap.title || meta.title, source: &quot;snapshot&quot; });
      }
    }
  } catch(eS) {}

  return API.neteasePlaylistDetail(meta.id, 0, 30).then(function(res){
    var songs = ((res &amp;&amp; res.songs) || []).slice(0, 30);
    return _enrichNeteaseCovers(songs).then(function(list){
      list = (list || []).slice(0, 30);
      try {
        // 只存播放所需精简字段，控制体积
        var slim = list.map(function(s){
          return {
            songmid: s.songmid, name: s.name, singer: s.singer,
            cover: s.cover, albummid: s.albummid, albumname: s.albumname,
            interval: s.interval, neteaseId: s.neteaseId, source: s.source || &quot;netease&quot;
          };
        });
        storeSet(snapKey, JSON.stringify({ title: meta.title, songs: slim, ts: Date.now() }));
      } catch(eW) {}
      return { songs: list, title: meta.title, source: &quot;toplist&quot; };
    });
  }).catch(function(){
    return { songs: [], title: meta.title, source: &quot;toplist&quot; };
  });
};

API.search = function(kw, page){
  page = page || 1;
  // 只打一枪单曲，优先出结果；歌手/专辑/歌单由 render 侧按需补
  return API._searchByType(kw, 0, page, 20).then(function(songRes){
    var songData = (songRes &amp;&amp; songRes.data) || {};
    var songList = (songData.song &amp;&amp; songData.song.list) || [];
    var zhida = songData.zhida || null;
    var total = (songData.song &amp;&amp; songData.song.totalnum) || songList.length;

    var zhidaSingers = [];
    if (zhida &amp;&amp; zhida.zhida_singer){
      var zs = zhida.zhida_singer;
      zhidaSingers = _normSingers([{
        singerMID: zs.singerMID, singerName: zs.singerName,
        singerPic: zs.singerPic, songNum: zs.songNum
      }]);
    }

    return {
      list: songList.map(normalizeSongFromSearch),
      singers: zhidaSingers.slice(),
      playlists: [],
      albums: [],
      zhida: zhida,
      total: total,
      _kw: kw
    };
  }).catch(function(){
    return { list: [], singers: [], playlists: [], albums: [], total: 0, _kw: kw };
  });
};

API.searchExtra = function(kw){
  return Promise.all([
    API._searchByType(kw, 9, 1, 20).catch(function(){ return null; }),
    API._searchByType(kw, 8, 1, 20).catch(function(){ return null; }),
    API.searchPlaylists(kw, 1).catch(function(){ return []; })
  ]).then(function(parts){
    var singerData = parts[0] &amp;&amp; parts[0].data;
    var albumData = parts[1] &amp;&amp; parts[1].data;
    var pls = parts[2] || [];
    return {
      singers: _normSingers((singerData &amp;&amp; singerData.singer &amp;&amp; singerData.singer.list) || []),
      albums: _normAlbums((albumData &amp;&amp; albumData.album &amp;&amp; albumData.album.list) || []),
      playlists: Array.isArray(pls) ? pls : _normPlaylists(pls)
    };
  }).catch(function(){
    return { singers: [], albums: [], playlists: [] };
  });
};

/** 搜索联想（smartbox_new：仅 song/singer/album/mv，无歌单字段） */
API.smartbox = function(kw){
  kw = (kw || &quot;&quot;).trim();
  if (!kw) return Promise.resolve({ songs: [], singers: [], playlists: [], albums: [] });
  var url = &quot;https://c.y.qq.com/splcloud/fcgi-bin/smartbox_new.fcg?is_xml=0&amp;format=json&amp;key=&quot;+
    encodeURIComponent(kw)+&quot;&amp;g_tk=5381&amp;loginUin=0&amp;hostUin=0&amp;inCharset=utf8&amp;outCharset=utf-8&amp;platform=yqq.json&quot;;
  return ADAPTER_request(url, {headers:withCookie({&quot;Referer&quot;:&quot;https://y.qq.com/&quot;})}).then(function(txt){
    var d = jsonp_safeParse(txt);
    var data = (d &amp;&amp; d.data) || {};
    var songs = ((data.song &amp;&amp; data.song.itemlist) || []).map(function(s){
      return {
        songmid: s.mid || s.songmid || &quot;&quot;,
        name: s.name || s.title || &quot;&quot;,
        singer: s.singer || &quot;&quot;,
        albummid: s.albummid || &quot;&quot;,
        interval: 0
      };
    }).filter(function(s){ return s.name; });
    var singers = ((data.singer &amp;&amp; data.singer.itemlist) || []).map(function(s){
      var mid = s.mid || s.singer_mid || &quot;&quot;;
      return {
        mid: mid,
        name: s.name || s.singer || &quot;&quot;,
        cover: fixCover(s.pic || &quot;&quot;) || (mid ? coverUrl(mid, &quot;singer&quot;) : &quot;&quot;)
      };
    }).filter(function(s){ return s.name; });
    // 官方 smartbox 无歌单；用专辑顶替「相关」展示
    var albums = ((data.album &amp;&amp; data.album.itemlist) || []).map(function(a){
      return {
        mid: a.mid || &quot;&quot;,
        name: a.name || &quot;&quot;,
        singer: a.singer || &quot;&quot;,
        cover: fixCover(a.pic || &quot;&quot;)
      };
    }).filter(function(a){ return a.name; });
    return { songs: songs, singers: singers, playlists: [], albums: albums };
  }).catch(function(){ return { songs: [], singers: [], playlists: [], albums: [] }; });
};

/* ---------- 各平台热搜（独立词池 + 接口 + 本地兜底） ---------- */
var HOT_FALLBACK = {
  qq: [&quot;周杰伦&quot;,&quot;林俊杰&quot;,&quot;邓紫棋&quot;,&quot;薛之谦&quot;,&quot;告五人&quot;,&quot;汪苏泷&quot;,&quot;张杰&quot;,&quot;单依纯&quot;,&quot;王菲&quot;,&quot;五月天&quot;,&quot;新裤子&quot;,&quot;陈奕迅&quot;,&quot;毛不易&quot;,&quot;赵雷&quot;,&quot;G.E.M.&quot;,&quot;告五人 唯一&quot;,&quot;海来阿木&quot;,&quot;房东的猫&quot;,&quot;颜人中&quot;,&quot;张碧晨&quot;,&quot;李荣浩&quot;,&quot;许嵩&quot;,&quot;华晨宇&quot;,&quot;容祖儿&quot;,&quot;SHE&quot;,&quot;五月天 倔强&quot;,&quot;周深&quot;,&quot;刘德华&quot;,&quot;王力宏&quot;,&quot;蔡依林&quot;],
  kuwo: [&quot;刀郎&quot;,&quot;张韶涵&quot;,&quot;任贤齐&quot;,&quot;凤凰传奇&quot;,&quot;腾格尔&quot;,&quot;降央卓玛&quot;,&quot;乌兰图雅&quot;,&quot;云朵&quot;,&quot;安儿陈&quot;,&quot;韩红&quot;,&quot;那英&quot;,&quot;孙楠&quot;,&quot;费玉清&quot;,&quot;李克勤&quot;,&quot;张学友&quot;,&quot;王杰&quot;,&quot;刘若英&quot;,&quot;齐秦&quot;,&quot;毛不易&quot;,&quot;赵雷&quot;,&quot;丢火车&quot;,&quot;痛仰&quot;,&quot;二手玫瑰&quot;,&quot;万能青年旅店&quot;,&quot;新裤子&quot;,&quot;伍佰&quot;,&quot;动力火车&quot;,&quot;黑鸭子&quot;,&quot;降央卓玛 西海情歌&quot;,&quot;刀郎 2002年的第一场雪&quot;],
  netease: [&quot;告五人&quot;,&quot;赵雷&quot;,&quot;万能青年旅店&quot;,&quot;痛仰&quot;,&quot;新裤子&quot;,&quot;陈鸿宇&quot;,&quot;宋冬野&quot;,&quot;马頔&quot;,&quot;尧十三&quot;,&quot;陈粒&quot;,&quot;郭顶&quot;,&quot;房东的猫&quot;,&quot;理想混蛋&quot;,&quot;草东没有派对&quot;,&quot;逃跑计划&quot;,&quot;海龟先生&quot;,&quot;五条人&quot;,&quot;霓虹花园&quot;,&quot;丢火车&quot;,&quot;声音玩具&quot;,&quot;木心&quot;,&quot;李志&quot;,&quot;赵雷 成都&quot;,&quot;告五人 爱在夏天&quot;,&quot;陈奕迅 孤勇者&quot;,&quot;周杰伦 晴天&quot;,&quot;邓紫棋 光年之外&quot;,&quot;薛之谦 认真的雪&quot;,&quot;毛不易 消愁&quot;,&quot;华晨宇 烟火里的尘埃&quot;],
  kugou: [&quot;DJ&quot;,&quot;车载音乐&quot;,&quot;夜色钢琴曲&quot;,&quot;纯音乐&quot;,&quot;经典老歌&quot;,&quot;网络热歌&quot;,&quot;抖音热歌&quot;,&quot;伤感情歌&quot;,&quot;粤语经典&quot;,&quot;国语老歌&quot;,&quot;周杰伦&quot;,&quot;林俊杰&quot;,&quot;薛之谦&quot;,&quot;张杰&quot;,&quot;邓紫棋&quot;,&quot;刀郎&quot;,&quot;凤凰传奇&quot;,&quot;海来阿木&quot;,&quot;乌兰图雅&quot;,&quot;光良&quot;,&quot;羽泉&quot;,&quot;朴树&quot;,&quot;水木年华&quot;,&quot;零点乐队&quot;,&quot;黑龙&quot;,&quot;杨坤&quot;,&quot;刀郎 冲动的惩罚&quot;,&quot;凤凰传奇 最炫民族风&quot;,&quot;海来阿木 你的万水千山&quot;,&quot;经典红歌&quot;],
  ytmusic: [&quot;Taylor Swift&quot;,&quot;BTS&quot;,&quot;Blackpink&quot;,&quot;NewJeans&quot;,&quot;IU&quot;,&quot;Adele&quot;,&quot;Ed Sheeran&quot;,&quot;The Weeknd&quot;,&quot;Billie Eilish&quot;,&quot;Drake&quot;,&quot;Ariana Grande&quot;,&quot;Bruno Mars&quot;,&quot;Coldplay&quot;,&quot;Imagine Dragons&quot;,&quot;Justin Bieber&quot;,&quot;Olivia Rodrigo&quot;,&quot;SZA&quot;,&quot;Dua Lipa&quot;,&quot;Harry Styles&quot;,&quot;LISA&quot;,&quot;Rosé&quot;,&quot;Jung Kook&quot;,&quot;Jennie&quot;,&quot;Stray Kids&quot;,&quot;aespa&quot;,&quot;IVE&quot;,&quot;LE SSERAFIM&quot;,&quot;SEVENTEEN&quot;,&quot;TXT&quot;,&quot;ENHYPEN&quot;]
};
function _uniqHot(list){
  var seen = {}, out = [];
  (list || []).forEach(function(t){
    t = String(t || &quot;&quot;).trim();
    if (!t || seen[t]) return;
    seen[t] = 1;
    out.push(t);
  });
  return out;
}
function _hotFromFallback(src, n){
  return shuffleArray(HOT_FALLBACK[src] || HOT_FALLBACK.qq).slice(0, n || 12);
}
API.hotSearchQQ = function(){
  var url = &quot;https://c.y.qq.com/splcloud/fcgi-bin/gethotkey.fcg?format=json&amp;inCharset=utf8&amp;outCharset=utf-8&amp;rnd=&quot;+Math.random()+&quot;&amp;_=&quot;+Date.now();
  return ADAPTER_request(url, {headers:withCookie(), timeout:10}).then(function(txt){
    var d = jsonp_safeParse(txt);
    var keys = (d &amp;&amp; d.data &amp;&amp; d.data.hotkey) || [];
    var list = keys.map(function(i){ return i &amp;&amp; (i.k || i.n || i.query); }).filter(Boolean);
    return _uniqHot(list);
  }).catch(function(){ return []; });
};
API.hotSearchNetease = function(){
  var hdr = { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Referer&quot;: &quot;https://music.163.com/&quot; };
  var urls = [
    &quot;https://music.163.com/api/search/hot&quot;,
    &quot;https://music.163.com/api/hotsearchlist/get&quot;,
    &quot;https://music.163.com/api/search/suggest/multimatch?s=%E7%83%AD%E6%90%9C&quot;
  ];
  function tryOne(i){
    if (i &gt;= urls.length) return Promise.resolve([]);
    return ADAPTER_request(urls[i], {headers:hdr, timeout:10}).then(function(txt){
      var d = jsonp_safeParse(txt);
      var list = [];
      if (d &amp;&amp; d.result &amp;&amp; d.result.hots){
        list = d.result.hots.map(function(h){ return h.first || h.second || h.word; });
      } else if (d &amp;&amp; d.data &amp;&amp; d.data){
        var arr = d.data;
        if (Array.isArray(arr)) list = arr.map(function(h){ return h.searchWord || h.word || h.first || h.title; });
        else if (arr &amp;&amp; arr.hots) list = arr.hots.map(function(h){ return h.first || h.searchWord; });
      }
      list = _uniqHot(list);
      if (list.length) return list;
      return tryOne(i + 1);
    }).catch(function(){ return tryOne(i + 1); });
  }
  return tryOne(0);
};
API.hotSearchKuwo = function(){
  var hdr = { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Referer&quot;: &quot;https://www.kuwo.cn/&quot;, &quot;Accept&quot;: &quot;application/json&quot; };
  var urls = [
    &quot;https://wapi.kuwo.cn/api/www/search/searchKey?key=&amp;httpsStatus=1&amp;reqId=&quot;+Math.random().toString(36).slice(2),
    &quot;https://search.kuwo.cn/r.s?all=&amp;ft=music&amp;newsearch=1&amp;itemset=web_2013&amp;client=kt&amp;cluster=0&amp;pn=0&amp;rn=0&amp;rformat=json&amp;encoding=utf8&amp;pcjson=1&amp;_=&quot;+Date.now()
  ];
  function tryOne(i){
    if (i &gt;= urls.length) return Promise.resolve([]);
    return ADAPTER_request(urls[i], {headers:hdr, timeout:10}).then(function(txt){
      var d = jsonp_safeParse(txt);
      var list = [];
      // wapi searchKey: data = [{word}] or data.list
      var data = (d &amp;&amp; d.data) || d;
      if (Array.isArray(data)){
        list = data.map(function(x){ return (typeof x === &quot;string&quot;) ? x : (x.word || x.KEY || x.name || x.keyword); });
      } else if (data &amp;&amp; Array.isArray(data.list)){
        list = data.list.map(function(x){ return x.word || x.KEY || x.name; });
      } else if (d &amp;&amp; d.abslist){
        list = (d.abslist || []).map(function(x){ return x.SONGNAME || x.ARTIST || x.name; });
      }
      list = _uniqHot(list);
      if (list.length) return list;
      return tryOne(i + 1);
    }).catch(function(){ return tryOne(i + 1); });
  }
  return tryOne(0);
};
API.hotSearchKugou = function(){
  var hdr = {
    &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;],
    &quot;Referer&quot;: &quot;https://www.kugou.com/&quot;,
    &quot;Accept&quot;: &quot;application/json&quot;
  };
  var urls = [
    &quot;https://mobilecdn.kugou.com/api/v3/search/hot?format=json&amp;plat=0&amp;count=30&quot;,
    &quot;https://gateway.kugou.com/complexity/v1/search/tip?keyword=&amp;page=1&amp;pagesize=20&quot;
  ];
  function tryOne(i){
    if (i &gt;= urls.length) return Promise.resolve([]);
    return ADAPTER_request(urls[i], {headers:hdr, timeout:10}).then(function(txt){
      var d = jsonp_safeParse(txt);
      var list = [];
      var data = (d &amp;&amp; d.data) || d;
      if (data &amp;&amp; Array.isArray(data.info)){
        list = data.info.map(function(x){ return x.keyword || x.tip || x.word || x.name; });
      } else if (data &amp;&amp; Array.isArray(data.list)){
        list = data.list.map(function(x){ return x.keyword || x.word || x.name; });
      } else if (Array.isArray(data)){
        list = data.map(function(x){ return (typeof x === &quot;string&quot;) ? x : (x.keyword || x.word); });
      } else if (d &amp;&amp; d.data &amp;&amp; d.data.keywords){
        list = d.data.keywords;
      }
      list = _uniqHot(list);
      if (list.length) return list;
      return tryOne(i + 1);
    }).catch(function(){ return tryOne(i + 1); });
  }
  return tryOne(0);
};
API.hotSearchYtmusic = function(){
  // YTM 无稳定公开热搜接口：用本地流行池即可
  return Promise.resolve(_hotFromFallback(&quot;ytmusic&quot;, 30));
};
/** 按当前音源取热搜；接口失败则用平台专属兜底池；每次调用都会打乱 */
API.hotSearch = function(){
  var src = state.source || &quot;qq&quot;;
  var fetcher = {
    qq: API.hotSearchQQ,
    netease: API.hotSearchNetease,
    kuwo: API.hotSearchKuwo,
    kugou: API.hotSearchKugou,
    ytmusic: API.hotSearchYtmusic
  }[src] || API.hotSearchQQ;
  return fetcher().then(function(list){
    list = _uniqHot(list);
    if (!list.length) list = HOT_FALLBACK[src] || HOT_FALLBACK.qq;
    // 接口词 + 兜底词混合，扩大词池再打乱
    var mixed = _uniqHot(list.concat(HOT_FALLBACK[src] || []));
    return shuffleArray(mixed);
  }).catch(function(){
    return shuffleArray(HOT_FALLBACK[src] || HOT_FALLBACK.qq);
  });
};


// 分类广场（按标签）
// 官方分类详情（含 category_pic 官方配图，非歌单封面）
API.qqCategoryDetail = function(categoryId){
  var body = JSON.stringify({
    comm: { ct: 24, cv: 0, t: Date.now() },
    req_0: {
      module: &quot;music.web_category_svr&quot;,
      method: &quot;get_category_detail&quot;,
      param: { id: Number(categoryId) || categoryId }
    }
  });
  return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg?t=&quot; + Date.now(), {
    method: &quot;POST&quot;,
    headers: withCookie({
      &quot;Content-Type&quot;: &quot;application/json&quot;,
      &quot;Referer&quot;: &quot;https://y.qq.com/&quot;,
      &quot;Origin&quot;: &quot;https://y.qq.com&quot;
    }),
    body: body
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var data = d &amp;&amp; d.req_0 &amp;&amp; d.req_0.data;
    if (!data) return null;
    var pic = data.category_pic || data.category_sharepic || data.reimgurl || &quot;&quot;;
    // 无效占位路径丢掉
    if (pic &amp;&amp; (/\/music\/common\/?$/.test(pic) || pic.indexOf(&quot;55372.png&quot;) &gt;= 0)){
      pic = data.category_sharepic || &quot;&quot;;
    }
    if (pic &amp;&amp; pic.indexOf(&quot;//&quot;) === 0) pic = &quot;https:&quot; + pic;
    if (pic &amp;&amp; pic.indexOf(&quot;http://&quot;) === 0) pic = pic.replace(&quot;http://&quot;, &quot;https://&quot;);
    return {
      id: data.category_id || categoryId,
      name: data.category_name || &quot;&quot;,
      desc: data.category_desc || &quot;&quot;,
      cover: pic || &quot;&quot;
    };
  }).catch(function(){ return null; });
};

API.playlistsByTag = function(categoryId, sortId, count){
  categoryId = categoryId == null ? 10000000 : categoryId;
  count = count || 20;
  sortId = sortId == null ? 3 : sortId;
  var url = &quot;https://c.y.qq.com/splcloud/fcgi-bin/fcg_get_diss_by_tag.fcg?picmid=1&amp;rnd=&quot;+Math.random()+
    &quot;&amp;g_tk=5381&amp;loginUin=0&amp;hostUin=0&amp;format=json&amp;inCharset=utf8&amp;outCharset=utf-8&amp;notice=0&amp;platform=yqq.json&quot;+
    &quot;&amp;needNewCode=0&amp;categoryId=&quot;+encodeURIComponent(categoryId)+&quot;&amp;sortId=&quot;+encodeURIComponent(sortId)+
    &quot;&amp;sin=0&amp;ein=&quot;+((count)-1);
  return ADAPTER_request(url, {headers:withCookie({&quot;Referer&quot;:&quot;https://y.qq.com/&quot;})}).then(function(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.data &amp;&amp; d.data.list) || [];
    return list.map(function(p){
      return {
        dissid: String(p.dissid || p.tid || p.id || &quot;&quot;),
        title: p.dissname || p.title || &quot;&quot;,
        cover: fixCover(p.imgurl || p.logo || p.picurl || p.cover || &quot;&quot;),
        playCount: p.listennum || p.listen_num || 0,
        creator: (p.creator &amp;&amp; (p.creator.name || p.creator.nickname)) || p.nickname || &quot;&quot;
      };
    }).filter(function(p){ return p.dissid &amp;&amp; p.title; });
  }).catch(function(){ return []; });
};

// 官方热门推荐（动态池，类似客户端「推荐歌单」）
API.hotRecommendPlaylists = function(){
  var body = JSON.stringify({
    comm: { ct: 24, cv: 0, uin: String((state.user &amp;&amp; state.user.uin) || &quot;0&quot;) },
    recomPlaylist: {
      method: &quot;get_hot_recommend&quot;,
      module: &quot;playlist.HotRecommendServer&quot;,
      param: { async: 1, cmd: 2 }
    }
  });
  return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
    method: &quot;POST&quot;,
    headers: withCookie({ &quot;Content-Type&quot;: &quot;application/json&quot; }),
    body: body
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.recomPlaylist &amp;&amp; d.recomPlaylist.data &amp;&amp; d.recomPlaylist.data.v_hot) || [];
    return list.map(function(p){
      return {
        dissid: String(p.content_id || p.id || &quot;&quot;),
        title: p.title || &quot;&quot;,
        cover: fixCover(p.cover || &quot;&quot;),
        playCount: p.listen_num || 0,
        creator: p.username || &quot;&quot;,
        rcmd: p.rcmdcontent || &quot;&quot;
      };
    }).filter(function(p){ return p.dissid &amp;&amp; p.title; });
  }).catch(function(){ return []; });
};

function shuffleArray(arr){
  var a = (arr || []).slice();
  for (var i = a.length - 1; i &gt; 0; i--){
    var j = Math.floor(Math.random() * (i + 1));
    var t = a[i]; a[i] = a[j]; a[j] = t;
  }
  return a;
}
function dedupePlaylists(list){
  var seen = {}, out = [];
  (list || []).forEach(function(p){
    if (!p || !p.dissid || seen[p.dissid]) return;
    seen[p.dissid] = 1;
    out.push(p);
  });
  return out;
}

// 可用分类池（已验证有数据）
var PL_CAT_POOL = [10000000, 6, 11, 15, 24, 28, 39, 52, 99, 122, 133, 136, 146, 153, 165, 166, 167, 168, 169, 194];
var _plRefreshNonce = 0;

// 分类分页拉取：支持 sin 偏移，换一批时换页
API.playlistsByTagPage = function(categoryId, sortId, sin, count){
  categoryId = categoryId == null ? 10000000 : categoryId;
  count = count || 20;
  // 官方 allsorts：1默认 2最新 3最热 4评分；旧代码 sortId=5 在部分类目下会空
  sortId = sortId == null ? 3 : sortId;
  sin = Number(sin) || 0;
  function mapList(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.data &amp;&amp; d.data.list) || [];
    return list.map(function(p){
      return {
        dissid: String(p.dissid || p.tid || p.id || &quot;&quot;),
        title: p.dissname || p.title || &quot;&quot;,
        cover: fixCover(p.imgurl || p.logo || p.picurl || p.cover || &quot;&quot;),
        playCount: p.listennum || p.listen_num || 0,
        creator: (p.creator &amp;&amp; (p.creator.name || p.creator.nickname)) || p.nickname || &quot;&quot;,
        _sum: (d &amp;&amp; d.data &amp;&amp; d.data.sum) || 0
      };
    }).filter(function(p){ return p.dissid &amp;&amp; p.title; });
  }
  function reqOnce(sid){
    var url = &quot;https://c.y.qq.com/splcloud/fcgi-bin/fcg_get_diss_by_tag.fcg?picmid=1&amp;rnd=&quot;+Math.random()+
      &quot;&amp;g_tk=5381&amp;loginUin=0&amp;hostUin=0&amp;format=json&amp;inCharset=utf8&amp;outCharset=utf-8&amp;notice=0&amp;platform=yqq.json&quot;+
      &quot;&amp;needNewCode=0&amp;categoryId=&quot;+encodeURIComponent(categoryId)+&quot;&amp;sortId=&quot;+encodeURIComponent(sid)+
      &quot;&amp;sin=&quot;+sin+&quot;&amp;ein=&quot;+(sin + count - 1);
    return ADAPTER_request(url, {headers:withCookie({&quot;Referer&quot;:&quot;https://y.qq.com/&quot;})}).then(mapList).catch(function(){ return []; });
  }
  return reqOnce(sortId).then(function(list){
    if (list &amp;&amp; list.length) return list;
    // 空则依次尝试 最热/最新/评分/默认
    var fallbacks = [3, 2, 4, 1].filter(function(x){ return x !== Number(sortId); });
    function tryFb(i){
      if (i &gt;= fallbacks.length) return Promise.resolve([]);
      return reqOnce(fallbacks[i]).then(function(list2){
        if (list2 &amp;&amp; list2.length) return list2;
        return tryFb(i + 1);
      });
    }
    return tryFb(0);
  });
};

// 智能推荐：多源混合 + 随机分类 + 随机分页 + 全量打散（换一批真的会变）
// 第 4 个参数 refresh=true 时强制换源/换页
API.recommendPlaylists = function(categoryId, sortId, count, refresh){
  count = count || 18;
  if (refresh) _plRefreshNonce++;
  var nonce = _plRefreshNonce + (refresh ? Math.floor(Math.random()*1000) : 0);

  // 指定具体分类（歌单页 Tab）
  if (categoryId &amp;&amp; categoryId !== 10000000 &amp;&amp; categoryId !== &quot;10000000&quot; &amp;&amp; categoryId !== &quot;smart&quot; &amp;&amp; categoryId !== null){
    var sin = refresh ? (Math.floor(Math.random() * 8) * 20) : 0; // 0/20/40/.../140
    return API.playlistsByTagPage(categoryId, sortId || 3, sin, Math.max(count, 24)).then(function(list){
      if (list.length) return shuffleArray(list).slice(0, count);
      // 空则换页再试一次
      return API.playlistsByTagPage(categoryId, 3, 0, count).then(function(list2){
        return shuffleArray(list2).slice(0, count);
      });
    });
  }

  // 每次（尤其换一批）随机抽 3 个分类 + 随机分页
  var pool = shuffleArray(PL_CAT_POOL);
  var catA = pool[nonce % pool.length];
  var catB = pool[(nonce + 3) % pool.length];
  var catC = pool[(nonce + 7) % pool.length];
  var sinA = (nonce % 5) * 12;
  var sinB = ((nonce + 2) % 5) * 12;
  var sinC = ((nonce + 4) % 5) * 12;

  return Promise.all([
    API.hotRecommendPlaylists(),
    API.playlistsByTagPage(catA, 3, sinA, 16),
    API.playlistsByTagPage(catB, 3, sinB, 16),
    API.playlistsByTagPage(catC, 3, sinC, 16)
  ]).then(function(parts){
    var mixed = dedupePlaylists([].concat(parts[0]||[], parts[1]||[], parts[2]||[], parts[3]||[]));
    // 换一批：整表打散，不要固定热门前 8
    mixed = shuffleArray(mixed);
    if (mixed.length &gt;= count) return mixed.slice(0, count);
    // 不够再补一页全部
    return API.playlistsByTagPage(10000000, 3, (nonce % 6) * 18, 30).then(function(more){
      return shuffleArray(dedupePlaylists(mixed.concat(more || []))).slice(0, count);
    });
  }).catch(function(){
    return API.playlistsByTagPage(10000000, 3, 0, count).then(function(list){
      return shuffleArray(list).slice(0, count);
    });
  });
};

// 排行榜列表（总览）—— 使用 musicu 新接口（旧 fcg_v8_toplist_cp 已失效）

function isMvChartBoard(t){
  if (!t) return false;
  var title = String(t.topTitle || t.title || t.name || &quot;&quot;);
  var id = Number(t.topId || t.id || 0);
  // 标题含 MV，或已知 MV 榜 topId（常见为 201 / 和接口返回一致）
  if (/MV|音乐视频|视频榜/i.test(title)) return true;
  if (id === 201 || id === 106 || id === 107) return true;
  return false;
}

API.toplistOverview = function(){
  var body = JSON.stringify({
    comm:{ ct:24, cv:0 },
    req_0:{ module:&quot;musicToplist.ToplistInfoServer&quot;, method:&quot;GetAll&quot;, param:{} }
  });
  return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
    method:&quot;POST&quot;, headers:withCookie({&quot;Content-Type&quot;:&quot;application/json&quot;}), body:body
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    if (!d || !d.req_0 || !d.req_0.data || !d.req_0.data.group) return [];
    var out = [];
    d.req_0.data.group.forEach(function(g){
      (g.toplist || []).forEach(function(t){
        out.push({
          topId: t.topId,
          id: t.topId,
          topTitle: t.title,
          title: t.title,
          intro: t.intro || t.titleDetail || &quot;&quot;,
          update_key: t.updateTime || t.period || &quot;&quot;,
          frontPicUrl: fixCover(t.headPicUrl || t.frontPicUrl || t.picUrl || &quot;&quot;),
          pic: fixCover(t.headPicUrl || t.frontPicUrl || t.picUrl || &quot;&quot;)
        });
      });
    });
    return out;
  }).catch(function(){ return []; });
};
API.toplistDetail = function(topid){
  var body = JSON.stringify({
    comm:{ ct:24, cv:0 },
    req_0:{ module:&quot;musicToplist.ToplistInfoServer&quot;, method:&quot;GetDetail&quot;,
      param:{ topId: Number(topid)||62, offset:0, num:100, period:&quot;&quot; } }
  });
  return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
    method:&quot;POST&quot;, headers:withCookie({&quot;Content-Type&quot;:&quot;application/json&quot;}), body:body
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    if (!d || !d.req_0 || !d.req_0.data) return {info:{}, songs:[]};
    var data = d.req_0.data;
    var infoRaw = data.data || {};
    var songs = (data.songInfoList || []).map(function(s){
      return {
        songmid: s.mid,
        name: s.title || s.name,
        singer: (s.singer||[]).map(function(a){ return a.name; }).join(&quot;/&quot;),
        albummid: (s.album &amp;&amp; (s.album.mid || s.album.pmid)) || s.albummid || &quot;&quot;,
        albumname: s.album &amp;&amp; (s.album.title || s.album.name),
        cover: (s.album &amp;&amp; s.album.pic) || s.pic || &quot;&quot;,
        interval: s.interval || 0,
        isVip: !!(s.pay &amp;&amp; (s.pay.pay_play === 1 || s.pay.payplay === 1))
      };
    });
    return {
      info: {
        title: infoRaw.title || infoRaw.titleDetail || &quot;&quot;,
        topTitle: infoRaw.title || &quot;&quot;,
        cover: fixCover(infoRaw.headPicUrl || infoRaw.frontPicUrl || infoRaw.picUrl || &quot;&quot;),
        frontPicUrl: fixCover(infoRaw.headPicUrl || &quot;&quot;),
        intro: infoRaw.intro || &quot;&quot;,
        playCount: infoRaw.listenNum || 0
      },
      songs: songs
    };
  }).catch(function(){ return {info:{}, songs:[]}; });
};

// 歌单详情
/** 歌单详情：pageNo 从 0 起，pageSize 默认 50；返回 {info, songs, hasMore, pageNo} */
API.playlistDetail = function(dissid, pageNo, pageSize){
  dissid = String(dissid || &quot;&quot;).replace(/\D/g, &quot;&quot;) || dissid;
  pageNo = Math.max(0, pageNo || 0);
  pageSize = pageSize || 50;
  var url = &quot;https://c.y.qq.com/qzone/fcg-bin/fcg_ucc_getcdinfo_byids_cp.fcg?type=1&amp;json=1&amp;utf8=1&amp;onlysong=0&amp;nosign=1&amp;disstid=&quot;+encodeURIComponent(dissid)+&quot;&amp;format=json&amp;g_tk=5381&amp;loginUin=0&amp;hostUin=0&amp;inCharset=utf8&amp;outCharset=utf-8&amp;platform=yqq.json&amp;needNewCode=0&quot;;
  function fromCdlist(txt){
    var d = jsonp_safeParse(txt);
    if (!d || !d.cdlist || !d.cdlist[0]) return null;
    var c = d.cdlist[0];
    var all = (c.songlist || []).map(normalizeSongFromPlaylist).filter(function(s){ return s &amp;&amp; s.songmid; });
    // 旧接口一次返回（可能不全），按页切片以统一分页体验
    var start = pageNo * pageSize;
    var slice = all.slice(start, start + pageSize);
    var total = c.songnum || all.length;
    return {
      info: { title:c.dissname, cover:fixCover(c.logo||c.dir_pic_url2||&quot;&quot;), desc:c.desc, playCount:c.visitnum, creator:c.nickname, songCount:total },
      songs: slice,
      hasMore: (start + slice.length) &lt; all.length || (total &gt; all.length &amp;&amp; slice.length &gt;= pageSize),
      pageNo: pageNo,
      _cdAll: pageNo === 0 ? all : null // 首页缓存全量，后续页本地切片
    };
  }
  function fromMusicu(){
    var body = JSON.stringify({
      comm: { ct: 24, cv: 0 },
      req_0: {
        module: &quot;srf_diss_info.DissInfoServer&quot;,
        method: &quot;CgiGetDiss&quot;,
        param: { disstid: Number(dissid)||dissid, num: pageSize, orderlist: 1, page_no: pageNo, onlysonglist: pageNo &gt; 0 ? 1 : 0, enc_host_uin: &quot;&quot; }
      }
    });
    return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
      method: &quot;POST&quot;, headers: withCookie({ &quot;Content-Type&quot;: &quot;application/json&quot; }), body: body
    }).then(function(txt){
      var d = jsonp_safeParse(txt);
      var data = d &amp;&amp; d.req_0 &amp;&amp; d.req_0.data;
      if (!data) return { info: {}, songs: [], hasMore: false, pageNo: pageNo };
      var dir = data.dirinfo || data.dirInfo || {};
      var list = data.songlist || data.songList || [];
      var songs = list.map(function(it){
        return normalizeSongFromPlaylist(it.songInfo || it.musicData || it);
      }).filter(function(s){ return s &amp;&amp; s.songmid; });
      var total = dir.songnum || dir.song_num || data.total_song_num || data.total || 0;
      if (!total) total = (pageNo * pageSize) + songs.length + (songs.length &gt;= pageSize ? pageSize : 0);
      return {
        info: {
          title: dir.title || dir.dissname || &quot;&quot;,
          cover: fixCover(dir.picurl || dir.logo || dir.pic_url || &quot;&quot;),
          desc: dir.desc || &quot;&quot;,
          playCount: dir.listennum || dir.visitnum || 0,
          creator: (dir.host_nick || dir.nickname || &quot;&quot;),
          songCount: total || ((pageNo * pageSize) + songs.length)
        },
        songs: songs,
        hasMore: songs.length &gt;= pageSize,
        pageNo: pageNo
      };
    }).catch(function(){ return { info: {}, songs: [], hasMore: false, pageNo: pageNo }; });
  }
  // 分页页只走 musicu；首页优先 cdlist，空则 musicu
  if (pageNo &gt; 0){
    return fromMusicu();
  }
  return ADAPTER_request(url, {headers:withCookie()}).then(function(txt){
    var res = fromCdlist(txt);
    if (res &amp;&amp; res.songs &amp;&amp; res.songs.length){
      // cdlist 若一次给全量，后续用本地缓存翻页
      return res;
    }
    return fromMusicu().then(function(res2){
      if (res2.songs &amp;&amp; res2.songs.length) return res2;
      return res || res2;
    });
  }).catch(function(){ return fromMusicu(); });
};

// 歌词（nobase64=1 优先明文；失败再按 base64 解码）

/** 按歌名+歌手从 QQ 拉歌词（给 YT/酷我等跨源用） */
API.lyricByMeta = function(name, singer){
  name = (name || &quot;&quot;).trim();
  if (!name) return Promise.resolve({ lyric: &quot;&quot;, trans: &quot;&quot; });
  var kw = (name + &quot; &quot; + ((singer || &quot;&quot;).split(/[\/、,&amp;]/)[0] || &quot;&quot;)).trim();
  return API._searchByType(kw, 0, 1, 5).then(function(songRes){
    var list = (((songRes || {}).data || {}).song || {}).list || [];
    if (!list.length) return { lyric: &quot;&quot;, trans: &quot;&quot; };
    var best = null, bestScore = -1;
    list.forEach(function(it){
      var n = normalizeSongFromSearch(it);
      var score = 0;
      if (n.name === name) score += 5;
      else if (n.name &amp;&amp; name &amp;&amp; n.name.indexOf(name) &gt;= 0) score += 3;
      else if (n.name &amp;&amp; name &amp;&amp; name.indexOf(n.name) &gt;= 0) score += 2;
      if (singer &amp;&amp; n.singer &amp;&amp; n.singer.indexOf((singer.split(/[\/、]/)[0]||&quot;&quot;)) &gt;= 0) score += 3;
      if (score &gt; bestScore){ bestScore = score; best = n; }
    });
    if (!best || !best.songmid) best = normalizeSongFromSearch(list[0]);
    if (!best || !best.songmid) return { lyric: &quot;&quot;, trans: &quot;&quot; };
    return API.lyric(best.songmid);
  }).catch(function(){ return { lyric: &quot;&quot;, trans: &quot;&quot; }; });
};

API.lyric = function(songmid){
  if (!songmid) return Promise.resolve({lyric:&quot;&quot;, trans:&quot;&quot;});
  var url = &quot;https://c.y.qq.com/lyric/fcgi-bin/fcg_query_lyric_new.fcg?songmid=&quot;+encodeURIComponent(songmid)+
    &quot;&amp;pcachetime=&quot;+Date.now()+&quot;&amp;g_tk=5381&amp;loginUin=0&amp;hostUin=0&amp;format=json&amp;inCharset=utf8&amp;outCharset=utf-8&quot;+
    &quot;&amp;notice=0&amp;platform=yqq.json&amp;needNewCode=0&amp;nobase64=1&quot;;
  function fromClassic(){
    return ADAPTER_request(url, {headers:withCookie({&quot;Referer&quot;:&quot;https://y.qq.com/&quot;})}).then(function(txt){
      var d = jsonp_safeParse(txt);
      if (!d) return {lyric:&quot;&quot;, trans:&quot;&quot;};
      var lyric = d.lyric || &quot;&quot;;
      var trans = d.trans || &quot;&quot;;
      if (lyric &amp;&amp; lyric.indexOf(&quot;[&quot;) === -1) lyric = atob_safe(lyric);
      if (trans &amp;&amp; trans.indexOf(&quot;[&quot;) === -1) trans = atob_safe(trans);
      return { lyric: lyric, trans: trans };
    }).catch(function(){ return {lyric:&quot;&quot;, trans:&quot;&quot;}; });
  }
  // 尝试 PlayLyricInfo（部分歌曲可能带逐字增强 LRC）
  function fromPlayLyric(){
    var body = {
      comm: { ct: 11, cv: 10030020, uin: &quot;0&quot;, format: &quot;json&quot; },
      req_0: {
        module: &quot;music.musichallSong.PlayLyricInfo&quot;,
        method: &quot;GetPlayLyricInfo&quot;,
        param: { songMID: String(songmid), songID: 0 }
      }
    };
    return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg?_=&quot; + Date.now(), {
      method: &quot;POST&quot;,
      headers: withCookie({ &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Referer&quot;: &quot;https://y.qq.com/&quot; }),
      body: body,
      timeout: 12
    }).then(function(txt){
      var d = jsonp_safeParse(txt);
      var data = d &amp;&amp; d.req_0 &amp;&amp; d.req_0.data;
      if (!data) return null;
      var lyric = data.lyric || &quot;&quot;;
      var trans = data.trans || data.transLyric || &quot;&quot;;
      if (lyric &amp;&amp; lyric.indexOf(&quot;[&quot;) === -1) lyric = atob_safe(lyric);
      if (trans &amp;&amp; trans.indexOf(&quot;[&quot;) === -1) trans = atob_safe(trans);
      if (!lyric) return null;
      return { lyric: lyric, trans: trans || &quot;&quot; };
    }).catch(function(){ return null; });
  }
  return fromPlayLyric().then(function(res){
    if (res &amp;&amp; res.lyric) return res;
    return fromClassic();
  }).catch(function(){ return fromClassic(); });
};
function atob_safe(b64){ try{ return decodeURIComponent(escape(atob(b64))); }catch(e){ try{ return atob(b64); }catch(e2){ return &quot;&quot;; } } }

// 播放地址（vkey）
// 音质：ZQ 无损 / SQ 320k / HQ 128k / LQ 96k / M4A 试听档
// 未登录或非绿钻时，高音质可能无 purl 或只返回试听链；试听链须拒绝并回落洛雪
API.songUrl = function(song){
  if (!song || !song.songmid) return Promise.resolve(null);
  var qMap = {
    &quot;ZQ&quot;: { s:&quot;F000&quot;, e:&quot;.flac&quot; },
    &quot;SQ&quot;: { s:&quot;M800&quot;, e:&quot;.mp3&quot; },
    &quot;HQ&quot;: { s:&quot;M500&quot;, e:&quot;.mp3&quot; },
    &quot;LQ&quot;: { s:&quot;M300&quot;, e:&quot;.mp3&quot; },
    &quot;M4A&quot;:{ s:&quot;C400&quot;, e:&quot;.m4a&quot; }
  };
  // 请求顺序：用户选择 → 完整音质降级；默认不自动落到 C400 试听档
  var order = [];
  var pref = state.quality || &quot;HQ&quot;;
  if (qMap[pref] &amp;&amp; pref !== &quot;M4A&quot;) order.push(pref);
  else if (pref === &quot;M4A&quot;) order.push(&quot;HQ&quot;);
  [&quot;HQ&quot;,&quot;SQ&quot;,&quot;LQ&quot;,&quot;ZQ&quot;].forEach(function(k){
    if (order.indexOf(k) &lt; 0) order.push(k);
  });

  var uin = &quot;0&quot;;
  if (state.user &amp;&amp; state.user.uin) uin = String(state.user.uin).replace(/^o0*/, &quot;&quot;) || &quot;0&quot;;
  var g = guid();
  // 官方 filename = 前缀 + media_mid(优先) / songmid + 后缀，切勿把两个 mid 拼在一起
  var songmid = song.songmid;
  var mediaMid = song.media_mid || song.strMediaMid || song.mediaMid || songmid;
  var midCandidates = [];
  if (mediaMid) midCandidates.push(mediaMid);
  if (songmid &amp;&amp; songmid !== mediaMid) midCandidates.push(songmid);

  var userIsVip = !!(state.user &amp;&amp; (state.user.vip || state.user.svip));
  var songIsVip = !!(song.isVip || song.pay_play || (song.pay &amp;&amp; (song.pay.pay_play === 1 || song.pay.payplay === 1)));

  /** 判断官方返回的 purl 是否为试听/无权限短链（一律拒绝，不播约 1 分钟试听） */
  function isTrialPurl(purl, item, qKey){
    if (!purl) return true;
    var p = String(purl);
    // C400 = 官方试听档；RS02 等为 try 文件
    if (/^C400/i.test(p) || /(?:^|[\/?&amp;])C400/i.test(p)) return true;
    if (/RS02|O6[0-9A-Z]|try[_-]?url|preview|tsmusic|onlyplay/i.test(p)) return true;
    if (/\/C400|filename=C400|C400[A-Za-z0-9]+\.m4a/i.test(p)) return true;
    if (item){
      var msg = String(item.msg || item.errmsg || item.errMsg || &quot;&quot;);
      if (/试听|无版权|付费|会员|vip|无权限|无法播放|开通/i.test(msg)) return true;
      // subcode 非 0 常见于无权限
      if (item.subcode != null &amp;&amp; Number(item.subcode) !== 0) return true;
    }
    // 请求完整音质却只拿到 m4a 试听前缀
    if (qKey &amp;&amp; qKey !== &quot;M4A&quot; &amp;&amp; /\.m4a(\?|$)/i.test(p) &amp;&amp; /C400/i.test(p)) return true;
    // 明确点了试听档 key
    if (qKey === &quot;M4A&quot;) return true;
    return false;
  }

  function parseVkeyResp(d, qKey){
    if (!d) return null;
    var data = (d.req_0 &amp;&amp; d.req_0.data) || (d.req &amp;&amp; d.req.data) || d.data || null;
    if (!data) return null;
    var item = (data.midurlinfo &amp;&amp; data.midurlinfo[0]) || null;
    if (!item || !item.purl) return null;
    if (isTrialPurl(item.purl, item, qKey)) return null;
    var domain = (data.sip &amp;&amp; data.sip[0]) || &quot;https://dl.stream.qqmusic.qq.com/&quot;;
    if (domain.indexOf(&quot;http&quot;) !== 0) domain = &quot;https://&quot; + domain;
    if (domain.slice(-1) !== &quot;/&quot;) domain += &quot;/&quot;;
    domain = domain.replace(/^http:/, &quot;https:&quot;);
    return domain + item.purl;
  }

  function requestOne(qKey, fileMid){
    var q = qMap[qKey] || qMap.HQ;
    var filename = q.s + fileMid + q.e;
    var body = JSON.stringify({
      req_0: {
        module: &quot;vkey.GetVkeyServer&quot;,
        method: &quot;CgiGetVkey&quot;,
        param: {
          guid: g,
          songmid: [songmid],
          filename: [filename],
          songtype: [0],
          uin: uin,
          loginflag: uin &amp;&amp; uin !== &quot;0&quot; ? 1 : 0,
          platform: &quot;20&quot;
        }
      },
      comm: {
        uin: Number(uin) || 0,
        format: &quot;json&quot;,
        ct: 24,
        cv: 0,
        authst: (state.user &amp;&amp; (state.user.qqmusic_key || state.user.qm_keyst)) || &quot;&quot;
      }
    });
    return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
      method: &quot;POST&quot;,
      headers: withCookie({
        &quot;Content-Type&quot;: &quot;application/json&quot;,
        &quot;Referer&quot;: &quot;https://y.qq.com/&quot;,
        &quot;Origin&quot;: &quot;https://y.qq.com&quot;
      }),
      body: body,
      credentials: &quot;include&quot;,
      timeout: 20
    }).then(function(txt){
      return parseVkeyResp(jsonp_safeParse(txt), qKey);
    }).catch(function(){ return null; });
  }

  // 备用：UrlGetVkey（部分环境 CgiGetVkey 对绿钻曲返回空 purl）
  function requestUrlGetVkey(qKey, fileMid){
    var q = qMap[qKey] || qMap.HQ;
    var filename = q.s + fileMid + q.e;
    var body = JSON.stringify({
      req_0: {
        module: &quot;music.vkey.GetVkey&quot;,
        method: &quot;UrlGetVkey&quot;,
        param: {
          guid: g,
          songmid: [songmid],
          filename: [filename],
          songtype: [0],
          uin: uin,
          loginflag: 1,
          platform: &quot;20&quot;
        }
      },
      comm: { uin: Number(uin) || 0, format: &quot;json&quot;, ct: 24, cv: 0 }
    });
    return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
      method: &quot;POST&quot;,
      headers: withCookie({
        &quot;Content-Type&quot;: &quot;application/json&quot;,
        &quot;Referer&quot;: &quot;https://y.qq.com/&quot;
      }),
      body: body,
      credentials: &quot;include&quot;,
      timeout: 20
    }).then(function(txt){
      return parseVkeyResp(jsonp_safeParse(txt), qKey);
    }).catch(function(){ return null; });
  }

  function tryOfficialVkey(){
    var chain = Promise.resolve(null);
    order.forEach(function(qKey){
      midCandidates.forEach(function(mid){
        chain = chain.then(function(got){
          if (got) return got;
          return requestOne(qKey, mid);
        }).then(function(got){
          if (got) return got;
          return requestUrlGetVkey(qKey, mid);
        });
      });
    });
    return chain;
  }

  // 非 VIP：直接走官方完整音质；VIP：长青∥洛雪完整曲，官方试听一律不用
  if (!songIsVip){
    return tryOfficialVkey().then(function(url){
      if (url) return url;
      // 官方失败再兜底第三方（少数地区/接口异常）
      return API.cqOrLxUrlMulti(song).then(function(u){ return u || null; });
    });
  }
  return API.cqOrLxUrlMulti(song).then(function(url){
    if (url) return url;
    return null; // VIP 不走官方试听
  });
};

/**
 * 洛雪音乐音源 · 独家音源 v4 协议（与 [独家音源] v4.0.js 对齐）
 *
 * 抓包结论：
 *   path = /lxmusicv4/url/{source}/{id}/{quality}
 *   sign = sha256( path + md5(&quot;&quot;) + &quot;JaJ?a7Nwk_Fgj?2o:znAkst&quot; )
 *   GET {API_URL}{path}?sign={sign}
 *   Header: X-Request-Key: lxmusic , User-Agent: lx-music-mobile/...
 *
 * QQ 曲目 id 取 musicInfo.hash（洛雪客户端把 songmid 填进 hash）；
 * 酷我取 rid。
 */
var LX_API = {
  base: storeGet(&quot;lxApiBase&quot;, &quot;https://88.lxmusic.xn--fiqs8s&quot;) || &quot;https://88.lxmusic.xn--fiqs8s&quot;,
  key: storeGet(&quot;lxApiKey&quot;, &quot;lxmusic&quot;) || &quot;lxmusic&quot;,
  secret: &quot;JaJ?a7Nwk_Fgj?2o:znAkst&quot;,
  tokenMd5: &quot;d41d8cd98f00b204e9800998ecf8427e&quot;,
  // 可用公共镜像（官方 88.lxmusic 的 /url 在多数公网 404；onrender 镜像实测可用）
  mirrors: [
    { base: &quot;https://lxmusicapi.onrender.com&quot;, key: &quot;share-v3&quot; },
    { base: &quot;https://88.lxmusic.xn--fiqs8s&quot;, key: &quot;lxmusic&quot;, signed: true },
    { base: &quot;https://88.lxmusic.中国&quot;, key: &quot;lxmusic&quot;, signed: true }
  ]
};

/* ---- 精简 md5 / sha256（仅用于洛雪签名） ---- */
function _lxMd5(str){
  str = String(str == null ? &quot;&quot; : str);
  function safeAdd(x,y){ var lsw=(x&amp;0xffff)+(y&amp;0xffff), msw=(x&gt;&gt;16)+(y&gt;&gt;16)+(lsw&gt;&gt;16); return (msw&lt;&lt;16)|(lsw&amp;0xffff); }
  function bitRotateLeft(n,c){ return (n&lt;&lt;c)|(n&gt;&gt;&gt; (32-c)); }
  function md5cmn(q,a,b,x,s,t){ return safeAdd(bitRotateLeft(safeAdd(safeAdd(a,q),safeAdd(x,t)),s),b); }
  function md5ff(a,b,c,d,x,s,t){ return md5cmn((b&amp;c)|((~b)&amp;d),a,b,x,s,t); }
  function md5gg(a,b,c,d,x,s,t){ return md5cmn((b&amp;d)|(c&amp;(~d)),a,b,x,s,t); }
  function md5hh(a,b,c,d,x,s,t){ return md5cmn(b^c^d,a,b,x,s,t); }
  function md5ii(a,b,c,d,x,s,t){ return md5cmn(c^(b|(~d)),a,b,x,s,t); }
  function bytesToWords(s){
    var n=s.length, arr=[];
    for (var i=0;i&lt;n;i++) arr[i&gt;&gt;2] |= s.charCodeAt(i)&lt;&lt;((i%4)*8);
    return { words: arr, n: n };
  }
  var x = bytesToWords(unescape(encodeURIComponent(str)));
  var n = x.n, w = x.words;
  w[n&gt;&gt;2] |= 0x80 &lt;&lt; ((n%4)*8);
  w[(((n+8)&gt;&gt;&gt;6)&lt;&lt;4)+14] = n*8;
  var a=1732584193,b=-271733879,c=-1732584194,d=271733878;
  for (var i=0;i&lt;w.length;i+=16){
    var oa=a,ob=b,oc=c,od=d;
    a=md5ff(a,b,c,d,w[i]|0,7,-680876936); d=md5ff(d,a,b,c,w[i+1]|0,12,-389564586); c=md5ff(c,d,a,b,w[i+2]|0,17,606105819); b=md5ff(b,c,d,a,w[i+3]|0,22,-1044525330);
    a=md5ff(a,b,c,d,w[i+4]|0,7,-176418897); d=md5ff(d,a,b,c,w[i+5]|0,12,1200080426); c=md5ff(c,d,a,b,w[i+6]|0,17,-1473231341); b=md5ff(b,c,d,a,w[i+7]|0,22,-45705983);
    a=md5ff(a,b,c,d,w[i+8]|0,7,1770035416); d=md5ff(d,a,b,c,w[i+9]|0,12,-1958414417); c=md5ff(c,d,a,b,w[i+10]|0,17,-42063); b=md5ff(b,c,d,a,w[i+11]|0,22,-1990404162);
    a=md5ff(a,b,c,d,w[i+12]|0,7,1804603682); d=md5ff(d,a,b,c,w[i+13]|0,12,-40341101); c=md5ff(c,d,a,b,w[i+14]|0,17,-1502002290); b=md5ff(b,c,d,a,w[i+15]|0,22,1236535329);
    a=md5gg(a,b,c,d,w[i+1]|0,5,-165796510); d=md5gg(d,a,b,c,w[i+6]|0,9,-1069501632); c=md5gg(c,d,a,b,w[i+11]|0,14,643717713); b=md5gg(b,c,d,a,w[i]|0,20,-373897302);
    a=md5gg(a,b,c,d,w[i+5]|0,5,-701558691); d=md5gg(d,a,b,c,w[i+10]|0,9,38016083); c=md5gg(c,d,a,b,w[i+15]|0,14,-660478335); b=md5gg(b,c,d,a,w[i+4]|0,20,-405537848);
    a=md5gg(a,b,c,d,w[i+9]|0,5,568446438); d=md5gg(d,a,b,c,w[i+14]|0,9,-1019803690); c=md5gg(c,d,a,b,w[i+3]|0,14,-187363961); b=md5gg(b,c,d,a,w[i+8]|0,20,1163531501);
    a=md5gg(a,b,c,d,w[i+13]|0,5,-1444681467); d=md5gg(d,a,b,c,w[i+2]|0,9,-51403784); c=md5gg(c,d,a,b,w[i+7]|0,14,1735328473); b=md5gg(b,c,d,a,w[i+12]|0,20,-1926607734);
    a=md5hh(a,b,c,d,w[i+5]|0,4,-378558); d=md5hh(d,a,b,c,w[i+8]|0,11,-2022574463); c=md5hh(c,d,a,b,w[i+11]|0,16,1839030562); b=md5hh(b,c,d,a,w[i+14]|0,23,-35309556);
    a=md5hh(a,b,c,d,w[i+1]|0,4,-1530992060); d=md5hh(d,a,b,c,w[i+4]|0,11,1272893353); c=md5hh(c,d,a,b,w[i+7]|0,16,-155497632); b=md5hh(b,c,d,a,w[i+10]|0,23,-1094730640);
    a=md5hh(a,b,c,d,w[i+13]|0,4,681279174); d=md5hh(d,a,b,c,w[i]|0,11,-358537222); c=md5hh(c,d,a,b,w[i+3]|0,16,-722521979); b=md5hh(b,c,d,a,w[i+6]|0,23,76029189);
    a=md5hh(a,b,c,d,w[i+9]|0,4,-640364487); d=md5hh(d,a,b,c,w[i+12]|0,11,-421815835); c=md5hh(c,d,a,b,w[i+15]|0,16,530742520); b=md5hh(b,c,d,a,w[i+2]|0,23,-995338651);
    a=md5ii(a,b,c,d,w[i]|0,6,-198630844); d=md5ii(d,a,b,c,w[i+7]|0,10,1126891415); c=md5ii(c,d,a,b,w[i+14]|0,15,-1416354905); b=md5ii(b,c,d,a,w[i+5]|0,21,-57434055);
    a=md5ii(a,b,c,d,w[i+12]|0,6,1700485571); d=md5ii(d,a,b,c,w[i+3]|0,10,-1894986606); c=md5ii(c,d,a,b,w[i+10]|0,15,-1051523); b=md5ii(b,c,d,a,w[i+1]|0,21,-2054922799);
    a=md5ii(a,b,c,d,w[i+8]|0,6,1873313359); d=md5ii(d,a,b,c,w[i+15]|0,10,-30611744); c=md5ii(c,d,a,b,w[i+6]|0,15,-1560198380); b=md5ii(b,c,d,a,w[i+13]|0,21,1309151649);
    a=md5ii(a,b,c,d,w[i+4]|0,6,-145523070); d=md5ii(d,a,b,c,w[i+11]|0,10,-1120210379); c=md5ii(c,d,a,b,w[i+2]|0,15,718787259); b=md5ii(b,c,d,a,w[i+9]|0,21,-343485551);
    a=safeAdd(a,oa); b=safeAdd(b,ob); c=safeAdd(c,oc); d=safeAdd(d,od);
  }
  function toHex(n){ var s=&quot;&quot;, i; for(i=0;i&lt;4;i++) s+=(&quot;0&quot;+((n&gt;&gt;(i*8))&amp;0xff).toString(16)).slice(-2); return s; }
  return toHex(a)+toHex(b)+toHex(c)+toHex(d);
}

function _lxSha256(ascii){
  // 精简正确实现（与 Node crypto 对齐，供洛雪 v4 签名）
  ascii = String(ascii == null ? &quot;&quot; : ascii);
  function rightRotate(value, amount){ return (value&gt;&gt;&gt;amount) | (value&lt;&lt;(32-amount)); }
  var mathPow = Math.pow, maxWord = mathPow(2, 32), i, j, result = &quot;&quot;, words = [];
  var asciiBitLength = ascii.length * 8;
  // K 常量表缓存；每次哈希使用新的初始 H
  if (!_lxSha256.k){
    _lxSha256.k = [];
    var isComposite = {}, primeCounter = 0, candidate;
    var hInit = [];
    for (candidate = 2; primeCounter &lt; 64; candidate++){
      if (!isComposite[candidate]){
        for (i = 0; i &lt; 313; i += candidate) isComposite[i] = candidate;
        hInit[primeCounter] = (mathPow(candidate, 0.5) * maxWord) | 0;
        _lxSha256.k[primeCounter++] = (mathPow(candidate, 1/3) * maxWord) | 0;
      }
    }
    _lxSha256.hInit = hInit.slice(0, 8);
  }
  var k = _lxSha256.k;
  var hash = _lxSha256.hInit.slice(0, 8);
  ascii += &quot;\x80&quot;;
  while (ascii.length % 64 - 56) ascii += &quot;\x00&quot;;
  for (i = 0; i &lt; ascii.length; i++){
    j = ascii.charCodeAt(i);
    if (j &gt;&gt; 8) return &quot;&quot;;
    words[i &gt;&gt; 2] |= j &lt;&lt; ((3 - i) % 4) * 8;
  }
  words[words.length] = ((asciiBitLength / maxWord) | 0);
  words[words.length] = (asciiBitLength);
  for (j = 0; j &lt; words.length;){
    var w = words.slice(j, j += 16);
    var oldHash = hash;
    hash = hash.slice(0, 8);
    for (i = 0; i &lt; 64; i++){
      var w15 = w[i - 15], w2 = w[i - 2];
      var a = hash[0], e = hash[4];
      var temp1 = hash[7]
        + (rightRotate(e, 6) ^ rightRotate(e, 11) ^ rightRotate(e, 25))
        + ((e &amp; hash[5]) ^ ((~e) &amp; hash[6]))
        + k[i]
        + (w[i] = (i &lt; 16) ? w[i] : (
            w[i - 16]
            + (rightRotate(w15, 7) ^ rightRotate(w15, 18) ^ (w15 &gt;&gt;&gt; 3))
            + w[i - 7]
            + (rightRotate(w2, 17) ^ rightRotate(w2, 19) ^ (w2 &gt;&gt;&gt; 10))
          ) | 0);
      var temp2 = (rightRotate(a, 2) ^ rightRotate(a, 13) ^ rightRotate(a, 22))
        + ((a &amp; hash[1]) ^ (a &amp; hash[2]) ^ (hash[1] &amp; hash[2]));
      hash = [(temp1 + temp2) | 0].concat(hash);
      hash[4] = (hash[4] + temp1) | 0;
    }
    for (i = 0; i &lt; 8; i++) hash[i] = (hash[i] + oldHash[i]) | 0;
  }
  for (i = 0; i &lt; 8; i++){
    for (j = 3; j + 1; j--){
      var b = (hash[i] &gt;&gt; (j * 8)) &amp; 255;
      result += ((b &lt; 16) ? &quot;0&quot; : &quot;&quot;) + b.toString(16);
    }
  }
  return result;
}

function _lxSign(path){
  // v4: sha256( path + md5(token) + secret )；当前 token 为空 → 固定 md5(&quot;&quot;)
  return _lxSha256(path + LX_API.tokenMd5 + LX_API.secret);
}


/* ============================================================
   长青 SVIP 音源（与洛雪并行）
   接口来自「长青SVIP音源 v1.2.0」：按源拼直链，支持 128k/320k/flac
   kg 用 hash；tx/wy/kw/mg 用 songmid/rid/数字 id
   ============================================================ */
var CHANGQING = {
  qualityMap: { &quot;128k&quot;: &quot;standard&quot;, &quot;320k&quot;: &quot;exhigh&quot;, &quot;flac&quot;: &quot;lossless&quot;, &quot;HQ&quot;: &quot;exhigh&quot;, &quot;SQ&quot;: &quot;exhigh&quot;, &quot;ZQ&quot;: &quot;lossless&quot; },
  endpoints: {
    kugou:   &quot;https://music.haitangw.cc/kgqq1/kg.php&quot;,
    qq:      &quot;http://175.27.166.236/kgqq1/qq.php&quot;,
    netease: &quot;http://175.27.166.236/wy1/wy.php&quot;,
    kuwo:    &quot;https://musicapi.haitangw.net/music1/kw.php&quot;,
    migu:    &quot;https://music.haitangw.cc/musicapi1/mg.php&quot;
  }
};
API.changqingLevel = function(){
  var q = state.quality || &quot;HQ&quot;;
  if (q === &quot;ZQ&quot; || q === &quot;flac&quot;) return &quot;lossless&quot;;
  if (q === &quot;SQ&quot; || q === &quot;320k&quot;) return &quot;exhigh&quot;;
  if (q === &quot;HQ&quot; || q === &quot;128k&quot;) return &quot;standard&quot;;
  return CHANGQING.qualityMap[q] || &quot;exhigh&quot;;
};
API.changqingSongId = function(song){
  if (!song) return &quot;&quot;;
  var src = song.source || &quot;qq&quot;;
  if (src === &quot;kugou&quot;){
    return String(song.hash || song.kgHash || song.songmid || &quot;&quot;).replace(/^kg_/, &quot;&quot;);
  }
  if (src === &quot;kuwo&quot;){
    return String(song.rid || song.hash || String(song.songmid || &quot;&quot;).replace(/^kw_/, &quot;&quot;)).replace(/^MUSIC_/i, &quot;&quot;);
  }
  if (src === &quot;netease&quot;){
    return String(song.neteaseId || song.hash || String(song.songmid || &quot;&quot;).replace(/^ne_/, &quot;&quot;));
  }
  if (src === &quot;migu&quot;){
    return String(song.miguId || song.hash || song.songmid || &quot;&quot;);
  }
  // qq / tx
  return String(song.songmid || song.media_mid || song.strMediaMid || song.hash || &quot;&quot;);
};
/** 长青：请求接口，跟随跳转得到可播直链；失败返回 null */
API.changqingUrl = function(song){
  if (!song) return Promise.resolve(null);
  var src = song.source || &quot;qq&quot;;
  var epKey = src === &quot;qq&quot; ? &quot;qq&quot; : src;
  var base = CHANGQING.endpoints[epKey];
  if (!base) return Promise.resolve(null);
  var id = API.changqingSongId(song);
  if (!id) return Promise.resolve(null);
  var level = API.changqingLevel();
  var url = base + &quot;?type=mp3&amp;id=&quot; + encodeURIComponent(id) + &quot;&amp;level=&quot; + encodeURIComponent(level);
  // 对齐可播版(q-16a)：接口 URL 原样作 audio.src（302 到真实 mp3）
  // 禁止 safePlaySrc 把 http 网关强升 https（长青节点常无证书，升了全挂）
  return Promise.resolve(url);
};
/** 长青与洛雪并行：主用长青，备用洛雪（与可播版一致） */
API.cqOrLxUrl = function(song){
  var cq = API.changqingUrl(song).catch(function(){ return null; });
  var lx = API.lxUrl(song).catch(function(){ return null; });
  return Promise.all([cq, lx]).then(function(arr){
    return arr[0] || arr[1] || null;
  });
};
API.cqOrLxUrlMulti = function(song){
  // 本源：长青 ∥ 洛雪 → 失败再走洛雪跨源
  return API.cqOrLxUrl(song).then(function(url){
    if (url) return url;
    return API.lxUrlMulti(song);
  });
};


API.lxQuality = function(){
  var q = state.quality || &quot;HQ&quot;;
  if (q === &quot;ZQ&quot;) return [&quot;flac&quot;, &quot;flac24bit&quot;, &quot;320k&quot;, &quot;128k&quot;];
  if (q === &quot;SQ&quot;) return [&quot;320k&quot;, &quot;128k&quot;, &quot;flac&quot;];
  return [&quot;128k&quot;, &quot;320k&quot;, &quot;flac&quot;];
};

API.lxSourceOf = function(song){
  if (!song) return &quot;tx&quot;;
  if (song.source === &quot;kuwo&quot;) return &quot;kw&quot;;
  if (song.source === &quot;netease&quot;) return &quot;wy&quot;;
  if (song.source === &quot;kugou&quot;) return &quot;kg&quot;;
  if (song.source === &quot;migu&quot;) return &quot;mg&quot;;
  return &quot;tx&quot;;
};

/** 与洛雪客户端一致：优先 hash，其次 songmid / rid */
API.lxSongId = function(song){
  if (!song) return &quot;&quot;;
  if (song.source === &quot;kuwo&quot;){
    return String(song.hash || song.rid || String(song.songmid || &quot;&quot;).replace(/^kw_/, &quot;&quot;)).replace(/^MUSIC_/i, &quot;&quot;);
  }
  if (song.source === &quot;netease&quot;){
    return String(song.hash || song.neteaseId || String(song.songmid || &quot;&quot;).replace(/^ne_/, &quot;&quot;));
  }
  if (song.source === &quot;kugou&quot;){
    return String(song.hash || song.kgHash || song.songmid || &quot;&quot;);
  }
  if (song.source === &quot;migu&quot;){
    return String(song.hash || song.miguId || song.songmid || &quot;&quot;);
  }
  // QQ：洛雪脚本读的是 musicInfo.hash
  return String(song.hash || song.songmid || song.media_mid || song.strMediaMid || &quot;&quot;);
};

API.lxUrl = function(song){
  var source = API.lxSourceOf(song);
  var songId = API.lxSongId(song);
  if (!songId) return Promise.resolve(null);
  var quals = API.lxQuality();

  function parseBody(txt){
    if (!txt) return null;
    if (typeof txt === &quot;string&quot; &amp;&amp; /^\s*&lt;/.test(txt)) return null; // nginx 404 html
    var d = null;
    try { d = typeof txt === &quot;string&quot; ? JSON.parse(txt) : txt; } catch(e){ d = jsonp_safeParse(txt); }
    if (!d) return null;
    // 洛雪：code===0 且 data/url 为链接；部分镜像直接 url 字段
    if (Number(d.code) === 0 || d.code === 200 || d.code === &quot;200&quot;){
      var u = d.url || d.data || (d.data &amp;&amp; d.data.url) || &quot;&quot;;
      if (typeof u === &quot;string&quot; &amp;&amp; /^https?:\/\//i.test(u)) return u.replace(/^http:/, &quot;https:&quot;);
    }
    // vkeys 风格
    if (d.data &amp;&amp; typeof d.data.url === &quot;string&quot; &amp;&amp; /^https?:\/\//i.test(d.data.url)){
      return String(d.data.url).replace(/^http:/, &quot;https:&quot;);
    }
    return null;
  }

  function tryOne(url, key){
    var isSlowMirror = /onrender\.com/i.test(url);
    return ADAPTER_request(url, {
      headers: {
        &quot;Content-Type&quot;: &quot;application/json&quot;,
        &quot;User-Agent&quot;: &quot;lx-music-mobile/1.4.3&quot;,
        &quot;X-Request-Key&quot;: key || LX_API.key,
        &quot;Accept&quot;: &quot;application/json, text/plain, */*&quot;
      },
      // onrender 冷启动较慢，适当放宽超时
      timeout: isSlowMirror ? 25 : 16,
      credentials: &quot;omit&quot;
    }).then(parseBody).catch(function(){ return null; });
  }

  var chain = Promise.resolve(null);
  var mirrors = (LX_API.mirrors &amp;&amp; LX_API.mirrors.length) ? LX_API.mirrors : [
    { base: LX_API.base, key: LX_API.key }
  ];

  // 优先：公共镜像无签名 /url/{source}/{id}/{quality}（实测可用）
  mirrors.forEach(function(m){
    if (m.signed) return;
    quals.forEach(function(q){
      chain = chain.then(function(got){
        if (got) return got;
        var path = &quot;/url/&quot; + encodeURIComponent(source) + &quot;/&quot; + encodeURIComponent(songId) + &quot;/&quot; + encodeURIComponent(q);
        return tryOne(String(m.base).replace(/\/$/, &quot;&quot;) + path, m.key);
      });
    });
  });

  // 其次：官方 v4 签名路径
  mirrors.forEach(function(m){
    if (!m.signed &amp;&amp; m.base.indexOf(&quot;88.lxmusic&quot;) === -1) return;
    quals.forEach(function(q){
      chain = chain.then(function(got){
        if (got) return got;
        var path = &quot;/lxmusicv4/url/&quot; + encodeURIComponent(source) + &quot;/&quot; + encodeURIComponent(songId) + &quot;/&quot; + encodeURIComponent(q);
        var sign = _lxSign(path);
        return tryOne(String(m.base).replace(/\/$/, &quot;&quot;) + path + &quot;?sign=&quot; + sign, m.key || LX_API.key);
      });
    });
  });

  // 再次：v3 无签名
  mirrors.forEach(function(m){
    quals.forEach(function(q){
      chain = chain.then(function(got){
        if (got) return got;
        var path = &quot;/lxmusicv3/url/&quot; + encodeURIComponent(source) + &quot;/&quot; + encodeURIComponent(songId) + &quot;/&quot; + encodeURIComponent(q);
        return tryOne(String(m.base).replace(/\/$/, &quot;&quot;) + path, m.key || LX_API.key);
      });
    });
  });

  // 最后：vkeys 公共接口（QQ mid）
  if (source === &quot;tx&quot;){
    chain = chain.then(function(got){
      if (got) return got;
      var qMap = { &quot;128k&quot;: 4, &quot;320k&quot;: 8, &quot;flac&quot;: 10, &quot;flac24bit&quot;: 14 };
      var order = quals.map(function(q){ return qMap[q] || 8; });
      var p = Promise.resolve(null);
      order.forEach(function(qv){
        p = p.then(function(g){
          if (g) return g;
          var u = &quot;https://api.vkeys.cn/v2/music/tencent/geturl?mid=&quot; + encodeURIComponent(songId) + &quot;&amp;quality=&quot; + qv;
          return ADAPTER_request(u, {
            headers: { &quot;User-Agent&quot;: &quot;Mozilla/5.0&quot;, &quot;Accept&quot;: &quot;application/json&quot; },
            timeout: 12,
            credentials: &quot;omit&quot;
          }).then(parseBody).catch(function(){ return null; });
        });
      });
      return p;
    });
  }

  return chain;
};

/**
 * 洛雪多音源兜底：先本源 (tx/kw/wy/kg/mg)，失败再按歌名跨源匹配后走洛雪
 * 用于任意平台曲目播放失败时统一回落
 */
API.lxUrlMulti = function(song){
  if (!song) return Promise.resolve(null);
  // 1) 本源直取
  return API.lxUrl(song).then(function(url){
    if (url) return url;
    // 2) 跨源并行：酷我 / 网易 / 酷狗 / QQ 同时搜，谁先出可用链用谁
    var name = (song.name || &quot;&quot;).trim();
    var singer = ((song.singer || &quot;&quot;).split(/[\/、,&amp;]/)[0] || &quot;&quot;).trim();
    if (!name) return null;
    var kw = (name + &quot; &quot; + singer).trim();
    var primary = API.lxSourceOf(song);

    function scorePick(list, mapItem){
      var best = null, bestScore = -1;
      (list || []).forEach(function(it){
        var n = mapItem ? mapItem(it) : it;
        if (!n || !n.name) return;
        var score = 0;
        if (n.name === name) score += 5;
        else if (name &amp;&amp; n.name.indexOf(name) &gt;= 0) score += 3;
        if (singer &amp;&amp; n.singer &amp;&amp; n.singer.indexOf(singer) &gt;= 0) score += 3;
        if (score &gt; bestScore){ bestScore = score; best = n; }
      });
      if (!best || bestScore &lt; 2){
        if (best &amp;&amp; bestScore &gt;= 1) return best;
        return null;
      }
      return best;
    }

    function trySearchThenLx(searchFn, srcTag){
      if (srcTag === primary) return Promise.resolve(null);
      return searchFn(kw, 1).then(function(res){
        var list = (res &amp;&amp; res.list) || [];
        if (!list.length) return null;
        var best = scorePick(list, null);
        if (!best) return null;
        best.source = srcTag === &quot;tx&quot; ? &quot;qq&quot; : (srcTag === &quot;kw&quot; ? &quot;kuwo&quot; : (srcTag === &quot;wy&quot; ? &quot;netease&quot; : (srcTag === &quot;kg&quot; ? &quot;kugou&quot; : srcTag)));
        return API.cqOrLxUrl(best);
      }).catch(function(){ return null; });
    }

    function tryQQSearchThenLx(){
      if (primary === &quot;tx&quot;) return Promise.resolve(null);
      return API._searchByType(kw, 0, 1, 6).then(function(songRes){
        var list = (((songRes || {}).data || {}).song || {}).list || [];
        if (!list.length) return null;
        var best = scorePick(list, normalizeSongFromSearch);
        if (!best || !best.songmid) return null;
        best.source = &quot;qq&quot;;
        return API.cqOrLxUrl(best);
      }).catch(function(){ return null; });
    }

    /** 并行竞速：任一源返回非空 URL 即采用，其余忽略 */
    function firstUrl(promises){
      return new Promise(function(resolve){
        if (!promises || !promises.length){ resolve(null); return; }
        var left = promises.length;
        var settled = false;
        promises.forEach(function(p){
          Promise.resolve(p).then(function(v){
            if (settled) return;
            if (v){ settled = true; resolve(v); return; }
            left--;
            if (left &lt;= 0) resolve(null);
          }).catch(function(){
            if (settled) return;
            left--;
            if (left &lt;= 0) resolve(null);
          });
        });
      });
    }

    return firstUrl([
      trySearchThenLx(API.kuwoSearch, &quot;kw&quot;),
      trySearchThenLx(API.neteaseSearch, &quot;wy&quot;),
      trySearchThenLx(API.kugouSearch, &quot;kg&quot;),
      tryQQSearchThenLx()
    ]);
  });
};

// 歌手列表：优先 musicu（字段规范），失败回退 v8.fcg（注意 data.list + Fsinger_*）
API.singerList = function(){
  function mapMusicu(list){
    return (list || []).map(function(s){
      var mid = s.singer_mid || s.singerMid || s.mid || &quot;&quot;;
      return {
        mid: mid,
        name: s.singer_name || s.singerName || s.name || &quot;&quot;,
        cover: fixCover(s.singer_pic || s.singerPic || &quot;&quot;) || coverUrl(mid, &quot;singer&quot;)
      };
    }).filter(function(s){ return s.mid &amp;&amp; s.name; });
  }
  function mapV8(list){
    return (list || []).map(function(s){
      var mid = s.Fsinger_mid || s.singer_mid || s.mid || &quot;&quot;;
      return {
        mid: mid,
        name: s.Fsinger_name || s.singer_name || s.name || &quot;&quot;,
        cover: coverUrl(mid, &quot;singer&quot;)
      };
    }).filter(function(s){ return s.mid &amp;&amp; s.name; });
  }
  var body = {
    comm: { ct: 24, cv: 0 },
    singerList: {
      module: &quot;Music.SingerListServer&quot;,
      method: &quot;get_singer_list&quot;,
      param: { area: -100, sex: -100, genre: -100, index: -100, sin: 0, cur_page: 1 }
    }
  };
  return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
    method: &quot;POST&quot;,
    headers: withCookie({ &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Referer&quot;: &quot;https://y.qq.com/&quot; }),
    body: JSON.stringify(body)
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.singerList &amp;&amp; d.singerList.data &amp;&amp; d.singerList.data.singerlist) || [];
    var mapped = mapMusicu(list);
    if (mapped.length) return mapped;
    // 回退旧 v8（解析 data.list，不是顶层 singerlist）
    var url = &quot;https://c.y.qq.com/v8/fcg-bin/v8.fcg?channel=singer&amp;page=list&amp;key=all_all_all&amp;pagesize=80&amp;pagenum=1&amp;format=json&quot;;
    return ADAPTER_request(url, {headers:withCookie({&quot;Referer&quot;:&quot;https://y.qq.com/&quot;})}).then(function(txt2){
      var d2 = jsonp_safeParse(txt2);
      var list2 = (d2 &amp;&amp; d2.data &amp;&amp; d2.data.list) || d2.singerlist || [];
      return mapV8(list2);
    });
  }).catch(function(){
    var url = &quot;https://c.y.qq.com/v8/fcg-bin/v8.fcg?channel=singer&amp;page=list&amp;key=all_all_all&amp;pagesize=80&amp;pagenum=1&amp;format=json&quot;;
    return ADAPTER_request(url, {headers:withCookie({&quot;Referer&quot;:&quot;https://y.qq.com/&quot;})}).then(function(txt){
      var d = jsonp_safeParse(txt);
      var list = (d &amp;&amp; d.data &amp;&amp; d.data.list) || [];
      return mapV8(list);
    }).catch(function(){ return []; });
  });
};
/** 歌手热门歌曲（新 musicu 接口，旧 fcg_v8_singer_track_cp 已 404） */
API.singerSongs = function(singermid){
  if (!singermid) return Promise.resolve({ info:{}, songs:[], total:0 });
  var body = {
    comm: { ct: 24, cv: 0 },
    req_1: {
      module: &quot;musichall.song_list_server&quot;,
      method: &quot;GetSingerSongList&quot;,
      param: { singerMid: singermid, begin: 0, num: 50, order: 1 }
    }
  };
  return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
    method: &quot;POST&quot;,
    headers: withCookie({ &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Referer&quot;: &quot;https://y.qq.com/&quot; }),
    body: JSON.stringify(body)
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var data = (d &amp;&amp; d.req_1 &amp;&amp; d.req_1.data) || {};
    var list = data.songList || [];
    var songs = list.map(function(it){
      var s = it.songInfo || it;
      return normalizeSongFromSearch(s);
    }).filter(function(s){ return s &amp;&amp; s.songmid; });
    return {
      info: { name: &quot;&quot;, cover: coverUrl(singermid, &quot;singer&quot;), mid: singermid },
      songs: songs,
      total: data.totalNum || songs.length
    };
  }).catch(function(){ return { info:{}, songs:[], total:0 }; });
};

/** 歌手专辑列表 */
API.singerAlbums = function(singermid){
  if (!singermid) return Promise.resolve([]);
  var url = &quot;https://c.y.qq.com/v8/fcg-bin/fcg_v8_singer_album.fcg?singermid=&quot;+encodeURIComponent(singermid)+
    &quot;&amp;order=time&amp;begin=0&amp;num=40&amp;format=json&quot;;
  return ADAPTER_request(url, {headers:withCookie({&quot;Referer&quot;:&quot;https://y.qq.com/&quot;})}).then(function(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.data &amp;&amp; d.data.list) || [];
    return list.map(function(a){
      return {
        mid: a.albumMID || a.album_mid || a.mid || &quot;&quot;,
        name: a.albumName || a.album_name || a.name || &quot;&quot;,
        cover: coverUrl(a.albumMID || a.album_mid || a.mid || &quot;&quot;),
        pubTime: a.pubTime || a.public_time || &quot;&quot;,
        listen: a.listen_count || a.listenCount || 0,
        company: a.company || &quot;&quot;
      };
    }).filter(function(a){ return a.mid &amp;&amp; a.name; });
  }).catch(function(){ return []; });
};

/** 专辑歌曲 */
API.albumSongs = function(albummid){
  if (!albummid) return Promise.resolve({ info:{}, songs:[] });
  var body = {
    comm: { ct: 24, cv: 0 },
    req_1: {
      module: &quot;music.musichallAlbum.AlbumSongList&quot;,
      method: &quot;GetAlbumSongList&quot;,
      param: { albumMid: albummid, begin: 0, num: 100, order: 2 }
    }
  };
  return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
    method: &quot;POST&quot;,
    headers: withCookie({ &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Referer&quot;: &quot;https://y.qq.com/&quot; }),
    body: JSON.stringify(body)
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var data = (d &amp;&amp; d.req_1 &amp;&amp; d.req_1.data) || {};
    var list = data.songList || [];
    var songs = list.map(function(it){
      return normalizeSongFromSearch(it.songInfo || it);
    }).filter(function(s){ return s &amp;&amp; s.songmid; });
    return { info: { mid: albummid, cover: coverUrl(albummid) }, songs: songs, total: data.totalNum || songs.length };
  }).catch(function(){ return { info:{}, songs:[] }; });
};

// MV榜：优先官方 MV 分类/热门接口，失败回退搜索
API.mvList = function(opts){
  opts = opts || {};
  function fromSearch(kw, n){
    var url = &quot;https://c.y.qq.com/soso/fcgi-bin/client_search_cp?w=&quot;+encodeURIComponent(kw)+
      &quot;&amp;format=json&amp;p=1&amp;n=&quot;+(n||40)+&quot;&amp;t=12&amp;aggr=1&amp;cr=1&amp;new_json=1&amp;g_tk=5381&quot;+
      &quot;&amp;loginUin=0&amp;hostUin=0&amp;inCharset=utf8&amp;outCharset=utf-8&amp;platform=yqq.json&amp;needNewCode=0&quot;;
    return ADAPTER_request(url, {headers:withCookie({&quot;Referer&quot;:&quot;https://y.qq.com/&quot;})}).then(function(txt){
      var d = jsonp_safeParse(txt);
      var list = (d &amp;&amp; d.data &amp;&amp; d.data.mv &amp;&amp; d.data.mv.list) || [];
      return list.map(mapMvSearchItem).filter(function(m){ return m &amp;&amp; m.vid; });
    }).catch(function(){ return []; });
  }
  function fromAlloc(){
    // 官方「最新/热门」MV 列表（MvService.MvInfoProServer）
    var body = JSON.stringify({
      comm: { ct: 24, cv: 0, g_tk: 5381, uin: (state.user &amp;&amp; state.user.uin) || &quot;0&quot;, format: &quot;json&quot;, platform: &quot;yqq&quot; },
      mv_list: {
        module: &quot;MvService.MvInfoProServer&quot;,
        method: &quot;GetAllocMvInfo&quot;,
        param: { start: 0, size: 40, version_id: 7, area_id: 15, order: 1 }
      }
    });
    return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
      method: &quot;POST&quot;,
      headers: withCookie({ &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Referer&quot;: &quot;https://y.qq.com/&quot; }),
      body: body,
      credentials: &quot;include&quot;
    }).then(function(txt){
      var d = jsonp_safeParse(txt);
      var raw = (d &amp;&amp; d.mv_list &amp;&amp; d.mv_list.data &amp;&amp; (d.mv_list.data.list || d.mv_list.data.mvlist || d.mv_list.data)) || [];
      if (!Array.isArray(raw)) raw = [];
      return raw.map(function(m){
        return mapMvSearchItem({
          v_id: m.vid || m.v_id || m.mv_id,
          vid: m.vid || m.v_id,
          mv_id: m.mv_id || m.id,
          mv_name: m.name || m.title || m.mv_name,
          title: m.name || m.title || m.mv_name,
          singer_name: m.singer_name || ((m.singers || m.singer_list || []).map(function(s){ return s.name || s.singer_name || &quot;&quot;; }).join(&quot;/&quot;)),
          singer_list: m.singers || m.singer_list,
          mv_pic_url: m.picurl || m.cover_pic || m.pic || m.mv_pic_url,
          pic: m.picurl || m.cover_pic || m.pic,
          duration: m.duration || m.play_duration || 0,
          play_count: m.playcnt || m.play_count || m.listen_num || 0
        });
      }).filter(function(m){ return m &amp;&amp; m.vid; });
    }).catch(function(){ return []; });
  }
  function fromToplist(topId){
    // 巅峰榜·MV 等：detail 接口里歌曲带 vid
    topId = Number(topId || 201) || 201;
    var body = JSON.stringify({
      comm: { ct: 24, cv: 0, g_tk: 5381, uin: (state.user &amp;&amp; state.user.uin) || &quot;0&quot;, format: &quot;json&quot;, platform: &quot;yqq&quot; },
      req_0: {
        module: &quot;musicToplist.ToplistInfoServer&quot;,
        method: &quot;GetDetail&quot;,
        param: { topId: topId, offset: 0, num: 50, period: &quot;&quot; }
      }
    });
    return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
      method: &quot;POST&quot;,
      headers: withCookie({ &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Referer&quot;: &quot;https://y.qq.com/&quot; }),
      body: body,
      credentials: &quot;include&quot;
    }).then(function(txt){
      var d = jsonp_safeParse(txt);
      var data = d &amp;&amp; d.req_0 &amp;&amp; d.req_0.data;
      var songList = (data &amp;&amp; data.songInfoList) || (data &amp;&amp; data.data &amp;&amp; data.data.song) || [];
      if (!Array.isArray(songList)) songList = [];
      var out = [];
      songList.forEach(function(s){
        var vid = s.vid || (s.mv &amp;&amp; (s.mv.vid || s.mv.v_id)) || s.mvvid || &quot;&quot;;
        if (!vid) return;
        out.push({
          vid: String(vid),
          title: s.title || s.name || s.songname || &quot;&quot;,
          singer: ((s.singer || []).map(function(x){ return x.name; }).join(&quot;/&quot;)) || s.singername || &quot;&quot;,
          cover: fixCover(s.cover || (s.album &amp;&amp; (s.album.pmid || s.album.mid) ? coverUrl(s.album.pmid || s.album.mid) : &quot;&quot;) || s.pic || &quot;&quot;),
          duration: s.interval || s.duration || 0,
          playCount: s.playCount || s.listen_count || 0
        });
      });
      return out;
    }).catch(function(){ return []; });
  }
  var topId = opts.topId || opts.id || 0;
  var chain = topId
    ? fromToplist(topId)
    : fromAlloc();
  return chain.then(function(list){
    if (list &amp;&amp; list.length) return list.slice(0, 40);
    return Promise.all([
      fromSearch(&quot;官方MV&quot;, 30),
      fromSearch(&quot;MV&quot;, 20),
      fromSearch(&quot;BLACKPINK&quot;, 8),
      fromSearch(&quot;周杰伦&quot;, 8)
    ]).then(function(parts){
      var seen = {}, out = [];
      parts.forEach(function(arr){
        (arr || []).forEach(function(m){
          var k = m.vid || (m.title + &quot;|&quot; + m.singer);
          if (!k || seen[k]) return;
          seen[k] = 1;
          out.push(m);
        });
      });
      out.sort(function(a,b){ return (b.playCount||0) - (a.playCount||0); });
      return out.slice(0, 40);
    });
  }).catch(function(){ return fromSearch(&quot;官方MV&quot;, 30); });
};
function mapMvSearchItem(m){
  if (!m) return null;
  // new_json / 旧字段兼容
  var vid = m.v_id || m.vid || m.mv_id || m.id || (m.doc &amp;&amp; (m.doc.vid || m.doc.v_id)) || &quot;&quot;;
  if (vid &amp;&amp; typeof vid === &quot;object&quot;) vid = vid.vid || vid.v_id || &quot;&quot;;
  vid = String(vid || &quot;&quot;).trim();
  if (!vid || vid === &quot;0&quot; || vid === &quot;undefined&quot; || vid === &quot;null&quot;) return null;
  var singers = m.singer_list || m.singers || m.singer || [];
  var singerName = m.singer_name || m.singerName || &quot;&quot;;
  if (!singerName &amp;&amp; Array.isArray(singers)){
    singerName = singers.map(function(s){
      if (typeof s === &quot;string&quot;) return s;
      return (s &amp;&amp; (s.name || s.singer_name || s.title)) || &quot;&quot;;
    }).filter(Boolean).join(&quot;/&quot;);
  } else if (!singerName &amp;&amp; typeof singers === &quot;string&quot;){
    singerName = singers;
  }
  var cover = m.mv_pic_url || m.pic || m.picurl || m.cover_pic || m.cover || m.pic_url ||
    (m.doc &amp;&amp; (m.doc.pic || m.doc.mv_pic_url)) || &quot;&quot;;
  return {
    vid: vid,
    title: m.mv_name || m.title || m.name || (m.doc &amp;&amp; m.doc.title) || &quot;&quot;,
    singer: singerName,
    cover: fixCover(cover),
    duration: Number(m.duration || m.play_duration || m.interval || 0) || 0,
    playCount: Number(m.play_count || m.playcnt || m.listen_num || 0) || 0
  };
}
function pickMvStreamUrl(info){
  if (!info) return null;
  function normUrl(u, vkey){
    if (!u) return &quot;&quot;;
    u = String(u).trim();
    if (!u) return &quot;&quot;;
    if (u.indexOf(&quot;//&quot;) === 0) u = &quot;https:&quot; + u;
    u = u.replace(/^http:/i, &quot;https:&quot;);
    // freeflow 已带完整 query；仅在缺 vkey 时补
    if (vkey &amp;&amp; u.indexOf(&quot;vkey=&quot;) &lt; 0 &amp;&amp; u.indexOf(&quot;vkey%3D&quot;) &lt; 0){
      u += (u.indexOf(&quot;?&quot;) &gt;= 0 ? &quot;&amp;&quot; : &quot;?&quot;) + &quot;vkey=&quot; + encodeURIComponent(vkey);
    }
    return u;
  }
  function pushUrl(out, u, size, filetype){
    u = normUrl(u, &quot;&quot;);
    if (!u || !/^https?:\/\//i.test(u)) return;
    // 过滤明显不可播的空壳
    if (/\/0$|\.ts$/i.test(u) &amp;&amp; u.indexOf(&quot;m3u8&quot;) &lt; 0) return;
    out.push({ u: u, size: Number(size) || 0, ft: Number(filetype) || 0 });
  }
  function collect(arr, out){
    (arr || []).forEach(function(x){
      if (!x) return;
      // code: 0 正常；部分节点用 1000；负值/非0且非1000 视为不可用
      var code = x.code;
      if (code != null &amp;&amp; code !== 0 &amp;&amp; code !== 1000 &amp;&amp; code !== &quot;0&quot;) return;
      var vkey = x.vkey || x.vnkey || &quot;&quot;;
      var size = x.fileSize || x.filesize || x.size || 0;
      var ft = x.filetype || x.fileType || x.file_type || 0;
      // 优先 freeflow（免流/完整链），再普通 url
      var pools = [x.freeflow_url, x.url, x.comm_url, x.cn, x.wifi_url, x.hls_url];
      pools.forEach(function(pool){
        if (!pool) return;
        var list = Array.isArray(pool) ? pool : [pool];
        list.forEach(function(u){
          if (typeof u === &quot;object&quot; &amp;&amp; u) u = u.url || u.purl || u.addr || &quot;&quot;;
          pushUrl(out, normUrl(u, vkey), size, ft);
        });
      });
      if (x.m3u8) pushUrl(out, normUrl(x.m3u8, vkey), size, ft);
      // 部分响应直接给 purl
      if (x.purl) pushUrl(out, normUrl(x.purl, vkey), size, ft);
    });
  }
  var cands = [];
  collect(info.mp4, cands);
  collect(info.hls, cands);
  collect(info.mp3, cands);
  // 少数响应把流放在根上
  if (!cands.length &amp;&amp; (info.freeflow_url || info.url)){
    collect([info], cands);
  }
  if (!cands.length) return null;
  // 偏好更高 filetype / 更大体积（跳过试看 filetype 0 若有更高清）
  cands.sort(function(a,b){
    var af = a.ft || 0, bf = b.ft || 0;
    if (af !== bf) return bf - af;
    return (b.size || 0) - (a.size || 0);
  });
  // 若最高是试看(0)且存在非0，则取非0
  var nonTrial = cands.filter(function(c){ return (c.ft || 0) &gt; 0; });
  if (nonTrial.length) return nonTrial[0].u;
  return cands[0].u;
}
/** 返回所有候选播放地址（高清优先），供 openMv 失败时换源 */
function pickMvStreamUrls(info, limit){
  if (!info) return [];
  function normUrl(u, vkey){
    if (!u) return &quot;&quot;;
    u = String(u).trim();
    if (u.indexOf(&quot;//&quot;) === 0) u = &quot;https:&quot; + u;
    u = u.replace(/^http:/i, &quot;https:&quot;);
    if (vkey &amp;&amp; u.indexOf(&quot;vkey=&quot;) &lt; 0){
      u += (u.indexOf(&quot;?&quot;) &gt;= 0 ? &quot;&amp;&quot; : &quot;?&quot;) + &quot;vkey=&quot; + encodeURIComponent(vkey);
    }
    return u;
  }
  var cands = [];
  var seen = {};
  function add(u, size, ft){
    u = normUrl(u, &quot;&quot;);
    if (!u || seen[u]) return;
    seen[u] = 1;
    cands.push({ u: u, size: Number(size)||0, ft: Number(ft)||0 });
  }
  function collect(arr){
    (arr || []).forEach(function(x){
      if (!x) return;
      var code = x.code;
      if (code != null &amp;&amp; code !== 0 &amp;&amp; code !== 1000 &amp;&amp; code !== &quot;0&quot;) return;
      var vkey = x.vkey || &quot;&quot;;
      var size = x.fileSize || x.filesize || 0;
      var ft = x.filetype || x.fileType || 0;
      [x.freeflow_url, x.url, x.comm_url, x.wifi_url].forEach(function(pool){
        if (!pool) return;
        (Array.isArray(pool) ? pool : [pool]).forEach(function(u){
          if (typeof u === &quot;object&quot; &amp;&amp; u) u = u.url || u.purl || &quot;&quot;;
          add(normUrl(u, vkey), size, ft);
        });
      });
      if (x.m3u8) add(normUrl(x.m3u8, vkey), size, ft);
      if (x.purl) add(normUrl(x.purl, vkey), size, ft);
    });
  }
  collect(info.mp4);
  collect(info.hls);
  cands.sort(function(a,b){
    if ((a.ft||0) !== (b.ft||0)) return (b.ft||0) - (a.ft||0);
    return (b.size||0) - (a.size||0);
  });
  return cands.slice(0, limit || 6).map(function(c){ return c.u; });
}
API.mvUrl = function(vid){
  if (!vid) return Promise.resolve(null);
  vid = String(vid).trim();
  if (!vid) return Promise.resolve(null);

  function parseMvPayload(txt){
    var d = jsonp_safeParse(txt);
    if (!d) return null;
    // 兼容 req_0 / getMVUrl / mvUrl 多种包壳
    var nodes = [];
    if (d.req_0 &amp;&amp; d.req_0.data) nodes.push(d.req_0.data);
    if (d.getMVUrl &amp;&amp; d.getMVUrl.data) nodes.push(d.getMVUrl.data);
    if (d.mvUrl &amp;&amp; d.mvUrl.data) nodes.push(d.mvUrl.data);
    if (d.data) nodes.push(d.data);
    for (var i = 0; i &lt; nodes.length; i++){
      var node = nodes[i];
      if (!node) continue;
      // data[vid] 或 data 直接是 info
      var info = node[vid] || node[String(vid)] || null;
      if (!info &amp;&amp; node.mp4) info = node;
      // 有时包一层 { data: { vid: info } }
      if (!info &amp;&amp; node.data){
        info = node.data[vid] || node.data[String(vid)] || (node.data.mp4 ? node.data : null);
      }
      if (info) return info;
    }
    return null;
  }

  function requestVariant(variant){
    var bodyObj = {
      comm: {
        ct: 24,
        cv: 0,
        g_tk: 5381,
        uin: (state.user &amp;&amp; state.user.uin) || &quot;0&quot;,
        format: &quot;json&quot;,
        platform: &quot;yqq&quot;
      }
    };
    bodyObj[variant.key] = {
      module: variant.module,
      method: &quot;GetMvUrls&quot;,
      param: variant.param
    };
    // 历史写法：request_typet 在 param 外层
    if (variant.outerTypet != null){
      bodyObj[variant.key].request_typet = variant.outerTypet;
    }
    var body = JSON.stringify(bodyObj);
    return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
      method: &quot;POST&quot;,
      headers: withCookie({
        &quot;Content-Type&quot;: &quot;application/json&quot;,
        &quot;Referer&quot;: &quot;https://y.qq.com/&quot;,
        &quot;Origin&quot;: &quot;https://y.qq.com&quot;
      }),
      body: body,
      credentials: &quot;include&quot;
    }).then(function(txt){
      var info = parseMvPayload(txt);
      if (!info) return null;
      // 返回候选列表，上层 openMv 可换源
      var urls = pickMvStreamUrls(info, 8);
      if (urls &amp;&amp; urls.length) return { url: urls[0], urls: urls, info: info };
      var one = pickMvStreamUrl(info);
      return one ? { url: one, urls: [one], info: info } : null;
    }).catch(function(){ return null; });
  }

  // 多种线上可用变体（2024–2025 抓包 + 旧 gosrf）
  var variants = [
    {
      key: &quot;mvUrl&quot;,
      module: &quot;music.stream.MvUrlProxy&quot;,
      param: { vids: [vid], request_type: 10003, addrtype: 3, format: 264, maxFiletype: 60 }
    },
    {
      key: &quot;req_0&quot;,
      module: &quot;gosrf.Stream.MvUrlProxy&quot;,
      param: { vids: [vid], request_typet: 10003, addrtype: 3 }
    },
    {
      key: &quot;getMVUrl&quot;,
      module: &quot;gosrf.Stream.MvUrlProxy&quot;,
      param: { vids: [vid], from: &quot;h5.playsong&quot; },
      outerTypet: 10001
    },
    {
      key: &quot;req_0&quot;,
      module: &quot;gosrf.Stream.MvUrlProxy&quot;,
      param: { vids: [vid], request_typet: 10001 }
    },
    {
      key: &quot;mvUrl&quot;,
      module: &quot;music.stream.MvUrlProxy&quot;,
      param: { vids: [vid], request_type: 10001, addrtype: 3 }
    }
  ];

  function tryAt(i){
    if (i &gt;= variants.length) return Promise.resolve(null);
    return requestVariant(variants[i]).then(function(res){
      if (res &amp;&amp; res.url) return res;
      return tryAt(i + 1);
    });
  }
  // 兼容旧调用方：默认 resolve 字符串 URL；同时挂 urls 供 openMv 使用
  return tryAt(0).then(function(res){
    if (!res) return null;
    var u = res.url;
    // 把候选挂到字符串上不现实；openMv 改为接收对象。这里返回对象，并让 String 场景仍可用
    return res;
  });
};

// 每日推荐 / 每日30首：登录与游客必须走不同路径
// 登录：仅用带 Cookie/authst 的个性化接口（按优先级串行，不再按「最长」误选公共榜）
// 游客：推荐=新歌，30首=官方榜单
function _isQqLoggedIn(){
  if (!state.user || !state.user.uin) return false;
  var u = String(state.user.uin).replace(/^o0*/, &quot;&quot;);
  if (!u || u === &quot;0&quot;) return false;
  if (state.user.cookie) return true;
  if (state.user.qqmusic_key || state.user.qm_keyst) return true;
  return false;
}
function _dailyAuthst(){
  try {
    if (state.user &amp;&amp; (state.user.qqmusic_key || state.user.qm_keyst))
      return String(state.user.qqmusic_key || state.user.qm_keyst || &quot;&quot;);
    var ck = (state.user &amp;&amp; state.user.cookie) || &quot;&quot;;
    if (!ck) return &quot;&quot;;
    var map = typeof parseCookieStr === &quot;function&quot; ? parseCookieStr(ck) : {};
    return String(map.qqmusic_key || map.qm_keyst || map.authst || &quot;&quot;);
  } catch(e) { return &quot;&quot;; }
}
function _dailyComm(mobile){
  var uin = String((state.user &amp;&amp; state.user.uin) || &quot;0&quot;).replace(/^o0*/, &quot;&quot;) || &quot;0&quot;;
  var gtk = 5381;
  try { gtk = (typeof getGtk === &quot;function&quot; ? getGtk() : 5381) || 5381; } catch(e) {}
  var authst = _dailyAuthst();
  var base = {
    uin: uin,
    uid: uin,
    format: &quot;json&quot;,
    platform: &quot;yqq.json&quot;,
    needNewCode: 1,
    g_tk: gtk,
    g_tk_new_20200303: gtk,
    t: Date.now()
  };
  if (authst){
    base.authst = authst;
    base.qqmusic_key = authst;
  }
  if (mobile){
    base.ct = 11;
    base.cv = 13020508;
    base.v = 13020508;
    base.mesh_devops = &quot;DevopsBase&quot;;
  } else {
    base.ct = 24;
    base.cv = 0;
  }
  return base;
}
function _mapDailySong(s){
  if (!s) return null;
  var song = s.songInfo || s.track || s.Track || s.song || s.musicData || s;
  var mid = song.mid || song.songmid || song.song_mid || song.strMediaMid || &quot;&quot;;
  if (!mid) return null;
  var album = song.album || song.albumInfo || {};
  if (typeof album === &quot;string&quot;) album = { name: album };
  var amid = album.mid || album.pmid || album.album_mid || album.albumMid
    || song.albummid || song.album_mid || song.albumMid || &quot;&quot;;
  var singers = song.singer || song.singers || song.singer_list || song.singerList || [];
  var singerName = &quot;&quot;;
  if (Array.isArray(singers)){
    singerName = singers.map(function(a){ return (a &amp;&amp; (a.name || a.singer_name || a.title)) || &quot;&quot;; }).filter(Boolean).join(&quot;/&quot;);
  } else if (typeof singers === &quot;string&quot;){
    singerName = singers;
  }
  singerName = singerName || song.singer_name || song.singerName || song.singername || &quot;&quot;;
  var rawPic = album.pic || album.picUrl || album.picurl || album.cover
    || song.pic || song.cover || song.albumPic || song.album_pic || &quot;&quot;;
  if (rawPic &amp;&amp; !/^https?:/i.test(rawPic) &amp;&amp; rawPic.indexOf(&quot;//&quot;) !== 0 &amp;&amp; !/^T00/i.test(rawPic)){
    rawPic = &quot;&quot;;
  }
  var cover = fixCover(rawPic);
  if (!cover &amp;&amp; amid) cover = coverUrl(amid);
  if (!cover &amp;&amp; /^T00/i.test(String(album.pmid || &quot;&quot;))) cover = coverUrl(album.pmid);
  return {
    songmid: mid,
    songid: song.id || song.songid || song.song_id || &quot;&quot;,
    name: song.title || song.name || song.songname || song.song_name || &quot;&quot;,
    singer: singerName,
    albummid: amid,
    albumname: album.name || album.title || song.albumname || song.album_name || &quot;&quot;,
    cover: cover,
    interval: Number(song.interval) || Number(song.time) || 0,
    isVip: !!(song.pay &amp;&amp; (song.pay.pay_play === 1 || song.pay.payplay === 1 || song.pay.pay_month === 1))
  };
}
function _parseDailySongsPayload(txt){
  var d = jsonp_safeParse(txt);
  if (!d) return [];
  // 收集所有像「歌曲数组」的字段
  function pickList(obj, depth){
    if (!obj || depth &gt; 5) return [];
    if (Array.isArray(obj)){
      if (!obj.length) return [];
      var first = obj[0];
      if (first &amp;&amp; (first.mid || first.songmid || first.songInfo || first.track || first.name || first.title || first.songname))
        return obj;
      return [];
    }
    if (typeof obj !== &quot;object&quot;) return [];
    var keys = [&quot;songlist&quot;,&quot;songList&quot;,&quot;songInfoList&quot;,&quot;trackList&quot;,&quot;tracks&quot;,&quot;list&quot;,&quot;v_song&quot;,&quot;v_songlist&quot;,&quot;song_list&quot;,&quot;vec_song&quot;,&quot;VecSongs&quot;,&quot;songinfo&quot;,&quot;songs&quot;,&quot;recommend&quot;,&quot;dailySongs&quot;];
    for (var i = 0; i &lt; keys.length; i++){
      var got = pickList(obj[keys[i]], depth + 1);
      if (got.length) return got;
    }
    // 扫子节点
    for (var k in obj){
      if (!Object.prototype.hasOwnProperty.call(obj, k)) continue;
      if (k === &quot;comm&quot; || k === &quot;code&quot; || k === &quot;ts&quot; || k === &quot;start_ts&quot;) continue;
      var g2 = pickList(obj[k], depth + 1);
      if (g2.length &gt;= 5) return g2;
    }
    return [];
  }
  var list = pickList(d, 0);
  if (list.length &amp;&amp; list[0] &amp;&amp; !list[0].mid &amp;&amp; !list[0].songmid &amp;&amp; (list[0].songInfo || list[0].track || list[0].Track)){
    list = list.map(function(it){ return it.songInfo || it.track || it.Track || it; });
  }
  return list.map(_mapDailySong).filter(Boolean);
}
function _postMusicu(bodyObj){
  return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg?t=&quot; + Date.now() + &quot;&amp;_=&quot; + Date.now(), {
    method: &quot;POST&quot;,
    headers: withCookie({
      &quot;Content-Type&quot;: &quot;application/json&quot;,
      &quot;Referer&quot;: &quot;https://y.qq.com/&quot;,
      &quot;Origin&quot;: &quot;https://y.qq.com&quot;,
      &quot;Cache-Control&quot;: &quot;no-cache&quot;
    }),
    body: JSON.stringify(bodyObj)
  }).then(_parseDailySongsPayload).catch(function(){ return []; });
}
/** 从 Mac 官网页解析「今日私享」歌单 ID（开源项目验证过的日推入口） */
function _reqTodayPrivateDissId(){
  var urls = [
    &quot;https://c.y.qq.com/node/musicmac/v6/index.html&quot;,
    &quot;https://y.qq.com/n/ryqq/index&quot;
  ];
  function scrape(html){
    if (!html || typeof html !== &quot;string&quot;) return &quot;&quot;;
    // 今日私享 / 每日30 / 私享
    var m = html.match(/今日私享[\s\S]{0,400}?data-rid=[&quot;']?(\d+)[&quot;']?/i)
      || html.match(/data-rid=[&quot;']?(\d+)[&quot;']?[\s\S]{0,200}?今日私享/i)
      || html.match(/今日私享[\s\S]{0,500}?\/playlist\/(\d+)/i)
      || html.match(/今日私享[\s\S]{0,500}?disstid[&quot;'\s:=]+(\d+)/i)
      || html.match(/每日\s*30[\s\S]{0,400}?data-rid=[&quot;']?(\d+)[&quot;']?/i)
      || html.match(/[&quot;']id[&quot;']\s*:\s*[&quot;']?(\d+)[&quot;']?[\s\S]{0,80}?今日私享/i);
    if (m &amp;&amp; m[1]) return String(m[1]);
    // JSON 片段
    var m2 = html.match(/&quot;dissid&quot;\s*:\s*&quot;?(\d+)&quot;?[\s\S]{0,120}?&quot;dissname&quot;\s*:\s*&quot;今日私享&quot;/)
      || html.match(/&quot;dissname&quot;\s*:\s*&quot;今日私享&quot;[\s\S]{0,120}?&quot;dissid&quot;\s*:\s*&quot;?(\d+)&quot;?/);
    if (m2 &amp;&amp; m2[1]) return String(m2[1]);
    return &quot;&quot;;
  }
  function tryUrl(i){
    if (i &gt;= urls.length) return Promise.resolve(&quot;&quot;);
    return ADAPTER_request(urls[i] + (urls[i].indexOf(&quot;?&quot;)&gt;=0?&quot;&amp;&quot;:&quot;?&quot;) + &quot;t=&quot; + Date.now(), {
      headers: withCookie({
        &quot;Referer&quot;: &quot;https://y.qq.com/&quot;,
        &quot;Accept&quot;: &quot;text/html,application/xhtml+xml&quot;
      }),
      timeout: 18
    }).then(function(html){
      var id = scrape(html);
      if (id) return id;
      return tryUrl(i + 1);
    }).catch(function(){ return tryUrl(i + 1); });
  }
  return tryUrl(0);
}
function _songsFromDissId(dissid, limit){
  limit = limit || 30;
  if (!dissid) return Promise.resolve([]);
  if (typeof API.playlistDetail !== &quot;function&quot;) return Promise.resolve([]);
  return API.playlistDetail(dissid, 0, limit).then(function(res){
    var songs = (res &amp;&amp; res.songs) || [];
    // 详情接口已是标准 song 结构，再走 _mapDailySong 兜底
    if (songs.length &amp;&amp; songs[0] &amp;&amp; songs[0].songmid) return songs.slice(0, limit);
    return songs.map(_mapDailySong).filter(Boolean).slice(0, limit);
  }).catch(function(){ return []; });
}
/** 登录态专用：mode=rec|d30 使用不同接口优先级，尽量两套不一样的歌 */
function _fetchPersonalizedDaily(preferSize, mode){
  preferSize = preferSize || 30;
  mode = mode || &quot;any&quot;;
  var uin = String((state.user &amp;&amp; state.user.uin) || &quot;0&quot;).replace(/^o0*/, &quot;&quot;) || &quot;0&quot;;
  var day = &quot;&quot;;
  try {
    var pi = typeof getDailyPeriodInfo === &quot;function&quot; ? getDailyPeriodInfo() : null;
    day = (pi &amp;&amp; pi.day) || &quot;&quot;;
  } catch(e) {}
  if (!day){
    var now = new Date();
    var mm = String(now.getMonth()+1); if (mm.length&lt;2) mm=&quot;0&quot;+mm;
    var dd = String(now.getDate()); if (dd.length&lt;2) dd=&quot;0&quot;+dd;
    day = now.getFullYear() + &quot;-&quot; + mm + &quot;-&quot; + dd;
  }

  var lastFail = &quot;&quot;;
  function step今日私享(){
    return {
      name: &quot;今日私享&quot;,
      run: function(){
        return _reqTodayPrivateDissId().then(function(id){
          if (!id){ lastFail = &quot;无今日私享ID&quot;; return []; }
          return _songsFromDissId(id, preferSize).then(function(songs){
            if (!songs.length) lastFail = &quot;私享歌单空&quot;;
            return songs;
          });
        });
      }
    };
  }
  function stepGetDaily(scene){
    return {
      name: &quot;GetDailySongs_&quot; + scene,
      run: function(){
        return _postMusicu({
          comm: _dailyComm(true),
          req_0: {
            module: &quot;music.recommend.TrackRecommend&quot;,
            method: &quot;GetDailySongs&quot;,
            param: { period: &quot;&quot;, uin: uin, size: preferSize, scene: scene }
          }
        }).then(function(list){
          if (!(list &amp;&amp; list.length)) lastFail = &quot;GetDailySongs空 s&quot; + scene;
          return list || [];
        });
      }
    };
  }
  function stepDailyRecommend(){
    return {
      name: &quot;get_daily_recommend&quot;,
      run: function(){
        return _postMusicu({
          comm: _dailyComm(true),
          req_0: {
            module: &quot;recommend.RecommendRecommendServer&quot;,
            method: &quot;get_daily_recommend&quot;,
            param: { uin: uin }
          }
        }).then(function(list){
          if (!(list &amp;&amp; list.length)) lastFail = &quot;get_daily_recommend空&quot;;
          return list || [];
        });
      }
    };
  }
  function stepGuessLike(){
    return {
      name: &quot;GetGuessLikeSongs&quot;,
      run: function(){
        return _postMusicu({
          comm: _dailyComm(true),
          req_0: {
            module: &quot;music.ai.RecommendSongSvr&quot;,
            method: &quot;GetGuessLikeSongs&quot;,
            param: { id: 99, num: preferSize, from: 0, scene: 0, song_ids: [] }
          }
        }).then(function(list){
          if (!(list &amp;&amp; list.length)) lastFail = &quot;猜你喜欢空&quot;;
          return list || [];
        });
      }
    };
  }
  function stepPrivateFM(){
    return {
      name: &quot;PrivateFM&quot;,
      run: function(){
        return _postMusicu({
          comm: _dailyComm(true),
          req_0: {
            module: &quot;music.web_fm_svr&quot;,
            method: &quot;GetPrivateFmPlaylist&quot;,
            param: { enc: &quot;utf8&quot;, moter: 0, uin: Number(uin) || 0, login: 1 }
          }
        }).then(function(list){
          if (list &amp;&amp; list.length) return list;
          return _postMusicu({
            comm: _dailyComm(true),
            fm: {
              method: &quot;GetPrivateFmPlaylist&quot;,
              module: &quot;music.web_fm_svr&quot;,
              param: { enc: &quot;utf8&quot;, moter: 0, uin: Number(uin)||0, login: 1 }
            }
          });
        }).then(function(list){
          if (!(list &amp;&amp; list.length)) lastFail = &quot;私人FM空&quot;;
          return list || [];
        });
      }
    };
  }

  // 两套不同优先级，尽量拿不同源
  // 每日推荐：猜你喜欢 / 日推接口 / scene1 / FM
  // 每日30：今日私享 / GetDailySongs scene0 / scene2 / 日推
  var steps;
  if (mode === &quot;rec&quot;){
    steps = [stepGuessLike(), stepDailyRecommend(), stepGetDaily(1), stepPrivateFM(), stepGetDaily(0), step今日私享()];
  } else if (mode === &quot;d30&quot;){
    steps = [step今日私享(), stepGetDaily(0), stepGetDaily(2), stepDailyRecommend(), stepGetDaily(1), stepPrivateFM()];
  } else {
    steps = [step今日私享(), stepGetDaily(0), stepGetDaily(1), stepDailyRecommend(), stepGuessLike(), stepPrivateFM()];
  }

  function tryStep(i){
    if (i &gt;= steps.length){
      try { window.__qqmDailyFail = lastFail || &quot;全部接口无数据&quot;; } catch(e) {}
      return Promise.resolve({ songs: [], source: &quot;&quot;, variant: &quot;&quot;, fail: lastFail });
    }
    return steps[i].run().then(function(list){
      list = list || [];
      if (list.length &gt;= 5){
        try { window.__qqmDailyFail = &quot;&quot;; window.__qqmDailyOk = steps[i].name + &quot;@&quot; + mode; } catch(e) {}
        return { songs: list.slice(0, preferSize), source: &quot;daily&quot;, variant: steps[i].name };
      }
      return tryStep(i + 1);
    }).catch(function(){
      lastFail = steps[i].name + &quot;异常&quot;;
      return tryStep(i + 1);
    });
  }
  return tryStep(0);
}
/** 两套列表都尽量给满（推荐最多 30 首，30 卡最多 30 首）；只错开排序，不砍成 15 首 */
function _dedupeDailyPair(recSongs, d30Songs){
  recSongs = (recSongs || []).slice();
  d30Songs = (d30Songs || []).slice();
  var seen = {};
  var pool = [];
  function addAll(list){
    (list || []).forEach(function(s){
      if (!s || !s.songmid || seen[s.songmid]) return;
      seen[s.songmid] = true;
      pool.push(s);
    });
  }
  addAll(d30Songs);
  addAll(recSongs);
  if (pool.length &lt; 5){
    return { rec: recSongs.slice(0, 30), d30: d30Songs.slice(0, 30), same: true };
  }

  // 每日30：原顺序前 30
  var d30 = pool.slice(0, Math.min(30, pool.length));

  // 每日推荐：同样最多 30 首，但从中段轮转，保证首曲不同、顺序不同
  var offset = 0;
  if (pool.length &gt;= 8){
    offset = Math.min(Math.max(3, Math.floor(pool.length / 4)), pool.length - 1);
  }
  var rec = pool.slice(offset).concat(pool.slice(0, offset)).slice(0, Math.min(30, pool.length));

  // 硬保证首曲不同
  if (rec[0] &amp;&amp; d30[0] &amp;&amp; rec[0].songmid === d30[0].songmid &amp;&amp; rec.length &gt; 1){
    for (var i = 1; i &lt; rec.length; i++){
      if (rec[i].songmid !== d30[0].songmid){
        var tmp = rec[0]; rec[0] = rec[i]; rec[i] = tmp;
        break;
      }
    }
  }
  return { rec: rec, d30: d30, same: true };
}
function _enrichDailyCovers(songs){
  songs = songs || [];
  songs.forEach(function(s){
    if (s &amp;&amp; !s.cover &amp;&amp; s.albummid) s.cover = coverUrl(s.albummid);
  });
  var need = songs.filter(function(s){ return s &amp;&amp; s.songmid &amp;&amp; !s.cover &amp;&amp; !s.albummid; }).slice(0, 30);
  if (!need.length) return Promise.resolve(songs);
  var mids = need.map(function(s){ return s.songmid; });
  var body = JSON.stringify({
    comm: _dailyComm(false),
    req_0: {
      module: &quot;music.trackInfo.UniformRuleCtrl&quot;,
      method: &quot;CgiGetTrackInfo&quot;,
      param: { types: mids.map(function(){ return 0; }), mids: mids, modify_stamp: mids.map(function(){ return 0; }), ctx: 0, client: 1 }
    }
  });
  return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg?t=&quot; + Date.now(), {
    method: &quot;POST&quot;,
    headers: withCookie({ &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Referer&quot;: &quot;https://y.qq.com/&quot; }),
    body: body
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var tracks = (d &amp;&amp; d.req_0 &amp;&amp; d.req_0.data &amp;&amp; d.req_0.data.tracks) || [];
    var byMid = {};
    tracks.forEach(function(tr){ if (tr &amp;&amp; tr.mid) byMid[tr.mid] = tr; });
    songs.forEach(function(s){
      if (!s) return;
      if (!s.cover &amp;&amp; s.albummid) s.cover = coverUrl(s.albummid);
      var tr = byMid[s.songmid];
      if (!tr) return;
      var al = tr.album || {};
      if (!s.albummid &amp;&amp; (al.mid || al.pmid)) s.albummid = al.mid || al.pmid;
      if (!s.cover &amp;&amp; s.albummid) s.cover = coverUrl(s.albummid);
      if (!s.interval &amp;&amp; tr.interval) s.interval = tr.interval;
      if (!s.name &amp;&amp; (tr.title || tr.name)) s.name = tr.title || tr.name;
    });
    return songs;
  }).catch(function(){ return songs; });
}

/** 与首页频道「KTV热歌」(categoryId=141) 同逻辑：随机分页拉歌单再合并歌曲，每次易变 */
function _dailyFromKtvHot(){
  var catId = 141; // KTV必点 / KTV热歌
  var sin = Math.floor(Math.random() * 6) * 10; // 0/10/20/…/50，换一批
  return API.playlistsByTagPage(catId, 3, sin, 10).then(function(list){
    list = list || [];
    if (!list.length) return API.playlistsByTagPage(catId, 3, 0, 10);
    return list;
  }).then(function(list){
    list = list || [];
    if (!list.length){
      // 再退回官方热歌榜
      return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg?t=&quot; + Date.now(), {
        method: &quot;POST&quot;,
        headers: withCookie({ &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Referer&quot;: &quot;https://y.qq.com/&quot; }),
        body: JSON.stringify({
          comm: _dailyComm(false),
          req_0: {
            module: &quot;musicToplist.ToplistInfoServer&quot;,
            method: &quot;GetDetail&quot;,
            param: { topId: 26, offset: 0, num: 30, period: &quot;&quot; }
          }
        })
      }).then(function(txt){
        var d = jsonp_safeParse(txt);
        var data = d &amp;&amp; d.req_0 &amp;&amp; d.req_0.data;
        var songs = ((data &amp;&amp; data.songInfoList) || []).map(_mapDailySong).filter(Boolean).slice(0, 30);
        return _enrichDailyCovers(songs).then(function(ss){
          return { songs: ss, title: &quot;热歌榜&quot;, source: &quot;toplist&quot; };
        });
      });
    }
    // 多抽几个歌单，合并去重后洗牌
    var picks = list.slice(0, 4);
    return Promise.all(picks.map(function(pl){
      return API.playlistDetail(pl.dissid, 0, 40).then(function(res){
        return (res &amp;&amp; res.songs) || [];
      }).catch(function(){ return []; });
    })).then(function(parts){
      var merged = [];
      var seen = {};
      (parts || []).forEach(function(arr){
        (arr || []).forEach(function(s){
          if (!s || !s.songmid || seen[s.songmid]) return;
          seen[s.songmid] = 1;
          merged.push(s);
        });
      });
      // 洗牌，每次打开顺序也不同
      try {
        for (var i = merged.length - 1; i &gt; 0; i--){
          var j = Math.floor(Math.random() * (i + 1));
          var tmp = merged[i]; merged[i] = merged[j]; merged[j] = tmp;
        }
      } catch(eSh) {}
      var songs = merged.slice(0, 30);
      return _enrichDailyCovers(songs).then(function(ss){
        return { songs: ss, title: &quot;KTV热歌&quot;, source: &quot;ktv-hot&quot; };
      });
    });
  }).catch(function(){
    return { songs: [], title: &quot;KTV热歌&quot;, source: &quot;ktv-hot&quot; };
  });
}
function _dailyFromToplist(periodKey){
  // 兼容旧调用：改为 KTV 热歌频道
  return _dailyFromKtvHot();
}
function _dailyFromNewSongs(){
  return _postMusicu({
    comm: _dailyComm(false),
    req_0: { module: &quot;newsong.NewSongServer&quot;, method: &quot;get_new_song_info&quot;, param: { type: 5, num: 30 } }
  }).then(function(list){
    return _enrichDailyCovers((list || []).slice(0, 30)).then(function(songs){
      return { songs: songs, source: &quot;newsong&quot; };
    });
  }).catch(function(){ return { songs: [], source: &quot;newsong&quot; }; });
}

// 每日推荐（卡片）
API.dailyRecommend = function(periodKey){
  if (!_isQqLoggedIn()){
    return _dailyFromNewSongs();
  }
  return _fetchPersonalizedDaily(30).then(function(res){
    if (res &amp;&amp; res.songs &amp;&amp; res.songs.length){
      return _enrichDailyCovers(res.songs).then(function(songs){
        return { songs: songs, source: &quot;daily&quot;, variant: res.variant || &quot;&quot; };
      });
    }
    // 登录了但个性化失败：仍回新歌，避免与「已登录每日30榜单兜底」混淆
    return _dailyFromNewSongs();
  });
};

// 每日30首：固定官方热歌榜（登录/未登录都一样）
API.daily30 = function(periodKey){
  return _dailyFromToplist(periodKey);
};


// 电台（分类节目单，作为简化版“电台”呈现）
API.radioList = function(){
  var url = &quot;https://c.y.qq.com/splcloud/fcgi-bin/fcg_get_diss_by_tag.fcg?picmid=1&amp;rnd=&quot;+Math.random()+
    &quot;&amp;g_tk=5381&amp;format=json&amp;inCharset=utf8&amp;outCharset=utf-8&amp;notice=0&amp;platform=yqq.json&amp;needNewCode=0&quot;+
    &quot;&amp;categoryId=16&amp;sortId=5&amp;sin=0&amp;ein=19&quot;;
  return ADAPTER_request(url, {headers:withCookie()}).then(function(txt){
    var d = jsonp_safeParse(txt);
    if (!d || !d.data || !d.data.list) return [];
    return d.data.list.map(function(p){ return {dissid:String(p.dissid), title:p.dissname, cover:fixCover(p.imgurl||p.logo||&quot;&quot;)}; });
  }).catch(function(){ return []; });
};

function normalizeSongFromSearch(s){
  var amid = (s.album&amp;&amp;(s.album.mid||s.album.pmid||s.album.album_mid)) || s.albummid || s.album_mid || &quot;&quot;;
  var mediaMid = (s.file &amp;&amp; (s.file.media_mid || s.file.mediaMid)) || s.media_mid || s.strMediaMid || s.mid || s.songmid || &quot;&quot;;
  return {
    songmid: s.mid||s.songmid,
    media_mid: mediaMid,
    name: s.name||s.title,
    singer:(s.singer||[]).map(function(a){return a.name;}).join(&quot;/&quot;),
    albummid: amid, albumname: (s.album&amp;&amp;(s.album.name||s.album.title))||s.albumname||&quot;&quot;,
    cover: (s.album&amp;&amp;s.album.pic) || s.pic || s.cover || &quot;&quot;,
    interval: s.interval||0, isVip: !!(s.pay&amp;&amp;(s.pay.pay_play===1||s.pay.payplay===1)), isSQ:true
  };
}
function normalizeSongFromTop(d){
  var mediaMid = (d.file &amp;&amp; (d.file.media_mid || d.file.mediaMid)) || d.media_mid || d.strMediaMid || d.songmid || d.mid || &quot;&quot;;
  return {
    songmid: d.songmid||d.mid,
    media_mid: mediaMid,
    name: d.songname||d.name||d.title,
    singer:(d.singer||[]).map(function(a){return a.name;}).join(&quot;/&quot;),
    albummid: d.albummid||d.album_mid||(d.album&amp;&amp;(d.album.mid||d.album.pmid))||&quot;&quot;,
    albumname: d.albumname||(d.album&amp;&amp;(d.album.name||d.album.title))||&quot;&quot;,
    cover: d.pic||d.cover||(d.album&amp;&amp;d.album.pic)||&quot;&quot;,
    interval: d.interval||0,
    isVip: !!(d.pay&amp;&amp;(d.pay.payplay===1||d.pay.pay_play===1))
  };
}
function normalizeSongFromPlaylist(d){
  if (!d) return {songmid:&quot;&quot;,name:&quot;未知&quot;,singer:&quot;&quot;,albummid:&quot;&quot;,interval:0};
  var mediaMid = (d.file &amp;&amp; (d.file.media_mid || d.file.mediaMid)) || d.media_mid || d.strMediaMid || d.songmid || d.mid || &quot;&quot;;
  return {
    songmid: d.songmid||d.mid,
    media_mid: mediaMid,
    name: d.songname||d.name||d.title,
    singer:(d.singer||[]).map(function(a){return a.name;}).join(&quot;/&quot;),
    albummid: d.albummid||d.album_mid||(d.album&amp;&amp;(d.album.mid||d.album.pmid))||&quot;&quot;,
    albumname: d.albumname||(d.album&amp;&amp;(d.album.name||d.album.title))||&quot;&quot;,
    cover: d.pic||d.cover||(d.album&amp;&amp;d.album.pic)||&quot;&quot;,
    interval: d.interval||0,
    isVip: !!(d.pay&amp;&amp;(d.pay.payplay===1||d.pay.pay_play===1))
  };
}

/* ============================================================
   § 4. 路由 + 全局返回（对齐 Solene）
   ------------------------------------------------------------
   - 首页 = history 第 0 层，URL = pathname+search（不带 #hash）
     原生用 URL 判断「是否主页」；带 #home 会对不上 homePage，无法退出全屏
   - 不垫任何哨兵层；离开首页才 pushState
   - 子页 restoreAffordance:&quot;none&quot;；首页 &quot;auto&quot; 交给 App 退出
   ============================================================ */
var VIEWS = [&quot;home&quot;,&quot;toplist&quot;,&quot;playlists&quot;,&quot;singers&quot;,&quot;radio&quot;,&quot;mv&quot;,&quot;mine&quot;,&quot;search&quot;,&quot;detail&quot;,&quot;singerDetail&quot;];
var MAIN_TABS = [&quot;home&quot;,&quot;toplist&quot;,&quot;playlists&quot;,&quot;singers&quot;,&quot;radio&quot;,&quot;mv&quot;,&quot;mine&quot;];
var _overlayNavLock = false;
var _ignorePop = 0;

function currentHistoryState(extra){
  var base = { view: state.view, params: state.viewParams || {}, qqm: 1 };
  if (extra) {
    for (var k in extra) if (Object.prototype.hasOwnProperty.call(extra, k)) base[k] = extra[k];
  }
  return base;
}

function isOverlayOpen(){
  var login = $(&quot;#loginView&quot;);
  if (login &amp;&amp; !login.classList.contains(&quot;hidden&quot;)) return &quot;login&quot;;
  var mv = $(&quot;#mvPlayerView&quot;);
  if (mv &amp;&amp; mv.classList.contains(&quot;show&quot;)) return &quot;mv&quot;;
  var fp = $(&quot;#fullPlayer&quot;);
  if (fp &amp;&amp; fp.classList.contains(&quot;show&quot;)){
    if (fp.classList.contains(&quot;lyrics-focus&quot;)) return &quot;lyrics&quot;;
    return &quot;player&quot;;
  }
  return null;
}

function syncAppUnderlay(){
  var app = $(&quot;#app&quot;);
  if (!app) return;
  if (isOverlayOpen()) app.classList.add(&quot;overlay-hidden&quot;);
  else app.classList.remove(&quot;overlay-hidden&quot;);
}

/** Solene: 子页 none（返回走 WebView history）；首页 auto（原生可退出全屏） */
function setSubviewChrome(isSubview){
  try {
    if (window.fm &amp;&amp; window.fm.ui &amp;&amp; typeof window.fm.ui.setChrome === &quot;function&quot;){
      window.fm.ui.setChrome({
        mode: &quot;edge&quot;,
        statusBarStyle: &quot;light&quot;,
        navigationBarStyle: &quot;light&quot;,
        restoreAffordance: isSubview ? &quot;none&quot; : &quot;auto&quot;
      }).catch(function(){});
    }
  } catch(e) {}
}

function hashFor(name, params){
  params = params || {};
  // 首页必须裸 URL，不能带 #home（Solene 注释：否则原生永远认为还没回主页）
  if (name === &quot;home&quot;) return location.pathname + location.search;
  var h = &quot;#&quot;+name;
  if (params.id) h += &quot;/&quot;+params.id;
  if (params.mid) h += &quot;/&quot;+params.mid;
  if (params.kw) h += &quot;/&quot;+encodeURIComponent(params.kw);
  return h;
}

/** 各视图滚动位置记忆：离开时保存，返回时还原 */
var _viewScrollPos = {};
function saveViewScroll(name){
  if (!name) return;
  try {
    var node = $(&quot;#view-&quot; + name);
    if (node) _viewScrollPos[name] = node.scrollTop || 0;
  } catch(e) {}
}
function restoreViewScroll(name){
  if (!name) return;
  var y = 0;
  try { y = +(_viewScrollPos[name] || 0) || 0; } catch(e0) { y = 0; }
  function apply(){
    try {
      var node = $(&quot;#view-&quot; + name);
      if (node) node.scrollTop = y;
      // viewport 在部分布局下也可能承接滚动
      var vp = $(&quot;#viewport&quot;);
      if (vp &amp;&amp; name === state.view) {
        // 仅当目标视图是当前激活视图时，不强制动 viewport；多数滚动在 .view 上
      }
    } catch(e1) {}
  }
  apply();
  try {
    requestAnimationFrame(function(){
      apply();
      requestAnimationFrame(apply);
    });
  } catch(e2) {
    setTimeout(apply, 0);
    setTimeout(apply, 50);
  }
}

function switchView(name, params, push){
  params = params || {};
  var prev = state.view;
  // 离开前记住上一页滚动位置
  if (prev &amp;&amp; prev !== name) saveViewScroll(prev);
  state.view = name;
  state.viewParams = params;

  VIEWS.forEach(function(v){
    var node = $(&quot;#view-&quot;+v);
    if (node) node.classList.toggle(&quot;active&quot;, v === name);
  });
  $all(&quot;.nav-item&quot;).forEach(function(n){
    n.classList.toggle(&quot;active&quot;, n.dataset.view === name);
  });
  // 新打开的详情类页面从顶部开始；返回旧页则还原记忆位置
  if (push !== false &amp;&amp; (name === &quot;detail&quot; || name === &quot;singerDetail&quot;)){
    _viewScrollPos[name] = 0;
  }

  if (push !== false){
    var url = hashFor(name, params);
    // 全屏播放器/歌词焦点打开时，禁止把 history.overlay 清掉，否则手势返回会丢层直接退出
    var keepOv = null;
    try {
      var ovNow = isOverlayOpen();
      if (ovNow === &quot;player&quot; || ovNow === &quot;lyrics&quot;) keepOv = ovNow;
      else if (history.state &amp;&amp; (history.state.overlay === &quot;player&quot; || history.state.overlay === &quot;lyrics&quot;)) {
        var fp0 = $(&quot;#fullPlayer&quot;);
        if (fp0 &amp;&amp; fp0.classList.contains(&quot;show&quot;)) keepOv = history.state.overlay;
      }
    } catch(eOv) {}
    var st = currentHistoryState({view:name, params:params, overlay: keepOv});
    try {
      if (name === &quot;home&quot;){
        // 回首页只 replace 成裸 URL（真正弹栈由 handleBack / history.back 完成）
        // 禁止在子页上误把当前 entry 直接改成 home，否则 Native 会认为已在主页并退出
        history.replaceState(st, &quot;&quot;, url);
      } else if (MAIN_TABS.indexOf(name) &gt; -1){
        if (prev === &quot;home&quot;) history.pushState(st, &quot;&quot;, url);
        else history.replaceState(st, &quot;&quot;, url);
      } else {
        history.pushState(st, &quot;&quot;, url);
      }
    } catch(e) {}
  }

  // 首页 auto；其它视图 / 浮层 none
  setSubviewChrome(name !== &quot;home&quot; || !!isOverlayOpen());
  renderView(name, params);
  restoreViewScroll(name);
  syncAppUnderlay();
}

function pushOverlayState(kind){
  try {
    // 盘链经验：必须改 URL（hash），同 URL 的 pushState 在部分 WebView/宿主上
    // 不会让 canGoBack/侧滑返回生效，表现为「进了全屏却滑不回去」。
    var url = location.href;
    if (kind === &quot;player&quot;) url = &quot;#player&quot;;
    else if (kind === &quot;lyrics&quot;) url = &quot;#player/lyrics&quot;;
    else if (kind === &quot;login&quot;) url = &quot;#login&quot;;
    else if (kind === &quot;mv&quot;) url = &quot;#mv&quot;;
    history.pushState(currentHistoryState({overlay: kind}), &quot;&quot;, url);
  } catch(e) {}
  setSubviewChrome(true);
}

function closeOverlayUI(kind){
  if (kind === &quot;login&quot;) closeLoginView(true);
  else if (kind === &quot;mv&quot;) closeMv(true);
  else if (kind === &quot;lyrics&quot;) exitLyricsFocus(true);
  else if (kind === &quot;player&quot;) closeFullPlayer(true);
  setSubviewChrome(state.view !== &quot;home&quot;);
  syncAppUnderlay();
}

function tryCloseOverlay(fromPopstate){
  var kind = isOverlayOpen();
  if (!kind) return false;
  // 是否在历史栈里真正压过这一层（没有则绝不能 history.back，否则会退出 WebView）
  var hadHistory = false;
  try {
    hadHistory = !!(history.state &amp;&amp; history.state.overlay === kind) ||
      (kind === &quot;player&quot; &amp;&amp; _fpHistoryPushed) ||
      (kind === &quot;lyrics&quot; &amp;&amp; _lyricsFocusPushed) ||
      (kind === &quot;player&quot; &amp;&amp; history.state &amp;&amp; history.state.overlay === &quot;lyrics&quot;); // 歌词层返回会先到 player
  } catch(eH) {
    hadHistory = (kind === &quot;player&quot; &amp;&amp; _fpHistoryPushed) || (kind === &quot;lyrics&quot; &amp;&amp; _lyricsFocusPushed);
  }

  if (kind === &quot;login&quot;) closeLoginView(true);
  else if (kind === &quot;mv&quot;) closeMv(true);
  else if (kind === &quot;lyrics&quot;){
    exitLyricsFocus(true);
  }
  else if (kind === &quot;player&quot;){
    _fpHistoryPushed = false;
    _lyricsFocusPushed = false;
    _fpClosing = false;
    closeFullPlayer(true);
  }
  // 关闭后立刻按当前 view 校正 chrome
  setSubviewChrome(state.view !== &quot;home&quot;);
  syncAppUnderlay();

  if (!fromPopstate){
    if (hadHistory){
      _overlayNavLock = true;
      _ignorePop = 1;
      try { history.back(); } catch(e) {}
      setTimeout(function(){
        _overlayNavLock = false;
        if (_ignorePop &gt; 0) _ignorePop = 0;
        // 兜底：UI 已关但 history 仍挂 overlay → 清掉，避免下次手势被吞/连退
        try {
          var fp = $(&quot;#fullPlayer&quot;);
          var stillOpen = fp &amp;&amp; fp.classList.contains(&quot;show&quot;) &amp;&amp; !_fpClosing;
          if (!stillOpen &amp;&amp; history.state &amp;&amp; (history.state.overlay === &quot;player&quot; || history.state.overlay === &quot;lyrics&quot;)){
            history.replaceState(currentHistoryState({ overlay: null }), &quot;&quot;, location.href);
            _fpHistoryPushed = false;
            _lyricsFocusPushed = false;
          }
        } catch(e3) {}
      }, 360);
    } else {
      // 没有浮层历史：只清 state，禁止 back 到原生
      try {
        history.replaceState(currentHistoryState({ overlay: null }), &quot;&quot;, location.href);
      } catch(e2) {}
      _fpHistoryPushed = false;
      _lyricsFocusPushed = false;
    }
  }
  return true;
}

/** 强制回到首页并清洗历史，防止栈深度为 1 时 Native 直接退出 */
function forceGoHome(){
  // 尽量关掉浮层
  try { tryCloseOverlay(true); } catch(e) {}
  try { tryCloseOverlay(true); } catch(e) {}

  state.view = &quot;home&quot;;
  state.viewParams = {};
  VIEWS.forEach(function(v){
    var node = $(&quot;#view-&quot; + v);
    if (node) node.classList.toggle(&quot;active&quot;, v === &quot;home&quot;);
  });
  $all(&quot;.nav-item&quot;).forEach(function(n){
    n.classList.toggle(&quot;active&quot;, n.dataset.view === &quot;home&quot;);
  });
  try {
    history.replaceState(
      { view: &quot;home&quot;, params: {}, qqm: 1, overlay: null },
      &quot;&quot;,
      location.pathname + location.search
    );
  } catch(e) {}

  setSubviewChrome(false);
  syncAppUnderlay();
  renderView(&quot;home&quot;, {});
  restoreViewScroll(&quot;home&quot;);
}

function handleBack(){
  var qs = $(&quot;#queueSheet&quot;);
  if (qs &amp;&amp; qs.classList.contains(&quot;show&quot;)){
    closeQueueSheet();
    return true;
  }

  // 全屏播放器 / 登录 / MV：必须先关浮层，绝不交给原生
  if (isOverlayOpen()){
    tryCloseOverlay(false);
    return true;
  }
  // 兜底：DOM 仍显示播放器但 isOverlayOpen 偶发读失败
  try {
    var fpB = $(&quot;#fullPlayer&quot;);
    if (fpB &amp;&amp; fpB.classList.contains(&quot;show&quot;)){
      closeFullPlayer(false);
      return true;
    }
  } catch(eB) {}

  if (state.view !== &quot;home&quot;){
    // 优先真弹栈；栈已空或丢失首页层时强制回首页，避免 Native 直接退出
    var canPop = false;
    try {
      canPop = history.length &gt; 1 &amp;&amp; !!(history.state &amp;&amp; history.state.qqm);
    } catch(e) {}

    if (canPop) {
      try {
        history.back();
        return true;
      } catch(e) {
        canPop = false;
      }
    }

    forceGoHome();
    return true;
  }

  // 首页：不拦截。canGoBack 应为 false，交给原生退出全屏
  return false;
}

window.addEventListener(&quot;popstate&quot;, function(e){
  if (_overlayExpected || _ignorePop &gt; 0){
    if (_ignorePop &gt; 0) _ignorePop--;
    _overlayNavLock = false;
    _overlayExpected = null;
    try {
      var sIgn = e.state;
      var openIgn = isOverlayOpen();
      if (openIgn &amp;&amp; !(sIgn &amp;&amp; sIgn.overlay)){
        if (openIgn === &quot;player&quot; || openIgn === &quot;lyrics&quot;){
          _fpHistoryPushed = false;
          _lyricsFocusPushed = false;
          _fpClosing = false;
          closeOverlayUI(openIgn === &quot;lyrics&quot; ? &quot;player&quot; : openIgn);
        }
      }
    } catch(eIgn) {}
    setSubviewChrome(state.view !== &quot;home&quot; || !!isOverlayOpen());
    syncAppUnderlay();
    return;
  }

  var s = e.state || { view: &quot;home&quot;, params: {}, qqm: 1 };
  var open = isOverlayOpen();

  // 浮层已不在 state 里 → 关 DOM（系统手势返回 / 物理返回键）
  if (open &amp;&amp; !(s &amp;&amp; s.overlay === open)){
    // lyrics → player：state 变成 player，应只退歌词焦点，不要整页关播放器
    if (open === &quot;lyrics&quot; &amp;&amp; s &amp;&amp; s.overlay === &quot;player&quot;){
      exitLyricsFocus(true);
      _fpHistoryPushed = true;
      setSubviewChrome(true);
      syncAppUnderlay();
      return;
    }
    if (open === &quot;player&quot;) _fpHistoryPushed = false;
    if (open === &quot;lyrics&quot;) _lyricsFocusPushed = false;
    _fpClosing = false;
    if (open === &quot;lyrics&quot;) closeOverlayUI(&quot;player&quot;);
    else closeOverlayUI(open);
    // 保险：再确认播放器 DOM 已关（部分 WebView state 与 class 不同步）
    try {
      var fpChk = $(&quot;#fullPlayer&quot;);
      if (fpChk &amp;&amp; fpChk.classList.contains(&quot;show&quot;) &amp;&amp; !(s &amp;&amp; (s.overlay === &quot;player&quot; || s.overlay === &quot;lyrics&quot;))){
        _fpClosing = false;
        closeFullPlayer(true);
      }
    } catch(eChk) {}
    var targetView = (s &amp;&amp; s.view &amp;&amp; VIEWS.indexOf(s.view) &gt; -1) ? s.view : state.view;
    if (targetView === state.view &amp;&amp; !(s &amp;&amp; s.overlay)){
      setSubviewChrome(state.view !== &quot;home&quot;);
      syncAppUnderlay();
      return;
    }
  }

  if (s &amp;&amp; s.overlay){
    if (s.overlay === &quot;player&quot;){
      _fpHistoryPushed = true;
      showFullPlayerUI();
      exitLyricsFocus(true);
    } else if (s.overlay === &quot;lyrics&quot;){
      _fpHistoryPushed = true;
      _lyricsFocusPushed = true;
      showFullPlayerUI();
      enterLyricsFocus(true);
    } else if (s.overlay === &quot;login&quot;){
      var login = $(&quot;#loginView&quot;);
      if (login) login.classList.remove(&quot;hidden&quot;);
    }
    setSubviewChrome(true);
    syncAppUnderlay();
    return;
  }

  // 无 overlay：确保播放器 DOM 已关（防止偶发只弹栈不关 UI）
  try {
    var fpLeft = $(&quot;#fullPlayer&quot;);
    if (fpLeft &amp;&amp; fpLeft.classList.contains(&quot;show&quot;)){
      _fpHistoryPushed = false;
      _lyricsFocusPushed = false;
      closeFullPlayer(true);
    }
  } catch(eFp) {}

  var view = (s &amp;&amp; s.view &amp;&amp; VIEWS.indexOf(s.view) &gt; -1) ? s.view : &quot;home&quot;;
  var params = (s &amp;&amp; s.params) || {};
  if (view !== state.view || JSON.stringify(params) !== JSON.stringify(state.viewParams||{})){
    switchView(view, params, false);
  } else {
    setSubviewChrome(view !== &quot;home&quot;);
    syncAppUnderlay();
  }
});

function renderView(name, params){
  if (name===&quot;home&quot;) renderHome();
  else if (name===&quot;toplist&quot;) renderToplist();
  else if (name===&quot;playlists&quot;) renderPlaylists(params || {});
  else if (name===&quot;singers&quot;) renderSingers();
  else if (name===&quot;radio&quot;) renderRadio();
  else if (name===&quot;mv&quot;) renderMv(params || {});
  else if (name===&quot;mine&quot;) renderMine();
  else if (name===&quot;search&quot;) {
    if (params &amp;&amp; params.kw) renderSearchResults(params.kw);
    else renderSearchEmpty();
  }
  else if (name===&quot;detail&quot;) renderDetail(params);
  else if (name===&quot;singerDetail&quot;) renderSingerDetail(params);
}

/* ============================================================
   § 5. 渲染：首页
   ============================================================ */
function skeletonCards(n, cls){
  var s = &quot;&quot;;
  for (var i=0;i&lt;n;i++) s += '&lt;div class=&quot;'+(cls||&quot;card&quot;)+'&quot;&gt;&lt;div class=&quot;card-cover skeleton&quot;&gt;&lt;/div&gt;&lt;div class=&quot;card-name skeleton&quot; style=&quot;height:12px;border-radius:6px;width:80%&quot;&gt;&lt;/div&gt;&lt;/div&gt;';
  return s;
}

var IMG_PLACEHOLDER = &quot;data:image/svg+xml;utf8,&quot; + encodeURIComponent(
  '&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;300&quot; height=&quot;300&quot; viewBox=&quot;0 0 300 300&quot;&gt;'+
  '&lt;defs&gt;&lt;linearGradient id=&quot;g&quot; x1=&quot;0&quot; y1=&quot;0&quot; x2=&quot;1&quot; y2=&quot;1&quot;&gt;&lt;stop offset=&quot;0%&quot; stop-color=&quot;#1a2a22&quot;/&gt;&lt;stop offset=&quot;100%&quot; stop-color=&quot;#0d1512&quot;/&gt;&lt;/linearGradient&gt;&lt;/defs&gt;'+
  '&lt;rect width=&quot;300&quot; height=&quot;300&quot; fill=&quot;url(#g)&quot;/&gt;'+
  '&lt;g fill=&quot;#FC3C44&quot; opacity=&quot;0.35&quot; transform=&quot;translate(110,95) scale(3.3)&quot;&gt;'+
  '&lt;path d=&quot;M9 3v11.6A3.5 3.5 0 1 0 11 18V8h6V5h-2V3z&quot;/&gt;&lt;/g&gt;&lt;/svg&gt;'
);
function safeImg(src, cls){
  var raw = src ? fixCover(src) : &quot;&quot;;
  var u = raw ? esc(mediaUrl(raw)) : IMG_PLACEHOLDER;
  return '&lt;img src=&quot;'+u+'&quot;'+(cls?' class=&quot;'+cls+'&quot;':'')+' loading=&quot;lazy&quot; decoding=&quot;async&quot; onerror=&quot;this.onerror=null;this.src=\''+IMG_PLACEHOLDER+'\';&quot;&gt;';
}
/** 安全设置 img：失败时加 img-err（露出 CSS 底图）并回退 SVG */
function setImgSrc(el, src, fallbackSrc){
  if (!el) return;
  var primary = src ? mediaUrl(fixCover(src)) : &quot;&quot;;
  var fallback = fallbackSrc ? mediaUrl(fixCover(fallbackSrc)) : &quot;&quot;;
  // 同一地址不重复赋值，避免切歌封面闪一下
  if (primary &amp;&amp; el.dataset.curSrc === primary &amp;&amp; !el.classList.contains(&quot;img-err&quot;)) return;
  el.onerror = function(){
    if (fallback &amp;&amp; this.dataset.tried !== &quot;1&quot;){
      this.dataset.tried = &quot;1&quot;;
      this.src = fallback;
      this.dataset.curSrc = fallback;
      return;
    }
    this.onerror = null;
    this.classList.add(&quot;img-err&quot;);
    // 失败时保留上一张可见图，不强制换成占位图造成闪白
  };
  el.dataset.tried = &quot;0&quot;;
  if (!primary){
    el.classList.add(&quot;img-err&quot;);
    return;
  }
  el.classList.remove(&quot;img-err&quot;);
  el.dataset.curSrc = primary;
  el.src = primary;
}
/** 同步顶栏头像 */
function syncUserAvatar(){
  var img = $(&quot;#avatarImg&quot;);
  if (!img) return;
  var u = state.user;
  if (!u || !u.uin){
    img.classList.add(&quot;img-err&quot;);
    img.removeAttribute(&quot;src&quot;);
    return;
  }
  var a1 = u.avatar || avatarUrl(u.uin);
  var a2 = &quot;https://q2.qlogo.cn/headimg_dl?dst_uin=&quot;+encodeURIComponent(String(u.uin).replace(/^o0*/,&quot;&quot;))+&quot;&amp;spec=100&quot;;
  setImgSrc(img, a1, a2);
}


/** 早 / 中 / 晚 三个时段：5–11 上午，11–17 中午，其余晚上 */
function getDailyPeriodInfo(){
  var now = new Date();
  var h = now.getHours();
  var period = h &gt;= 5 &amp;&amp; h &lt; 11 ? &quot;morning&quot; : (h &gt;= 11 &amp;&amp; h &lt; 17 ? &quot;noon&quot; : &quot;evening&quot;);
  var y = now.getFullYear();
  var m = String(now.getMonth() + 1);
  if (m.length &lt; 2) m = &quot;0&quot; + m;
  var d = String(now.getDate());
  if (d.length &lt; 2) d = &quot;0&quot; + d;
  var day = y + &quot;-&quot; + m + &quot;-&quot; + d;
  var labels = {
    morning: { short: &quot;上午&quot;, title: &quot;晨间推荐&quot;, subRec: &quot;清晨好时光&lt;br&gt;来点儿音乐提提神吧~&quot;, sub30: &quot;KTV热歌频道&lt;br&gt;每次都不一样&quot; },
    noon:    { short: &quot;中午&quot;, title: &quot;午间推荐&quot;, subRec: &quot;午后小憩&lt;br&gt;换首好歌继续听~&quot;, sub30: &quot;KTV热歌频道&lt;br&gt;每次都不一样&quot; },
    evening: { short: &quot;晚上&quot;, title: &quot;晚间推荐&quot;, subRec: &quot;夜色正好&lt;br&gt;沉浸在音乐里吧~&quot;, sub30: &quot;KTV热歌频道&lt;br&gt;每次都不一样&quot; }
  };
  var meta = labels[period] || labels.evening;
  return {
    key: day + &quot;-&quot; + period,
    day: day,
    period: period,
    short: meta.short,
    title: meta.title,
    subRec: meta.subRec,
    sub30: meta.sub30
  };
}

var _homePlSrc = storeGet(&quot;homePlSrc&quot;, &quot;qq&quot;) === &quot;netease&quot; ? &quot;netease&quot; : &quot;qq&quot;;
var _homeNeOffset = 0;

var _dailyCache = { key: &quot;&quot;, src: &quot;&quot;, recSongs: [], d30Songs: [], loading: false };

function applyHomeSrcTheme(){
  var isNe = _homePlSrc === &quot;netease&quot;;
  var rec = $(&quot;#dailyRecCard&quot;), d30 = $(&quot;#daily30Card&quot;);
  if (rec) rec.classList.toggle(&quot;ne-skin&quot;, isNe);
  if (d30) d30.classList.toggle(&quot;ne-skin&quot;, isNe);
  // 早 / 中 / 晚 时段色（与标题时段同步）
  try {
    var pi = getDailyPeriodInfo();
    var pk = (pi &amp;&amp; pi.period) || &quot;evening&quot;;
    var periods = [&quot;morning&quot;, &quot;noon&quot;, &quot;evening&quot;];
    [rec, d30].forEach(function(el){
      if (!el) return;
      periods.forEach(function(p){ el.classList.toggle(&quot;period-&quot; + p, p === pk); });
    });
  } catch(eP) {}
  if (isNe){
    // 切网易：临时网易红；记住切换前主题（勿把 netease 写成长期偏好）
    if (state.theme !== &quot;netease&quot;){
      _themeBeforeNe = state.theme || &quot;apple&quot;;
      try { storeSet(&quot;theme&quot;, _themeBeforeNe); } catch(e0) {}
    }
    try {
      state.theme = &quot;netease&quot;;
      document.documentElement.setAttribute(&quot;data-theme&quot;, &quot;netease&quot;);
    } catch(e) {}
  } else {
    // 切回 QQ 歌单：主题固定 QQ 绿
    _themeBeforeNe = null;
    try { applyTheme(&quot;qq&quot;, true); } catch(e) {}
  }
}


/** 把今日日推列表落到本地，避免二次进入/刷新顺序漂移 */
function _dailyStoreKey(kind){
  try {
    var period = getDailyPeriodInfo();
    var uinKey = (state.user &amp;&amp; state.user.uin) ? String(state.user.uin) : &quot;guest&quot;;
    var src = _homePlSrc || &quot;qq&quot;;
    return &quot;dailySnap|&quot; + kind + &quot;|&quot; + period.day + &quot;|&quot; + src + &quot;|&quot; + uinKey;
  } catch(e) { return &quot;dailySnap|&quot; + kind; }
}
function _saveDailySnap(kind, songs){
  try {
    if (!songs || !songs.length) return;
    var slim = songs.slice(0, 30).map(function(s){
      if (!s) return null;
      return {
        songmid: s.songmid || &quot;&quot;,
        name: s.name || &quot;&quot;,
        singer: s.singer || &quot;&quot;,
        cover: s.cover || &quot;&quot;,
        albummid: s.albummid || &quot;&quot;,
        albumname: s.albumname || &quot;&quot;,
        interval: s.interval || 0,
        neteaseId: s.neteaseId || &quot;&quot;,
        source: s.source || &quot;&quot;,
        strMediaMid: s.strMediaMid || s.media_mid || &quot;&quot;,
        media_mid: s.media_mid || s.strMediaMid || &quot;&quot;
      };
    }).filter(Boolean);
    storeSet(_dailyStoreKey(kind), JSON.stringify(slim));
  } catch(e) {}
}
function _loadDailySnap(kind){
  try {
    var raw = storeGet(_dailyStoreKey(kind), &quot;&quot;);
    if (!raw) return [];
    var list = typeof raw === &quot;string&quot; ? JSON.parse(raw) : raw;
    return Array.isArray(list) ? list : [];
  } catch(e) { return []; }
}

/** 缓存命中快路径：不重新拉接口，只重绑封面/文案/点击（DOM 可能重建过）。
 *  之前一直缺失这个函数，导致每次走快路径都静默 no-op —— 卡片一直停在首次渲染的状态。 */
function _rebindDailyCardsOnly(){
  try {
    var recCover = $(&quot;#dailyRecCover&quot;), d30Cover = $(&quot;#daily30Cover&quot;);
    var recMeta = $(&quot;#dailyRecMeta&quot;), d30Meta = $(&quot;#daily30Meta&quot;);
    var recSongs = (_dailyCache &amp;&amp; _dailyCache.recSongs) || [];
    var d30Songs = (_dailyCache &amp;&amp; _dailyCache.d30Songs) || [];

    function setCover(el, song){ if (el &amp;&amp; song) el.innerHTML = safeImg(songCoverUrl(song)); }
    function setMetaText(el, song, sub){
      if (!el) return;
      if (!song){ el.innerHTML = '&lt;div class=&quot;df-name&quot;&gt;暂无数据&lt;/div&gt;&lt;div class=&quot;df-sub&quot;&gt;'+esc(sub||&quot;&quot;)+'&lt;/div&gt;'; return; }
      el.innerHTML = '&lt;div class=&quot;df-name&quot;&gt;'+esc(song.name)+(song.singer?(&quot; - &quot;+esc(song.singer)):&quot;&quot;)+'&lt;/div&gt;&lt;div class=&quot;df-sub&quot;&gt;'+esc(sub||&quot;&quot;)+'&lt;/div&gt;';
    }
    setCover(recCover, recSongs[0]);
    setMetaText(recMeta, recSongs[0], &quot;每日推荐&quot;);
    setCover(d30Cover, d30Songs[0]);
    setMetaText(d30Meta, d30Songs[0], &quot;每日30首&quot;);

    function bindOne(cardId, playId, getSongs, label, tag){
      var card = $(&quot;#&quot;+cardId), btn = $(&quot;#&quot;+playId);
      function snapshotSongs(){ return (getSongs() || []).slice(); }
      function playOrToggle(){
        if (state.queueTag === tag &amp;&amp; state.queue &amp;&amp; state.queue.length){
          if (!audio.paused){ audio.pause(); return; }
          audio.play().catch(function(){}); return;
        }
        var songs = snapshotSongs();
        if (!songs.length){ toast(label+&quot;还在加载，稍后再试&quot;); return; }
        playQueue(songs, 0, tag);
      }
      function openList(){
        var songs = snapshotSongs();
        if (!songs.length){ toast(label+&quot;还在加载，稍后再试&quot;); return; }
        var cover = (songs[0] &amp;&amp; (songs[0].cover || songCoverUrl(songs[0]))) || &quot;&quot;;
        switchView(&quot;detail&quot;, { type: &quot;album&quot;, id: tag, title: label, cover: cover, songs: songs, queueTag: tag });
      }
      if (card) card.onclick = function(e){
        if (e.target &amp;&amp; e.target.closest &amp;&amp; e.target.closest(&quot;.dc-play&quot;)) return;
        openList();
      };
      if (btn) btn.onclick = function(e){ e.stopPropagation(); playOrToggle(); };
    }
    bindOne(&quot;dailyRecCard&quot;, &quot;dailyRecPlay&quot;, function(){ return _dailyCache.recSongs; }, &quot;每日推荐&quot;, &quot;daily-rec&quot;);
    bindOne(&quot;daily30Card&quot;, &quot;daily30Play&quot;, function(){ return _dailyCache.d30Songs; }, &quot;每日30首&quot;, &quot;daily-30&quot;);

    // 若当前正播的就是这两个队列之一，把&quot;正在播放 · 歌名&quot;覆盖上去，而不是停在通用文案
    try { syncDailyPlayingMeta(state.queue &amp;&amp; state.queue[state.queueIndex]); } catch(eDS) {}
  } catch(e) {}
}
function loadDailySections(force){
  var period = getDailyPeriodInfo();
  var src = _homePlSrc || &quot;qq&quot;;
  // 缓存键含 uin + 日期：跨日必须重新拉
  var uinKey = (state.user &amp;&amp; state.user.uin) ? String(state.user.uin) : &quot;guest&quot;;
  var cacheKey = period.key + &quot;|&quot; + src + &quot;|&quot; + uinKey;
  var lastDay = &quot;&quot;;
  try { lastDay = String(storeGet(&quot;dailyLastDay&quot;, &quot;&quot;) || &quot;&quot;); } catch(e0) {}
  // 跨自然日：强制刷新，丢掉内存里的昨日歌
  if (lastDay &amp;&amp; lastDay !== period.day){
    force = true;
    _dailyCache.recSongs = [];
    _dailyCache.d30Songs = [];
    _dailyCache.key = &quot;&quot;;
    _dailyCache.src = &quot;&quot;;
    try {
      storeSet(&quot;daily30Mids&quot;, &quot;&quot;); storeSet(&quot;dailyRecMids&quot;, &quot;&quot;);
      // 清掉昨日网易30快照键（按旧日期）
      if (lastDay) storeSet(&quot;neDaily30Snap|&quot; + lastDay, &quot;&quot;);
    } catch(e1) {}
  }
  if (_dailyCache.key &amp;&amp; _dailyCache.key !== cacheKey){
    force = true;
    _dailyCache.recSongs = [];
    _dailyCache.d30Songs = [];
    _dailyCache.key = &quot;&quot;;
    _dailyCache.src = &quot;&quot;;
  }
  // 内存命中：同一天同一源直接复用，禁止二次请求把列表换掉
  if (!force &amp;&amp; _dailyCache.key === cacheKey &amp;&amp; (_dailyCache.recSongs.length || _dailyCache.d30Songs.length)){
    try {
      var snapDay = String(storeGet(&quot;dailyLastDay&quot;, &quot;&quot;) || &quot;&quot;);
      if (snapDay === period.day){
        // 仍要绑定点击（DOM 可能重建过），但不重新拉接口
        try { _rebindDailyCardsOnly(); } catch(eRb) {}
        return;
      }
      force = true;
    } catch(e2) {
      try { _rebindDailyCardsOnly(); } catch(eRb2) {}
      return;
    }
  }
  // 内存空但本地有今日快照：先灌进内存，保证点开一致
  if (!force){
    try {
      if (!_dailyCache.recSongs.length){
        var snapR = _loadDailySnap(&quot;rec&quot;);
        if (snapR.length) _dailyCache.recSongs = snapR;
      }
      if (!_dailyCache.d30Songs.length){
        var snapD = _loadDailySnap(&quot;d30&quot;);
        if (snapD.length) _dailyCache.d30Songs = snapD;
      }
      if ((_dailyCache.recSongs.length || _dailyCache.d30Songs.length) &amp;&amp; !_dailyCache.key){
        _dailyCache.key = cacheKey;
        _dailyCache.src = src;
      }
    } catch(eHydra) {}
  }
  // 再次命中检查（含刚灌入的本地快照）
  if (!force &amp;&amp; _dailyCache.key === cacheKey &amp;&amp; (_dailyCache.recSongs.length || _dailyCache.d30Songs.length)){
    try { _rebindDailyCardsOnly(); } catch(eRb3) {}
    return;
  }
  if (_dailyCache.loading &amp;&amp; !force) return;
  _dailyCache.loading = true;
  // 强制时允许打断「加载中」卡死
  if (force) _dailyCache.loading = true;

  var recCover = $(&quot;#dailyRecCover&quot;), d30Cover = $(&quot;#daily30Cover&quot;);
  var recMeta = $(&quot;#dailyRecMeta&quot;), d30Meta = $(&quot;#daily30Meta&quot;);

  function setCardCover(el, song){ if (el) el.innerHTML = safeImg(songCoverUrl(song)); }
  function setMeta(el, song, sub){
    if (!el) return;
    if (!song){ el.innerHTML = '&lt;div class=&quot;df-name&quot;&gt;暂无数据&lt;/div&gt;&lt;div class=&quot;df-sub&quot;&gt;'+esc(sub||&quot;&quot;)+'&lt;/div&gt;'; return; }
    el.innerHTML = '&lt;div class=&quot;df-name&quot;&gt;'+esc(song.name)+(song.singer?(&quot; - &quot;+esc(song.singer)):&quot;&quot;)+'&lt;/div&gt;&lt;div class=&quot;df-sub&quot;&gt;'+esc(sub||&quot;&quot;)+'&lt;/div&gt;';
  }
  function bindPlay(cardId, playId, getSongs, label, tag){
    function snapshotSongs(){
      var songs = getSongs() || [];
      // 浅拷贝数组，固定顺序，防止后续接口回写 / 播放副作用影响卡片缓存
      return songs.slice();
    }
    function playOrToggle(){
      // 点播放按钮：已在播同一批则暂停/继续，否则直接开播（不进列表）
      if (state.queueTag === tag &amp;&amp; state.queue &amp;&amp; state.queue.length){
        if (!audio.paused){ audio.pause(); return; }
        audio.play().catch(function(){}); return;
      }
      var songs = snapshotSongs();
      if (!songs.length){ toast(label+&quot;还在加载，稍后再试&quot;); return; }
      playQueue(songs, 0, tag);
    }
    function openList(){
      // 点卡片：进入本批播放列表页（使用快照，与卡片展示一致）
      var songs = snapshotSongs();
      if (!songs.length){ toast(label+&quot;还在加载，稍后再试&quot;); return; }
      var cover = (songs[0] &amp;&amp; (songs[0].cover || songCoverUrl(songs[0]))) || &quot;&quot;;
      switchView(&quot;detail&quot;, {
        type: &quot;album&quot;,
        id: tag,
        title: label,
        cover: cover,
        songs: songs,
        queueTag: tag
      });
    }
    var card = $(&quot;#&quot;+cardId), btn = $(&quot;#&quot;+playId);
    if (card) card.onclick = function(e){
      if (e.target &amp;&amp; e.target.closest &amp;&amp; e.target.closest(&quot;.dc-play&quot;)) return;
      openList();
    };
    if (btn) btn.onclick = function(e){ e.stopPropagation(); playOrToggle(); };
  }
  bindPlay(&quot;dailyRecCard&quot;, &quot;dailyRecPlay&quot;, function(){ return _dailyCache.recSongs; }, &quot;每日推荐&quot;, &quot;daily-rec&quot;);
  bindPlay(&quot;daily30Card&quot;, &quot;daily30Play&quot;, function(){ return _dailyCache.d30Songs; }, &quot;每日30首&quot;, &quot;daily-30&quot;);

  var subRec = $(&quot;#dailyRecCard .dc-sub&quot;), sub30 = $(&quot;#daily30Card .dc-sub&quot;);
  var titleRec = $(&quot;#dailyRecCard .dc-title&quot;), title30 = $(&quot;#daily30Card .dc-title&quot;);
  var isNe = src === &quot;netease&quot;;
  applyHomeSrcTheme();

  if (titleRec) titleRec.textContent = isNe ? (&quot;网易 · &quot; + period.title) : period.title;
  if (title30) title30.textContent = isNe ? (&quot;网易 30 · &quot; + period.short) : (&quot;Daily 30 · &quot; + period.short);
  if (subRec) subRec.innerHTML = isNe ? (&quot;网易云新歌&lt;br&gt;&quot; + period.short + &quot;精选&quot;) : period.subRec;
  if (sub30) sub30.innerHTML = isNe ? (&quot;网易云榜单&lt;br&gt;&quot; + period.short + &quot;热歌&quot;) : period.sub30;

  var periodArg = period.key || (period.day + &quot;-&quot; + period.period);

  function applyRecUI(res){
    var recSongs = (res &amp;&amp; res.songs) || [];
    // 非强制刷新时保留已有列表，避免第二次点开顺序/内容被接口重写
    if (!force &amp;&amp; _dailyCache.recSongs &amp;&amp; _dailyCache.recSongs.length &gt;= 5){
      recSongs = _dailyCache.recSongs;
    } else {
      _dailyCache.recSongs = recSongs.slice();
      _saveDailySnap(&quot;rec&quot;, _dailyCache.recSongs);
    }
    var tip = isNe
      ? (&quot;网易推荐 · &quot; + period.short)
      : (res &amp;&amp; res.source === &quot;daily&quot;
          ? (&quot;每日推荐 · 登录专属 · &quot; + period.short)
          : (&quot;每日推荐 · 新歌速递 · &quot; + period.short));
    if (recSongs[0]){
      setCardCover(recCover, recSongs[0]);
      setMeta(recMeta, recSongs[0], tip);
      if (subRec &amp;&amp; !isNe){
        subRec.innerHTML = (res &amp;&amp; res.source === &quot;daily&quot;)
          ? (&quot;根据口味精选&lt;br&gt;&quot; + period.short + &quot;推荐&quot;)
          : (&quot;今日新歌速递&lt;br&gt;&quot; + period.short + &quot;精选&quot;);
      }
    } else setMeta(recMeta, null, isNe ? &quot;网易推荐&quot; : period.title);
  }
  function applyD30UI(res){
    var d30Songs = (res &amp;&amp; res.songs) || [];
    // 已有列表且新结果为空 → 保留；已有列表且非强制 → 保留；其余写入
    if (_dailyCache.d30Songs &amp;&amp; _dailyCache.d30Songs.length &gt;= 5){
      if (!d30Songs.length || !force){
        d30Songs = _dailyCache.d30Songs;
      } else {
        _dailyCache.d30Songs = d30Songs.slice();
      }
    } else if (d30Songs.length){
      _dailyCache.d30Songs = d30Songs.slice();
    }
    try {
      if (_dailyCache.d30Songs &amp;&amp; _dailyCache.d30Songs.length){
        var mids = _dailyCache.d30Songs.map(function(s){ return s &amp;&amp; s.songmid; }).filter(Boolean).join(&quot;,&quot;);
        storeSet(&quot;daily30Mids&quot;, mids);
        storeSet(&quot;daily30MidsDay&quot;, period.day);
      }
    } catch(eSt) {}
    d30Songs = _dailyCache.d30Songs || d30Songs;
    if (d30Songs[0]){
      var tip30;
      if (isNe) tip30 = &quot;网易30 · &quot; + ((res &amp;&amp; res.title) || &quot;热歌&quot;) + &quot; · &quot; + period.short;
      else tip30 = &quot;每日30首 · &quot; + period.short;
      // 卡片封面/标题固定为列表第 1 首，与点进详情、点播放一致
      setCardCover(d30Cover, d30Songs[0]);
      setMeta(d30Meta, d30Songs[0], tip30);
      if (sub30 &amp;&amp; !isNe){
        sub30.innerHTML = &quot;KTV热歌频道&lt;br&gt;每次都不一样&quot;;
      }
    } else setMeta(d30Meta, null, isNe ? &quot;网易30首&quot; : &quot;每日30首&quot;);
  }
  function finishLoad(){
    _dailyCache.key = cacheKey; _dailyCache.src = src; _dailyCache.loading = false;
    try {
      storeSet(&quot;dailyLastDay&quot;, period.day);
      storeSet(&quot;dailyLastTs&quot;, Date.now());
      storeSet(&quot;dailyLastKey&quot;, cacheKey);
    } catch(eSt) {}
  }

  // 网易：两套接口独立
  if (isNe){
    API.neteaseDailyRecommend(periodArg).then(applyRecUI).catch(function(){ applyRecUI({ songs: [] }); });
    API.neteaseDaily30(periodArg).then(applyD30UI).catch(function(){ applyD30UI({ songs: [] }); }).then(finishLoad);
    return;
  }

  // QQ：每日30 固定热歌榜；推荐=登录个性化 / 游客新歌
  _dailyFromToplist(periodArg).then(applyD30UI).catch(function(){ applyD30UI({ songs: [] }); });

  if (!_isQqLoggedIn()){
    _dailyFromNewSongs().then(applyRecUI).catch(function(){ applyRecUI({ songs: [] }); }).then(finishLoad);
    return;
  }

  _fetchPersonalizedDaily(30, &quot;rec&quot;).then(function(res){
    return _enrichDailyCovers((res &amp;&amp; res.songs) || []).then(function(songs){
      return { songs: songs, source: (songs.length &gt;= 5 ? &quot;daily&quot; : &quot;&quot;), variant: (res &amp;&amp; res.variant) || &quot;&quot; };
    });
  }).then(function(recPart){
    if (recPart.songs &amp;&amp; recPart.songs.length &gt;= 5){
      applyRecUI({ songs: recPart.songs, source: &quot;daily&quot; });
      finishLoad();
      return;
    }
    return _dailyFromNewSongs().then(function(ns){
      applyRecUI(ns || { songs: [] });
      finishLoad();
    });
  }).catch(function(){
    _dailyFromNewSongs().then(function(ns){
      applyRecUI(ns || { songs: [] });
      finishLoad();
    });
  });
}
function maybeRefreshDaily(force){
  var period = getDailyPeriodInfo();
  var uinKey = (state.user &amp;&amp; state.user.uin) ? String(state.user.uin) : &quot;guest&quot;;
  var cacheKey = period.key + &quot;|&quot; + (_homePlSrc || &quot;qq&quot;) + &quot;|&quot; + uinKey;
  if (window.__qqmForceDaily){
    force = true;
    try { window.__qqmForceDaily = false; } catch(eF) {}
  }
  // 跨日强制刷新
  try {
    var lastDay = storeGet(&quot;dailyLastDay&quot;, &quot;&quot;);
    if (lastDay &amp;&amp; lastDay !== period.day){
      force = true;
      _dailyCache.key = &quot;&quot;;
      _dailyCache.recSongs = [];
      _dailyCache.d30Songs = [];
      _dailyCache.loading = false;
    }
  } catch(eD) {}
  // 超过 4 小时也刷新（官方日推多在凌晨换批）
  try {
    var lastTs = Number(storeGet(&quot;dailyLastTs&quot;, 0) || 0);
    if (lastTs &amp;&amp; (Date.now() - lastTs) &gt; 4 * 3600 * 1000) force = true;
  } catch(eT) {}
  if (force || _dailyCache.key !== cacheKey) loadDailySections(true);
}
// 回到前台 / 跨日自动刷新日推
if (!window.__qqmDailyVisBound){
  window.__qqmDailyVisBound = true;
  document.addEventListener(&quot;visibilitychange&quot;, function(){
    if (document.visibilityState !== &quot;visible&quot;) return;
    try { maybeRefreshDaily(false); } catch(e) {}
  });
  window.addEventListener(&quot;pageshow&quot;, function(){
    try { maybeRefreshDaily(false); } catch(e2) {}
  });
  // 每 20 分钟检查一次是否跨日
  setInterval(function(){
    try { maybeRefreshDaily(false); } catch(e3) {}
  }, 20 * 60 * 1000);
}

