      '&lt;button class=&quot;hero-play&quot; id=&quot;btnGoLogin&quot; style=&quot;margin-left:auto&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-play&quot;/&gt;&lt;/svg&gt;去登录&lt;/button&gt;&lt;/div&gt;';
  }
  html += '&lt;div class=&quot;sec&quot;&gt;&lt;div class=&quot;sec-head&quot;&gt;&lt;div class=&quot;sec-title&quot;&gt;&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;我喜欢（'+state.favorites.length+'）&lt;/div&gt;'+
    (u ? '&lt;button type=&quot;button&quot; class=&quot;sec-more&quot; id=&quot;btnPlayAllFav&quot;&gt;播放全部&lt;/button&gt;' : '')+
    '&lt;/div&gt;&lt;div class=&quot;song-list&quot; id=&quot;mineFav&quot;&gt;&lt;/div&gt;&lt;/div&gt;';
  // 自建 / 收藏歌单：并排切换（对齐截图「自建歌单 | 收藏歌单」）
  var minePlTab = (state.minePlTab ==</td></tr><tr><td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;font-weight:600;width:38%;vertical-align:top;">Content-Type</td><td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;vertical-align:top;">text/html; charset=utf-8</td></tr><tr><td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;font-weight:600;width:38%;vertical-align:top;">Length</td><td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;vertical-align:top;">732,090</td></tr><tr><td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;font-weight:600;width:38%;vertical-align:top;">Normalized Url</td><td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;vertical-align:top;">https://q-16a.pages.dev/</td></tr><tr><td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;font-weight:600;width:38%;vertical-align:top;">Truncated</td><td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;vertical-align:top;">Yes</td></tr></table>
    
