<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>网页源代码 — 结果</title>
</head>
<body style="margin:0;padding:32px;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#fafafa;color:#111827;">
  <div style="max-width:720px;margin:0 auto;background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:28px 32px;box-shadow:0 1px 2px rgba(0,0,0,0.04);">
    <h1 style="margin:0 0 8px;font-size:1.5rem;font-weight:700;">网页源代码 — 结果</h1>
    <p style="margin:0 0 24px;font-size:0.875rem;color:#6b7280;">2026年8月7日 23:01</p>
    <table style="width:100%;border-collapse:collapse;font-size:0.9375rem;"><tr><td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;font-weight:600;width:38%;vertical-align:top;">Text</td><td style="padding:10px 12px;border-bottom:1px solid #e5e7eb;vertical-align:top;">&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;zh-CN&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;UTF-8&quot;&gt;
&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover&quot;&gt;
&lt;title&gt;QQ音乐&lt;/title&gt;
&lt;style&gt;
/* ============================================================
   DESIGN TOKENS · 深空黑底 + 毛玻璃 + 可切换强调色
   --green 为全局强调色变量名（兼容脚本）；主题：apple / qq / kuwo / ytmusic
   ============================================================ */
:root{
  --bg-0:#000000;
  --bg-1:#0a0a0a;
  --bg-2:#1c1c1e;
  --bg-elevated:#2c2c2e;
  --glass:rgba(255,255,255,0.08);
  --glass-strong:rgba(44,44,48,0.62);
  --glass-border:rgba(255,255,255,0.12);
  --line:rgba(255,255,255,0.12);
  /* 默认：Apple Music 玫瑰红 */
  --green:#FC3C44;
  --green-dim:#d92b34;
  --green-glow:rgba(252,60,68,0.28);
  --accent-rgb:252,60,68;
  --gold:#ff9f0a;
  --text-0:#ffffff;
  --text-1:rgba(235,235,245,0.72);
  --text-2:rgba(235,235,245,0.42);
  --danger:#FF453A;
  --radius-s:12px;
  --radius-m:14px;
  --radius-l:20px;
  --blur-1:20px;
  --blur-2:40px;
  --blur-3:60px;
  --ease:cubic-bezier(0.25,0.1,0.25,1);
  --ease-spring:cubic-bezier(0.34,1.56,0.64,1);
  --ease-smooth:cubic-bezier(0.22,1,0.36,1);
  --ease-out:cubic-bezier(0.16,1,0.3,1);
  --font-display:-apple-system,&quot;SF Pro Display&quot;,&quot;PingFang SC&quot;,&quot;Helvetica Neue&quot;,sans-serif;
  --font-body:-apple-system,&quot;SF Pro Text&quot;,&quot;PingFang SC&quot;,&quot;Helvetica Neue&quot;,sans-serif;
  --font-num:&quot;SF Pro Rounded&quot;,&quot;SF Pro Text&quot;,-apple-system,var(--font-body);
  --safe-t:env(safe-area-inset-top,0px);
  --safe-b:env(safe-area-inset-bottom,0px);
}
/* QQ 音乐本色 · 绿 */
html[data-theme=&quot;qq&quot;]{
  --green:#31c27c;
  --green-dim:#28a86a;
  --green-glow:rgba(49,194,124,0.30);
  --accent-rgb:49,194,124;
}
/* 酷我音乐 · 琥珀黄 */
html[data-theme=&quot;kuwo&quot;]{
  --green:#ffb000;
  --green-dim:#e09a00;
  --green-glow:rgba(255,176,0,0.30);
  --accent-rgb:255,176,0;
}

/* 酷狗音乐 · 蓝 */
html[data-theme=&quot;kugou&quot;]{
  --green:#00A9FF;
  --green-dim:#0088cc;
  --green-glow:rgba(0,169,255,0.30);
  --accent-rgb:0,169,255;
}
/* YouTube Music · 红 */
html[data-theme=&quot;ytmusic&quot;]{
  --green:#FF0033;
  --green-dim:#cc0029;
  --green-glow:rgba(255,0,51,0.30);
  --accent-rgb:255,0,51;
}
/* 网易云音乐 · 正红 */
html[data-theme=&quot;netease&quot;]{
  --green:#EC4141;
  --green-dim:#c73434;
  --green-glow:rgba(236,65,65,0.32);
  --accent-rgb:236,65,65;
}
/* Apple 玫瑰（显式，便于还原） */
html[data-theme=&quot;apple&quot;]{
  --green:#FC3C44;
  --green-dim:#d92b34;
  --green-glow:rgba(252,60,68,0.28);
  --accent-rgb:252,60,68;
}
/* ============================================================
   明暗模式 · light=多彩氛围；dark=统一黑底；neon=赛博霓虹
   ============================================================ */
html[data-mode=&quot;dark&quot;]{
  --bg-0:#000000;--bg-1:#000000;--bg-2:#111111;--bg-elevated:#1a1a1a;
  --glass:rgba(255,255,255,0.06);--glass-strong:rgba(28,28,30,0.88);
  --glass-border:rgba(255,255,255,0.10);--line:rgba(255,255,255,0.10);
  --text-0:#ffffff;--text-1:rgba(235,235,245,0.72);--text-2:rgba(235,235,245,0.42);
}
html[data-mode=&quot;dark&quot;],
html[data-mode=&quot;dark&quot;] body{background:#000!important;color:var(--text-0);}
html[data-mode=&quot;dark&quot;] #ambientBg{background:#000!important;}
html[data-mode=&quot;dark&quot;] #ambientVeil{background:transparent!important;}
html[data-mode=&quot;dark&quot;] #grain{opacity:0;}
html[data-mode=&quot;dark&quot;] .login-btn-primary,
html[data-mode=&quot;dark&quot;] .hero-play,
html[data-mode=&quot;dark&quot;] .pb-play,
html[data-mode=&quot;dark&quot;] .fp-play,
html[data-mode=&quot;dark&quot;] .daily-card .dc-play,
html[data-mode=&quot;dark&quot;] .detail-play-all,
html[data-mode=&quot;dark&quot;] .card-cover .play-fab,
html[data-mode=&quot;dark&quot;] #ytmApiSave,
html[data-mode=&quot;dark&quot;] .nav-item.active{
  background:#fff!important;color:#111!important;border-color:transparent!important;
  box-shadow:0 4px 16px rgba(0,0,0,.35)!important;
}
html[data-mode=&quot;dark&quot;] .login-btn-primary svg,
html[data-mode=&quot;dark&quot;] .hero-play svg,
html[data-mode=&quot;dark&quot;] .pb-play svg,
html[data-mode=&quot;dark&quot;] .fp-play svg,
html[data-mode=&quot;dark&quot;] .daily-card .dc-play svg,
html[data-mode=&quot;dark&quot;] .card-cover .play-fab svg{color:#111!important;}
html[data-mode=&quot;dark&quot;] #sourceTabs.sr-tabs{
  background:rgba(118,118,128,0.28);border:none;
}
html[data-mode=&quot;dark&quot;] #sourceTabs .sr-indicator{
  background:#fff!important;
  box-shadow:0 2px 12px rgba(0,0,0,.35), 0 1px 0 rgba(255,255,255,.5) inset!important;
}
html[data-mode=&quot;dark&quot;] #sourceTabs .sr-tab.active[data-src],
html[data-mode=&quot;dark&quot;] #sourceTabs .sr-tab.active[data-src=&quot;qq&quot;],
html[data-mode=&quot;dark&quot;] #sourceTabs .sr-tab.active[data-src=&quot;kuwo&quot;],
html[data-mode=&quot;dark&quot;] #sourceTabs .sr-tab.active[data-src=&quot;netease&quot;],
html[data-mode=&quot;dark&quot;] #sourceTabs .sr-tab.active[data-src=&quot;kugou&quot;],
html[data-mode=&quot;dark&quot;] #sourceTabs .sr-tab.active[data-src=&quot;ytmusic&quot;]{
  color:#111!important;background:transparent!important;border-color:transparent!important;
  box-shadow:none!important;
}
html[data-mode=&quot;dark&quot;] .hot-search-tag,
html[data-mode=&quot;dark&quot;] .login-btn-guest,
html[data-mode=&quot;dark&quot;] #searchEmptyBack{
  background:rgba(255,255,255,0.1)!important;color:#fff!important;
}
html[data-mode=&quot;dark&quot;] #playerBar{
  background:rgba(22,22,26,0.58)!important;
  border-color:rgba(255,255,255,0.14)!important;
  border-top-color:rgba(255,255,255,0.16)!important;
  backdrop-filter:blur(36px) saturate(1.35) brightness(1.02)!important;
  -webkit-backdrop-filter:blur(36px) saturate(1.35) brightness(1.02)!important;
}
html[data-mode=&quot;dark&quot;] #playerBar::before{
  background:linear-gradient(135deg,
    rgba(255,255,255,0.06) 0%,
    rgba(var(--accent-rgb),0.10) 50%,
    rgba(255,255,255,0.03) 100%);
  opacity:.9;
  animation:none!important;
}
html[data-mode=&quot;dark&quot;] #topbar{
  background:linear-gradient(180deg,rgba(0,0,0,.95) 0%,rgba(0,0,0,0) 100%);
}
html[data-mode=&quot;dark&quot;] .search-box{
  background:rgba(255,255,255,0.10)!important;border-color:rgba(255,255,255,0.08)!important;
}
html[data-mode=&quot;dark&quot;] .search-box.focused{
  background:rgba(255,255,255,0.16)!important;
  border-color:rgba(255,255,255,0.16)!important;
}
html[data-mode=&quot;dark&quot;] .pb-bar-fill,
html[data-mode=&quot;dark&quot;] .fp-bar-fill{background:#fff!important;}
html[data-mode=&quot;dark&quot;] .pb-bar-knob,
html[data-mode=&quot;dark&quot;] .fp-bar-knob{background:#fff!important;}
/* 全屏播放页 */
html[data-mode=&quot;dark&quot;] #fullPlayer{background:#000!important;color:#fff!important;}
html[data-mode=&quot;dark&quot;] #fpBg{background:#000!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-track-name{color:#fff!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-track-artist{color:rgba(235,235,245,.55)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-tab{color:rgba(235,235,245,.4)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-tab.active{color:#fff!important;border-color:var(--green)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .lyric-line{color:rgba(235,235,245,.35)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .lyric-line:hover{color:rgba(235,235,245,.65)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .lyric-line.active{color:#fff!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .lyric-line.active .lyric-tr{color:var(--green)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .lyric-tr{color:rgba(235,235,245,.35)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-time{color:rgba(235,235,245,.45)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-bar{background:rgba(255,255,255,.18)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-bar-fill{background:#fff!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-bar-knob{background:#fff!important;box-shadow:0 1px 4px rgba(0,0,0,.4)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-ctrl-btn{color:rgba(235,235,245,.85)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-quick button{color:rgba(235,235,245,.75)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-quick button.on{color:var(--danger)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-quality-btn,
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-speed-btn{color:rgba(235,235,245,.75)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-speed-btn.on{color:var(--green)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .pl-panel-row{color:#fff!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .pl-panel-row:hover{background:rgba(255,255,255,.06)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .pl-panel-row.playing{color:var(--green)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .empty-state{color:rgba(235,235,245,.4)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .empty-state .e-title{color:rgba(235,235,245,.7)!important;}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-close{
  color:#fff!important;background:rgba(255,255,255,.12)!important;box-shadow:none!important;
}
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-play{
  background:#fff!important;color:#111!important;
}
/* 播放页底部 dock · 暗色去掉浅色渐变 */
html[data-mode=&quot;dark&quot;] .fp-dock,
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-dock{
  background:linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,.88) 28%, rgba(0,0,0,.98) 100%)!important;
}
html[data-mode=&quot;dark&quot;] .fp-dock .fp-quick button,
html[data-mode=&quot;dark&quot;] .fp-dock .fp-ctrl-btn,
html[data-mode=&quot;dark&quot;] .fp-dock .fp-quality-btn{
  color:#fff!important;
}
html[data-mode=&quot;dark&quot;] .fp-dock .fp-time{color:rgba(235,235,245,.5)!important;}
html[data-mode=&quot;dark&quot;] .fp-dock .fp-play{
  background:#fff!important;color:#111!important;
  box-shadow:0 6px 20px rgba(0,0,0,.45)!important;
}
html[data-mode=&quot;dark&quot;] .fp-dock .fp-play svg{color:#111!important;}

/* ============================================================
   赛博霓虹模式 · cyber neon（沉浸加强）
   ============================================================ */
html[data-mode=&quot;neon&quot;]{
  --bg-0:#03010a;--bg-1:#06031a;--bg-2:#0e0828;--bg-elevated:#160e32;
  --glass:rgba(0,240,255,0.08);--glass-strong:rgba(12,6,32,0.88);
  --glass-border:rgba(0,255,255,0.32);--line:rgba(255,0,170,0.28);
  --text-0:#f5f9ff;--text-1:rgba(210,235,255,0.9);--text-2:rgba(180,205,235,0.72);
  --green:#00f6ff;
  --green-dim:#00c8d8;
  --green-glow:rgba(0,246,255,0.55);
  --accent-rgb:0,246,255;
  --gold:#ff2bd6;
  --danger:#ff4d8a;
}
html[data-mode=&quot;neon&quot;],
html[data-mode=&quot;neon&quot;] body{
  background:#03010a!important;color:var(--text-0)!important;
}
html[data-mode=&quot;neon&quot;] body{
  background:#03010a!important;
}
/* 动态霓虹氛围层 */
html[data-mode=&quot;neon&quot;] #ambientBg{
  background:
    radial-gradient(ellipse 95% 70% at 8% -5%, rgba(255,0,170,0.55) 0%, transparent 52%),
    radial-gradient(ellipse 85% 65% at 100% 5%, rgba(0,246,255,0.42) 0%, transparent 52%),
    radial-gradient(ellipse 80% 60% at 85% 95%, rgba(120,40,255,0.48) 0%, transparent 55%),
    radial-gradient(ellipse 70% 50% at 5% 90%, rgba(0,255,180,0.28) 0%, transparent 50%),
    radial-gradient(ellipse 50% 40% at 50% 50%, rgba(80,20,160,0.25) 0%, transparent 70%),
    linear-gradient(165deg, #0c0620 0%, #03010a 40%, #0a0418 100%)!important;
  animation:neonAmbientPulse 8s ease-in-out infinite alternate;
  filter:saturate(1.35);
}
@keyframes neonAmbientPulse{
  0%{ filter:saturate(1.2) brightness(0.95); transform:scale(1); }
  100%{ filter:saturate(1.55) brightness(1.08); transform:scale(1.03); }
}
html[data-mode=&quot;neon&quot;] #ambientVeil{
  background:
    linear-gradient(180deg, rgba(3,1,10,.25) 0%, rgba(3,1,10,.08) 35%, rgba(3,1,10,.45) 100%),
    repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,246,255,.03) 2px, rgba(0,246,255,.03) 3px)!important;
  opacity:1!important;
}
/* 扫描线 + 暗角 */
html[data-mode=&quot;neon&quot;] #grain{
  opacity:1!important;
  background:
    repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 3px,
      rgba(0,0,0,.18) 3px,
      rgba(0,0,0,.18) 4px
    ),
    radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,.55) 100%)!important;
  mix-blend-mode:overlay;
  pointer-events:none;
  animation:neonScan 9s linear infinite;
}
@keyframes neonScan{
  0%{ background-position:0 0, center; }
  100%{ background-position:0 120px, center; }
}
html[data-mode=&quot;neon&quot;] #topbar{
  background:linear-gradient(180deg,rgba(3,1,10,.95) 0%,rgba(3,1,10,.4) 70%,rgba(3,1,10,0) 100%)!important;
}
html[data-mode=&quot;neon&quot;] .search-box{
  background:rgba(0,246,255,0.07)!important;
  border:1px solid rgba(0,246,255,0.4)!important;
  box-shadow:
    0 0 0 1px rgba(255,43,214,0.12),
    0 0 18px rgba(0,246,255,0.18),
    inset 0 0 16px rgba(255,0,170,0.06)!important;
}
html[data-mode=&quot;neon&quot;] .search-box.focused{
  background:rgba(0,246,255,0.12)!important;
  border-color:rgba(0,246,255,0.7)!important;
  box-shadow:
    0 0 0 2px rgba(0,246,255,0.25),
    0 0 28px rgba(0,246,255,0.35),
    0 0 40px rgba(255,43,214,0.2)!important;
}
html[data-mode=&quot;neon&quot;] .brand-mark{
  background:linear-gradient(135deg, #ff2bd6 0%, #7a3cff 45%, #00f6ff 100%)!important;
  box-shadow:
    0 0 20px rgba(0,246,255,.55),
    0 0 36px rgba(255,43,214,.4)!important;
  animation:neonLogoGlow 3s ease-in-out infinite alternate;
}
@keyframes neonLogoGlow{
  0%{ box-shadow:0 0 16px rgba(0,246,255,.45), 0 0 28px rgba(255,43,214,.3); }
  100%{ box-shadow:0 0 28px rgba(0,246,255,.7), 0 0 48px rgba(255,43,214,.5); }
}
html[data-mode=&quot;neon&quot;] .sec-title{
  color:#f5f9ff!important;
  text-shadow:0 0 16px rgba(0,246,255,.35), 0 0 2px rgba(255,255,255,.3);
  letter-spacing:0.02em;
}
html[data-mode=&quot;neon&quot;] .sec-more{
  color:#00f6ff!important;
  text-shadow:0 0 12px rgba(0,246,255,.55);
}
html[data-mode=&quot;neon&quot;] .nav-item.active{
  color:#03010a!important;
  background:linear-gradient(120deg,#00f6ff,#ff2bd6)!important;
  box-shadow:0 0 20px rgba(0,246,255,.45)!important;
}
html[data-mode=&quot;neon&quot;] #bottomNav{
  background:rgba(6,3,18,0.96)!important;
  border-top:1px solid rgba(0,246,255,0.28)!important;
  box-shadow:0 -4px 24px rgba(0,246,255,.12)!important;
}
html[data-mode=&quot;neon&quot;] #bottomNav .nav-item.active{
  color:#00f6ff!important;
  background:rgba(0,246,255,0.14)!important;
  box-shadow:0 0 16px rgba(0,246,255,.28), inset 0 0 12px rgba(0,246,255,.08)!important;
}
html[data-mode=&quot;neon&quot;] #bottomNav .nav-item.active svg{
  color:#00f6ff!important;
  filter:drop-shadow(0 0 6px rgba(0,246,255,.7));
}
/* 主按钮 */
html[data-mode=&quot;neon&quot;] .login-btn-primary,
html[data-mode=&quot;neon&quot;] .hero-play,
html[data-mode=&quot;neon&quot;] .pb-play,
html[data-mode=&quot;neon&quot;] .fp-play,
html[data-mode=&quot;neon&quot;] .daily-card .dc-play,
html[data-mode=&quot;neon&quot;] .detail-play-all,
html[data-mode=&quot;neon&quot;] .card-cover .play-fab,
html[data-mode=&quot;neon&quot;] #ytmApiSave{
  background:linear-gradient(135deg,#00f6ff 0%,#8a4dff 50%,#ff2bd6 100%)!important;
  color:#03010a!important;border:none!important;
  box-shadow:
    0 0 22px rgba(0,246,255,.55),
    0 0 40px rgba(255,43,214,.3)!important;
}
html[data-mode=&quot;neon&quot;] .login-btn-primary svg,
html[data-mode=&quot;neon&quot;] .hero-play svg,
html[data-mode=&quot;neon&quot;] .pb-play svg,
html[data-mode=&quot;neon&quot;] .fp-play svg,
html[data-mode=&quot;neon&quot;] .daily-card .dc-play svg,
html[data-mode=&quot;neon&quot;] .card-cover .play-fab svg{color:#03010a!important;}
html[data-mode=&quot;neon&quot;] .login-btn-guest,
html[data-mode=&quot;neon&quot;] .hot-search-tag,
html[data-mode=&quot;neon&quot;] #searchEmptyBack{
  background:rgba(0,246,255,0.08)!important;color:#e8f7ff!important;
  border:1px solid rgba(0,246,255,0.38)!important;
  box-shadow:0 0 12px rgba(0,246,255,.15)!important;
}
html[data-mode=&quot;neon&quot;] .hot-search-tag:hover{
  border-color:rgba(255,43,214,0.55)!important;
  box-shadow:0 0 16px rgba(255,43,214,.25)!important;
}
/* 音源 */
html[data-mode=&quot;neon&quot;] #sourceTabs.sr-tabs{
  background:rgba(12,6,32,0.8)!important;
  border:1px solid rgba(0,246,255,0.35)!important;
  box-shadow:0 0 20px rgba(255,0,170,0.15), inset 0 0 20px rgba(0,246,255,0.05)!important;
}
html[data-mode=&quot;neon&quot;] #sourceTabs .sr-indicator{
  background:linear-gradient(120deg,#00f6ff,#ff2bd6)!important;
  box-shadow:0 0 18px rgba(0,246,255,.6), 0 0 28px rgba(255,43,214,.3)!important;
}
html[data-mode=&quot;neon&quot;] #sourceTabs .sr-tab.active[data-src],
html[data-mode=&quot;neon&quot;] #sourceTabs .sr-tab.active[data-src=&quot;qq&quot;],
html[data-mode=&quot;neon&quot;] #sourceTabs .sr-tab.active[data-src=&quot;kuwo&quot;],
html[data-mode=&quot;neon&quot;] #sourceTabs .sr-tab.active[data-src=&quot;netease&quot;],
html[data-mode=&quot;neon&quot;] #sourceTabs .sr-tab.active[data-src=&quot;kugou&quot;],
html[data-mode=&quot;neon&quot;] #sourceTabs .sr-tab.active[data-src=&quot;ytmusic&quot;]{
  color:#03010a!important;background:transparent!important;
}
/* 列表 / 卡片 */
html[data-mode=&quot;neon&quot;] .card-cover{
  box-shadow:0 0 0 1px rgba(0,246,255,0.2), 0 8px 24px rgba(0,0,0,.35)!important;
}
html[data-mode=&quot;neon&quot;] .card:hover .card-cover,
html[data-mode=&quot;neon&quot;] .rank-card:hover{
  box-shadow:0 0 0 1px rgba(0,246,255,0.45), 0 0 20px rgba(0,246,255,.2)!important;
}
html[data-mode=&quot;neon&quot;] .song-row:hover{
  background:rgba(0,246,255,0.06)!important;
}
html[data-mode=&quot;neon&quot;] .song-row.playing{
  background:linear-gradient(90deg, rgba(0,246,255,0.14), rgba(255,43,214,0.08))!important;
  box-shadow:inset 3px 0 0 #00f6ff;
}
html[data-mode=&quot;neon&quot;] .song-row.playing .song-title,
html[data-mode=&quot;neon&quot;] .song-row.playing .song-idx{
  color:#00f6ff!important;
  text-shadow:0 0 10px rgba(0,246,255,.5);
}
html[data-mode=&quot;neon&quot;] .tag-sq{
  border-color:rgba(0,246,255,.65)!important;color:#00f6ff!important;
  text-shadow:0 0 6px rgba(0,246,255,.4);
}
html[data-mode=&quot;neon&quot;] .daily-card{
  position:relative!important;
  border:1px solid rgba(0,246,255,0.4)!important;
  box-shadow:
    0 0 0 1px rgba(255,43,214,0.15),
    0 0 28px rgba(0,246,255,.22),
    0 0 40px rgba(255,0,170,.12),
    0 12px 32px rgba(0,0,0,.4)!important;
  overflow:hidden!important;
}
/* 霓虹边框光效 */
html[data-mode=&quot;neon&quot;] .daily-card::before{
  content:&quot;&quot;!important;
  position:absolute!important;inset:0!important;border-radius:inherit!important;
  pointer-events:none!important;z-index:3!important;
  background:
    linear-gradient(90deg, rgba(0,246,255,.85) 0%, transparent 28%, transparent 72%, rgba(255,43,214,.75) 100%) top / 100% 1.5px no-repeat,
    linear-gradient(90deg, rgba(255,43,214,.75) 0%, transparent 28%, transparent 72%, rgba(0,246,255,.85) 100%) bottom / 100% 1.5px no-repeat,
    linear-gradient(180deg, rgba(0,246,255,.85) 0%, transparent 30%, transparent 70%, rgba(255,43,214,.7) 100%) left / 1.5px 100% no-repeat,
    linear-gradient(180deg, rgba(255,43,214,.75) 0%, transparent 30%, transparent 70%, rgba(0,246,255,.85) 100%) right / 1.5px 100% no-repeat!important;
  opacity:.9;
}
/* 四角霓虹折线 */
html[data-mode=&quot;neon&quot;] .daily-card::after{
  content:&quot;&quot;!important;
  position:absolute!important;inset:6px!important;border-radius:12px!important;
  pointer-events:none!important;z-index:3!important;
  background:
    linear-gradient(#00f6ff,#00f6ff) top left / 18px 2px no-repeat,
    linear-gradient(#00f6ff,#00f6ff) top left / 2px 18px no-repeat,
    linear-gradient(#ff2bd6,#ff2bd6) top right / 18px 2px no-repeat,
    linear-gradient(#ff2bd6,#ff2bd6) top right / 2px 18px no-repeat,
    linear-gradient(#ff2bd6,#ff2bd6) bottom left / 18px 2px no-repeat,
    linear-gradient(#ff2bd6,#ff2bd6) bottom left / 2px 18px no-repeat,
    linear-gradient(#00f6ff,#00f6ff) bottom right / 18px 2px no-repeat,
    linear-gradient(#00f6ff,#00f6ff) bottom right / 2px 18px no-repeat!important;
  filter:drop-shadow(0 0 4px rgba(0,246,255,.6));
  opacity:.95;
}
/* 霓虹模式下重绘卡片渐变底色 */
html[data-mode=&quot;neon&quot;] .daily-card.daily30,
html[data-mode=&quot;neon&quot;] .daily-card.daily30.period-morning,
html[data-mode=&quot;neon&quot;] .daily-card.daily30.period-noon,
html[data-mode=&quot;neon&quot;] .daily-card.daily30.period-evening,
html[data-mode=&quot;neon&quot;] .daily-card.daily30.ne-skin{
  background:
    linear-gradient(135deg, rgba(0,246,255,0.25) 0%, transparent 40%),
    linear-gradient(225deg, rgba(255,43,214,0.3) 0%, transparent 45%),
    linear-gradient(160deg, #0a1a3a 0%, #1a0a32 45%, #0c1830 100%)!important;
}
html[data-mode=&quot;neon&quot;] .daily-card.period-morning,
html[data-mode=&quot;neon&quot;] .daily-card.period-noon,
html[data-mode=&quot;neon&quot;] .daily-card.period-evening,
html[data-mode=&quot;neon&quot;] .daily-card.ne-skin,
html[data-mode=&quot;neon&quot;] .daily-card:not(.daily30){
  background:
    linear-gradient(135deg, rgba(255,43,214,0.28) 0%, transparent 42%),
    linear-gradient(225deg, rgba(0,246,255,0.22) 0%, transparent 48%),
    linear-gradient(155deg, #1a0830 0%, #0a1228 50%, #14082a 100%)!important;
}
html[data-mode=&quot;neon&quot;] .daily-card .dc-title{
  color:#fff!important;
  text-shadow:0 0 12px rgba(0,246,255,.4), 0 0 2px rgba(255,255,255,.4)!important;
}
html[data-mode=&quot;neon&quot;] .daily-card .dc-sub{
  color:rgba(200,230,255,.88)!important;
}
html[data-mode=&quot;neon&quot;] .daily-card .dc-play{
  background:linear-gradient(135deg,#00f6ff,#ff2bd6)!important;
  color:#03010a!important;
  box-shadow:0 0 16px rgba(0,246,255,.5), 0 0 28px rgba(255,43,214,.3)!important;
}
html[data-mode=&quot;neon&quot;] .daily-card .dc-play svg{color:#03010a!important;}
html[data-mode=&quot;neon&quot;] .daily-card .dc-art-inner{
  box-shadow:0 0 0 1px rgba(0,246,255,0.35), 0 0 14px rgba(0,246,255,.25)!important;
}
html[data-mode=&quot;neon&quot;] .daily-card .dc-vinyl{
  box-shadow:0 0 16px rgba(255,43,214,.25)!important;
}
html[data-mode=&quot;neon&quot;] .daily-card.is-playing{
  box-shadow:
    0 0 0 1.5px rgba(0,246,255,0.65),
    0 0 32px rgba(0,246,255,.35),
    0 0 48px rgba(255,43,214,.2),
    0 12px 32px rgba(0,0,0,.4)!important;
}
html[data-mode=&quot;neon&quot;] .daily-card.is-playing::before{
  opacity:1;
  filter:brightness(1.2);
}
/* 迷你播放条 · 强霓虹 */
html[data-mode=&quot;neon&quot;] #playerBar{
  background:rgba(8,4,22,0.78)!important;
  /* 去掉 border-image：会破坏圆角，形成长方形描边 */
  border:1px solid rgba(0,246,255,0.18)!important;
  border-image:none!important;
  background-clip:padding-box!important;
  box-shadow:
    0 0 28px rgba(0,246,255,.22),
    0 0 48px rgba(255,0,170,.12),
    0 12px 32px rgba(0,0,0,.45)!important;
  backdrop-filter:blur(32px) saturate(1.6)!important;
  -webkit-backdrop-filter:blur(32px) saturate(1.6)!important;
  animation:neonBarPulse 4s ease-in-out infinite alternate;
}
@keyframes neonBarPulse{
  0%{ box-shadow:0 0 22px rgba(0,246,255,.18), 0 0 40px rgba(255,0,170,.10), 0 12px 32px rgba(0,0,0,.45); }
  100%{ box-shadow:0 0 32px rgba(0,246,255,.30), 0 0 56px rgba(255,0,170,.18), 0 12px 32px rgba(0,0,0,.45); }
}
html[data-mode=&quot;neon&quot;] #playerBar::before{
  background:linear-gradient(135deg,
    rgba(0,246,255,0.18) 0%,
    rgba(255,43,214,0.2) 45%,
    rgba(120,40,255,0.14) 100%)!important;
  opacity:1!important;animation:none!important;
}
html[data-mode=&quot;neon&quot;] .pb-title{
  text-shadow:0 0 8px rgba(0,246,255,.25);
}
html[data-mode=&quot;neon&quot;] .pb-bar-fill,
html[data-mode=&quot;neon&quot;] .fp-bar-fill,
html[data-mode=&quot;neon&quot;] .pb-mini-progress-fill{
  background:linear-gradient(90deg,#00f6ff,#ff2bd6 70%,#b44dff)!important;
  box-shadow:0 0 10px rgba(0,246,255,.6), 0 0 18px rgba(255,43,214,.3)!important;
}
html[data-mode=&quot;neon&quot;] .pb-bar-knob,
html[data-mode=&quot;neon&quot;] .fp-bar-knob{
  background:#fff!important;
  box-shadow:0 0 12px rgba(0,246,255,.85), 0 0 20px rgba(255,43,214,.4)!important;
}
html[data-mode=&quot;neon&quot;] .pb-play{
  animation:neonBtnPulse 2.4s ease-in-out infinite alternate;
}
@keyframes neonBtnPulse{
  0%{ box-shadow:0 0 16px rgba(0,246,255,.4), 0 0 28px rgba(255,43,214,.2); }
  100%{ box-shadow:0 0 28px rgba(0,246,255,.65), 0 0 44px rgba(255,43,214,.35); }
}
/* 全屏播放 · 沉浸 */
html[data-mode=&quot;neon&quot;] #fullPlayer{background:#03010a!important;color:#f5f9ff!important;}
html[data-mode=&quot;neon&quot;] #fpBg{
  background:
    radial-gradient(ellipse 100% 70% at 15% 0%, rgba(255,0,170,0.5) 0%, transparent 50%),
    radial-gradient(ellipse 90% 65% at 95% 15%, rgba(0,246,255,0.42) 0%, transparent 52%),
    radial-gradient(ellipse 80% 55% at 50% 100%, rgba(120,40,255,0.4) 0%, transparent 55%),
    radial-gradient(ellipse 50% 40% at 50% 45%, rgba(40,10,80,0.35) 0%, transparent 70%),
    linear-gradient(165deg, #140828 0%, #03010a 45%, #0a0418 100%)!important;
  animation:neonAmbientPulse 7s ease-in-out infinite alternate;
}
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-track-name{
  color:#fff!important;
  text-shadow:0 0 20px rgba(0,246,255,.45), 0 0 40px rgba(255,43,214,.2);
}
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-track-artist{color:rgba(190,230,255,.65)!important;}
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-tab{color:rgba(180,200,230,.4)!important;}
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-tab.active{
  color:#00f6ff!important;border-color:#ff2bd6!important;
  text-shadow:0 0 14px rgba(0,246,255,.55);
  box-shadow:0 2px 0 0 #ff2bd6;
}
html[data-mode=&quot;neon&quot;] #fullPlayer .lyric-line{color:rgba(150,175,210,.32)!important;}
html[data-mode=&quot;neon&quot;] #fullPlayer .lyric-line:hover{color:rgba(200,230,255,.7)!important;}
html[data-mode=&quot;neon&quot;] #fullPlayer .lyric-line.active{
  color:#fff!important;
  text-shadow:0 0 18px rgba(0,246,255,.45), 0 0 28px rgba(255,43,214,.2);
}
html[data-mode=&quot;neon&quot;] #fullPlayer .lyric-line.active .lyric-tr{
  color:#ff2bd6!important;text-shadow:0 0 10px rgba(255,43,214,.5);
}
html[data-mode=&quot;neon&quot;] #fullPlayer .lyric-tr{color:rgba(150,175,210,.32)!important;}
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-time{color:rgba(180,210,240,.55)!important;}
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-bar{background:rgba(0,246,255,.18)!important;}
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-ctrl-btn{color:rgba(210,235,255,.9)!important;}
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-quick button{color:rgba(210,235,255,.8)!important;}
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-quick button.on{
  color:#ff4d8a!important;filter:drop-shadow(0 0 6px rgba(255,77,138,.6));
}
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-close{
  color:#00f6ff!important;background:rgba(0,246,255,.14)!important;
  border:1px solid rgba(0,246,255,.35)!important;
  box-shadow:0 0 14px rgba(0,246,255,.3)!important;
}
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-play{
  background:linear-gradient(135deg,#00f6ff,#ff2bd6)!important;color:#03010a!important;
  box-shadow:0 0 28px rgba(0,246,255,.55), 0 0 48px rgba(255,43,214,.3)!important;
}
html[data-mode=&quot;neon&quot;] .fp-dock,
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-dock{
  background:linear-gradient(180deg, rgba(3,1,10,0) 0%, rgba(3,1,10,.92) 28%, rgba(3,1,10,.98) 100%)!important;
}
html[data-mode=&quot;neon&quot;] .fp-dock .fp-quick button,
html[data-mode=&quot;neon&quot;] .fp-dock .fp-ctrl-btn,
html[data-mode=&quot;neon&quot;] .fp-dock .fp-quality-btn{color:#eef7ff!important;}
html[data-mode=&quot;neon&quot;] .fp-dock .fp-time{color:rgba(180,210,240,.55)!important;}
html[data-mode=&quot;neon&quot;] .fp-dock .fp-play{
  background:linear-gradient(135deg,#00f6ff,#ff2bd6)!important;color:#03010a!important;
  box-shadow:0 0 26px rgba(0,246,255,.55)!important;
}
html[data-mode=&quot;neon&quot;] .fp-dock .fp-play svg{color:#03010a!important;}
html[data-mode=&quot;neon&quot;] #fullPlayer .pl-panel-row{
  color:rgba(240,248,255,.95)!important;
}
html[data-mode=&quot;neon&quot;] #fullPlayer .pl-panel-row &gt; span{
  color:inherit!important;
}
/* 时长：压过 inline color:var(--text-2) */
html[data-mode=&quot;neon&quot;] #fullPlayer .pl-panel-row &gt; span:last-child{
  color:rgba(190,215,245,.78)!important;
}
html[data-mode=&quot;neon&quot;] #fullPlayer .pl-panel-row &gt; span:first-child{
  color:rgba(200,220,255,.8)!important;
}
html[data-mode=&quot;neon&quot;] #fullPlayer .pl-panel-row:hover{
  background:rgba(0,246,255,.1)!important;
  color:#fff!important;
}
html[data-mode=&quot;neon&quot;] #fullPlayer .pl-panel-row.playing,
html[data-mode=&quot;neon&quot;] #fullPlayer .pl-panel-row.playing &gt; span{
  color:#00f6ff!important;
  text-shadow:0 0 10px rgba(0,246,255,.4);
}
html[data-mode=&quot;neon&quot;] #fullPlayer .pl-panel-row.playing &gt; span:last-child{
  color:rgba(0,246,255,.9)!important;
}
html[data-mode=&quot;neon&quot;] #fullPlayer #playlistPanel,
html[data-mode=&quot;neon&quot;] #fullPlayer .pl-panel,
html[data-mode=&quot;neon&quot;] #fullPlayer .pl-list{
  color:rgba(240,248,255,.95)!important;
}
/* 非激活 tab 也略提亮，便于辨认 */
html[data-mode=&quot;neon&quot;] #fullPlayer .fp-tab{
  color:rgba(200,220,245,.55)!important;
}
html[data-mode=&quot;neon&quot;] .queue-sheet{
  background:rgba(8,4,20,.97)!important;
  border:1px solid rgba(0,246,255,.3)!important;
  box-shadow:0 -10px 40px rgba(0,246,255,.15), 0 -4px 24px rgba(255,0,170,.1)!important;
}
html[data-mode=&quot;neon&quot;] .queue-sheet-row.playing{
  color:#00f6ff!important;text-shadow:0 0 8px rgba(0,246,255,.4);
}
html[data-mode=&quot;neon&quot;] .avatar-btn{
  border:1.5px solid rgba(0,246,255,.5)!important;
  box-shadow:0 0 14px rgba(255,43,214,.3), 0 0 20px rgba(0,246,255,.2)!important;
}
html[data-mode=&quot;neon&quot;] .login-card{
  background:rgba(12,6,28,0.82)!important;
  border:1px solid rgba(0,246,255,0.38)!important;
  box-shadow:
    0 0 0 1px rgba(255,43,214,0.15),
    0 0 48px rgba(0,246,255,.18),
    0 0 64px rgba(255,0,170,.12),
    0 24px 80px rgba(0,0,0,.55)!important;
}
/* 封面外圈轻微霓虹 */
html[data-mode=&quot;neon&quot;] .fp-art .fp-vinyl{
  box-shadow:
    0 0 0 1px rgba(0,246,255,0.25),
    0 0 32px rgba(0,246,255,0.2),
    0 0 48px rgba(255,43,214,0.12),
    0 16px 40px rgba(0,0,0,.4)!important;
}
html[data-mode=&quot;neon&quot;] .mini-disc{
  box-shadow:
    0 0 0 1px rgba(0,246,255,0.35),
    0 0 16px rgba(0,246,255,0.3),
    0 6px 18px rgba(0,0,0,.4)!important;
}

*{box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{height:100%;margin:0;background:#0b0b0f;color:var(--text-0);
  font-family:var(--font-body);overscroll-behavior:none;-webkit-user-select:none;user-select:none;
  overflow-x:hidden;max-width:100vw;width:100%;touch-action:pan-y;}
body{position:relative;overflow:hidden;overflow-x:hidden;touch-action:pan-y;
  background:
    radial-gradient(110% 80% at 50% -20%, rgba(var(--accent-rgb),0.18) 0%, transparent 55%),
    radial-gradient(90% 60% at 100% 30%, rgba(88,70,160,0.14) 0%, transparent 50%),
    radial-gradient(80% 50% at 0% 80%, rgba(40,90,160,0.12) 0%, transparent 45%),
    #0b0b0f;}
::-webkit-scrollbar{width:0;height:0;}
img{-webkit-user-drag:none;max-width:100%;}
button{font-family:inherit;border:none;background:none;color:inherit;cursor:pointer;outline:none;
  transition:transform .35s var(--ease-spring), opacity .2s var(--ease);}
button:active{transform:scale(0.94);opacity:.88;}
a{color:inherit;text-decoration:none;}
input{font-family:inherit;color:inherit;background:none;border:none;outline:none;}

/* ---- Apple 弹性动效体系 ---- */
@keyframes amFadeUp{
  from{opacity:0;transform:translate3d(0,16px,0);}
  to{opacity:1;transform:none;}
}
@keyframes amPop{
  0%{opacity:0;transform:scale(.92);}
  70%{transform:scale(1.03);}
  100%{opacity:1;transform:scale(1);}
}
@keyframes amTabIn{
  from{opacity:0;transform:translate3d(0,8px,0);}
  to{opacity:1;transform:none;}
}
.view.active .sec,
.view.active .daily-row,
.view.active .hscroll,
.view.active .grid-cols,
.view.active .song-list{
  animation:amFadeUp .48s var(--ease-smooth) both;
}
.view.active .sec:nth-child(1){animation-delay:.02s;}
.view.active .sec:nth-child(2){animation-delay:.06s;}
.view.active .sec:nth-child(3){animation-delay:.1s;}
.view.active .sec:nth-child(4){animation-delay:.14s;}
.view.active .sec:nth-child(5){animation-delay:.18s;}
.card,.rank-card,.radio-card,.mv-card,.daily-card{
  transition:transform .4s var(--ease-spring), box-shadow .3s var(--ease);
}
.card:active,.rank-card:active,.radio-card:active,.mv-card:active,.daily-card:active{
  transform:scale(0.96);
}
.card-cover,.daily-card .dc-art-inner{
  transition:transform .45s var(--ease-spring);
}
.nav-item{
  transition:transform .35s var(--ease-spring), background .25s var(--ease), color .2s;
}
.nav-item:active{transform:scale(0.92);}
.nav-item.active{transform:scale(1);}
#bottomNav .nav-item.active svg,
#bottomNav .nav-item.active span{transition:transform .4s var(--ease-spring);}
.avatar-btn{transition:transform .4s var(--ease-spring);}
.avatar-btn:active{transform:scale(0.9);}
.search-box{transition:background .25s var(--ease);}
.search-box.focused{transform:none;}
.song-row{transition:background .2s var(--ease), transform .3s var(--ease-spring);}
.song-row:active{transform:scale(0.985);}
#toast{
  transition:transform .45s var(--ease-spring), opacity .3s var(--ease)!important;
}
#playerBar{
  transition:transform .45s var(--ease-spring), opacity .3s var(--ease);
}
#playerBar.show{animation:none;}
#fullPlayer.show{
  opacity:1!important;pointer-events:auto!important;transform:translate3d(0,0,0);visibility:visible!important;
}
#fullPlayer:not(.show){
  opacity:0!important;pointer-events:none!important;visibility:hidden!important;
}
#fullPlayer:not(.show) *{
  pointer-events:none!important;
}
.fp-play,.pb-play{
  transition:transform .4s var(--ease-spring), background .2s, box-shadow .3s!important;
}
.fp-play:active,.pb-play:active{transform:scale(0.9)!important;}
.fp-ctrl-btn,.pb-ctrl-btn,.fp-quick button{
  transition:transform .35s var(--ease-spring), color .2s!important;
}
.fp-ctrl-btn:active,.pb-ctrl-btn:active,.fp-quick button:active{transform:scale(0.88)!important;}
.fp-tab,.sr-tab{
  transition:transform .35s var(--ease-spring), color .2s, border-color .2s, background .2s;
}
.fp-tab:active,.sr-tab:active{transform:scale(0.94);}
.login-card{animation:amPop .5s var(--ease-spring) both;}
.hero-play,.login-btn,.detail-play-all{
  transition:transform .4s var(--ease-spring), opacity .2s, box-shadow .3s!important;
}
.hero-play:active,.login-btn:active,.detail-play-all:active{transform:scale(0.95)!important;}
.brand-mark{transition:transform .4s var(--ease-spring);}
.brand-mark:active{transform:scale(0.9);}
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{
    animation-duration:.01ms!important;
    animation-iteration-count:1!important;
    transition-duration:.01ms!important;
  }
}


/* 首页氛围：固定多色交织渐变（无光球动画，减卡顿） */
#ambientBg{
  position:fixed;inset:0;z-index:0;pointer-events:none;
  overflow:hidden;
  background:
    radial-gradient(ellipse 90% 70% at 10% 5%, rgba(255,120,160,0.55) 0%, transparent 55%),
    radial-gradient(ellipse 80% 65% at 95% 8%, rgba(100,150,255,0.50) 0%, transparent 55%),
    radial-gradient(ellipse 75% 60% at 85% 90%, rgba(160,120,255,0.48) 0%, transparent 55%),
    radial-gradient(ellipse 70% 55% at 5% 88%, rgba(60,200,160,0.42) 0%, transparent 55%),
    radial-gradient(ellipse 55% 45% at 48% 48%, rgba(255,180,100,0.28) 0%, transparent 58%),
    linear-gradient(165deg, #1a1218 0%, #12161e 40%, #121a18 70%, #161218 100%);
}
#ambientVeil{
  position:fixed;inset:0;z-index:1;pointer-events:none;
  background:
    linear-gradient(180deg,
      rgba(12,12,18,.42) 0%,
      rgba(12,12,18,.22) 22%,
      rgba(12,12,18,.12) 45%,
      rgba(12,12,18,.28) 72%,
      rgba(12,12,18,.55) 100%);
}
#grain{position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.028;mix-blend-mode:overlay;
  background-image:url(&quot;data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' width='120' height='120'&gt;&lt;filter id='n'&gt;&lt;feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/&gt;&lt;/filter&gt;&lt;rect width='100%25' height='100%25' filter='url(%23n)'/&gt;&lt;/svg&gt;&quot;);}

#app{position:relative;z-index:2;height:100%;display:flex;flex-direction:column;overflow-x:hidden;max-width:100vw;width:100%;background:transparent;}

/* ---------- glass primitives ---------- */
.glass{background:var(--glass);backdrop-filter:blur(var(--blur-1));-webkit-backdrop-filter:blur(var(--blur-1));
  border:1px solid var(--glass-border);}
.glass-strong{background:var(--glass-strong);backdrop-filter:blur(var(--blur-2));-webkit-backdrop-filter:blur(var(--blur-2));
  border:1px solid var(--glass-border);}

/* ============================================================
   LOGIN
   ============================================================ */
#loginView{position:fixed;inset:0;z-index:220;display:flex;align-items:center;justify-content:center;
  background:
    radial-gradient(100% 70% at 50% 0%, rgba(var(--accent-rgb),0.35) 0%, transparent 55%),
    radial-gradient(80% 50% at 20% 90%, rgba(90,60,160,0.28) 0%, transparent 50%),
    radial-gradient(70% 40% at 90% 70%, rgba(40,100,180,0.2) 0%, transparent 45%),
    #121218;}
#loginView.hidden{display:none;}
.login-card{width:380px;max-width:88vw;padding:40px 34px 30px;border-radius:24px;
  background:rgba(40,40,46,0.55);backdrop-filter:blur(60px) saturate(1.6);-webkit-backdrop-filter:blur(60px) saturate(1.6);
  border:1px solid rgba(255,255,255,0.14);box-shadow:0 24px 80px rgba(0,0,0,.4), 0 1px 0 rgba(255,255,255,.08) inset;
  display:flex;flex-direction:column;align-items:center;}
.login-title{font-size:22px;font-weight:700;letter-spacing:-0.3px;margin-bottom:4px;}
.login-sub{font-size:13px;color:var(--text-2);margin-bottom:26px;}
.login-pane-cookie{display:flex;flex-direction:column;align-items:stretch;width:100%;gap:0;}
.login-actions{display:flex;gap:12px;width:100%;margin-top:14px;}
.login-btn{flex:1;padding:14px 0;border-radius:980px;font-weight:600;font-size:16px;
  transition:transform .28s var(--ease-spring), opacity .2s, box-shadow .25s, background .2s, color .2s, border-color .2s;}
.login-btn:active{transform:scale(.97);}
.login-btn[disabled]{opacity:.5;pointer-events:none;}
.login-btn-primary{background:#fff;color:#111;
  box-shadow:0 8px 28px rgba(0,0,0,.28), 0 1px 0 rgba(255,255,255,.35) inset;}
.login-btn-primary:hover{box-shadow:0 10px 32px rgba(0,0,0,.34), 0 1px 0 rgba(255,255,255,.4) inset;}
.login-btn-guest{background:rgba(255,255,255,.08);color:var(--text-0);
  border:1px solid rgba(255,255,255,.22);
  box-shadow:none;}
.login-btn-guest:hover{background:rgba(255,255,255,.14);}
.login-hint{font-size:11px;color:var(--text-2);line-height:1.7;margin-top:14px;text-align:center;padding:0 6px;}
.login-hint b{color:var(--gold);}
.cookie-area{width:100%;height:110px;padding:12px 14px;border-radius:var(--radius-s);background:rgba(255,255,255,.05);
  border:1px solid var(--line);font-size:12px;line-height:1.6;resize:none;-webkit-user-select:text;user-select:text;
  box-sizing:border-box;}
.cookie-area:focus{border-color:var(--green);background:rgba(255,255,255,.07);}
.cookie-area::placeholder{color:var(--text-2);}

/* ============================================================
   TOP NAV / LAYOUT
   ============================================================ */
#topbar{position:relative;z-index:10;display:grid;
  grid-template-columns:36px minmax(0,1fr) 36px;align-items:center;column-gap:12px;
  padding:calc(12px + var(--safe-t)) 16px 12px;flex-shrink:0;
  background:linear-gradient(180deg,rgba(0,0,0,.72) 0%,rgba(0,0,0,0) 100%);}
.brand{display:flex;align-items:center;justify-content:center;flex-shrink:0;grid-column:1;width:36px;height:36px;}
.brand-mark{
  width:36px;height:36px;border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  line-height:0;
  position:relative;overflow:hidden;
  background:linear-gradient(160deg, rgba(var(--accent-rgb),1) 0%, rgba(var(--accent-rgb),0.82) 100%);
  box-shadow:inset 0 1px 0 rgba(255,255,255,0.28);
  border:none;
  cursor:pointer;
  -webkit-user-select:none;user-select:none;
  transition:transform .28s var(--ease-spring), box-shadow .25s ease, filter .25s ease;
}
.brand-mark::before{
  content:&quot;&quot;;position:absolute;inset:0;border-radius:inherit;pointer-events:none;
  background:linear-gradient(180deg, rgba(255,255,255,0.22) 0%, transparent 48%);
  opacity:.9;
}
.brand-mark::after{display:none!important;content:none!important;}
.brand-mark svg{
  width:20px;height:20px;position:relative;z-index:1;
  color:#fff;
  display:block;
  /* 音符符头偏左下，光学上往右上微移，在方块里才真正居中 */
  transform:translate(0.5px, 0.5px);
  transform-origin:50% 50%;
  filter:none;
  transition:transform .25s var(--ease-spring);
}
.brand-mark:active{transform:scale(0.9);box-shadow:inset 0 1px 0 rgba(255,255,255,0.2);}
.brand-mark:active svg{transform:translate(0.5px, 0.5px) scale(0.92);}
.brand-name{display:none!important;}
.brand-mark .logo-hint{
  position:absolute;left:50%;bottom:-18px;transform:translateX(-50%);
  font-size:10px;color:var(--text-2);white-space:nowrap;opacity:0;pointer-events:none;
  transition:opacity .25s;z-index:2;
}
.brand-mark.show-hint .logo-hint{opacity:1;}
#mainNav{display:none;} /* 顶栏隐藏；底栏仅 TV 显示 */
.nav-item{padding:8px 16px;font-size:14px;color:var(--text-1);border-radius:980px;
  transition:transform .35s var(--ease-spring), background .25s var(--ease), color .2s;position:relative;font-weight:500;}
.nav-item:hover{color:var(--text-0);background:rgba(255,255,255,.08);}
.nav-item.active{color:#111;background:rgba(255,255,255,.92);font-weight:600;
  box-shadow:0 4px 16px rgba(0,0,0,.22);}
/* 底栏：手机隐藏，TV 显示 */
#bottomNav{
  display:none;position:relative;z-index:18;flex-shrink:0;
  flex-direction:row;align-items:stretch;justify-content:space-around;
  padding:8px 12px calc(12px + var(--safe-b));
  background:rgba(12,12,16,0.94);border-top:1px solid rgba(255,255,255,0.10);
  backdrop-filter:blur(20px) saturate(1.3);-webkit-backdrop-filter:blur(20px) saturate(1.3);
  box-sizing:border-box;max-width:100%;width:100%;
}
#bottomNav .nav-item{
  flex:1;min-width:0;border:none;cursor:pointer;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:12px 6px 10px;border-radius:14px;background:transparent;box-shadow:none;
  color:rgba(235,235,245,0.45);font-size:14px;font-weight:500;line-height:1.2;text-align:center;
}
#bottomNav .nav-item svg{width:28px;height:28px;margin-bottom:4px;opacity:0.85;color:inherit;}
#bottomNav .nav-item.active{color:var(--green);background:rgba(var(--accent-rgb),0.14);box-shadow:none;font-weight:600;}
#bottomNav .nav-item.active svg{opacity:1;color:var(--green);}
html[data-mode=&quot;dark&quot;] #bottomNav{background:rgba(0,0,0,0.96);border-top-color:rgba(255,255,255,0.08);}
html[data-mode=&quot;dark&quot;] #bottomNav .nav-item.active{color:#fff!important;background:rgba(255,255,255,0.12)!important;}
html[data-mode=&quot;dark&quot;] #bottomNav .nav-item.active svg{color:#fff!important;}
html:not(.tv-mode) #bottomNav{display:none!important;}
html.tv-mode #bottomNav{display:flex!important;}
/* display:contents 让搜索框与头像参与顶栏三列网格，搜索视觉居中 */
#topActions{display:contents;}
#mainNav{grid-column:1/-1;display:none;}
.search-box{display:flex;align-items:center;gap:9px;padding:0 14px;height:36px;box-sizing:border-box;
  border-radius:999px;min-width:0;width:100%;grid-column:2;
  background:rgba(255,255,255,0.10)!important;
  border:1px solid rgba(255,255,255,0.08)!important;
  backdrop-filter:blur(20px) saturate(1.15);-webkit-backdrop-filter:blur(20px) saturate(1.15);
  box-shadow:none;
  transition:background .2s ease, border-color .2s ease, box-shadow .2s ease;}
.search-box.focused{
  background:rgba(255,255,255,0.16)!important;
  border-color:rgba(255,255,255,0.18)!important;
  box-shadow:0 0 0 2px rgba(var(--accent-rgb),0.22)!important;
}
.search-box svg{width:15px;height:15px;flex-shrink:0;color:rgba(235,235,245,0.45);transition:color .2s;}
.search-box.focused svg{color:rgba(235,235,245,0.75);}
.search-box input{flex:1;min-width:0;font-size:15px;line-height:1.3;color:var(--text-0);
  font-weight:400;letter-spacing:-0.1px;
  -webkit-user-select:text;user-select:text;
  pointer-events:auto;touch-action:manipulation;background:transparent;border:0;outline:none;}
.search-box input::placeholder{
  color:rgba(235,235,245,0.42);
  font-size:14.5px;font-weight:400;
  opacity:1;
}
.search-box input::-webkit-input-placeholder{
  color:rgba(235,235,245,0.42);
  font-size:14.5px;
  opacity:1;
}
.search-box input::-moz-placeholder{
  color:rgba(235,235,245,0.42);
  font-size:14.5px;
  opacity:1;
}
.search-box input:disabled{opacity:.6;}
.avatar-btn{width:36px;height:36px;border-radius:50%;overflow:hidden;flex-shrink:0;
  grid-column:3;justify-self:center;align-self:center;
  border:1.5px solid rgba(255,255,255,0.14);
  background:rgba(255,255,255,0.08);
  background-image:url(&quot;data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ffffff' opacity='0.4'&gt;&lt;circle cx='12' cy='8' r='4'/&gt;&lt;path d='M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7z'/&gt;&lt;/svg&gt;&quot;);
  background-size:55%;background-repeat:no-repeat;background-position:center 42%;
  box-sizing:border-box;cursor:pointer;
  box-shadow:0 0 0 0.5px rgba(0,0,0,0.2);}
.avatar-btn img{width:100%;height:100%;object-fit:cover;display:block;}
.avatar-btn img.img-err{opacity:0;}

#viewport{flex:1;position:relative;overflow:hidden;overflow-x:hidden;max-width:100%;width:100%;}
.view{position:absolute;inset:0;overflow-y:auto;overflow-x:hidden;padding:6px 28px calc(92px + var(--safe-b));background:transparent;
  opacity:0;pointer-events:none;transform:translate3d(0,14px,0);
  transition:opacity .38s var(--ease-smooth),transform .48s var(--ease-spring);
  max-width:100%;width:100%;-webkit-overflow-scrolling:touch;}
.view.active{opacity:1;pointer-events:auto;transform:translate3d(0,0,0);}

/* section headers · Apple Music large titles */
.sec{margin:28px 0 12px;}
.sec-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px;}
.sec-title{font-size:22px;font-weight:700;letter-spacing:-0.2px;display:flex;align-items:center;gap:8px;}
.sec-title .dot{width:0;height:0;opacity:0;display:none;}
.sec-more{font-size:15px;color:var(--green);display:flex;align-items:center;gap:3px;font-weight:500;}


/* ---------- 每日推荐 / Daily 30 卡片 ---------- */
.daily-row{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-top:6px;}
.daily-card{position:relative;border-radius:18px;overflow:hidden;min-height:148px;
  display:flex;align-items:stretch;cursor:pointer;
  background:linear-gradient(135deg,#5B9DFF 0%,#7EB6FF 55%,#A8D0FF 100%);
  box-shadow:0 8px 24px rgba(0,0,0,.20);transition:transform .2s var(--ease), background .35s var(--ease), box-shadow .35s var(--ease);}
.daily-card:active{transform:scale(.98);}
.daily-card.daily30{background:linear-gradient(135deg,#3D7CFF 0%,#6AA1FF 50%,#9EC5FF 100%);}
/* 按时段变色：晨 / 午 / 晚（网易红 ne-skin 优先覆盖） */
.daily-card.period-morning{
  background:linear-gradient(135deg,#FF9A4D 0%,#FFB86C 45%,#FFD19A 100%);
  box-shadow:0 6px 22px rgba(255,140,60,.28);}
.daily-card.daily30.period-morning{
  background:linear-gradient(135deg,#FF7A2F 0%,#FF9A4D 50%,#FFC07A 100%);
  box-shadow:0 6px 22px rgba(255,122,47,.30);}
.daily-card.period-noon{
  background:linear-gradient(135deg,#3D9BFF 0%,#6BB5FF 50%,#A8D4FF 100%);
  box-shadow:0 6px 22px rgba(61,155,255,.26);}
.daily-card.daily30.period-noon{
  background:linear-gradient(135deg,#1E7AE8 0%,#4A9CFF 50%,#8FC4FF 100%);
  box-shadow:0 6px 22px rgba(30,122,232,.28);}
.daily-card.period-evening{
  background:linear-gradient(135deg,#7B5CFF 0%,#9B7CFF 45%,#C4A8FF 100%);
  box-shadow:0 6px 22px rgba(123,92,255,.28);}
.daily-card.daily30.period-evening{
  background:linear-gradient(135deg,#5B3FD4 0%,#7B5CFF 50%,#A88CFF 100%);
  box-shadow:0 6px 22px rgba(91,63,212,.30);}
.daily-card.ne-skin{
  background:linear-gradient(135deg,#E84545 0%,#F06A6A 55%,#F5A0A0 100%);
  box-shadow:0 6px 22px rgba(236,65,65,.28);}
.daily-card.daily30.ne-skin{
  background:linear-gradient(135deg,#C62828 0%,#E53935 50%,#EF9A9A 100%);
  box-shadow:0 6px 22px rgba(198,40,40,.30);}
.daily-card .dc-body{flex:1;padding:16px 12px 14px 16px;display:flex;flex-direction:column;justify-content:space-between;min-width:0;z-index:1;}
.daily-card .dc-title{font-size:17px;font-weight:700;color:#fff;letter-spacing:-0.2px;line-height:1.28;}
.daily-card .dc-sub{font-size:12px;color:rgba(255,255,255,.85);margin-top:6px;line-height:1.45;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.daily-card .dc-play{width:38px;height:38px;border-radius:50%;background:#fff;color:#111;
  display:flex;align-items:center;justify-content:center;margin-top:12px;
  box-shadow:0 4px 16px rgba(0,0,0,.22), 0 1px 0 rgba(255,255,255,.5) inset;border:none;
  transition:background .2s var(--ease), color .2s, transform .35s var(--ease-spring), box-shadow .25s;}
.daily-card .dc-play svg{width:15px;height:15px;margin-left:1.5px;}
.daily-card .dc-play.is-playing{background:#fff;color:#111;}
.daily-card .dc-play.is-playing svg{margin-left:0;}
.daily-card.is-playing{box-shadow:0 6px 24px rgba(0,0,0,.28), 0 0 0 1.5px rgba(255,255,255,.35);}
.daily-card .dc-art{width:42%;max-width:130px;position:relative;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;padding:12px 10px 12px 0;}
.daily-card .dc-art-inner{width:100%;aspect-ratio:1;border-radius:10px;overflow:hidden;
  box-shadow:0 6px 18px rgba(0,0,0,.30);background:#1c1c1e;position:relative;}
.daily-card .dc-art-inner img{width:100%;height:100%;object-fit:cover;display:block;}
.daily-card .dc-art-inner img.img-err{opacity:0;}
.daily-card .dc-vinyl{position:absolute;right:-18%;top:50%;width:70%;aspect-ratio:1;border-radius:50%;
  background:radial-gradient(circle at 40% 40%,#444 0%,#111 60%,#000 100%);
  transform:translateY(-50%);z-index:0;opacity:.9;}
.daily-foot{display:flex;justify-content:space-between;gap:12px;margin-top:12px;padding:0 2px;}
.daily-foot .df-item{flex:1;min-width:0;}
.daily-foot .df-name{font-size:13px;color:var(--text-0);font-weight:500;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.daily-foot .df-sub{font-size:12px;color:var(--text-2);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
@media (max-width:860px){
  .daily-row{grid-template-columns:1fr 1fr;gap:10px;}
  .daily-card{min-height:132px;border-radius:14px;}
  .daily-card .dc-title{font-size:16px;}
  .daily-card .dc-sub{font-size:11px;}
  .daily-card .dc-play{width:32px;height:32px;}
  .daily-card .dc-art{width:40%;max-width:110px;}
}

/* ---------- hero carousel ---------- */
.hero{position:relative;height:340px;border-radius:var(--radius-l);overflow:hidden;margin-top:4px;touch-action:pan-y;
  box-shadow:0 12px 40px rgba(0,0,0,.35);}
.hero-track{position:absolute;inset:0;display:flex;transition:transform .35s var(--ease);will-change:transform;}
.hero-slide{position:relative;flex:0 0 100%;height:100%;background-size:cover;background-position:center;background-color:var(--bg-2);}
.hero-slide::after{content:&quot;&quot;;position:absolute;inset:0;
  background:linear-gradient(0deg,rgba(8,12,10,.92) 0%,rgba(8,12,10,.35) 55%,rgba(8,12,10,.1) 100%);}
.hero-info{position:absolute;left:36px;bottom:32px;right:36px;z-index:2;}
.hero-tag{display:inline-block;padding:4px 10px;border-radius:6px;background:rgba(255,255,255,.18);color:#fff;
  font-size:11px;font-weight:600;margin-bottom:12px;backdrop-filter:blur(8px);}
.hero-title{font-size:32px;font-weight:700;margin:0 0 8px;letter-spacing:-0.5px;text-shadow:0 2px 16px rgba(0,0,0,.45);max-width:60%;}
.hero-desc{font-size:13px;color:var(--text-1);max-width:52%;line-height:1.6;margin-bottom:16px;
  overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;}
.hero-play{display:inline-flex;align-items:center;gap:8px;padding:11px 22px;border-radius:980px;
  background:rgba(255,255,255,.95);border:none;color:#111;
  font-size:14px;font-weight:600;letter-spacing:-0.2px;
  box-shadow:0 6px 24px rgba(0,0,0,.28), 0 1px 0 rgba(255,255,255,.5) inset;
  transition:transform .28s var(--ease-spring), opacity .2s, box-shadow .25s;}
.hero-play:hover{box-shadow:0 8px 28px rgba(0,0,0,.34);}
.hero-play:active{transform:scale(.96);opacity:.92;}
.hero-play svg{width:14px;height:14px;}
.hero-dots{position:absolute;right:36px;bottom:34px;z-index:2;display:flex;gap:6px;}
.hero-dot{width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.35);transition:all .3s var(--ease);}
.hero-dot.active{width:6px;border-radius:50%;background:#fff;transform:scale(1.25);}

/* ---------- horizontal scroller ---------- */
.hscroll{display:flex;gap:16px;overflow-x:auto;overflow-y:hidden;scroll-behavior:smooth;padding-bottom:6px;margin:0;
  width:100%;max-width:100%;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;}
.hscroll::-webkit-scrollbar{display:none;}

/* ---------- playlist / album card ---------- */
.card{flex:0 0 auto;width:150px;cursor:pointer;}
.card-cover{position:relative;width:150px;height:150px;border-radius:14px;overflow:hidden;
  background:linear-gradient(145deg,#2c2c2e,#1c1c1e);transition:transform .22s var(--ease);
  box-shadow:0 4px 14px rgba(0,0,0,.22);}
.card-cover::before{content:&quot;&quot;;position:absolute;inset:0;background:url(&quot;data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23FC3C44' opacity='0.3'&gt;&lt;path d='M9 3v11.6A3.5 3.5 0 1 0 11 18V8h6V5h-2V3z'/&gt;&lt;/svg&gt;&quot;) center/28% no-repeat;pointer-events:none;z-index:0;}
.card:hover .card-cover{transform:scale(1.02);}
.card-cover img{width:100%;height:100%;object-fit:cover;display:block;position:relative;z-index:1;background:transparent;}
.card-cover img.img-err{opacity:0;}
.grid-cols .card{width:100%;}
.grid-cols .card-cover{width:100%;height:auto;aspect-ratio:1/1;}
.card-cover .play-fab{position:absolute;right:8px;bottom:8px;width:36px;height:36px;border-radius:50%;
  background:#fff;display:flex;align-items:center;justify-content:center;opacity:0;
  transform:scale(.7);transition:transform .4s var(--ease-spring), opacity .25s var(--ease);
  box-shadow:0 6px 18px rgba(0,0,0,.32), 0 1px 0 rgba(255,255,255,.5) inset;}
.card:hover .play-fab{opacity:1;transform:scale(1);}
.card-cover .play-fab svg{width:14px;height:14px;color:#000;margin-left:1px;}
.card-cover .plays{position:absolute;left:8px;top:8px;font-size:11px;background:rgba(0,0,0,.45);
  backdrop-filter:blur(10px);padding:3px 8px;border-radius:100px;display:flex;align-items:center;gap:3px;font-weight:500;}
.card-cover .plays svg{width:9px;height:9px;}
.card-name{font-size:13px;margin-top:8px;line-height:1.4;color:var(--text-0);font-weight:500;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.card-sub{font-size:11.5px;color:var(--text-2);margin-top:2px;line-height:1.35;}
.card.round .card-cover{border-radius:50%;}

/* ---------- 搜索歌手横排：头像 + 底部名字 ---------- */
.singer-hscroll{display:flex;gap:14px;overflow-x:auto;overflow-y:hidden;padding:4px 2px 10px;margin:0;-webkit-overflow-scrolling:touch;scroll-behavior:smooth;}
.singer-hscroll::-webkit-scrollbar{display:none;}
.singer-chip{flex:0 0 auto;width:76px;display:flex;flex-direction:column;align-items:center;cursor:pointer;text-align:center;}
.singer-chip-avatar{width:68px;height:68px;border-radius:50%;overflow:hidden;background:linear-gradient(145deg,#2c2c2e,#1c1c1e);box-shadow:0 4px 14px rgba(0,0,0,.22);border:1.5px solid rgba(255,255,255,.1);}
.singer-chip-avatar img{width:100%;height:100%;object-fit:cover;display:block;}
.singer-chip-name{font-size:12px;color:var(--text-0);margin-top:8px;line-height:1.3;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:500;}
.singer-chip:active{opacity:.85;transform:scale(.96);}
@media (max-width:860px){
  .singer-chip{width:70px;}
  .singer-chip-avatar{width:62px;height:62px;}
  .singer-chip-name{font-size:11px;}
}

/* ---------- ranked list (toplist) ---------- */
.rank-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;}
.rank-card{display:flex;align-items:center;gap:13px;padding:12px;border-radius:var(--radius-m);cursor:pointer;
  transition:background .2s var(--ease);}
.rank-card:hover{background:var(--glass);}
.rank-cover{width:52px;height:52px;border-radius:10px;overflow:hidden;flex-shrink:0;position:relative;background:linear-gradient(145deg,#1a2a22,#0d1512);}
.rank-cover img{width:100%;height:100%;object-fit:cover;background:transparent;}
.rank-name{font-size:13.5px;font-weight:600;}
.rank-desc{font-size:11px;color:var(--text-2);margin-top:3px;}
.rank-num{font-family:var(--font-num);font-size:15px;font-weight:800;color:var(--text-2);width:20px;text-align:center;flex-shrink:0;}
.rank-num.top1{color:var(--green);}
.rank-num.top2{color:#ff9f0a;}
.rank-num.top3{color:#ffd60a;}

/* ---------- song row (in playlist / search) ---------- */
.song-list{display:flex;flex-direction:column;}
.song-row{display:flex;align-items:center;gap:14px;padding:11px 12px;border-radius:12px;cursor:pointer;transition:background .16s;}
.song-row:hover{background:rgba(255,255,255,.06);}
.song-row.playing{background:rgba(var(--accent-rgb),.1);}
.song-row.playing .song-title{color:var(--green);}
.song-idx{width:22px;text-align:center;font-size:15px;color:var(--text-2);font-family:var(--font-num);flex-shrink:0;font-weight:500;}
.song-row.playing .song-idx{color:var(--green);}
.song-cover{width:44px;height:44px;border-radius:8px;overflow:hidden;flex-shrink:0;background:var(--bg-2);}
.song-cover img{width:100%;height:100%;object-fit:cover;}
.song-meta{flex:1;min-width:0;}
.song-title{font-size:16px;color:var(--text-0);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:flex;align-items:center;gap:6px;font-weight:400;letter-spacing:-0.2px;}
.song-sub{font-size:13px;color:var(--text-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:2px;}
.tag-sq{font-size:9px;padding:1px 5px;border-radius:4px;border:1px solid rgba(var(--accent-rgb),.45);color:var(--green);flex-shrink:0;font-weight:600;}
.tag-vip{font-size:9px;padding:1px 5px;border-radius:4px;flex-shrink:0;font-weight:700;letter-spacing:0.02em;
  background:var(--gold);color:#1c1200;}
/* VIP 标签随音源变色 */
.tag-vip.vip-qq,.tag-vip[data-src=&quot;qq&quot;]{
  background:linear-gradient(135deg,#3ad48a,#28a86a);color:#fff;}
.tag-vip.vip-kuwo,.tag-vip[data-src=&quot;kuwo&quot;]{
  background:linear-gradient(135deg,#ffc43a,#e09a00);color:#1c1200;}
.tag-vip.vip-netease,.tag-vip[data-src=&quot;netease&quot;]{
  background:linear-gradient(135deg,#f05555,#d32f2f);color:#fff;}
.tag-vip.vip-kugou,.tag-vip[data-src=&quot;kugou&quot;]{
  background:linear-gradient(135deg,#33b8ff,#0088cc);color:#fff;}
.tag-vip.vip-ytmusic,.tag-vip[data-src=&quot;ytmusic&quot;]{
  background:linear-gradient(135deg,#ff3355,#cc0029);color:#fff;}
/* 跟随当前全局强调色（无 source 时） */
.tag-vip.vip-theme{
  background:rgba(var(--accent-rgb),0.92);color:#fff;}

.song-dur{font-size:13px;color:var(--text-2);font-family:var(--font-num);flex-shrink:0;min-width:42px;margin-left:auto;text-align:right;padding-right:2px;}
.song-actions{display:none!important;}

.grid-cols{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:16px 14px;}

.empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:70px 20px;color:var(--text-2);gap:10px;text-align:center;}
.empty-state svg{width:40px;height:40px;opacity:.4;}
.empty-state .e-title{font-size:13.5px;color:var(--text-1);}
.empty-state .e-sub{font-size:11.5px;}

.skeleton{background:linear-gradient(100deg,var(--glass) 30%,var(--glass-strong) 50%,var(--glass) 70%);
  background-size:200% 100%;animation:shimmer 1.6s ease-in-out infinite;}
@keyframes shimmer{0%{background-position:150% 0;}100%{background-position:-50% 0;}}

/* ============================================================
   MINI PLAYER BAR
   ============================================================ */
#playerBar{
  position:relative;z-index:20;flex-shrink:0;display:flex;align-items:center;gap:12px;
  padding:12px 16px 12px;
  margin:0 12px calc(10px + var(--safe-b));width:auto;
  border-radius:999px;
  /* 磨砂玻璃：半透明底 + 强模糊 */
  border:1px solid rgba(255,255,255,.16);
  border-top:1px solid rgba(255,255,255,.20);
  background:rgba(28,28,32,0.55);
  backdrop-filter:blur(36px) saturate(1.4) brightness(1.02);
  -webkit-backdrop-filter:blur(36px) saturate(1.4) brightness(1.02);
  box-shadow:
    0 10px 28px rgba(0,0,0,.32),
    0 1px 0 rgba(255,255,255,.14) inset,
    0 -1px 0 rgba(0,0,0,.10) inset;
  transform:translateY(100%);
  transition:transform .4s var(--ease);
  max-width:100%;overflow:visible;box-sizing:border-box;
  min-height:64px;
  isolation:isolate;
}
#playerBar &gt; *{position:relative;z-index:1;}
/* 彩色渐变层：更淡，透出磨砂感，仍做呼吸 */
#playerBar::before{
  content:&quot;&quot;;
  position:absolute;inset:0;border-radius:inherit;z-index:0;pointer-events:none;
  background:linear-gradient(135deg,
    rgba(255,255,255,0.08) 0%,
    rgba(var(--accent-rgb),0.12) 50%,
    rgba(255,255,255,0.04) 100%);
  background-size:100% 100%;
  opacity:.85;
  animation:none;
}
@keyframes pbBarBreathe{
  0%,100%{
    background-position:0% 40%;
    opacity:.55;
    filter:saturate(.95) brightness(.98);
  }
  50%{
    background-position:100% 60%;
    opacity:.82;
    filter:saturate(1.15) brightness(1.06);
  }
}
@media (prefers-reduced-motion: reduce){
  #playerBar::before{animation:none!important;opacity:.7;filter:none;background-position:50% 50%;}
}
#playerBar.show{transform:translateY(0);}

/* ---- 迷你栏：浮层居中；原盘在流式布局内略超出上下，不跑出屏幕 ---- */
#playerBar{
  position:fixed!important;
  left:50%!important;
  right:auto!important;
  bottom:calc(12px + var(--safe-b))!important;
  z-index:30!important;
  flex-shrink:0;
  display:flex!important;
  justify-content:flex-start!important;
  align-items:center!important;
  gap:10px!important;
  padding:6px 12px 6px 4px!important;
  min-height:52px!important;
  height:52px!important;
  width:min(400px, calc(100% - 36px))!important;
  max-width:min(400px, calc(100% - 36px))!important;
  margin:0!important;
  box-sizing:border-box!important;
  overflow:visible!important;
  pointer-events:none;
  opacity:0;
  transform:translate(-50%, 140%)!important;
  transition:
    transform .55s cubic-bezier(0.22, 1, 0.36, 1),
    opacity .4s cubic-bezier(0.22, 1, 0.36, 1)!important;
}
#playerBar.show{
  pointer-events:auto;
  opacity:1;
  transform:translate(-50%, 0)!important;
}
/* 迷你黑胶：精致多层盘片 · 细密沟槽 + 镜面高光 + 中心标签 */
#playerBar .pb-cover{
  display:block!important;
  position:relative!important;
  left:auto!important;
  top:auto!important;
  width:76px!important;
  height:76px!important;
  margin: -14px 0 -14px -24px!important;
  border-radius:50%!important;
  flex-shrink:0!important;
  overflow:hidden!important;
  cursor:pointer;
  z-index:2;
  /* 盘体：深炭黑 + 微冷灰层次 + 左上主高光 */
  background:
    radial-gradient(circle at 32% 28%, rgba(255,255,255,.16) 0%, transparent 28%),
    radial-gradient(circle at 70% 72%, rgba(255,255,255,.04) 0%, transparent 32%),
    radial-gradient(circle at 50% 50%,
      #2a2a30 0%,
      #1a1a20 38%,
      #121216 62%,
      #0a0a0e 82%,
      #060608 100%)!important;
  box-shadow:
    0 6px 20px rgba(0,0,0,.55),
    0 2px 6px rgba(0,0,0,.35),
    0 0 0 1px rgba(255,255,255,.12),
    0 0 0 2px rgba(0,0,0,.35),
    inset 0 1px 1px rgba(255,255,255,.12),
    inset 0 -2px 4px rgba(0,0,0,.45)!important;
  animation:pbDiscSpin 18s linear infinite;
  animation-play-state:paused;
  will-change:transform;
}
/* 沟槽环：细密交错明暗，模拟真实黑胶纹路 */
#playerBar .pb-cover::before{
  content:&quot;&quot;;
  position:absolute;inset:0;border-radius:50%;pointer-events:none;z-index:2;
  background:
    repeating-radial-gradient(circle at center,
      transparent 0 1.5px,
      rgba(255,255,255,.045) 1.5px 2px),
    repeating-radial-gradient(circle at center,
      transparent 0 3.5px,
      rgba(0,0,0,.28) 3.5px 4px),
    repeating-radial-gradient(circle at center,
      transparent 0 7px,
      rgba(255,255,255,.03) 7px 7.5px);
  -webkit-mask:radial-gradient(circle at center, transparent 0 28%, #000 29% 96%, transparent 100%);
  mask:radial-gradient(circle at center, transparent 0 28%, #000 29% 96%, transparent 100%);
  opacity:.95;
}
/* 镜面扫光弧 + 外缘细金属边 + 中心轴孔暗示 */
#playerBar .pb-cover::after{
  content:&quot;&quot;!important;
  display:block!important;
  position:absolute;inset:0;border-radius:50%;pointer-events:none;z-index:4;
  background:
    /* 斜向高光带 */
    conic-gradient(from 210deg at 50% 50%,
      transparent 0deg,
      rgba(255,255,255,.0) 18deg,
      rgba(255,255,255,.14) 38deg,
      rgba(255,255,255,.04) 52deg,
      transparent 70deg,
      transparent 200deg,
      rgba(255,255,255,.06) 230deg,
      transparent 260deg,
      transparent 360deg),
    /* 外缘细亮环 */
    radial-gradient(circle at center,
      transparent 0 47%,
      rgba(255,255,255,.18) 48.2%,
      transparent 49.5%,
      transparent 100%);
  opacity:.85;
  mix-blend-mode:screen;
}
/* 中心封面标签：约 56%，带内外双环 */
#playerBar .pb-cover img{
  position:absolute!important;
  left:50%!important;top:50%!important;
  width:56%!important;height:56%!important;
  margin:0!important;
  transform:translate(-50%,-50%)!important;
  object-fit:cover!important;
  border-radius:50%!important;
  border:2px solid rgba(255,255,255,.14)!important;
  z-index:3!important;
  background:
    radial-gradient(circle at 40% 35%, #3a3a42 0%, #1e1e24 100%)!important;
  opacity:1!important;
  display:block!important;
  box-shadow:
    0 0 0 1px rgba(0,0,0,.5),
    0 0 0 3px rgba(18,18,22,.95),
    inset 0 1px 0 rgba(255,255,255,.12);
}
#playerBar .pb-cover img.img-err{ opacity:0!important; }
#playerBar .pb-cover.spin{
  animation-play-state:running!important;
}
#playerBar .pb-cover.spin img{ animation:none!important; }
@keyframes pbDiscSpin{
  from{ transform:rotate(0deg); }
  to{ transform:rotate(360deg); }
}
#playerBar .pb-meta{
  display:flex!important;
  flex-direction:column!important;
  justify-content:center!important;
  flex:1 1 0!important;
  min-width:0!important;
  max-width:none!important;
  padding:0 6px 0 6px!important;
  overflow:hidden!important;
  cursor:pointer;
  position:relative;z-index:3;
  height:100%;
}
#playerBar .pb-meta-info{
  display:flex;flex-direction:column;justify-content:center;
  min-width:0;overflow:hidden;
  transition:opacity .35s ease, transform .35s ease;
}
#playerBar .pb-meta-info.is-hidden{
  position:absolute;opacity:0;pointer-events:none;
  transform:translateY(-6px);
}
#playerBar .pb-lyric{
  display:none;
  font-size:14px;font-weight:600;line-height:1.35;
  color:#fff;
  text-align:center;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  text-shadow:0 1px 4px rgba(0,0,0,.55);
  letter-spacing:-0.1px;
  width:100%;
}
#playerBar .pb-lyric.is-on{
  display:block;
  animation:pbLyricIn .35s ease both;
}
#playerBar .pb-lyric .pb-lyric-tr{
  display:block;font-size:12px;font-weight:400;
  color:rgba(255,255,255,.72);margin-top:2px;
  text-align:center;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
@keyframes pbLyricIn{
  from{ opacity:0; transform:translateY(6px); }
  to{ opacity:1; transform:none; }
}
#playerBar .pb-title{
  display:block!important;
  font-size:14px!important;
  font-weight:600!important;
  color:#fff!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
  text-shadow:0 1px 3px rgba(0,0,0,.5)!important;
  line-height:1.25!important;
}
#playerBar .pb-artist{
  display:block!important;
  font-size:12px!important;
  color:rgba(255,255,255,.8)!important;
  white-space:nowrap!important;
  overflow:hidden!important;
  text-overflow:ellipsis!important;
  margin-top:2px!important;
  text-shadow:0 1px 2px rgba(0,0,0,.45)!important;
  line-height:1.2!important;
}
#playerBar .pb-play{
  width:40px!important;height:40px!important;
  margin:0 0 0 auto!important;
  flex-shrink:0!important;
  position:relative;z-index:3;
}
#playerBar .pb-play svg{width:17px!important;height:17px!important;}
#playerBar .pb-list-btn{
  width:36px!important;height:36px!important;
  color:#fff!important;
  background:rgba(255,255,255,.12)!important;
  border-radius:50%!important;
  flex-shrink:0!important;
  position:relative;z-index:3;
}
#playerBar .pb-list-btn svg{width:18px!important;height:18px!important;color:#fff!important;}
#playerBar .pb-mini-progress{left:12px;right:12px;border-radius:999px;}
#playerBar [hidden]{display:none!important;}
@media (max-width:400px){
  #playerBar{
    width:min(100%, calc(100% - 24px))!important;
    max-width:calc(100% - 24px)!important;
    gap:10px!important;
    padding:5px 10px 5px 4px!important;
    height:50px!important;
    min-height:50px!important;
  }
  #playerBar .pb-cover{
    width:68px!important;height:68px!important;
    margin:-12px 0 -12px -22px!important;
    /* 勿写 transform:none，否则小屏下胶片无法旋转 */
  }
  #playerBar .pb-title{font-size:13px!important;}
  #playerBar .pb-artist{font-size:11px!important;}
  #playerBar .pb-play{width:36px!important;height:36px!important;}
  #playerBar .pb-list-btn{width:34px!important;height:34px!important;}
}

/* 底部为悬浮迷你播放器留出空间（胶片盖住胶囊约 72px + 底边距），避免挡住末行内容 */
#app &gt; #viewport .view,
.view{
  padding-bottom:calc(92px + var(--safe-b))!important;
}
@media (max-width:860px){
  .view{padding-bottom:calc(88px + var(--safe-b))!important;}
}
html.tv-mode .view{padding-bottom:calc(102px + var(--safe-b))!important;}


/* 底部播放列表弹层 */
.queue-sheet-mask{
  position:fixed;inset:0;z-index:40;
  background:rgba(0,0,0,.45);
  opacity:0;pointer-events:none;
  transition:opacity .28s ease;
}
.queue-sheet-mask.show{opacity:1;pointer-events:auto;}
.queue-sheet{
  position:fixed;left:0;right:0;bottom:0;z-index:41;
  max-height:min(72vh, 560px);
  background:rgba(28,28,32,.96);
  backdrop-filter:blur(28px) saturate(1.4);
  -webkit-backdrop-filter:blur(28px) saturate(1.4);
  border-radius:18px 18px 0 0;
  border:1px solid rgba(255,255,255,.12);
  border-bottom:none;
  box-shadow:0 -12px 40px rgba(0,0,0,.4);
  transform:translateY(105%);
  transition:transform .38s cubic-bezier(0.22,1,0.36,1);
  display:flex;flex-direction:column;
  padding:0 0 calc(12px + var(--safe-b));
  color:#fff;
  pointer-events:none;
  touch-action:pan-y;
  will-change:transform;
}
.queue-sheet.show{transform:translateY(0);pointer-events:auto;}
.queue-sheet.dragging{transition:none!important;}
.queue-sheet-handle{
  width:36px;height:4px;border-radius:4px;
  background:rgba(255,255,255,.28);
  margin:10px auto 6px;flex-shrink:0;
  /* 扩大可拖热区 */
  position:relative;
}
.queue-sheet-handle::after{
  content:&quot;&quot;;position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  width:80px;height:28px;
}
.queue-sheet-head{
  display:flex;align-items:center;gap:10px;
  padding:6px 16px 12px;flex-shrink:0;
}
.queue-sheet-title{
  flex:1;font-size:16px;font-weight:700;letter-spacing:-0.2px;
}
.queue-sheet-title span{font-weight:500;color:rgba(235,235,245,.55);font-size:14px;margin-left:4px;}
.queue-sheet-mode,.queue-sheet-close{
  width:36px;height:36px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  color:rgba(235,235,245,.85);background:rgba(255,255,255,.08);
  font-size:22px;line-height:1;border:none;cursor:pointer;
}
.queue-sheet-mode svg{width:18px;height:18px;}
.queue-sheet-list{
  flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;
  padding:0 8px 8px;min-height:0;
}
.queue-sheet-row{
  display:flex;align-items:center;gap:10px;
  padding:12px 10px;border-radius:12px;cursor:pointer;
  transition:background .15s;
}
.queue-sheet-row:active,.queue-sheet-row:hover{background:rgba(255,255,255,.06);}
.queue-sheet-row.playing{color:var(--green);}
.queue-sheet-row .qs-idx{width:24px;text-align:center;font-size:13px;color:rgba(235,235,245,.4);flex-shrink:0;}
.queue-sheet-row.playing .qs-idx{color:var(--green);}
.queue-sheet-row .qs-meta{flex:1;min-width:0;}
.queue-sheet-row .qs-name{font-size:15px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.queue-sheet-row .qs-sub{font-size:12px;color:rgba(235,235,245,.45);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.queue-sheet-row .qs-dur{font-size:12px;color:rgba(235,235,245,.4);flex-shrink:0;}
.queue-sheet-empty{padding:40px 20px;text-align:center;color:rgba(235,235,245,.4);font-size:14px;}
html[data-mode=&quot;dark&quot;] .queue-sheet{background:rgba(0,0,0,.96);}
html[data-mode=&quot;dark&quot;] .pb-title{color:#fff!important;text-shadow:0 1px 3px rgba(0,0,0,.7);}
html[data-mode=&quot;dark&quot;] .pb-artist{color:rgba(255,255,255,.8)!important;text-shadow:0 1px 2px rgba(0,0,0,.6);}

/* 胶囊迷你栏：全端统一（手机竖/横、桌面、TV） */
.pb-mini-progress{display:block;position:absolute;left:20px;right:20px;top:0;height:3px;background:rgba(255,255,255,.12);border-radius:999px 999px 0 0;overflow:hidden;width:auto;}
.pb-mini-progress-fill{height:100%;width:0%;background:var(--green);border-radius:0 1.5px 1.5px 0;box-shadow:0 0 8px var(--green-glow);}
.pb-cover{width:52px;height:52px;border-radius:50%;overflow:hidden;flex-shrink:0;cursor:pointer;background:var(--bg-2);
  position:relative;box-shadow:0 3px 12px rgba(0,0,0,.38);
  background-image:url(&quot;data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23FC3C44' opacity='0.4'&gt;&lt;path d='M9 3v11.6A3.5 3.5 0 1 0 11 18V8h6V5h-2V3z'/&gt;&lt;/svg&gt;&quot;);
  background-size:45%;background-repeat:no-repeat;background-position:center;}
.pb-cover img{width:100%;height:100%;object-fit:cover;transition:transform 8s linear;display:block;}
.pb-cover img.img-err{opacity:0;}
/* 旧规则：仅转封面图。迷你栏已改为整盘（含封面）一起转，这里禁用以免双重旋转 */
.pb-cover.spin img{animation:none;}
@keyframes spin{to{transform:rotate(360deg);}}
.pb-meta{
  width:auto;flex:1 1 auto;min-width:96px;max-width:none;padding-right:8px;cursor:pointer;
  position:relative;z-index:2;overflow:hidden;
}
.pb-title{
  font-size:16px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:-0.2px;
  color:#fff!important;
  text-shadow:0 1px 3px rgba(0,0,0,.55), 0 0 12px rgba(0,0,0,.25);
}
.pb-artist{
  font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:3px;
  color:rgba(255,255,255,.82)!important;
  text-shadow:0 1px 2px rgba(0,0,0,.5);
}
.pb-like{display:none;}
.pb-like.on{color:var(--danger);}
.pb-like svg{width:18px;height:18px;}
.pb-center{
  flex:0 1 auto;display:flex;flex-direction:column;align-items:center;gap:4px;
  max-width:48%;margin:0;min-width:0;position:relative;z-index:2;
}
.pb-ctrls{display:flex;align-items:center;gap:8px;flex-shrink:1;min-width:0;}
.pb-ctrl-btn{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--text-1);
  transition:color .15s, background .2s, transform .3s var(--ease-spring);flex-shrink:0;}
.pb-ctrl-btn:hover{color:var(--text-0);background:rgba(255,255,255,.08);}
.pb-ctrl-btn svg{width:22px;height:22px;}
.pb-play{width:48px;height:48px;border-radius:50%;background:#fff;color:#111;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
  box-shadow:0 4px 18px rgba(0,0,0,.32), 0 1px 0 rgba(255,255,255,.55) inset;
  transition:transform .32s var(--ease-spring), box-shadow .25s;}
.pb-play:hover{box-shadow:0 6px 22px rgba(0,0,0,.38), 0 1px 0 rgba(255,255,255,.6) inset;}
.pb-play:active{transform:scale(.9);}
.pb-play svg{width:22px;height:22px;}
#pbQuality.pb-ctrl-btn{font-size:13px;font-weight:700;letter-spacing:0.02em;}
.pb-progress{display:none;}
.pb-time{font-size:10.5px;color:var(--text-2);font-family:var(--font-num);width:34px;flex-shrink:0;}
.pb-time.right{text-align:right;}
.pb-bar{flex:1;height:4px;border-radius:2px;background:rgba(255,255,255,.15);position:relative;cursor:pointer;}
.pb-bar-fill{position:absolute;left:0;top:0;height:100%;border-radius:2px;background:#fff;width:0%;}
.pb-bar-knob{position:absolute;top:50%;width:12px;height:12px;border-radius:50%;background:#fff;
  box-shadow:0 1px 4px rgba(0,0,0,.35);transform:translate(-50%,-50%);left:0%;opacity:0;transition:opacity .15s;}
.pb-bar:hover .pb-bar-knob{opacity:1;}
.pb-right{display:none;}
.pb-vol{display:none;align-items:center;gap:7px;width:88px;}
.pb-vol svg{width:15px;height:15px;color:var(--text-1);flex-shrink:0;}
.pb-vol-bar{flex:1;height:3px;border-radius:2px;background:var(--line);position:relative;cursor:pointer;}
.pb-vol-fill{position:absolute;left:0;top:0;height:100%;border-radius:2px;background:var(--text-1);width:80%;}
.pb-icon-btn{display:none!important;width:28px;height:28px;align-items:center;justify-content:center;color:var(--text-1);flex-shrink:0;}
.pb-icon-btn.on{color:var(--green);}
.pb-icon-btn svg{width:15px;height:15px;}

/* ============================================================
   FULL PLAYER (lyrics)
   ============================================================ */
/* 全屏浮层：实色底 + 高 z-index，避免透出底层 WebHome / 其它页面 */
#app.overlay-hidden{visibility:hidden;pointer-events:none;}
#fullPlayer{
  position:fixed;inset:0;z-index:200;display:flex;flex-direction:row;opacity:0;pointer-events:none;
  transform:translate3d(0,8%,0);transition:opacity .35s var(--ease-smooth),transform .5s var(--ease-spring);
  overflow:hidden;max-width:100vw;width:100%;
  background:transparent;color:#1c1c1e;
  /* 允许纵向拖动手势关闭；横向边缘留给系统返回，勿用 pan-x 锁死 */
  touch-action:pan-y;
}
#fullPlayer.show{opacity:1!important;pointer-events:auto!important;transform:translate3d(0,0,0);visibility:visible!important;}
/* 播放页：固定浅色多色交织渐变（无动画，杜绝闪烁） */
#fpBg{
  position:absolute;inset:0;overflow:hidden;pointer-events:none;z-index:0;
  background:
    radial-gradient(ellipse 90% 70% at 10% 5%, #ffb3c9 0%, transparent 55%),
    radial-gradient(ellipse 80% 65% at 95% 8%, #a8c8ff 0%, transparent 55%),
    radial-gradient(ellipse 75% 60% at 85% 90%, #c8b0ff 0%, transparent 55%),
    radial-gradient(ellipse 70% 55% at 5% 88%, #9aefd0 0%, transparent 55%),
    radial-gradient(ellipse 55% 45% at 48% 48%, #ffe0b0 0%, transparent 58%),
    linear-gradient(165deg, #f5e6f0 0%, #e8eef8 40%, #e8f5f0 70%, #f0e8f5 100%);
}
#fpBg::before,#fpBg::after{display:none;content:none;}
#fpOrbs{display:none!important;}

/* 顶栏：左关闭 | 中歌名↑歌手↓ 上下排列居中 | 右占位 */
.fp-topbar{
  position:absolute;left:0;right:0;top:0;z-index:5;
  display:flex;align-items:center;gap:8px;
  padding:calc(10px + var(--safe-t)) 12px 8px;
  box-sizing:border-box;pointer-events:none;
  min-height:calc(52px + var(--safe-t));
}
.fp-topbar .fp-close,
.fp-topbar .fp-track-info{pointer-events:auto;}
.fp-close{position:relative;left:auto;top:auto;flex-shrink:0;width:38px;height:38px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;color:#1c1c1e;background:rgba(255,255,255,.55);
  box-shadow:0 2px 10px rgba(0,0,0,.06);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);}
.fp-top-spacer{width:38px;height:38px;flex-shrink:0;}
.fp-topbar .fp-track-info{
  flex:1;min-width:0;max-width:none;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:0 4px;gap:2px;
}
.fp-topbar .fp-track-name{
  display:block;width:100%;
  font-size:16px;font-weight:700;line-height:1.25;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.fp-topbar .fp-track-artist{
  display:block;width:100%;
  font-size:12px;margin-top:0;line-height:1.2;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
/* 浅色播放页文字与控件 */
#fullPlayer .fp-track-name{color:#1c1c1e;}
#fullPlayer .fp-track-artist{color:rgba(60,60,67,.6);}
#fullPlayer .fp-tab{color:rgba(60,60,67,.45);}
#fullPlayer .fp-tab.active{color:#1c1c1e;border-color:var(--green);}
#fullPlayer .lyric-line{color:rgba(60,60,67,.4);}
#fullPlayer .lyric-line:hover{color:rgba(60,60,67,.7);}
#fullPlayer .lyric-line.active{color:#1c1c1e;}
#fullPlayer .lyric-line.active .lyric-tr{color:var(--green);}
#fullPlayer .lyric-tr{color:rgba(60,60,67,.4);}
#fullPlayer .fp-time{color:rgba(60,60,67,.5);}
#fullPlayer .fp-bar{background:rgba(60,60,67,.18);}
#fullPlayer .fp-bar-fill{background:#1c1c1e;}
#fullPlayer .fp-bar-knob{background:#1c1c1e;box-shadow:0 1px 4px rgba(0,0,0,.2);}
#fullPlayer .fp-ctrl-btn{color:rgba(60,60,67,.75);}
#fullPlayer .fp-quick button{color:rgba(60,60,67,.7);}
#fullPlayer .fp-quick button.on{color:var(--danger);}
#fullPlayer .fp-quality-btn{color:rgba(60,60,67,.7)!important;}
#fullPlayer .fp-speed-btn{color:rgba(60,60,67,.7)!important;}
#fullPlayer .fp-speed-btn.on{color:var(--green)!important;}
#fullPlayer .pl-panel-row{color:#1c1c1e;}
#fullPlayer .pl-panel-row:hover{background:rgba(0,0,0,.05);}
#fullPlayer .pl-panel-row.playing{color:var(--green);}
#fullPlayer .empty-state{color:rgba(60,60,67,.45);}
#fullPlayer .empty-state .e-title{color:rgba(60,60,67,.7);}
#lyricsList{transition:opacity .18s ease;}
#lyricsList.is-updating{opacity:.35;}
.fp-close svg{width:18px;height:18px;}
.fp-left{position:relative;z-index:2;width:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:calc(56px + var(--safe-t)) 28px 24px;box-sizing:border-box;min-width:0;}
/* 封面舞台：样式互斥，只有黑胶转 */
.fp-art{position:relative;display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;-webkit-user-select:none;user-select:none;}
.fp-art-stage{position:relative;width:min(340px,42vw);height:min(340px,42vw);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.fp-vinyl{width:100%;height:100%;border-radius:50%;position:relative;display:flex;align-items:center;justify-content:center;
  background:transparent;box-shadow:none;overflow:hidden;z-index:2;}
.fp-art[data-style=&quot;vinyl&quot;] .fp-vinyl{
  background:
    radial-gradient(circle at 32% 28%, rgba(255,255,255,.18) 0%, transparent 30%),
    radial-gradient(circle at 72% 78%, rgba(255,255,255,.06) 0%, transparent 34%),
    radial-gradient(circle at 50% 50%, #2a2a30 0%, #18181e 42%, #101014 70%, #0a0a0c 100%);
  box-shadow:
    0 28px 64px -18px rgba(0,0,0,.55),
    0 0 0 1px rgba(255,255,255,.12),
    inset 0 1px 2px rgba(255,255,255,.1),
    inset 0 -2px 6px rgba(0,0,0,.4);
}
/* 沟槽 + 轻光泽弧 */
.fp-vinyl .fp-groove{position:absolute;inset:0;border-radius:50%;z-index:0;pointer-events:none;
  background:
    repeating-radial-gradient(circle at center,
      rgba(255,255,255,.07) 0 1px,
      transparent 1px 3px),
    repeating-radial-gradient(circle at center,
      transparent 0 5px,
      rgba(0,0,0,.3) 5px 6px),
    conic-gradient(from 200deg at 50% 50%,
      transparent 0deg,
      rgba(255,255,255,.14) 22deg,
      transparent 48deg,
      transparent 200deg,
      rgba(255,255,255,.07) 228deg,
      transparent 260deg,
      transparent 360deg);
  -webkit-mask:radial-gradient(circle at center, transparent 0 33%, #000 34% 100%);
  mask:radial-gradient(circle at center, transparent 0 33%, #000 34% 100%);
  opacity:.95;
}
.fp-art[data-style=&quot;vinyl&quot;] .fp-vinyl img{
  width:68%;height:68%;
  border:5px solid rgba(255,255,255,.12);
  box-shadow:0 0 0 1px rgba(0,0,0,.35);
}
.fp-vinyl img{width:86%;height:86%;border-radius:50%;object-fit:cover;position:relative;z-index:2;
  border:none;background:linear-gradient(145deg,#1a2a22,#0d1512);
  background-image:url(&quot;data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23FC3C44' opacity='0.4'&gt;&lt;path d='M9 3v11.6A3.5 3.5 0 1 0 11 18V8h6V5h-2V3z'/&gt;&lt;/svg&gt;&quot;);
  background-size:40%;background-repeat:no-repeat;background-position:center;
  transition:border-radius .25s,width .25s,height .25s,border .25s;}
.fp-vinyl img.img-err{object-position:-9999px;color:transparent;}
.fp-vinyl.spin{animation:spin 16s linear infinite;}
.fp-vinyl.paused,.fp-art.is-paused .fp-vinyl.spin{animation-play-state:paused;}
/* 圆形声波环：绕封面一圈的径向柱，平滑、细、发光 */
.fp-spectrum{
  position:absolute;inset:-40px;display:none;pointer-events:none;z-index:1;
}
.fp-spectrum i{
  position:absolute;left:50%;top:50%;
  width:2px;height:22px;
  margin-left:-1px;margin-top:-11px;
  border-radius:2px;
  background:linear-gradient(to top,rgba(var(--accent-rgb),.25),rgba(255,255,255,.95));
  box-shadow:0 0 8px rgba(var(--accent-rgb),.4);
  transform-origin:center center;
  opacity:.92;
  will-change:transform,opacity;
}
/* is-fake 动画改由 JS fillSimulatedFreq 驱动，避免与 inline transform 抢 */
.fp-art.is-fake .fp-spectrum i{animation:none;}
@keyframes fpBar{0%{transform:var(--tr) scaleY(.35);}100%{transform:var(--tr) scaleY(1.15);}}
/* 外层柔光圈：随音量微扩 */
.fp-spectrum-glow{
  position:absolute;inset:-8px;border-radius:50%;pointer-events:none;z-index:0;display:none;
  box-shadow:0 0 0 1px rgba(255,255,255,.12),0 0 22px rgba(var(--accent-rgb),.25);
  transition:transform .08s linear,opacity .08s linear;
}
.fp-art[data-style=&quot;spectrum&quot;] .fp-spectrum-glow{display:block;}
.fp-pulse-ring{position:absolute;inset:-18px;border-radius:50%;border:2px solid rgba(var(--accent-rgb),.45);
  display:none;pointer-events:none;z-index:0;animation:fpPulse 2.2s ease-out infinite;}
.fp-pulse-ring.r2{inset:-32px;animation-delay:.75s;border-color:rgba(var(--accent-rgb),.28);}
@keyframes fpPulse{0%{transform:scale(.9);opacity:.55;}100%{transform:scale(1.15);opacity:0;}}
.fp-wave{
  /* 粒子扩散：封面外缘细密尘雾光环（参考星尘环） */
  position:absolute;left:50%;top:50%;
  width:240%;height:240%;
  margin-left:-120%;margin-top:-120%;
  display:none;pointer-events:none;z-index:4;
  overflow:visible;
}
.fp-wave .fp-particle{
  position:absolute;left:50%;top:50%;
  width:3px;height:3px;margin:-1.5px 0 0 -1.5px;
  border-radius:50%;
  background:#fff;
  box-shadow:0 0 3px rgba(255,255,255,.9),0 0 7px rgba(180,220,255,.75),0 0 12px rgba(var(--accent-rgb),.4);
  opacity:0;
  will-change:transform,opacity;
  pointer-events:none;
}
.fp-art[data-style=&quot;wave&quot;] .fp-art-stage{overflow:visible!important;}
.fp-art[data-style=&quot;wave&quot;] .fp-vinyl{
  position:relative;z-index:2;
  box-shadow:0 12px 36px rgba(0,0,0,.28),0 0 0 1px rgba(255,255,255,.06);
}
.fp-art[data-style=&quot;wave&quot;] .fp-wave{display:block!important;z-index:4;overflow:visible!important;}
/* 光环：细弧双环，纯 CSS，禁止每帧改 box-shadow（会闪） */
.fp-ring-spin{
  position:absolute;inset:-12px;border-radius:50%;
  border:none;background:transparent;
  display:none;pointer-events:none;z-index:3;
  box-shadow:
    0 0 0 1px rgba(var(--accent-rgb), .22),
    0 0 24px rgba(var(--accent-rgb), .16);
}
.fp-ring-spin::before{
  content:&quot;&quot;;position:absolute;inset:-5px;border-radius:50%;
  background:conic-gradient(
    from 0deg,
    transparent 0deg 250deg,
    rgba(var(--accent-rgb), .2) 270deg,
    var(--green) 305deg,
    rgba(255,255,255,.7) 328deg,
    var(--green) 348deg,
    transparent 360deg
  );
  -webkit-mask:radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
  mask:radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
  animation:fpRingSpin 4s linear infinite;
  opacity:.88;
}
.fp-ring-spin::after{
  content:&quot;&quot;;position:absolute;inset:-16px;border-radius:50%;
  background:conic-gradient(
    from 180deg,
    transparent 0deg 290deg,
    rgba(var(--accent-rgb), .28) 310deg,
    rgba(var(--accent-rgb), .45) 330deg,
    transparent 360deg
  );
  -webkit-mask:radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
  mask:radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px));
  animation:fpRingSpin 8s linear infinite reverse;
  opacity:.4;
}
@keyframes fpRingSpin{to{transform:rotate(360deg);}}
.fp-art.is-paused .fp-spectrum i,
.fp-art.is-paused .fp-wave b,
.fp-art.is-paused .fp-pulse-ring,
.fp-art.is-paused .fp-ring-spin,
.fp-art.is-paused .fp-ring-spin::before,
.fp-art.is-paused .fp-ring-spin::after{animation-play-state:paused!important;}
/* —— 互斥样式 —— */
.fp-art .fp-groove,.fp-art .fp-spectrum,.fp-art .fp-pulse-ring,.fp-art .fp-wave,.fp-art .fp-ring-spin,.fp-art .fp-portal,.fp-art .fp-orbit,.fp-art .fp-holo{display:none;}
.fp-art[data-style=&quot;vinyl&quot;] .fp-groove{display:block;}
.fp-art[data-style=&quot;vinyl&quot;] .fp-vinyl.spin{animation:spin 16s linear infinite;}
.fp-art[data-style=&quot;spectrum&quot;] .fp-spectrum{display:block;}
.fp-art[data-style=&quot;spectrum&quot;] .fp-vinyl{background:#111;box-shadow:0 16px 40px rgba(0,0,0,.45);}
.fp-art[data-style=&quot;spectrum&quot;] .fp-vinyl.spin{animation:none;}
.fp-art[data-style=&quot;spectrum&quot;] .fp-vinyl img{width:56%;height:56%;}
.fp-art[data-style=&quot;pulse&quot;] .fp-pulse-ring{display:block;}
.fp-art[data-style=&quot;pulse&quot;] .fp-vinyl{box-shadow:0 0 36px rgba(var(--accent-rgb),.28),0 24px 50px -18px rgba(0,0,0,.55);}
.fp-art[data-style=&quot;pulse&quot;] .fp-vinyl.spin{animation:none;}
.fp-art[data-style=&quot;square&quot;] .fp-vinyl{border-radius:20px;background:transparent;overflow:hidden;}
.fp-art[data-style=&quot;square&quot;] .fp-vinyl.spin{animation:none;}
.fp-art[data-style=&quot;square&quot;] .fp-vinyl img{width:100%;height:100%;border-radius:20px;border:none;}
.fp-art[data-style=&quot;wave&quot;] .fp-wave{display:block;}
.fp-art[data-style=&quot;wave&quot;] .fp-vinyl.spin{animation:none;}
.fp-art[data-style=&quot;wave&quot;] .fp-vinyl img{width:100%;height:100%;}
.fp-art[data-style=&quot;ring&quot;] .fp-ring-spin{display:block;}
.fp-art[data-style=&quot;ring&quot;] .fp-vinyl{
  background:transparent;
  box-shadow:0 12px 36px rgba(0,0,0,.12), 0 0 0 1px rgba(0,0,0,.04);
  overflow:hidden;
}
.fp-art[data-style=&quot;ring&quot;] .fp-vinyl.spin{animation:none;}
.fp-art[data-style=&quot;ring&quot;] .fp-vinyl img{width:100%;height:100%;border:none;border-radius:50%;}

/* —— 虫洞 Portal：多层漩涡能量环，无黑边封面 —— */
.fp-portal{
  position:absolute;inset:-48px;border-radius:50%;pointer-events:none;z-index:1;display:none;
  overflow:visible;
}
.fp-portal i{
  position:absolute;inset:0;border-radius:50%;
  box-sizing:border-box;
  will-change:transform;
}
/* 外层慢旋：宽色带 */
.fp-portal .p1{
  background:conic-gradient(
    from 0deg,
    transparent 0deg 25deg,
    rgba(var(--accent-rgb),.0) 30deg,
    rgba(var(--accent-rgb),.55) 55deg,
    rgba(120,200,255,.4) 75deg,
    transparent 100deg 180deg,
    rgba(200,140,255,.45) 210deg,
    rgba(var(--accent-rgb),.35) 235deg,
    transparent 270deg 360deg
  );
  -webkit-mask:radial-gradient(farthest-side, transparent 52%, #000 56%, #000 78%, transparent 82%);
  mask:radial-gradient(farthest-side, transparent 52%, #000 56%, #000 78%, transparent 82%);
  animation:fpPortalSpin 11s linear infinite;
  filter:blur(1px);
  opacity:.9;
}
/* 中层反旋：细亮丝 */
.fp-portal .p2{
  inset:6%;
  background:conic-gradient(
    from 90deg,
    transparent 0deg 200deg,
    rgba(255,255,255,.7) 220deg,
    rgba(var(--accent-rgb),.8) 235deg,
    transparent 255deg 360deg
  );
  -webkit-mask:radial-gradient(farthest-side, transparent 48%, #000 51%, #000 72%, transparent 76%);
  mask:radial-gradient(farthest-side, transparent 48%, #000 51%, #000 72%, transparent 76%);
  animation:fpPortalSpin 7s linear infinite reverse;
  opacity:.85;
}
/* 内层快旋：能量弧 */
.fp-portal .p3{
  inset:14%;
  background:conic-gradient(
    from 180deg,
    transparent 0deg 280deg,
    rgba(var(--accent-rgb),.65) 300deg,
    rgba(255,255,255,.5) 315deg,
    transparent 335deg 360deg
  );
  -webkit-mask:radial-gradient(farthest-side, transparent 42%, #000 46%, #000 68%, transparent 72%);
  mask:radial-gradient(farthest-side, transparent 42%, #000 46%, #000 68%, transparent 72%);
  animation:fpPortalSpin 4.5s linear infinite;
  opacity:.8;
}
/* 中心柔光，衬托封面 */
.fp-portal .p-core{
  position:absolute;inset:22%;border-radius:50%;
  background:radial-gradient(circle,
    rgba(var(--accent-rgb),.25) 0%,
    rgba(var(--accent-rgb),.08) 50%,
    transparent 75%);
  filter:blur(16px);
  animation:fpPortalCore 3.2s ease-in-out infinite alternate;
}
@keyframes fpPortalSpin{ to{ transform:rotate(360deg); } }
@keyframes fpPortalCore{
  0%{ transform:scale(0.9); opacity:.5; }
  100%{ transform:scale(1.12); opacity:.9; }
}
.fp-art[data-style=&quot;portal&quot;] .fp-portal{display:block;}
.fp-art[data-style=&quot;portal&quot;] .fp-art-stage{overflow:visible!important;}
/* 无黑边：透明底，封面近乎铺满圆形 */
.fp-art[data-style=&quot;portal&quot;] .fp-vinyl{
  background:transparent!important;
  box-shadow:
    0 0 40px rgba(var(--accent-rgb),.3),
    0 16px 40px rgba(0,0,0,.25)!important;
  overflow:hidden;
  border-radius:50%!important;
  position:relative;z-index:3;
}
.fp-art[data-style=&quot;portal&quot;] .fp-vinyl.spin{
  animation:fpPortalFloat 5s ease-in-out infinite;
}
.fp-art[data-style=&quot;portal&quot;] .fp-vinyl img{
  width:100%!important;height:100%!important;
  border:none!important;border-radius:50%!important;
  box-shadow:none!important;
  object-fit:cover;
}
@keyframes fpPortalFloat{
  0%,100%{ transform:scale(1); }
  50%{ transform:scale(1.03); }
}
.fp-art.is-paused .fp-portal i,
.fp-art.is-paused .fp-portal .p-core,
.fp-art.is-paused[data-style=&quot;portal&quot;] .fp-vinyl.spin{
  animation-play-state:paused!important;
}

/* —— 轨道 Orbit：多层虚线/亮弧环 + 游标光点 —— */
.fp-orbit{
  position:absolute;inset:-28px;border-radius:50%;pointer-events:none;z-index:3;display:none;
}
.fp-orbit i{
  position:absolute;inset:0;border-radius:50%;border:1.5px solid transparent;
  box-sizing:border-box;
}
.fp-orbit .o1{
  inset:8%;
  border-color:rgba(120,160,255,.4);
  box-shadow:0 0 12px rgba(120,160,255,.22), inset 0 0 12px rgba(120,160,255,.08);
  animation:fpOrbitSpin 14s linear infinite;
  border-style:dashed;
  opacity:.95;
}
.fp-orbit .o2{
  inset:0;
  border:1.5px solid rgba(255,255,255,.2);
  border-top-color:rgba(180,140,255,.75);
  border-right-color:rgba(255,255,255,.1);
  box-shadow:0 0 18px rgba(160,140,255,.2);
  animation:fpOrbitSpin 9s linear infinite reverse;
}
.fp-orbit .o3{
  inset:-12%;
  border:1px solid rgba(120,200,220,.28);
  border-bottom-color:rgba(120,200,220,.6);
  border-left-color:transparent;
  animation:fpOrbitSpin 22s linear infinite;
  opacity:.8;
}
.fp-orbit .o-dot{
  position:absolute;width:8px;height:8px;border-radius:50%;
  left:50%;top:50%;margin:-4px 0 0 -4px;
  background:radial-gradient(circle at 35% 30%, #fff 0%, #b8c8ff 55%, #7a9cff 100%);
  box-shadow:0 0 8px rgba(140,170,255,.9), 0 0 16px rgba(140,170,255,.45);
}
.fp-orbit .o-dot.d1{
  animation:fpOrbitDotA 9s linear infinite reverse;
}
.fp-orbit .o-dot.d2{
  width:6px;height:6px;margin:-3px 0 0 -3px;
  background:radial-gradient(circle at 35% 30%, #fff 0%, #f0c0e0 50%, #e090c0 100%);
  box-shadow:0 0 6px rgba(240,160,200,.85), 0 0 12px rgba(240,160,200,.4);
  animation:fpOrbitDotB 14s linear infinite;
}
@keyframes fpOrbitSpin{ to{ transform:rotate(360deg); } }
@keyframes fpOrbitDotA{
  from{ transform:rotate(0deg) translateX(var(--orbit-r, 150px)) rotate(0deg); }
  to{ transform:rotate(360deg) translateX(var(--orbit-r, 150px)) rotate(-360deg); }
}
@keyframes fpOrbitDotB{
  from{ transform:rotate(120deg) translateX(calc(var(--orbit-r, 150px) - 10px)) rotate(-120deg); }
  to{ transform:rotate(480deg) translateX(calc(var(--orbit-r, 150px) - 10px)) rotate(-480deg); }
}
.fp-art[data-style=&quot;orbit&quot;] .fp-orbit{display:block;}
.fp-art[data-style=&quot;orbit&quot;] .fp-art-stage{overflow:visible!important;}
.fp-art[data-style=&quot;orbit&quot;] .fp-vinyl{
  background:
    radial-gradient(circle at 35% 30%, rgba(255,255,255,.1), transparent 40%),
    radial-gradient(circle at 50% 50%, #1a1a22 0%, #0c0c12 100%);
  box-shadow:
    0 0 0 1px rgba(140,160,255,.28),
    0 0 28px rgba(140,160,255,.2),
    0 18px 40px rgba(0,0,0,.4);
  overflow:hidden;
}
.fp-art[data-style=&quot;orbit&quot;] .fp-vinyl.spin{animation:spin 20s linear infinite;}
.fp-art[data-style=&quot;orbit&quot;] .fp-vinyl img{
  width:78%;height:78%;border:none;
  box-shadow:0 0 0 2px rgba(255,255,255,.08);
}
.fp-art.is-paused .fp-orbit i,
.fp-art.is-paused .fp-orbit .o-dot{animation-play-state:paused!important;}

/* —— 全息 Holo：棱彩描边 + 扫描线 + 呼吸光晕 —— */
.fp-holo{
  position:absolute;inset:-18px;border-radius:50%;pointer-events:none;z-index:3;display:none;
  overflow:visible;
}
.fp-holo .h-ring{
  position:absolute;inset:0;border-radius:50%;
  background:conic-gradient(
    from 0deg,
    rgba(var(--accent-rgb),.0),
    rgba(var(--accent-rgb),.55) 40deg,
    rgba(120,220,255,.5) 80deg,
    rgba(255,120,220,.45) 130deg,
    rgba(var(--accent-rgb),.0) 180deg,
    rgba(180,140,255,.5) 230deg,
    rgba(80,220,200,.45) 280deg,
    rgba(var(--accent-rgb),.0) 360deg
  );
  -webkit-mask:radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
  mask:radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
  animation:fpHoloSpin 6s linear infinite;
  filter:blur(.3px);
  opacity:.95;
}
.fp-holo .h-ring::after{
  content:&quot;&quot;;position:absolute;inset:6px;border-radius:50%;
  background:conic-gradient(
    from 180deg,
    transparent 0deg 260deg,
    rgba(255,255,255,.55) 300deg,
    transparent 340deg
  );
  -webkit-mask:radial-gradient(farthest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1px));
  mask:radial-gradient(farthest-side, transparent calc(100% - 1.5px), #000 calc(100% - 1px));
  animation:fpHoloSpin 10s linear infinite reverse;
  opacity:.7;
}
.fp-holo .h-scan{
  position:absolute;inset:14px;border-radius:50%;overflow:hidden;pointer-events:none;
  background:linear-gradient(180deg,
    transparent 0%,
    rgba(120,220,255,.08) 46%,
    rgba(255,255,255,.14) 50%,
    rgba(var(--accent-rgb),.1) 54%,
    transparent 100%);
  background-size:100% 220%;
  animation:fpHoloScan 3.6s ease-in-out infinite;
  mix-blend-mode:screen;
  opacity:.7;
}
@keyframes fpHoloSpin{ to{ transform:rotate(360deg); } }
@keyframes fpHoloScan{
  0%{ background-position:0% -40%; opacity:.35; }
  50%{ background-position:0% 140%; opacity:.75; }
  100%{ background-position:0% -40%; opacity:.35; }
}
.fp-art[data-style=&quot;holo&quot;] .fp-holo{display:block;}
.fp-art[data-style=&quot;holo&quot;] .fp-art-stage{overflow:visible!important;}
.fp-art[data-style=&quot;holo&quot;] .fp-vinyl{
  background:
    radial-gradient(circle at 35% 28%, rgba(180,220,255,.12), transparent 42%),
    radial-gradient(circle at 50% 50%, #14141c 0%, #0a0a10 100%);
  box-shadow:
    0 0 0 1px rgba(255,255,255,.1),
    0 0 32px rgba(var(--accent-rgb),.28),
    0 0 60px rgba(120,180,255,.12),
    0 20px 48px rgba(0,0,0,.45);
  overflow:hidden;
}
.fp-art[data-style=&quot;holo&quot;] .fp-vinyl.spin{animation:spin 18s linear infinite;}
.fp-art[data-style=&quot;holo&quot;] .fp-vinyl img{
  width:86%;height:86%;border:none;
  box-shadow:0 0 0 1px rgba(255,255,255,.1), inset 0 0 20px rgba(120,200,255,.08);
}
.fp-art.is-paused .fp-holo .h-ring,
.fp-art.is-paused .fp-holo .h-ring::after,
.fp-art.is-paused .fp-holo .h-scan{animation-play-state:paused!important;}

.fp-track-info{text-align:center;width:100%;max-width:360px;padding:0 8px;box-sizing:border-box;flex-shrink:0;}
.fp-track-name{font-size:22px;font-weight:700;line-height:1.3;word-break:break-word;letter-spacing:-0.3px;}
.fp-track-artist{font-size:12.5px;color:var(--text-1);margin-top:6px;}
.fp-quick{display:flex;gap:18px;align-items:center;justify-content:center;}
.fp-quick button{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--text-1);}
.fp-quick button svg{width:17px;height:17px;}
.fp-quick button.on{color:var(--danger);}
.fp-quality-btn,.fp-quick button.fp-quality-btn,
.fp-speed-btn,.fp-quick button.fp-speed-btn{
  width:auto!important;min-width:36px;padding:0 4px;
  border:none!important;background:transparent!important;border-radius:0!important;
  font-size:12px;font-weight:700;letter-spacing:0.04em;
  color:var(--text-1)!important;
}
.fp-speed-btn.on,.fp-quick button.fp-speed-btn.on{
  color:var(--green)!important;
}
/* 全屏播放器内的进度与控制（手机端可见） */
.fp-controls{width:100%;max-width:420px;display:flex;flex-direction:column;align-items:center;gap:18px;padding:0 4px;box-sizing:border-box;}
.fp-progress{display:flex;align-items:center;gap:8px;width:100%;}
.fp-time{font-size:11px;color:var(--text-2);font-family:var(--font-num);width:36px;flex-shrink:0;}
.fp-time.right{text-align:right;}
.fp-bar{flex:1;height:5px;border-radius:3px;background:rgba(255,255,255,.18);position:relative;cursor:pointer;touch-action:none;}
.fp-bar-fill{position:absolute;left:0;top:0;height:100%;border-radius:3px;background:#fff;width:0%;}
.fp-bar-knob{position:absolute;top:50%;width:14px;height:14px;border-radius:50%;background:#fff;
  box-shadow:0 1px 6px rgba(0,0,0,.4);transform:translate(-50%,-50%);left:0%;}
.fp-ctrls{display:flex;align-items:center;justify-content:center;gap:36px;}
.fp-ctrl-btn{width:44px;height:44px;display:flex;align-items:center;justify-content:center;color:var(--text-1);}
.fp-ctrl-btn svg{width:24px;height:24px;}
.fp-play{width:60px;height:60px;border-radius:50%;background:#fff;color:#111;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 8px 32px rgba(0,0,0,.38), 0 1px 0 rgba(255,255,255,.55) inset;
  transition:transform .32s var(--ease-spring), box-shadow .25s;}
.fp-play svg{width:24px;height:24px;}
.fp-play:hover{box-shadow:0 10px 36px rgba(0,0,0,.42);}
.fp-play:active{transform:scale(.92);}

.fp-right{position:relative;z-index:2;flex:1;display:flex;flex-direction:column;padding:70px 48px 30px;min-width:0;box-sizing:border-box;}
.fp-tabs{display:flex;gap:22px;margin-bottom:14px;flex-shrink:0;}
.fp-tab{font-size:16px;color:var(--text-2);padding-bottom:8px;border-bottom:2px solid transparent;transition:all .2s;}
.fp-tab.active{color:var(--text-0);border-color:var(--green);font-weight:600;}
/* 全屏歌词模式 */
#fullPlayer.lyrics-focus .fp-left{display:none!important;}
#fullPlayer.lyrics-focus .fp-dock{display:none!important;}
#fullPlayer.lyrics-focus .fp-tabs{display:none!important;}
#fullPlayer.lyrics-focus .fp-right{
  position:absolute!important;inset:0!important;width:100%!important;max-width:none!important;
  padding:calc(56px + var(--safe-t)) 20px calc(28px + var(--safe-b))!important;
  margin:0!important;z-index:6!important;
  display:flex!important;flex-direction:column!important;
  order:unset!important;overflow:hidden!important;background:transparent!important;
}
#fullPlayer.lyrics-focus #lyricsWrap,
#fullPlayer.lyrics-focus #playlistPanel{
  flex:1 1 auto!important;min-height:0!important;max-height:none!important;
  mask-image:linear-gradient(180deg,transparent 0,#000 8%,#000 92%,transparent 100%)!important;
  -webkit-mask-image:linear-gradient(180deg,transparent 0,#000 8%,#000 92%,transparent 100%)!important;
}
#fullPlayer.lyrics-focus .lyric-line{font-size:20px!important;line-height:1.9!important;padding:8px 12px!important;}
#fullPlayer.lyrics-focus .lyric-line.active{font-size:32px!important;font-weight:700!important;}
#fullPlayer.lyrics-focus .lyric-tr{font-size:14px!important;}
#fullPlayer.lyrics-focus .fp-topbar{z-index:8!important;}
#lyricsWrap{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;mask-image:linear-gradient(180deg,transparent 0,#000 10%,#000 88%,transparent 100%);
  -webkit-mask-image:linear-gradient(180deg,transparent 0,#000 10%,#000 88%,transparent 100%);}
.lyric-line{
  font-size:18px;line-height:2.1;color:var(--text-2);
  cursor:pointer;padding:6px 8px;text-align:center;font-weight:500;
  transform:scale(1) translateY(0);transform-origin:center center;
  opacity:.72;
  transition:
    color .4s cubic-bezier(0.22,1,0.36,1),
    opacity .4s cubic-bezier(0.22,1,0.36,1),
    font-size .48s cubic-bezier(0.22,1,0.36,1),
    transform .48s cubic-bezier(0.22,1,0.36,1),
    letter-spacing .4s ease,
    font-weight .3s ease;
  will-change:transform,font-size,opacity;
}
.lyric-line:hover{color:var(--text-1);opacity:.9;}
.lyric-line.active{
  color:var(--text-0);font-size:28px;font-weight:700;letter-spacing:-0.3px;
  opacity:1;
  transform:scale(1.04) translateY(0);
}
.lyric-line.active .lyric-tr{color:var(--green);transition:color .35s ease;}
.lyric-line.is-leaving{
  opacity:.45;
  transform:scale(0.96) translateY(-6px);
}
.lyric-line.is-entering{
  animation:lyricEnter .48s cubic-bezier(0.22,1,0.36,1) both;
}
@keyframes lyricEnter{
  from{ opacity:.4; transform:scale(0.94) translateY(10px); }
  to{ opacity:1; transform:scale(1.04) translateY(0); }
}
.lyric-tr{display:block;font-size:13px;color:var(--text-2);margin-top:2px;font-weight:400;}
/* ---- KTV 逐字高亮（需压过 #fullPlayer .lyric-line.active 整行色） ---- */
.lyric-main{display:inline;}
.lyric-word{
  display:inline;
  color:inherit;
  transition:color .08s linear, opacity .08s linear, text-shadow .12s ease;
}
#fullPlayer .lyric-line.active .lyric-word,
.lyric-line.active .lyric-word{
  color:rgba(60,60,67,.28)!important;
  opacity:1!important;
}
#fullPlayer .lyric-line.active .lyric-word.sung,
.lyric-line.active .lyric-word.sung{
  color:var(--green)!important;
  opacity:1!important;
  text-shadow:0 0 10px rgba(var(--accent-rgb),.3);
}
#fullPlayer .lyric-line.active .lyric-word.sung.current,
.lyric-line.active .lyric-word.sung.current{
  color:var(--green)!important;
  font-weight:700!important;
}
/* 整行 KTV 扫光：颜色连续从左流入，避免单字闪烁 */
.lyric-line.active .lyric-main.ktv-sweep,
#fullPlayer .lyric-line.active .lyric-main.ktv-sweep{
  color:transparent!important;
  -webkit-text-fill-color:transparent!important;
  background-image:linear-gradient(
    90deg,
    var(--green) 0%,
    var(--green) var(--ktv-fill, 0%),
    rgba(60,60,67,.28) var(--ktv-fill, 0%),
    rgba(60,60,67,.28) 100%
  );
  -webkit-background-clip:text!important;
  background-clip:text!important;
}
html[data-mode=&quot;dark&quot;] .lyric-line.active .lyric-main.ktv-sweep,
html[data-mode=&quot;dark&quot;] #fullPlayer .lyric-line.active .lyric-main.ktv-sweep{
  background-image:linear-gradient(
    90deg,
    var(--green) 0%,
    var(--green) var(--ktv-fill, 0%),
    rgba(235,235,245,.26) var(--ktv-fill, 0%),
    rgba(235,235,245,.26) 100%
  );
}
.lyric-line:not(.active) .lyric-main.ktv-sweep{
  color:inherit!important;
  -webkit-text-fill-color:inherit!important;
  background-image:none!important;
  -webkit-background-clip:border-box!important;
  background-clip:border-box!important;
}
.lyric-line.active .lyric-word{
  /* 颜色由父级扫光控制，避免子级闪烁 */
  transition:none!important;
  color:inherit!important;
  -webkit-text-fill-color:inherit!important;
  background:none!important;
}
html[data-mode=&quot;dark&quot;] #fullPlayer .lyric-line.active .lyric-word,
html[data-mode=&quot;dark&quot;] .lyric-line.active .lyric-word{
  color:rgba(235,235,245,.26)!important;
}
html[data-mode=&quot;dark&quot;] #fullPlayer .lyric-line.active .lyric-word.sung,
html[data-mode=&quot;dark&quot;] .lyric-line.active .lyric-word.sung{
  color:var(--green)!important;
  text-shadow:0 0 12px rgba(var(--accent-rgb),.4);
}
#playlistPanel{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;}
.pl-panel-row{display:flex;align-items:center;gap:10px;padding:11px 6px;border-radius:10px;cursor:pointer;}
.pl-panel-row:hover{background:var(--glass);}
.pl-panel-row.playing{color:var(--green);}
/* 迷你条顶部细进度：已并入全局 #playerBar 胶囊样式 */

/* ============================================================
   MV / RADIO
   ============================================================ */
.mv-card{flex:0 0 auto;width:220px;cursor:pointer;}
.mv-cover{width:220px;height:124px;border-radius:var(--radius-m);overflow:hidden;position:relative;
  background:linear-gradient(145deg,#1a222a,#0d1215);}
.mv-cover::before{content:&quot;&quot;;position:absolute;inset:0;background:url(&quot;data:image/svg+xml;utf8,&lt;svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23ffffff' opacity='0.22'&gt;&lt;path d='M8 5v14l11-7z'/&gt;&lt;/svg&gt;&quot;) center/22% no-repeat;pointer-events:none;z-index:0;}
.mv-cover img{width:100%;height:100%;object-fit:cover;transition:transform .3s var(--ease);position:relative;z-index:1;}
.mv-card:hover .mv-cover img{transform:scale(1.06);}
.mv-dur{position:absolute;right:7px;bottom:7px;font-size:10px;background:rgba(0,0,0,.55);padding:2px 6px;border-radius:5px;z-index:2;}
.mv-rank-badge{position:absolute;left:7px;top:7px;min-width:22px;height:22px;padding:0 6px;border-radius:6px;background:rgba(0,0,0,.55);color:#fff;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;z-index:2;font-family:var(--font-num);}
.mv-rank-badge.top1{background:linear-gradient(135deg,#ffd700,#f0a000);color:#1a1200;}
.mv-rank-badge.top2{background:linear-gradient(135deg,#e8e8e8,#b0b0b0);color:#222;}
.mv-rank-badge.top3{background:linear-gradient(135deg,#e8a060,#c07030);color:#1a1000;}
.mv-play-fab{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .2s;background:rgba(0,0,0,.25);z-index:2;}
.mv-card:hover .mv-play-fab{opacity:1;}
.mv-play-fab svg{width:36px;height:36px;color:#fff;}
.mv-title{font-size:13px;margin-top:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.mv-sub{font-size:11px;color:var(--text-2);margin-top:2px;}
.mv-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px 12px;}
.mv-grid .mv-card{width:100%;}
.mv-grid .mv-cover{width:100%;height:auto;aspect-ratio:16/9;}

#mvPlayerView{position:fixed;inset:0;z-index:210;background:#000;display:none;flex-direction:column;
  touch-action:pan-y;overscroll-behavior:none;
  transition:transform .4s cubic-bezier(0.22,1,0.36,1),opacity .3s ease;}
#mvPlayerView.show{display:flex;}
#mvPlayerView video{flex:1;width:100%;object-fit:contain;background:#000;min-height:0;}
.mv-top-bar{position:absolute;top:0;left:0;right:0;padding:20px 26px;display:flex;align-items:center;gap:14px;
  background:linear-gradient(180deg,rgba(0,0,0,.6),transparent);z-index:2;
  /* 顶部拖动手势热区提示条 */
  padding-top:max(20px, calc(12px + env(safe-area-inset-top, 0px)));}
.mv-top-bar .fp-close{position:static;}
.mv-drag-hint{position:absolute;left:50%;top:calc(8px + env(safe-area-inset-top, 0px));transform:translateX(-50%);
  width:36px;height:4px;border-radius:4px;background:rgba(255,255,255,.35);pointer-events:none;z-index:3;}

.radio-card{flex:0 0 auto;width:132px;text-align:center;cursor:pointer;}
.radio-cover{width:132px;height:132px;border-radius:50%;overflow:hidden;background:conic-gradient(var(--green),#12864e,var(--green));
  padding:3px;}
.radio-cover img{width:100%;height:100%;border-radius:50%;object-fit:cover;display:block;}
.radio-name{font-size:12.5px;margin-top:10px;}

/* ---------- 听书（网易 + 喜马拉雅） ---------- */
#homeVoiceSec{display:none;}
#homeVoiceSec.is-ne{display:block;}
.voice-hscroll{
  display:flex;gap:12px;overflow-x:auto;-webkit-overflow-scrolling:touch;
  padding:4px 2px 8px;scroll-snap-type:x mandatory;
}
.voice-hscroll::-webkit-scrollbar{display:none;}
.voice-card{flex:0 0 auto;width:118px;cursor:pointer;scroll-snap-align:start;}
.voice-cover{
  width:118px;height:118px;border-radius:12px;overflow:hidden;position:relative;
  background:linear-gradient(145deg,#2a1a40,#120a22);
  box-shadow:0 6px 18px rgba(0,0,0,.25);
}
.voice-cover img{width:100%;height:100%;object-fit:cover;display:block;}
.voice-badge{
  position:absolute;left:6px;top:6px;z-index:2;
  font-size:10px;font-weight:700;padding:2px 6px;border-radius:6px;
  background:rgba(0,0,0,.55);color:#fff;
}
.voice-badge.free{background:linear-gradient(135deg,#31c27c,#1a9e5c);}
.voice-badge.trial{background:linear-gradient(135deg,#ff8a4a,#e06020);}
.voice-badge.xm{background:linear-gradient(135deg,#ff5534,#e03a1a);}
.voice-badge.funny{background:linear-gradient(135deg,#ff9f0a,#e08600);}
.voice-name{
  font-size:12.5px;margin-top:8px;line-height:1.35;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.voice-sub{font-size:11px;color:var(--text-2);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.voice-all-tabs{
  display:flex;gap:8px;overflow-x:auto;-webkit-overflow-scrolling:touch;
  padding:4px 0 12px;scrollbar-width:none;
}
.voice-all-tabs::-webkit-scrollbar{display:none;}
.voice-all-tab{
  flex:0 0 auto;font-size:13px;padding:6px 14px;border-radius:100px;font-weight:600;
  color:var(--text-1);background:rgba(118,118,128,.14);border:1px solid transparent;
  white-space:nowrap;
}
.voice-all-tab.active{
  color:var(--text-0);background:rgba(var(--accent-rgb),.18);
  border-color:rgba(var(--accent-rgb),.4);
}
.voice-all-grid{
  display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px 10px;
  padding:4px 2px 8px;
}
@media(min-width:600px){.voice-all-grid{grid-template-columns:repeat(auto-fill,minmax(120px,1fr));}}
.voice-all-grid .voice-card{width:100%;}
.voice-all-grid .voice-cover{width:100%;aspect-ratio:1/1;height:auto;padding-bottom:0;position:relative;}
.voice-all-grid .voice-cover img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
.voice-all-more{text-align:center;padding:14px 0 28px;font-size:12.5px;color:var(--text-2);}
.voice-sort-bar{display:flex;align-items:center;gap:8px;padding:4px 0 10px;}
.voice-sort-btn{
  font-size:12.5px;padding:5px 12px;border-radius:100px;font-weight:600;
  color:var(--text-1);background:rgba(118,118,128,.14);border:1px solid transparent;
}
.voice-sort-btn.active{
  color:var(--text-0);background:rgba(var(--accent-rgb),.16);
  border-color:rgba(var(--accent-rgb),.35);
}

/* ---------- 首页频道（精致方卡 · 渐变底图 + 官方封面） ---------- */
.channel-sec-head{
  display:flex;align-items:center;gap:10px;margin-bottom:14px;min-width:0;
}
.channel-sec-head .sec-title{flex-shrink:0;margin:0;}
.channel-tabs{
  display:flex;flex:1;min-width:0;gap:4px;overflow-x:auto;align-items:center;
  -webkit-overflow-scrolling:touch;padding:2px 0;scrollbar-width:none;
}
.channel-tabs::-webkit-scrollbar{display:none;}
.channel-tab{
  flex-shrink:0;padding:5px 12px;border-radius:980px;font-size:14px;font-weight:500;
  color:var(--text-2);background:transparent;border:none;cursor:pointer;
  transition:color .2s, background .2s, transform .3s var(--ease-spring);
  white-space:nowrap;line-height:1.2;
}
.channel-tab:active{transform:scale(.94);}
.channel-tab.active{
  color:var(--text-0);background:rgba(255,255,255,.14);font-weight:600;
}
html[data-mode=&quot;dark&quot;] .channel-tab.active{
  color:#111;background:#fff;
}
.channel-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(100px,1fr));
  gap:16px 12px;
  padding:4px 2px 8px;
}
.channel-item{
  display:flex;flex-direction:column;align-items:stretch;text-align:left;
  cursor:pointer;-webkit-user-select:none;user-select:none;
  transition:transform .35s var(--ease-spring);
  position:relative;min-width:0;
}
.channel-item:active{transform:scale(.96);}
.channel-avatar{
  width:100%;aspect-ratio:1/1;border-radius:16px;overflow:hidden;position:relative;
  box-shadow:0 8px 24px rgba(0,0,0,.28), 0 1px 0 rgba(255,255,255,.08) inset;
  border:1px solid rgba(255,255,255,.1);
  outline:none;
  background:#1c1c1e;
  transition:box-shadow .25s, transform .35s var(--ease-spring), border-color .2s;
  box-sizing:border-box;
}
.channel-avatar img{
  width:100%;height:100%;object-fit:cover;display:block;
  border:none;outline:none;border-radius:inherit;
  position:relative;z-index:1;
}
/* 官方封面上的轻渐变遮罩，避免刺眼并统一观感 */
.channel-avatar.has-cover::after{
  content:&quot;&quot;;position:absolute;inset:0;z-index:2;pointer-events:none;
  background:linear-gradient(160deg, rgba(255,255,255,.12) 0%, transparent 42%, rgba(0,0,0,.22) 100%);
  border-radius:inherit;
}
/* 有官方封面时先藏设计底，加载失败再由 onerror 显示 */
.channel-avatar.has-cover .ch-art{display:none;}
/* 无官方图时的设计底：多层光斑 + 大字 */
.channel-avatar .ch-art{
  position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;
  z-index:1;overflow:hidden;
}
.channel-avatar .ch-art::before{
  content:&quot;&quot;;position:absolute;width:140%;height:140%;left:-20%;top:-30%;
  background:radial-gradient(circle at 30% 25%, rgba(255,255,255,.28) 0%, transparent 48%),
             radial-gradient(circle at 80% 75%, rgba(0,0,0,.22) 0%, transparent 50%);
  pointer-events:none;
}
.channel-avatar .ch-art-mark{
  position:relative;z-index:2;
  font-size:28px;font-weight:800;letter-spacing:-0.5px;line-height:1;
  color:#fff;text-shadow:0 2px 12px rgba(0,0,0,.28);
  opacity:.95;
}
.channel-avatar .ch-art-sub{
  position:relative;z-index:2;margin-top:6px;
  font-size:10px;font-weight:600;letter-spacing:.12em;
  color:rgba(255,255,255,.72);text-transform:uppercase;
}
.channel-avatar .ch-art-ring{
  position:absolute;right:-18%;bottom:-18%;width:62%;aspect-ratio:1;border-radius:50%;
  border:2px solid rgba(255,255,255,.14);pointer-events:none;z-index:1;
}
.channel-avatar .ch-art-ring2{
  position:absolute;left:-22%;top:-22%;width:55%;aspect-ratio:1;border-radius:50%;
  background:rgba(255,255,255,.08);pointer-events:none;z-index:0;
}
.channel-name{
  font-size:13px;color:var(--text-0);margin-top:9px;line-height:1.35;
  width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-weight:600;
  transition:color .2s;text-align:center;letter-spacing:-0.1px;
}
/* 正在播放高亮 */
.channel-item.is-playing .channel-avatar{
  border-color:rgba(var(--accent-rgb),.55);
  box-shadow:0 0 0 2px var(--green), 0 10px 28px rgba(0,0,0,.35);
}
.channel-item.is-playing .channel-name{
  color:var(--green);font-weight:700;
}
.channel-item.is-playing .channel-avatar .ch-playing{
  position:absolute;right:8px;bottom:8px;width:28px;height:28px;border-radius:50%;
  background:var(--green);box-shadow:0 2px 10px rgba(0,0,0,.4);
  display:flex;align-items:center;justify-content:center;z-index:3;
}
.channel-item.is-playing .channel-avatar .ch-playing svg{
  width:12px;height:12px;color:#fff;margin-left:1px;
}
html[data-mode=&quot;dark&quot;] .channel-item.is-playing .channel-avatar{
  border-color:rgba(255,255,255,.4);
  box-shadow:0 0 0 2px #fff, 0 10px 28px rgba(0,0,0,.45);
}
html[data-mode=&quot;dark&quot;] .channel-item.is-playing .channel-name{color:#fff;}
html[data-mode=&quot;dark&quot;] .channel-item.is-playing .channel-avatar .ch-playing{
  background:#fff;
}
html[data-mode=&quot;dark&quot;] .channel-item.is-playing .channel-avatar .ch-playing svg{color:#111;}
@media (max-width:860px){
  .channel-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px 10px;}
  .channel-avatar{border-radius:14px;}
  .channel-name{font-size:12px;margin-top:7px;}
  .channel-tab{padding:4px 10px;font-size:13px;}
  .channel-sec-head{gap:8px;}
  .channel-avatar .ch-art-mark{font-size:24px;}
  .channel-item.is-playing .channel-avatar .ch-playing{width:24px;height:24px;right:6px;bottom:6px;}
  .channel-item.is-playing .channel-avatar .ch-playing svg{width:11px;height:11px;}
}
@media (min-width:861px){
  .channel-grid{grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:18px 14px;}
  .channel-avatar{border-radius:18px;}
  .channel-name{font-size:13px;}
  .channel-avatar .ch-art-mark{font-size:30px;}
}
html.tv-mode .channel-grid{grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:18px;}
html.tv-mode .channel-avatar{border-radius:20px;}
html.tv-mode .channel-name{font-size:15px;}

/* ============================================================
   SEARCH OVERLAY
   ============================================================ */
.sr-tabs,#srTabs{display:flex;gap:10px;margin:10px 0 14px;flex-wrap:nowrap;overflow-x:auto;align-items:center;}
.sr-tab{padding:7px 14px;border-radius:10px;font-size:13px;color:var(--text-1);background:rgba(118,118,128,0.16);
  white-space:nowrap;flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;line-height:1.2;
  writing-mode:horizontal-tb;-webkit-writing-mode:horizontal-tb;font-weight:500;margin:0 2px;}
.sr-tab.active{background:rgba(255,255,255,0.14);color:var(--text-0);font-weight:600;}
/* 音源切换：更大分段控件 + Apple 风格滑动指示器 */
#sourceTabs.sr-tabs{
  position:relative;
  display:flex;flex-wrap:nowrap;gap:0;align-items:center;justify-content:center;
  margin:14px auto 22px;padding:4px;width:fit-content;max-width:calc(100% - 24px);
  overflow:visible;
  background:rgba(118,118,128,0.22);border:none;border-radius:980px;
  backdrop-filter:blur(16px) saturate(1.25);-webkit-backdrop-filter:blur(16px) saturate(1.25);
  box-shadow:0 1px 0 rgba(255,255,255,0.06) inset, 0 4px 16px rgba(0,0,0,0.12);
}
#sourceTabs .sr-indicator{
  position:absolute;top:4px;bottom:4px;left:0;
  width:0;border-radius:980px;background:#fff;
  box-shadow:0 2px 10px rgba(0,0,0,.22), 0 1px 0 rgba(255,255,255,.55) inset;
  pointer-events:none;z-index:0;
  /* 参考 av 切站源：带轻微过冲的弹性曲线 */
  transition:transform .34s cubic-bezier(.34,1.4,.5,1), width .34s cubic-bezier(.34,1.4,.5,1);
  will-change:transform,width;
}
#sourceTabs .sr-tab,#sourceTabs .sr-tab[data-src]{
  position:relative;z-index:1;
  padding:10px 18px;margin:0;border-radius:980px;font-size:14.5px;font-weight:600;
  color:rgba(235,235,245,0.58);background:transparent!important;border:none;
  box-shadow:none!important;
  transition:color .28s ease, transform .28s var(--ease-spring);
  letter-spacing:0.01em;
  min-width:52px;text-align:center;
}
#sourceTabs .sr-tab:active{transform:scale(0.96);}
#sourceTabs .sr-tab.active[data-src],
#sourceTabs .sr-tab.active[data-src=&quot;qq&quot;],
#sourceTabs .sr-tab.active[data-src=&quot;kuwo&quot;],
#sourceTabs .sr-tab.active[data-src=&quot;netease&quot;],
#sourceTabs .sr-tab.active[data-src=&quot;kugou&quot;],
#sourceTabs .sr-tab.active[data-src=&quot;ytmusic&quot;]{
  color:#111!important;background:transparent!important;border:none;
  box-shadow:none!important;
  font-weight:700;
}
#plTabs.sr-tabs,.hscroll#plTabs{align-items:center;flex-wrap:nowrap;gap:10px;}
#hotTags{
  display:flex;flex-wrap:wrap;justify-content:center;align-items:center;
  gap:8px;margin:18px auto 0;max-width:560px;padding:0 8px;
  width:100%;box-sizing:border-box;
}
.hot-search-tag{
  padding:8px 14px;border-radius:12px;font-size:13px;
  background:rgba(118,118,128,0.16);color:var(--text-1);font-weight:500;
  margin:0;flex:0 0 auto;text-align:center;
}

/* ============================================================
   MINE / LOGIN-STATE PAGE
   ============================================================ */
.mine-header{display:flex;align-items:center;gap:14px;padding:16px 4px;}
.mine-avatar{width:74px;height:74px;border-radius:50%;overflow:hidden;background:var(--bg-2);border:2px solid var(--glass-border);flex-shrink:0;}
.mine-avatar img{width:100%;height:100%;object-fit:cover;}
.mine-name{font-size:19px;font-weight:700;line-height:1.3;}
.mine-uin{font-size:12px;color:var(--text-2);margin-top:4px;line-height:1.4;}
.detail-header{display:flex;align-items:center;gap:14px;padding:10px 2px 6px;}
.detail-cover{width:88px;height:88px;border-radius:14px;overflow:hidden;flex-shrink:0;background:var(--bg-2);}
.detail-cover img{width:100%;height:100%;object-fit:cover;display:block;}
.detail-meta{flex:1;min-width:0;}
.detail-title{font-size:17px;font-weight:700;line-height:1.35;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.detail-sub{font-size:11.5px;color:var(--text-2);margin-top:4px;line-height:1.4;}
.detail-desc{font-size:11.5px;color:var(--text-2);margin-top:6px;line-height:1.5;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.detail-play-all{flex-shrink:0;padding:9px 14px;font-size:12.5px;}
.mine-vip{display:inline-flex;align-items:center;gap:4px;font-size:11px;background:linear-gradient(90deg,#ffd60a,#ff9f0a);color:#1c1200;
  padding:3px 10px;border-radius:100px;margin-top:6px;font-weight:700;}
.mine-logout{margin-left:auto;font-size:12px;color:var(--text-2);padding:8px 16px;border-radius:100px;background:var(--glass);}
/* 自建 / 收藏歌单并排切换（对齐官方「自建歌单 | 收藏歌单」） */
.mine-pl-tabs{display:flex;align-items:center;gap:0;margin:4px 0 14px;padding:0 2px;user-select:none;-webkit-user-select:none;}
.mine-pl-tab{font-size:16px;font-weight:600;color:var(--text-2);padding:4px 2px;cursor:pointer;transition:color .2s var(--ease);line-height:1.3;background:none;border:none;}
.mine-pl-tab.active{color:var(--text-0);font-weight:700;}
.mine-pl-tab:active{opacity:.75;}
.mine-pl-sep{font-size:14px;color:var(--text-2);margin:0 10px;opacity:.55;font-weight:400;pointer-events:none;}
.mine-pl-pane{display:none;}
.mine-pl-pane.active{display:grid;}

/* ============================================================
   TOAST / MODAL
   ============================================================ */
#toast{position:fixed;left:50%;bottom:120px;transform:translate(-50%,20px);z-index:99;padding:12px 22px;
  border-radius:14px;background:rgba(44,44,46,.94);backdrop-filter:blur(20px) saturate(1.4);font-size:14px;
  opacity:0;pointer-events:none;transition:transform .5s var(--ease-spring),opacity .3s var(--ease);border:1px solid rgba(255,255,255,.08);
  box-shadow:0 8px 30px rgba(0,0,0,.4);font-weight:500;}
#toast.show{opacity:1;transform:translate(-50%,0);}

.sheet-mask{position:fixed;inset:0;z-index:38;background:rgba(0,0,0,.5);opacity:0;pointer-events:none;transition:opacity .3s;}
.sheet-mask.show{opacity:1;pointer-events:auto;}

/* ============================================================
   TV MODE
   ============================================================ */
html.tv-mode #topbar{padding:34px 54px 18px;grid-template-columns:44px minmax(0,1fr) 44px;column-gap:16px;}
html.tv-mode .brand{width:44px;height:44px;}
html.tv-mode .brand-mark{width:44px;height:44px;border-radius:13px;}
html.tv-mode .brand-mark svg{width:28px;height:28px;}
html.tv-mode .search-box{height:44px;padding:0 18px;border-radius:999px;}
html.tv-mode .avatar-btn{width:44px;height:44px;}
html.tv-mode .view{padding:6px 54px calc(112px + var(--safe-b));}

/* ---------- 首页下拉刷新 ---------- */
.home-ptr{
  position:absolute;left:0;right:0;top:0;height:0;overflow:visible;
  display:flex;align-items:flex-end;justify-content:center;
  pointer-events:none;z-index:5;
}
.home-ptr-inner{
  display:flex;align-items:center;justify-content:center;gap:8px;
  padding:0 0 10px;min-height:0;
  color:var(--text-2);font-size:13px;font-weight:500;
  opacity:0;transform:translateY(-8px);
  transition:opacity .15s ease;
}
.home-ptr.show .home-ptr-inner{opacity:1;transform:translateY(0);}
.home-ptr.ready .home-ptr-inner{color:var(--text-0);}
.home-ptr.loading .home-ptr-inner{opacity:1;}
.home-ptr-spinner{
  width:16px;height:16px;border-radius:50%;
  border:2px solid rgba(128,128,128,.25);
  border-top-color:var(--text-0, #111);
  box-sizing:border-box;
  opacity:0;
}
.home-ptr.loading .home-ptr-spinner{
  opacity:1;
  animation:homePtrSpin .7s linear infinite;
}
@keyframes homePtrSpin{to{transform:rotate(360deg);}}
#view-home.ptr-pulling{overflow-y:hidden;}

html.tv-mode .nav-item{padding:12px 24px;font-size:16px;}
html.tv-mode .avatar-btn{display:none;} /* TV 端保留搜索框 */
html.tv-mode .card,html.tv-mode .mv-card{width:180px;}
html.tv-mode .card-cover,html.tv-mode .mv-cover{width:180px;}
html.tv-mode .mv-cover{height:100px;}
html.tv-mode *{transition:transform .18s var(--ease) !important;}
html.tv-mode .grain,html.tv-mode #grain{display:none;}
.tv-focus{outline:none;transform:scale(1.08);z-index:5;box-shadow:0 0 0 3px var(--green),0 16px 40px -10px rgba(0,0,0,.6);
  border-radius:var(--radius-m);}

@media (max-width:400px){
  #playerBar .pb-meta{min-width:64px;flex:1 1 0;max-width:calc(100% - 140px);}
  #playerBar #pbModeBtn{display:none;}
  #playerBar #pbQuality{display:none;}
  #playerBar .pb-ctrls{gap:2px;}
  #playerBar .pb-title{font-size:14px;}
  #playerBar .pb-artist{font-size:11.5px;}
}
html.tv-mode #playerBar{
  gap:14px;padding:14px 20px;margin:0 24px calc(14px + var(--safe-b));width:auto;
  border-radius:999px;border:1px solid rgba(255,255,255,.16);
  min-height:72px;
}
html.tv-mode .pb-cover{width:56px;height:56px;}
html.tv-mode .pb-meta{width:auto;flex:1;min-width:0;max-width:none;}
html.tv-mode .pb-like{display:none;}
html.tv-mode .pb-center{max-width:none;flex:0 0 auto;gap:4px;}
html.tv-mode .pb-progress{display:none;}
html.tv-mode .pb-right{display:none;}
html.tv-mode .pb-mini-progress{display:block;border-radius:999px 999px 0 0;overflow:hidden;left:22px;right:22px;width:auto;}

html:not(.tv-mode) .tv-only{display:none !important;}
html.tv-mode .mobile-only{display:none !important;}

/* ---------- 手机竖屏 / 窄屏 ---------- */
@media (max-width:860px){
  #mainNav{display:none;}
  #topbar{column-gap:10px;padding:calc(10px + var(--safe-t)) 14px 8px;
    grid-template-columns:34px minmax(0,1fr) 34px;}
  .brand{width:34px;height:34px;}
  .brand-mark{width:34px;height:34px;border-radius:10px;}
  .brand-mark svg{width:18px;height:18px;}
  .search-box{height:34px;padding:0 12px;border-radius:999px;}
  .avatar-btn{width:34px;height:34px;}
  .view{padding:6px 14px calc(68px + var(--safe-b));}
  .hero{height:200px;}
  .hero-info{left:18px;bottom:18px;right:18px;}
  .hero-title{font-size:20px;max-width:90%;}
  .hero-desc{display:none;}
  .hero-dots{right:18px;bottom:20px;}
  .rank-grid{grid-template-columns:1fr;}
  .grid-cols{grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:14px 12px;}
  .hscroll .card,.hscroll .card-cover{width:110px;}
  .hscroll .card-cover{height:110px;}
  .grid-cols{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px 11px;}
  .grid-cols .card{width:100%;}
  .grid-cols .card-cover{width:100%;height:auto;aspect-ratio:1/1;}
  .mv-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 10px;}
  .mv-grid .mv-card{width:100%;}
  .mv-grid .mv-cover{width:100%;height:auto;aspect-ratio:16/9;}
  .hscroll .mv-card,.hscroll .mv-cover{width:160px;}
  .hscroll .mv-cover{height:90px;}
  .sec{margin:14px 0 10px;}
  .view{padding-bottom:calc(88px + var(--safe-b));}
  /* 迷你播放栏已统一为全局胶囊样式 */
  .pb-icon-btn{display:none;}
  .login-card{padding:28px 22px 24px;width:min(360px,92vw);}
  .sec{margin:18px 0 12px;}
  .detail-header{gap:12px;padding:6px 0 4px;align-items:center;}
  .detail-cover{width:72px;height:72px;border-radius:12px;}
  .detail-title{font-size:15px;}
  .detail-sub{font-size:11px;}
  .detail-desc{-webkit-line-clamp:2;margin-top:4px;}
  .detail-play-all{padding:8px 12px;font-size:12px;}
  .mine-header{padding:12px 2px;gap:12px;}
  .mine-avatar{width:56px;height:56px;}
  .mine-name{font-size:16px;}

  /* 全屏播放器：竖屏 — 原盘下移，歌词/列表区下移并填满控件上方空白 */
  #fullPlayer{flex-direction:column;}
  /* 封面区：原盘整体下移，底部留出与歌词区的间隔，避免重叠 */
  .fp-left{
    display:flex;width:100%;flex:0 0 auto;
    padding:calc(82px + var(--safe-t)) 16px 14px;
    gap:0;justify-content:center;align-items:center;order:1;
    position:relative;z-index:2;
  }
  .fp-art{width:100%;align-items:center;}
  .fp-art-stage{
    width:min(62vw,260px)!important;
    height:min(62vw,260px)!important;
  }
  /* 底部操作区：固定贴底 */
  .fp-dock{
    position:absolute;left:0;right:0;bottom:0;
    z-index:30;
    display:flex!important;flex-direction:column;align-items:center;
    width:100%;box-sizing:border-box;
    padding:10px 18px calc(10px + var(--safe-b));
    background:linear-gradient(180deg, rgba(245,240,248,0) 0%, rgba(245,240,248,.92) 28%, rgba(245,240,248,.98) 100%);
  }
  .fp-dock .fp-quick{
    display:flex!important;align-items:center;justify-content:center;
    gap:28px;margin:8px 0 0;width:100%;
  }
  .fp-dock .fp-quick button{
    width:40px;height:40px;flex-shrink:0;
    color:#1c1c1e!important;opacity:1!important;
  }
  .fp-dock .fp-quick button svg{width:20px;height:20px;}
  .fp-dock .fp-quality-btn{font-size:13px!important;color:#1c1c1e!important;}
  .fp-dock .fp-controls{
    display:flex!important;flex-direction:column;align-items:center;
    width:100%;max-width:100%;
    gap:16px;margin:0;padding:0;
    box-sizing:border-box;
  }
  .fp-dock .fp-progress{display:flex!important;width:100%;align-items:center;gap:8px;}
  .fp-dock .fp-ctrls{
    display:flex!important;align-items:center;justify-content:center;
    gap:36px;width:100%;
  }
  .fp-dock .fp-ctrl-btn{
    width:48px;height:48px;color:#1c1c1e!important;opacity:1!important;
  }
  .fp-dock .fp-ctrl-btn svg{width:24px;height:24px;}
  .fp-dock .fp-play{
    width:56px;height:56px;flex-shrink:0;
    background:#1c1c1e!important;color:#fff!important;
    box-shadow:0 6px 20px rgba(0,0,0,.2);
  }
  .fp-dock .fp-play svg{width:24px;height:24px;color:#fff!important;}
  .fp-dock .fp-time{color:rgba(28,28,30,.55)!important;}
  /* 歌词/列表区：下移并与原盘/波形拉开间距，填满控件上方空白 */
  .fp-right{
    width:100%;
    flex:1 1 auto;
    min-height:0;
    padding:46px 16px 0;
    margin-bottom:calc(150px + var(--safe-b));
    display:flex;flex-direction:column;
    order:2;position:relative;z-index:1;
    overflow:hidden;
  }
  .fp-tabs{justify-content:center;gap:28px;margin-bottom:2px;flex-shrink:0;}
  #lyricsWrap,#playlistPanel{
    flex:1 1 auto;min-height:0;max-height:22vh;
    overflow-y:auto;-webkit-overflow-scrolling:touch;
  }
  .lyric-line{font-size:13px;line-height:1.55;padding:1px 6px;}
  .lyric-line.active{font-size:18px;}
  #lyricsWrap,#playlistPanel{
    flex:1 1 auto;min-height:0;max-height:none;
    mask-image:linear-gradient(180deg,transparent 0,#000 6%,#000 94%,transparent 100%);
    -webkit-mask-image:linear-gradient(180deg,transparent 0,#000 6%,#000 94%,transparent 100%);
  }
  .lyric-line{font-size:14px;line-height:1.7;padding:3px 6px;}
  .lyric-line.active{font-size:20px;}
}

/* ---------- 横屏播放页：左右 50:50；封面+控件更大（竖屏不动） ---------- */
#fullPlayer.is-landscape{
  flex-direction:row!important;
}
#fullPlayer.is-landscape #fpBg{
  position:absolute!important;inset:0!important;width:100%!important;height:100%!important;
  z-index:0!important;
}

#fullPlayer.is-landscape .fp-left{
  width:50%!important;max-width:none!important;height:100%!important;
  flex:0 0 50%!important;
  padding:calc(12px + var(--safe-t)) 20px calc(140px + var(--safe-b))!important;
  gap:10px!important;justify-content:center!important;align-items:center!important;
  position:relative!important;z-index:2!important;
  order:0!important;margin:0!important;
  box-sizing:border-box!important;overflow:hidden!important;
}
#fullPlayer.is-landscape .fp-art-stage{
  width:min(52vh,280px)!important;height:min(52vh,280px)!important;
}
/* 顶栏只留关闭按钮，限定左半区，避免与右侧 Tab 叠加 */
#fullPlayer.is-landscape .fp-topbar{
  position:absolute!important;left:0!important;right:auto!important;
  width:50%!important;max-width:none!important;top:0!important;
  justify-content:flex-start!important;align-items:center!important;
  z-index:8!important;pointer-events:none!important;
  min-height:calc(44px + var(--safe-t))!important;
  padding-left:12px!important;
}
#fullPlayer.is-landscape .fp-topbar .fp-close{pointer-events:auto!important;}
#fullPlayer.is-landscape .fp-topbar .fp-track-info,
#fullPlayer.is-landscape .fp-topbar .fp-top-spacer{display:none!important;}
/* 右半：歌词 / 列表 */
#fullPlayer.is-landscape .fp-right{
  flex:0 0 50%!important;width:50%!important;max-width:50%!important;height:100%!important;
  padding:calc(14px + var(--safe-t)) 24px calc(14px + var(--safe-b))!important;
  position:relative!important;z-index:5!important;isolation:isolate!important;
  box-sizing:border-box!important;overflow:hidden!important;
  order:0!important;margin:0!important;
  display:flex!important;flex-direction:column!important;background:transparent!important;
}
#fullPlayer.is-landscape .fp-tabs{
  margin-bottom:10px!important;justify-content:flex-start!important;
  position:relative!important;z-index:2!important;flex-shrink:0!important;gap:24px!important;
}
#fullPlayer.is-landscape #lyricsWrap,
#fullPlayer.is-landscape #playlistPanel{
  position:relative!important;z-index:1!important;
  flex:1 1 auto!important;min-height:0!important;max-height:none!important;margin:0!important;
}
#fullPlayer.is-landscape .lyric-line{font-size:15px!important;line-height:1.75!important;text-align:left!important;padding:3px 6px!important;}
#fullPlayer.is-landscape .lyric-line.active{font-size:22px!important;}
/* dock 钉在左半区底部，控件加大 */
#fullPlayer.is-landscape .fp-left,
#fullPlayer.is-landscape .fp-right{
  background:transparent!important;
}
#fullPlayer.is-landscape .fp-dock{
  position:absolute!important;left:0!important;right:auto!important;
  width:50%!important;max-width:none!important;bottom:0!important;
  padding:10px 20px calc(12px + var(--safe-b))!important;
  box-sizing:border-box!important;z-index:6!important;
  /* 横屏不铺半幅底色，避免与整页 #fpBg 渐变在中线割裂 */
  background:transparent!important;
  display:flex!important;flex-direction:column!important;align-items:center!important;
}
#fullPlayer.is-landscape .fp-dock .fp-controls{width:100%!important;max-width:100%!important;gap:12px!important;margin:0!important;}
#fullPlayer.is-landscape .fp-dock .fp-ctrls{gap:28px!important;}
#fullPlayer.is-landscape .fp-dock .fp-play{width:56px!important;height:56px!important;}
#fullPlayer.is-landscape .fp-dock .fp-ctrl-btn{width:46px!important;height:46px!important;}
#fullPlayer.is-landscape .fp-dock .fp-ctrl-btn svg{width:22px!important;height:22px!important;}
#fullPlayer.is-landscape .fp-dock .fp-play svg{width:22px!important;height:22px!important;}
#fullPlayer.is-landscape .fp-dock .fp-progress{gap:8px!important;width:100%!important;}
#fullPlayer.is-landscape .fp-dock .fp-bar{height:5px!important;}
#fullPlayer.is-landscape .fp-dock .fp-time{font-size:11px!important;width:34px!important;}
#fullPlayer.is-landscape .fp-dock .fp-quick{gap:20px!important;margin-top:8px!important;width:100%!important;}
#fullPlayer.is-landscape .fp-dock .fp-quick button{width:34px!important;height:34px!important;}
#fullPlayer.is-landscape .fp-dock .fp-quick button svg{width:18px!important;height:18px!important;}
@media (max-width:860px) and (orientation:landscape){
  #playerBar{padding:10px 12px;margin:0 10px calc(8px + var(--safe-b));gap:8px;}
  #playerBar .pb-meta{min-width:72px;flex:1 1 0;max-width:calc(100% - 160px);}
  #playerBar .pb-center{max-width:none;flex:0 0 auto;}
  #playerBar .pb-ctrls{gap:4px;}
  #playerBar .pb-ctrl-btn{width:36px;height:36px;}
  #playerBar .pb-ctrl-btn svg{width:20px;height:20px;}
  #playerBar .pb-play{width:44px;height:44px;}
  #playerBar .pb-play svg{width:20px;height:20px;}
  #playerBar .pb-cover{
    width:64px!important;height:64px!important;
    margin:-10px 0 -10px -20px!important;
  }
  #playerBar .pb-title{font-size:15px;}
  #playerBar .pb-artist{font-size:12px;}
  /* 窄屏：压缩两侧控件，把横向空间留给歌名/歌手 */
  #playerBar #pbModeBtn{width:32px;height:32px;}
  #playerBar #pbQuality{width:auto;min-width:32px;padding:0 4px;font-size:11px;}
  .view{padding:6px 14px calc(60px + var(--safe-b));}
  .hero{height:140px;}
}
@media (min-width:861px){
  #fullPlayer.is-landscape .fp-left,
  #fullPlayer.is-landscape .fp-topbar,
  #fullPlayer.is-landscape .fp-dock{width:50%!important;max-width:none!important;}
  #fullPlayer.is-landscape .fp-left{flex-basis:50%!important;}
  #fullPlayer.is-landscape .fp-right{width:50%!important;flex:0 0 50%!important;max-width:50%!important;}
  #fullPlayer.is-landscape .fp-art-stage{
    width:min(56vh,320px)!important;height:min(56vh,320px)!important;
  }
}

/* CSS 横屏兜底（不依赖 JS class）：短屏或 orientation:landscape */
@media (orientation:landscape), (max-height:520px) and (min-width:500px){
  /* 仅横屏/矮屏：左右 50:50；竖屏由下方 portrait 规则与 :not(.is-landscape) 保护 */
  #fullPlayer.show.is-landscape .fp-topbar .fp-track-info,
  #fullPlayer.show.is-landscape .fp-topbar .fp-top-spacer,
  #fullPlayer.show:not(.lyrics-focus).is-landscape .fp-topbar .fp-track-info{display:none!important;}
  #fullPlayer.show.is-landscape{flex-direction:row!important;}
  #fullPlayer.show.is-landscape .fp-left{
    width:50%!important;max-width:none!important;height:100%!important;
    flex:0 0 50%!important;
    padding:calc(12px + var(--safe-t)) 20px calc(140px + var(--safe-b))!important;
    justify-content:center!important;order:0!important;margin:0!important;
    box-sizing:border-box!important;overflow:hidden!important;
  }
  #fullPlayer.show.is-landscape .fp-art-stage{width:min(52vh,280px)!important;height:min(52vh,280px)!important;}
  #fullPlayer.show.is-landscape .fp-topbar{
    right:auto!important;width:50%!important;max-width:none!important;
    justify-content:flex-start!important;
  }
  #fullPlayer.show.is-landscape .fp-right{
    flex:0 0 50%!important;width:50%!important;max-width:50%!important;height:100%!important;
    padding:calc(14px + var(--safe-t)) 24px calc(14px + var(--safe-b))!important;
    position:relative!important;z-index:5!important;isolation:isolate!important;
    overflow:hidden!important;display:flex!important;flex-direction:column!important;
    margin:0!important;order:0!important;
  }
  #fullPlayer.show.is-landscape .fp-tabs{justify-content:flex-start!important;margin-bottom:10px!important;flex-shrink:0!important;}
  #fullPlayer.show.is-landscape #lyricsWrap,
  #fullPlayer.show.is-landscape #playlistPanel{flex:1 1 auto!important;min-height:0!important;max-height:none!important;}
  #fullPlayer.show.is-landscape .fp-left,
  #fullPlayer.show.is-landscape .fp-right{background:transparent!important;}
  #fullPlayer.show.is-landscape .fp-dock{
    position:absolute!important;left:0!important;right:auto!important;
    width:50%!important;max-width:none!important;bottom:0!important;
    padding:10px 20px calc(12px + var(--safe-b))!important;
    box-sizing:border-box!important;z-index:6!important;
    background:transparent!important;
  }
  #fullPlayer.show.is-landscape .fp-dock .fp-play{width:56px!important;height:56px!important;}
  #fullPlayer.show.is-landscape .fp-dock .fp-ctrl-btn{width:46px!important;height:46px!important;}
  #fullPlayer.show.is-landscape .fp-dock .fp-ctrl-btn svg{width:22px!important;height:22px!important;}
  #fullPlayer.show.is-landscape .fp-dock .fp-play svg{width:22px!important;height:22px!important;}
}
/* 竖屏强制恢复（避免横屏规则残留） */
@media (orientation:portrait) and (max-width:860px){
  #fullPlayer.show:not(.is-landscape){flex-direction:column!important;}
}


/* 桌面端：全屏播放器控制区可隐藏（已有底部栏），仍保留便于统一逻辑 */
@media (min-width:861px){
  .fp-controls{margin-top:4px;}
  /* 顶栏歌名限制在左侧，避免与右侧歌词 Tab 叠加 */
  #fullPlayer .fp-topbar{
    right:auto!important;
    width:50%!important;
    justify-content:flex-start;
    gap:10px;
  }
  #fullPlayer .fp-topbar .fp-top-spacer{display:none!important;}
  #fullPlayer .fp-topbar .fp-track-info{
    align-items:flex-start!important;
    text-align:left!important;
  }
  #fullPlayer .fp-topbar .fp-track-name,
  #fullPlayer .fp-topbar .fp-track-artist{text-align:left!important;}
  #fullPlayer .fp-right{
    position:relative;z-index:4;isolation:isolate;
  }
}
/* 桌面端：底部操作区在左侧封面下方 */
@media (min-width:861px){
  #fullPlayer .fp-dock{
    position:absolute;left:0;bottom:20px;width:50%;
    padding:0 28px;box-sizing:border-box;z-index:3;
    background:transparent;
  }
  #fullPlayer .fp-left{width:50%;flex:0 0 50%;padding-bottom:160px;}
  #fullPlayer .fp-right{width:50%;flex:0 0 50%;}
  #fullPlayer .fp-dock .fp-quick{margin-top:12px;margin-bottom:0;}
}


/* 暗色模式 · 播放页底部 dock 覆盖（需在移动端媒体查询之后） */
html[data-mode=&quot;dark&quot;] .fp-dock,
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-dock{
  background:linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,.9) 22%, #000 100%)!important;
}
/* 竖屏 / 非横屏：dock 底部渐变；横屏保持透明以免中线割裂 */
html[data-mode=&quot;dark&quot;] #fullPlayer.show:not(.is-landscape) .fp-dock{
  background:linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,.85) 28%, #000 100%)!important;
}
html[data-mode=&quot;dark&quot;] #fullPlayer.is-landscape .fp-dock,
html[data-mode=&quot;dark&quot;] #fullPlayer.is-landscape .fp-left,
html[data-mode=&quot;dark&quot;] #fullPlayer.is-landscape .fp-right{
  background:transparent!important;
}

html[data-mode=&quot;dark&quot;] .fp-dock .fp-quick button,
html[data-mode=&quot;dark&quot;] .fp-dock .fp-ctrl-btn,
html[data-mode=&quot;dark&quot;] .fp-dock .fp-quality-btn,
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-dock .fp-quick button,
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-dock .fp-ctrl-btn,
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-dock .fp-quality-btn{
  color:#fff!important;
}
html[data-mode=&quot;dark&quot;] .fp-dock .fp-time,
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-dock .fp-time{
  color:rgba(235,235,245,.55)!important;
}
html[data-mode=&quot;dark&quot;] .fp-dock .fp-play,
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-dock .fp-play{
  background:#fff!important;color:#111!important;
  box-shadow:0 6px 20px rgba(0,0,0,.5)!important;
}
html[data-mode=&quot;dark&quot;] .fp-dock .fp-play svg,
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-dock .fp-play svg{
  color:#111!important;
}
html[data-mode=&quot;dark&quot;] .fp-dock .fp-bar,
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-dock .fp-bar{
  background:rgba(255,255,255,.2)!important;
}
html[data-mode=&quot;dark&quot;] .fp-dock .fp-bar-fill,
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-dock .fp-bar-fill{
  background:#fff!important;
}
html[data-mode=&quot;dark&quot;] .fp-dock .fp-bar-knob,
html[data-mode=&quot;dark&quot;] #fullPlayer .fp-dock .fp-bar-knob{
  background:#fff!important;
}

&lt;/style&gt;

&lt;script&gt;
/* 首屏前同步读登录态，避免登录页闪一下；默认直接进主页，不强制弹登录框 */
(function(){
  try{
    var raw = localStorage.getItem(&quot;qqm_user&quot;);
    if (raw &amp;&amp; raw !== &quot;null&quot; &amp;&amp; raw !== &quot;{}&quot;){
      var u = JSON.parse(raw);
      if (u &amp;&amp; (u.uin || u.cookie)) document.documentElement.classList.add(&quot;qqm-authed&quot;);
    }
  }catch(e){}
  /* 默认跳过登录闪屏，直接进主页；需要登录时再点头像打开 */
  try{
    document.documentElement.classList.add(&quot;qqm-authed&quot;);
    if (localStorage.getItem(&quot;qqm_skip_login&quot;) !== &quot;1&quot;) {
      localStorage.setItem(&quot;qqm_skip_login&quot;, &quot;1&quot;);
    }
  }catch(e2){}
})();
&lt;/script&gt;
&lt;style&gt;
html.qqm-authed #loginView{display:none!important;visibility:hidden!important;}
&lt;/style&gt;
&lt;/head&gt;
&lt;body&gt;
&lt;!-- icon sprite --&gt;
&lt;svg style=&quot;display:none&quot;&gt;
&lt;symbol id=&quot;i-play&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M8 5v14l11-7z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-pause&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M6 5h4v14H6zM14 5h4v14h-4z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-prev&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M6 6h2v12H6zM20 6v12l-10-6z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-next&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M16 6h2v12h-2zM4 6v12l10-6z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-heart&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M12 20.5l-1.45-1.32C5.4 14.36 2 11.28 2 7.5 2 4.42 4.42 2 7.5 2c1.74 0 3.41.81 4.5 2.09C13.09 2.81 14.76 2 16.5 2 19.58 2 22 4.42 22 7.5c0 3.78-3.4 6.86-8.55 11.68L12 20.5z&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;1.8&quot; stroke-linejoin=&quot;round&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-heart-fill&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M12 20.5l-1.45-1.32C5.4 14.36 2 11.28 2 7.5 2 4.42 4.42 2 7.5 2c1.74 0 3.41.81 4.5 2.09C13.09 2.81 14.76 2 16.5 2 19.58 2 22 4.42 22 7.5c0 3.78-3.4 6.86-8.55 11.68L12 20.5z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-search&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M15.5 14h-.8l-.3-.3a6.5 6.5 0 1 0-.7.7l.3.3v.8l5 5 1.5-1.5zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-close&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M18.3 5.7L12 12l6.3 6.3-1.4 1.4L10.6 13.4 4.3 19.7l-1.4-1.4L9.2 12 2.9 5.7l1.4-1.4L10.6 10.6l6.3-6.3z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-more&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;circle cx=&quot;5&quot; cy=&quot;12&quot; r=&quot;2&quot; fill=&quot;currentColor&quot;/&gt;&lt;circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;2&quot; fill=&quot;currentColor&quot;/&gt;&lt;circle cx=&quot;19&quot; cy=&quot;12&quot; r=&quot;2&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-vol&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M4 9v6h4l5 5V4L8 9H4z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-vol0&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M4 9v6h4l5 5V4L8 9H4zm12.7-1.8l1.4 1.4-2.4 2.4 2.4 2.4-1.4 1.4-2.4-2.4-2.4 2.4-1.4-1.4 2.4-2.4-2.4-2.4 1.4-1.4 2.4 2.4z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-list&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M4 6h16v2H4zM4 11h16v2H4zM4 16h10v2H4z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;!-- 播放模式：顺序（箭头序列，与列表三横线区分） / 随机 / 单曲循环 --&gt;
&lt;symbol id=&quot;i-order&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M4 7h9v2H4V7zm0 4h9v2H4v-2zm0 4h6v2H4v-2zm12.5-8.5V5L21 9l-4.5 4v-2.5H13v-3h3.5zM17.5 14.5V13L21 17l-3.5 4v-2.5H13v-3h4.5z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-shuffle&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-repeat&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-repeat-one&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4zm-4-2V9h-1l-2 1v1h1.5v4H13z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-download&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M11 4h2v9l3.5-3.5 1.4 1.4L12 16.8l-5.9-5.9 1.4-1.4L11 13V4zM5 19h14v2H5z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-add&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-play-fill&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;circle cx=&quot;12&quot; cy=&quot;12&quot; r=&quot;11&quot; fill=&quot;currentColor&quot; opacity=&quot;.15&quot;/&gt;&lt;path d=&quot;M10 8.5v7l6-3.5z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-back&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M15 5l-7 7 7 7 1.4-1.4L10.8 12l5.6-5.6z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-chevdown&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M12 15.5L4.5 8l1.4-1.4L12 12.7l6.1-6.1L19.5 8z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-user&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;circle cx=&quot;12&quot; cy=&quot;8&quot; r=&quot;4&quot; fill=&quot;currentColor&quot;/&gt;&lt;path d=&quot;M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-note&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M9 3v11.6A3.5 3.5 0 1 0 11 18V8h6V5h-2V3z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-fire&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M12 2s5 4.5 5 9.5A5 5 0 0 1 7 11.5c0-1 .3-1.9.8-2.7-.3 1.6 0 2.8 1 3.3-.6-2.3.5-4.3 2.2-5.6-.2 1 0 1.9.6 2.6C11 6.5 12 4 12 2z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/symbol&gt;
&lt;symbol id=&quot;i-empty&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M9 3v11.6A3.5 3.5 0 1 0 11 18V8h6V5h-2V3z&quot; fill=&quot;currentColor&quot; opacity=&quot;.5&quot;/&gt;&lt;/symbol&gt;
&lt;/svg&gt;

&lt;div id=&quot;ambientBg&quot;&gt;&lt;/div&gt;
&lt;div id=&quot;ambientVeil&quot;&gt;&lt;/div&gt;
&lt;div id=&quot;grain&quot;&gt;&lt;/div&gt;

&lt;!-- ============ LOGIN ============ --&gt;
&lt;div id=&quot;loginView&quot; class=&quot;hidden&quot;&gt;
  &lt;div class=&quot;login-card&quot; style=&quot;position:relative&quot;&gt;
    &lt;button type=&quot;button&quot; id=&quot;loginCloseBtn&quot; aria-label=&quot;关闭&quot; style=&quot;position:absolute;right:12px;top:12px;width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.08);color:var(--text-0);font-size:20px;line-height:36px;text-align:center;z-index:2&quot;&gt;×&lt;/button&gt;
    &lt;div class=&quot;login-title&quot;&gt;QQ音乐&lt;/div&gt;
    &lt;div class=&quot;login-sub&quot;&gt;千万正版曲库 · 无损音质 · 畅听无限&lt;/div&gt;

    &lt;div class=&quot;login-pane login-pane-cookie&quot; data-pane=&quot;cookie&quot;&gt;
      &lt;textarea class=&quot;cookie-area&quot; id=&quot;cookieInput&quot; placeholder=&quot;粘贴 Cookie（含 uin 与 qqmusic_key / qm_keyst）&quot;&gt;&lt;/textarea&gt;
      &lt;div class=&quot;login-actions&quot;&gt;
        &lt;button class=&quot;login-btn login-btn-primary&quot; id=&quot;btnLoginCookie&quot; type=&quot;button&quot;&gt;登录&lt;/button&gt;
        &lt;button class=&quot;login-btn login-btn-guest&quot; id=&quot;btnGuest&quot; type=&quot;button&quot;&gt;游客&lt;/button&gt;
      &lt;/div&gt;
      &lt;div class=&quot;login-hint&quot;&gt;在浏览器登录 y.qq.com 后，于开发者工具复制 Cookie 粘贴到上方&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- ============ APP SHELL ============ --&gt;
&lt;div id=&quot;app&quot;&gt;
  &lt;div id=&quot;topbar&quot;&gt;
    &lt;div class=&quot;brand&quot; title=&quot;单击切换明暗 · 长按切换强调色&quot;&gt;&lt;div class=&quot;brand-mark&quot; id=&quot;brandMark&quot; aria-label=&quot;QQ音乐&quot; role=&quot;button&quot;&gt;
      &lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot; aria-hidden=&quot;true&quot;&gt;
        &lt;!-- 光学居中的完整音符（符头略下、符杆居中） --&gt;
        &lt;path d=&quot;M11.2 3.1v10.35c-.55-.3-1.18-.47-1.85-.47-2.05 0-3.7 1.55-3.7 3.46 0 1.91 1.65 3.46 3.7 3.46s3.7-1.55 3.7-3.46V7.05h3.75V3.1H11.2z&quot;/&gt;
      &lt;/svg&gt;
      &lt;span class=&quot;logo-hint&quot; id=&quot;logoHint&quot;&gt;&lt;/span&gt;
    &lt;/div&gt;&lt;div class=&quot;brand-name&quot;&gt;QQ音乐&lt;/div&gt;&lt;/div&gt;
    &lt;nav id=&quot;mainNav&quot;&gt;
      &lt;div class=&quot;nav-item active&quot; data-view=&quot;home&quot;&gt;推荐&lt;/div&gt;
      &lt;div class=&quot;nav-item&quot; data-view=&quot;toplist&quot;&gt;排行榜&lt;/div&gt;
      &lt;div class=&quot;nav-item&quot; data-view=&quot;playlists&quot;&gt;歌单&lt;/div&gt;
      &lt;div class=&quot;nav-item&quot; data-view=&quot;singers&quot;&gt;歌手&lt;/div&gt;
      &lt;div class=&quot;nav-item&quot; data-view=&quot;radio&quot;&gt;电台&lt;/div&gt;
      &lt;div class=&quot;nav-item&quot; data-view=&quot;mv&quot;&gt;MV榜&lt;/div&gt;
      &lt;div class=&quot;nav-item&quot; data-view=&quot;mine&quot;&gt;我的&lt;/div&gt;
    &lt;/nav&gt;
    &lt;div id=&quot;topActions&quot;&gt;
      &lt;div class=&quot;search-box glass&quot; id=&quot;searchBox&quot;&gt;
        &lt;svg&gt;&lt;use href=&quot;#i-search&quot;/&gt;&lt;/svg&gt;
        &lt;input id=&quot;searchInput&quot; placeholder=&quot;歌曲、歌手、歌单&quot; autocomplete=&quot;off&quot;&gt;
      &lt;/div&gt;
      &lt;div class=&quot;avatar-btn glass&quot; id=&quot;avatarBtn&quot;&gt;&lt;img id=&quot;avatarImg&quot; src=&quot;&quot; alt=&quot;&quot;&gt;&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;

  &lt;div id=&quot;viewport&quot;&gt;
    &lt;div class=&quot;view active&quot; id=&quot;view-home&quot; data-view=&quot;home&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;view&quot; id=&quot;view-toplist&quot; data-view=&quot;toplist&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;view&quot; id=&quot;view-playlists&quot; data-view=&quot;playlists&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;view&quot; id=&quot;view-singers&quot; data-view=&quot;singers&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;view&quot; id=&quot;view-radio&quot; data-view=&quot;radio&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;view&quot; id=&quot;view-mv&quot; data-view=&quot;mv&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;view&quot; id=&quot;view-mine&quot; data-view=&quot;mine&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;view&quot; id=&quot;view-search&quot; data-view=&quot;search&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;view&quot; id=&quot;view-detail&quot; data-view=&quot;detail&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;view&quot; id=&quot;view-singerDetail&quot; data-view=&quot;singerDetail&quot;&gt;&lt;/div&gt;
  &lt;/div&gt;

  &lt;div id=&quot;playerBar&quot;&gt;
    &lt;div class=&quot;pb-mini-progress&quot; id=&quot;pbMiniProgress&quot;&gt;&lt;div class=&quot;pb-mini-progress-fill&quot; id=&quot;pbMiniProgressFill&quot;&gt;&lt;/div&gt;&lt;/div&gt;
    &lt;div class=&quot;pb-cover&quot; id=&quot;pbCover&quot;&gt;&lt;img id=&quot;pbCoverImg&quot; alt=&quot;&quot; class=&quot;img-err&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;pb-meta&quot; id=&quot;pbMeta&quot;&gt;
      &lt;div class=&quot;pb-meta-info&quot; id=&quot;pbMetaInfo&quot;&gt;
        &lt;div class=&quot;pb-title&quot; id=&quot;pbTitle&quot;&gt;未播放&lt;/div&gt;
        &lt;div class=&quot;pb-artist&quot; id=&quot;pbArtist&quot;&gt;选择一首歌曲开始&lt;/div&gt;
      &lt;/div&gt;
      &lt;div class=&quot;pb-lyric&quot; id=&quot;pbLyric&quot; aria-live=&quot;polite&quot;&gt;&lt;/div&gt;
    &lt;/div&gt;
    &lt;button type=&quot;button&quot; class=&quot;pb-play&quot; id=&quot;pbPlay&quot; aria-label=&quot;播放/暂停&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-play&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
    &lt;button type=&quot;button&quot; class=&quot;pb-ctrl-btn pb-list-btn&quot; id=&quot;pbListBtn&quot; aria-label=&quot;播放列表&quot; title=&quot;播放列表&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-list&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
    &lt;!-- 隐藏保留节点，兼容旧逻辑 --&gt;
    &lt;button class=&quot;pb-like&quot; id=&quot;pbLike&quot; hidden&gt;&lt;svg&gt;&lt;use href=&quot;#i-heart&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
    &lt;div class=&quot;pb-center&quot; hidden&gt;
      &lt;div class=&quot;pb-ctrls&quot;&gt;
        &lt;button class=&quot;pb-ctrl-btn&quot; id=&quot;pbModeBtn&quot; title=&quot;顺序播放&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-order&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
        &lt;button class=&quot;pb-ctrl-btn&quot; id=&quot;pbPrev&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-prev&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
        &lt;button class=&quot;pb-ctrl-btn&quot; id=&quot;pbNext&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-next&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
        &lt;button class=&quot;pb-ctrl-btn&quot; id=&quot;pbQuality&quot;&gt;SQ&lt;/button&gt;
      &lt;/div&gt;
      &lt;div class=&quot;pb-progress&quot;&gt;
        &lt;span class=&quot;pb-time&quot; id=&quot;pbCur&quot;&gt;00:00&lt;/span&gt;
        &lt;div class=&quot;pb-bar&quot; id=&quot;pbBar&quot;&gt;&lt;div class=&quot;pb-bar-fill&quot; id=&quot;pbBarFill&quot;&gt;&lt;/div&gt;&lt;div class=&quot;pb-bar-knob&quot; id=&quot;pbBarKnob&quot;&gt;&lt;/div&gt;&lt;/div&gt;
        &lt;span class=&quot;pb-time right&quot; id=&quot;pbDur&quot;&gt;00:00&lt;/span&gt;
      &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class=&quot;pb-right&quot; hidden&gt;
      &lt;div class=&quot;pb-vol&quot;&gt;&lt;svg id=&quot;pbVolIcon&quot;&gt;&lt;use href=&quot;#i-vol&quot;/&gt;&lt;/svg&gt;&lt;div class=&quot;pb-vol-bar&quot; id=&quot;pbVolBar&quot;&gt;&lt;div class=&quot;pb-vol-fill&quot; id=&quot;pbVolFill&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;

  &lt;!-- 底部播放列表弹层 --&gt;
  &lt;div class=&quot;queue-sheet-mask&quot; id=&quot;queueSheetMask&quot;&gt;&lt;/div&gt;
  &lt;div class=&quot;queue-sheet&quot; id=&quot;queueSheet&quot; aria-hidden=&quot;true&quot;&gt;
    &lt;div class=&quot;queue-sheet-handle&quot;&gt;&lt;/div&gt;
    &lt;div class=&quot;queue-sheet-head&quot;&gt;
      &lt;div class=&quot;queue-sheet-title&quot;&gt;当前播放 &lt;span id=&quot;queueSheetCount&quot;&gt;0&lt;/span&gt;&lt;/div&gt;
      &lt;button type=&quot;button&quot; class=&quot;queue-sheet-mode&quot; id=&quot;queueSheetMode&quot; title=&quot;播放模式&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-order&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
      &lt;button type=&quot;button&quot; class=&quot;queue-sheet-close&quot; id=&quot;queueSheetClose&quot; aria-label=&quot;关闭&quot;&gt;×&lt;/button&gt;
    &lt;/div&gt;
    &lt;div class=&quot;queue-sheet-list&quot; id=&quot;queueSheetList&quot;&gt;&lt;/div&gt;
  &lt;/div&gt;

  &lt;nav id=&quot;bottomNav&quot; aria-label=&quot;主导航&quot;&gt;
    &lt;button type=&quot;button&quot; class=&quot;nav-item active&quot; data-view=&quot;home&quot;&gt;
      &lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z&quot;/&gt;&lt;/svg&gt;
      &lt;span&gt;推荐&lt;/span&gt;
    &lt;/button&gt;
    &lt;button type=&quot;button&quot; class=&quot;nav-item&quot; data-view=&quot;toplist&quot;&gt;
      &lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M3.5 18.49l6-6.01 4 4L22 6.92l-1.41-1.41-7.09 7.97-4-4L2 16.99z&quot;/&gt;&lt;/svg&gt;
      &lt;span&gt;排行&lt;/span&gt;
    &lt;/button&gt;
    &lt;button type=&quot;button&quot; class=&quot;nav-item&quot; data-view=&quot;playlists&quot;&gt;
      &lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M15 6H3v2h12V6zm0 4H3v2h12v-2zM3 16h8v-2H3v2zM17 6v8.18c-.31-.11-.65-.18-1-.18-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3V8h3V6h-5z&quot;/&gt;&lt;/svg&gt;
      &lt;span&gt;歌单&lt;/span&gt;
    &lt;/button&gt;
    &lt;button type=&quot;button&quot; class=&quot;nav-item&quot; data-view=&quot;singers&quot;&gt;
      &lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z&quot;/&gt;&lt;/svg&gt;
      &lt;span&gt;歌手&lt;/span&gt;
    &lt;/button&gt;
    &lt;button type=&quot;button&quot; class=&quot;nav-item&quot; data-view=&quot;mine&quot;&gt;
      &lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M12 1c-4.97 0-9 4.03-9 9v7c0 1.66 1.34 3 3 3h3v-8H5v-2c0-3.87 3.13-7 7-7s7 3.13 7 7v2h-4v8h3c1.66 0 3-1.34 3-3v-7c0-4.97-4.03-9-9-9z&quot;/&gt;&lt;/svg&gt;
      &lt;span&gt;我的&lt;/span&gt;
    &lt;/button&gt;
  &lt;/nav&gt;
&lt;/div&gt;


&lt;!-- ============ FULL PLAYER ============ --&gt;
&lt;div id=&quot;fullPlayer&quot;&gt;
  &lt;div id=&quot;fpBg&quot;&gt;&lt;/div&gt;
  &lt;div id=&quot;fpOrbs&quot; aria-hidden=&quot;true&quot;&gt;&lt;div class=&quot;fp-orb&quot;&gt;&lt;/div&gt;&lt;div class=&quot;fp-orb&quot;&gt;&lt;/div&gt;&lt;div class=&quot;fp-orb&quot;&gt;&lt;/div&gt;&lt;/div&gt;
  &lt;div class=&quot;fp-topbar&quot;&gt;
    &lt;button class=&quot;fp-close&quot; id=&quot;fpClose&quot; type=&quot;button&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-chevdown&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
    &lt;div class=&quot;fp-track-info&quot;&gt;&lt;div class=&quot;fp-track-name&quot; id=&quot;fpTitle&quot;&gt;未播放&lt;/div&gt;&lt;div class=&quot;fp-track-artist&quot; id=&quot;fpArtist&quot;&gt;—&lt;/div&gt;&lt;/div&gt;
    &lt;div class=&quot;fp-top-spacer&quot; aria-hidden=&quot;true&quot;&gt;&lt;/div&gt;
  &lt;/div&gt;
  &lt;div class=&quot;fp-left&quot;&gt;
    &lt;div class=&quot;fp-art&quot; id=&quot;fpArt&quot; data-style=&quot;vinyl&quot; title=&quot;点击切换封面样式&quot;&gt;
      &lt;div class=&quot;fp-art-stage&quot;&gt;
        &lt;div class=&quot;fp-spectrum-glow&quot; id=&quot;fpSpectrumGlow&quot;&gt;&lt;/div&gt;
        &lt;div class=&quot;fp-spectrum&quot; id=&quot;fpSpectrum&quot;&gt;&lt;/div&gt;
        &lt;div class=&quot;fp-pulse-ring&quot;&gt;&lt;/div&gt;
        &lt;div class=&quot;fp-pulse-ring r2&quot;&gt;&lt;/div&gt;
        &lt;div class=&quot;fp-ring-spin&quot;&gt;&lt;/div&gt;
        &lt;div class=&quot;fp-portal&quot; id=&quot;fpPortal&quot; aria-hidden=&quot;true&quot;&gt;
          &lt;i class=&quot;p1&quot;&gt;&lt;/i&gt;&lt;i class=&quot;p2&quot;&gt;&lt;/i&gt;&lt;i class=&quot;p3&quot;&gt;&lt;/i&gt;
          &lt;span class=&quot;p-core&quot;&gt;&lt;/span&gt;
        &lt;/div&gt;
        &lt;div class=&quot;fp-orbit&quot; id=&quot;fpOrbit&quot; aria-hidden=&quot;true&quot;&gt;
          &lt;i class=&quot;o1&quot;&gt;&lt;/i&gt;&lt;i class=&quot;o2&quot;&gt;&lt;/i&gt;&lt;i class=&quot;o3&quot;&gt;&lt;/i&gt;
          &lt;span class=&quot;o-dot d1&quot;&gt;&lt;/span&gt;&lt;span class=&quot;o-dot d2&quot;&gt;&lt;/span&gt;
        &lt;/div&gt;
        &lt;div class=&quot;fp-holo&quot; id=&quot;fpHolo&quot; aria-hidden=&quot;true&quot;&gt;
          &lt;span class=&quot;h-scan&quot;&gt;&lt;/span&gt;
          &lt;span class=&quot;h-ring&quot;&gt;&lt;/span&gt;
        &lt;/div&gt;
        &lt;div class=&quot;fp-vinyl spin&quot; id=&quot;fpVinyl&quot;&gt;
          &lt;div class=&quot;fp-groove&quot;&gt;&lt;/div&gt;
          &lt;img id=&quot;fpCoverImg&quot; alt=&quot;&quot; class=&quot;img-err&quot;&gt;
        &lt;/div&gt;
        &lt;div class=&quot;fp-wave&quot; id=&quot;fpWave&quot;&gt;&lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  &lt;/div&gt;
  &lt;div class=&quot;fp-right&quot;&gt;
    &lt;div class=&quot;fp-tabs&quot;&gt;
      &lt;div class=&quot;fp-tab active&quot; data-tab=&quot;lyrics&quot;&gt;歌词&lt;/div&gt;
      &lt;div class=&quot;fp-tab&quot; data-tab=&quot;playlist&quot;&gt;播放列表&lt;/div&gt;
    &lt;/div&gt;
    &lt;div id=&quot;lyricsWrap&quot;&gt;&lt;div class=&quot;song-list&quot; id=&quot;lyricsList&quot;&gt;&lt;/div&gt;&lt;/div&gt;
    &lt;div id=&quot;playlistPanel&quot; style=&quot;display:none&quot;&gt;&lt;/div&gt;
  &lt;/div&gt;
  &lt;div class=&quot;fp-dock&quot;&gt;
    &lt;div class=&quot;fp-controls&quot;&gt;
      &lt;div class=&quot;fp-ctrls&quot;&gt;
        &lt;button class=&quot;fp-ctrl-btn&quot; id=&quot;fpPrev&quot; type=&quot;button&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-prev&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
        &lt;button class=&quot;fp-play&quot; id=&quot;fpPlay&quot; type=&quot;button&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-play&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
        &lt;button class=&quot;fp-ctrl-btn&quot; id=&quot;fpNext&quot; type=&quot;button&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-next&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
      &lt;/div&gt;
      &lt;div class=&quot;fp-progress&quot;&gt;
        &lt;span class=&quot;fp-time&quot; id=&quot;fpCur&quot;&gt;00:00&lt;/span&gt;
        &lt;div class=&quot;fp-bar&quot; id=&quot;fpBar&quot;&gt;&lt;div class=&quot;fp-bar-fill&quot; id=&quot;fpBarFill&quot;&gt;&lt;/div&gt;&lt;div class=&quot;fp-bar-knob&quot; id=&quot;fpBarKnob&quot;&gt;&lt;/div&gt;&lt;/div&gt;
        &lt;span class=&quot;fp-time right&quot; id=&quot;fpDur&quot;&gt;00:00&lt;/span&gt;
      &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class=&quot;fp-quick&quot;&gt;
      &lt;button id=&quot;fpLike&quot; type=&quot;button&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-heart&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
      &lt;button id=&quot;fpSpeed&quot; type=&quot;button&quot; class=&quot;fp-speed-btn&quot; title=&quot;播放倍速&quot;&gt;1.0x&lt;/button&gt;
      &lt;button id=&quot;fpQuality&quot; type=&quot;button&quot; class=&quot;fp-quality-btn&quot; title=&quot;切换音质&quot;&gt;HQ&lt;/button&gt;
      &lt;button id=&quot;fpModeBtn&quot; type=&quot;button&quot; title=&quot;顺序播放&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-order&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;
    &lt;/div&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;!-- ============ MV PLAYER ============ --&gt;
&lt;div id=&quot;mvPlayerView&quot;&gt;
  &lt;div class=&quot;mv-drag-hint&quot; aria-hidden=&quot;true&quot;&gt;&lt;/div&gt;
  &lt;div class=&quot;mv-top-bar&quot;&gt;&lt;button class=&quot;fp-close&quot; id=&quot;mvClose&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-chevdown&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;&lt;div id=&quot;mvTopTitle&quot; style=&quot;font-size:14px;font-weight:600&quot;&gt;&lt;/div&gt;&lt;/div&gt;
  &lt;video id=&quot;mvVideo&quot; controls playsinline&gt;&lt;/video&gt;
&lt;/div&gt;

&lt;div class=&quot;sheet-mask&quot; id=&quot;sheetMask&quot;&gt;&lt;/div&gt;
&lt;div id=&quot;toast&quot;&gt;&lt;/div&gt;
&lt;audio id=&quot;audioEl&quot; preload=&quot;auto&quot; playsinline webkit-playsinline x5-playsinline x5-video-player-type=&quot;h5&quot; x5-video-player-fullscreen=&quot;false&quot; x-webkit-airplay=&quot;allow&quot;&gt;&lt;/audio&gt;
&lt;audio id=&quot;audioNextEl&quot; preload=&quot;auto&quot; playsinline webkit-playsinline x5-playsinline x5-video-player-type=&quot;h5&quot; x5-video-player-fullscreen=&quot;false&quot;&gt;&lt;/audio&gt;

&lt;script&gt;
(function(){
&quot;use strict&quot;;

/* ============================================================
   § 0. 网络适配层 —— fm.req 桥接
   ------------------------------------------------------------
   与 solene / pinglian 项目保持一致的约定：原生环境下用
   fm.req 发起跨域请求（绕过 WebView CORS 限制，且原生端会
   保留域内 Cookie，QR/Cookie 登录都依赖这一点）。
   如果你在其它项目里 fm.req 的实际签名与这里不同，
   只需要改 ADAPTER 这一处，其余业务代码不用动。
   ============================================================ */
var _jsonpSeq = 0;

/** 是否处于 Fongmi/WebHome 原生环境（运行时检测，不要在脚本顶层写死） */
function isNativeFm(){
  return !!(window.fm &amp;&amp; typeof window.fm.req === &quot;function&quot;);
}

/** 等待 SDK 注入（Native 在 onPageFinished 后注入并派发 fmsdk） */
function whenFm(timeoutMs){
  if (isNativeFm()) return Promise.resolve(window.fm);
  return new Promise(function(resolve){
    var done = false;
    function finish(v){
      if (done) return;
      done = true;
      resolve(v || window.fm || null);
    }
    try{
      window.addEventListener(&quot;fmsdk&quot;, function(){ finish(window.fm); }, { once: true });
    }catch(e){
      window.addEventListener(&quot;fmsdk&quot;, function(){ finish(window.fm); });
    }
    var n = 0, max = Math.ceil((timeoutMs || 4000) / 50);
    var timer = setInterval(function(){
      n++;
      if (isNativeFm()){ clearInterval(timer); finish(window.fm); }
      else if (n &gt;= max){ clearInterval(timer); finish(null); }
    }, 50);
  });
}

/** 把 fm.req 返回值统一成「响应文本字符串」——官方返回 { ok, status, body } */
function unwrapFmResponse(res){
  if (res == null) return &quot;&quot;;
  if (typeof res === &quot;object&quot;){
    if (res.body != null){
      if (typeof res.body === &quot;string&quot;) return res.body;
      try{ return JSON.stringify(res.body); }catch(e){ return String(res.body); }
    }
    if (res.error) return &quot;&quot;;
    try{ return JSON.stringify(res); }catch(e){ return &quot;&quot;; }
  }
  if (typeof res === &quot;string&quot;) return res;
  return String(res);
}

/** JSONP 请求：浏览器预览兜底 */
function jsonpRequest(url, timeoutMs){
  return new Promise(function(resolve, reject){
    var cb = &quot;__qqm_jp_&quot; + (++_jsonpSeq) + &quot;_&quot; + Date.now();
    var timer = setTimeout(function(){
      cleanup();
      reject(new Error(&quot;jsonp timeout&quot;));
    }, timeoutMs || 12000);
    function cleanup(){
      clearTimeout(timer);
      try{ delete window[cb]; }catch(e){ window[cb] = undefined; }
      if (script &amp;&amp; script.parentNode) script.parentNode.removeChild(script);
    }
    window[cb] = function(data){
      cleanup();
      try{
        resolve(typeof data === &quot;string&quot; ? data : JSON.stringify(data));
      }catch(e){ resolve(String(data)); }
    };
    var sep = url.indexOf(&quot;?&quot;) &gt;= 0 ? &quot;&amp;&quot; : &quot;?&quot;;
    var finalUrl = url;
    if (/([?&amp;])(callback|jsonpCallback)=/.test(finalUrl)){
      finalUrl = finalUrl.replace(/([?&amp;])(callback|jsonpCallback)=[^&amp;]*/g, &quot;$1$2=&quot; + cb);
    } else {
      finalUrl = finalUrl + sep + &quot;callback=&quot; + cb + &quot;&amp;jsonpCallback=&quot; + cb;
    }
    finalUrl = finalUrl.replace(/([?&amp;])format=json\b/g, &quot;$1format=jsonp&quot;);
    var script = document.createElement(&quot;script&quot;);
    script.async = true;
    script.src = finalUrl;
    script.onerror = function(){
      cleanup();
      reject(new Error(&quot;jsonp script error&quot;));
    };
    (document.head || document.documentElement).appendChild(script);
  });
}

/**
 * 统一网络请求：
 * 1) App 内：fm.req（官方返回 {ok,status,body}，这里解包成文本）
 * 2) 浏览器：JSONP / fetch 兜底
 */
function ADAPTER_request(url, opts){
  opts = opts || {};
  var method = (opts.method || &quot;GET&quot;).toUpperCase();
  var headers = opts.headers || {};
  var body = opts.body;
  if (body != null &amp;&amp; typeof body !== &quot;string&quot;){
    try{ body = JSON.stringify(body); }catch(e){ body = String(body); }
  }

  if (isNativeFm()){
    var reqOpts = {
      method: method,
      headers: headers,
      body: body || &quot;&quot;,
      responseType: &quot;text&quot;,
      timeout: opts.timeout || 30,
      credentials: opts.credentials || &quot;include&quot;
    };
    return Promise.resolve()
      .then(function(){ return window.fm.req(url, reqOpts); })
      .then(function(res){
        var text = unwrapFmResponse(res);
        if (res &amp;&amp; typeof res === &quot;object&quot; &amp;&amp; res.ok === false &amp;&amp; !text){
          console.warn(&quot;[adapter] fm.req not ok&quot;, res.status, res.error || &quot;&quot;, url);
        }
        return text;
      })
      .catch(function(e){
        console.warn(&quot;[adapter] fm.req failed&quot;, e, url);
        return &quot;&quot;;
      });
  }

  try{
    var jpUrl = url;
    if (method === &quot;POST&quot; &amp;&amp; body &amp;&amp; /u\.y\.qq\.com\/cgi-bin\/musicu\.fcg/i.test(url)){
      var sep = url.indexOf(&quot;?&quot;) &gt;= 0 ? &quot;&amp;&quot; : &quot;?&quot;;
      jpUrl = url + sep + &quot;data=&quot; + encodeURIComponent(body);
      if (jpUrl.indexOf(&quot;format=&quot;) &lt; 0) jpUrl += &quot;&amp;format=jsonp&amp;inCharset=utf8&amp;outCharset=utf-8&amp;platform=yqq.json&amp;needNewCode=0&quot;;
    } else if (method === &quot;POST&quot;){
      return fetch(url, { method: method, headers: headers, body: body, mode:&quot;cors&quot;, credentials:&quot;omit&quot; })
        .then(function(r){ return r.text(); })
        .catch(function(){ return &quot;&quot;; });
    }
    return jsonpRequest(jpUrl).catch(function(err){
      console.warn(&quot;[adapter] JSONP failed, try fetch&quot;, err);
      return fetch(url, { method: method === &quot;POST&quot; ? &quot;POST&quot; : &quot;GET&quot;, headers: headers, body: method === &quot;POST&quot; ? body : undefined, mode:&quot;cors&quot;, credentials:&quot;omit&quot; })
        .then(function(r){ return r.text(); })
        .catch(function(){ return &quot;&quot;; });
    });
  }catch(e){
    console.warn(&quot;[adapter] request error&quot;, e);
    return Promise.resolve(&quot;&quot;);
  }
}

/** 原生播放已关闭：统一走页面 &lt;audio&gt;，避免跳进 fm 播放器 */
function nativePlay(url, headers, title){
  return false;
}

/** 浏览器可播地址：HTTPS 页面禁止 http 音源（混合内容会被静默拦截） */
function safePlaySrc(url){
  if (!url) return url;
  var u = String(url);
  try {
    if (typeof location !== &quot;undefined&quot; &amp;&amp; location.protocol === &quot;https:&quot; &amp;&amp; /^http:\/\//i.test(u)){
      // 优先升级为 https；部分长青节点仅 http，升级失败时由上层换源
      u = u.replace(/^http:/i, &quot;https:&quot;);
    }
  } catch(e) {}
  return u;
}
/** 当前是否为纯浏览器（无 fm 壳） */
function isBrowserOnly(){
  try { return !isNativeFm(); } catch(e) { return true; }
}

/** 图片资源：App 内走 fm.res 网关 */
function mediaUrl(url, headers){
  if (!url) return &quot;&quot;;
  url = String(url).trim();
  if (url.indexOf(&quot;//&quot;) === 0) url = &quot;https:&quot; + url;
  url = url.replace(/^http:/, &quot;https:&quot;);
  try{
    if (window.fm &amp;&amp; typeof window.fm.res === &quot;function&quot;){
      var r = window.fm.res(url, {
        headers: headers || { &quot;Referer&quot;: &quot;https://y.qq.com/&quot; },
        credentials: &quot;include&quot;
      });
      // fm.res 异常时可能返回 null/undefined，必须回退原链，否则全站裂图
      if (r) return r;
    }
  }catch(e){}
  return url;
}

function storeGet(key, def){
  try{
    var raw = localStorage.getItem(&quot;qqm_&quot;+key);
    if (raw === null) return def;
    return JSON.parse(raw);
  }catch(e){ return def; }
}
function storeSet(key, val){
  var s = JSON.stringify(val);
  try{ localStorage.setItem(&quot;qqm_&quot;+key, s); }catch(e){}
}

/* ============================================================
   § 1. 工具函数
   ============================================================ */
function $(sel, ctx){ return (ctx||document).querySelector(sel); }
function $all(sel, ctx){ return Array.prototype.slice.call((ctx||document).querySelectorAll(sel)); }
function el(html){ var d=document.createElement(&quot;div&quot;); d.innerHTML=html.trim(); return d.firstElementChild; }
function esc(s){ return (s==null?&quot;&quot;:String(s)).replace(/[&amp;&lt;&gt;&quot;']/g,function(c){return {&quot;&amp;&quot;:&quot;&amp;amp;&quot;,&quot;&lt;&quot;:&quot;&amp;lt;&quot;,&quot;&gt;&quot;:&quot;&amp;gt;&quot;,'&quot;':&quot;&amp;quot;&quot;,&quot;'&quot;:&quot;&amp;#39;&quot;}[c];}); }
function fmtTime(sec){
  sec = Math.max(0, Math.floor(sec||0));
  var m = Math.floor(sec/60), s = sec%60;
  return (m&lt;10?&quot;0&quot;:&quot;&quot;)+m+&quot;:&quot;+(s&lt;10?&quot;0&quot;:&quot;&quot;)+s;
}
function fmtCount(n){
  n = Number(n)||0;
  if (n &gt;= 1e8) return (n/1e8).toFixed(1)+&quot;亿&quot;;
  if (n &gt;= 1e4) return (n/1e4).toFixed(1)+&quot;万&quot;;
  return String(n);
}
function toast(msg, ms){
  var t = $(&quot;#toast&quot;);
  t.textContent = msg;
  t.classList.add(&quot;show&quot;);
  clearTimeout(toast._tm);
  toast._tm = setTimeout(function(){ t.classList.remove(&quot;show&quot;); }, ms||2200);
}
function guid(){
  var s = storeGet(&quot;device_guid&quot;, null);
  if (s) return s;
  s = String(Math.floor(Math.random()*9000000000)+1000000000);
  storeSet(&quot;device_guid&quot;, s);
  return s;
}
function debounce(fn, ms){
  var tm;
  return function(){
    var args = arguments, ctx = this;
    clearTimeout(tm);
    tm = setTimeout(function(){ fn.apply(ctx, args); }, ms);
  };
}
function jsonp_safeParse(txt){
  // 部分 QQ 音乐接口返回 callback(...) 包裹或裸 JSON
  try{ return JSON.parse(txt); }catch(e){}
  var m = /\(([\s\S]*)\)\s*;?\s*$/.exec(txt);
  if (m){ try{ return JSON.parse(m[1]); }catch(e2){} }
  return null;
}
function coverUrl(mid, type){
  // type: album(专辑) / singer(歌手) / playlist(歌单封面走接口自带url)
  if (!mid) return &quot;&quot;;
  mid = String(mid).trim();
  if (mid.indexOf(&quot;http&quot;) === 0) return mid.replace(/^http:/, &quot;https:&quot;);
  // 部分接口带 T002R... 完整文件名
  if (/^T00[12]R/i.test(mid)) return &quot;https://y.gtimg.cn/music/photo_new/&quot;+mid+(mid.indexOf(&quot;.jpg&quot;)&gt;-1?&quot;&quot;:&quot;.jpg&quot;);
  if (type === &quot;singer&quot;) return &quot;https://y.gtimg.cn/music/photo_new/T001R300x300M000&quot;+mid+&quot;.jpg&quot;;
  return &quot;https://y.gtimg.cn/music/photo_new/T002R300x300M000&quot;+mid+&quot;.jpg&quot;;
}
function fixCover(url){
  if (!url) return &quot;&quot;;
  url = String(url).trim();
  if (url.indexOf(&quot;//&quot;) === 0) url = &quot;https:&quot; + url;
  return url.replace(/^http:/, &quot;https:&quot;);
}
/** QQ 头像（多 CDN 兜底由 setImgSrc 负责） */
function avatarUrl(uin){
  if (!uin) return &quot;&quot;;
  uin = String(uin).replace(/^o0*/,&quot;&quot;);
  if (!uin) return &quot;&quot;;
  return &quot;https://q1.qlogo.cn/g?b=qq&amp;nk=&quot;+encodeURIComponent(uin)+&quot;&amp;s=100&quot;;
}
/** 从歌曲对象解析封面地址 */
function songCoverUrl(s){
  if (!s) return &quot;&quot;;
  if (s.cover) return fixCover(s.cover);
  if (s.pic) return fixCover(s.pic);
  if (s.albummid) return coverUrl(s.albummid);
  if (s.album_mid) return coverUrl(s.album_mid);
  if (s.album &amp;&amp; s.album.mid) return coverUrl(s.album.mid);
  if (s.album &amp;&amp; s.album.pmid) return coverUrl(s.album.pmid);
  return &quot;&quot;;
}

/* ============================================================
   § 2. 全局状态
   ============================================================ */
var state = {
  isTv: !!(window.fongmiClient &amp;&amp; window.fongmiClient.isLeanback) || /\bLeanback\b|\bAndroid TV\b|\bAFT[A-Z]|SMART-TV|SmartTV/i.test(navigator.userAgent || &quot;&quot;),
  user: storeGet(&quot;user&quot;, null),           // {uin, cookie, nickname, avatar, vip}
  favorites: storeGet(&quot;favorites&quot;, []),   // [{songmid,name,singer,...}] 兼容旧版纯 mid 字符串
  favPlaylists: storeGet(&quot;favPlaylists&quot;, []),
  queue: [],           // 当前播放队列 [{songmid,name,singer,albummid,interval,...}]
  queueIndex: -1,
  playMode: storeGet(&quot;playMode&quot;, &quot;order&quot;), // order | shuffle | single
  quality: storeGet(&quot;quality&quot;, &quot;HQ&quot;),      // HQ(128k) 更易免登录拿到；SQ(320k)/ZQ(无损) 常需登录或绿钻
  volume: storeGet(&quot;volume&quot;, 0.8),
  theme: storeGet(&quot;theme&quot;, &quot;apple&quot;),      // apple | qq | kuwo | kugou | ytmusic
  uiMode: storeGet(&quot;uiMode&quot;, &quot;light&quot;),    // light | dark | neon
  source: &quot;qq&quot;,
  sourceUnlocked: !!storeGet(&quot;sourceUnlocked&quot;, false),
  ytmApi: storeGet(&quot;ytmApi&quot;, &quot;&quot;),
  currentLyrics: [],   // [{time,text,tr}]
  queueTag: null,       // 当前队列来源标记，如 &quot;daily-rec&quot; | &quot;daily-30&quot;
  view: &quot;home&quot;,
  viewParams: {},
  viewCache: {},       // 简单内存缓存，避免重复请求
};

var THEME_META = {
  apple:  { id: &quot;apple&quot;,  name: &quot;苹果红&quot;, label: &quot;Apple 玫瑰&quot; },
  qq:     { id: &quot;qq&quot;,     name: &quot;QQ绿&quot;,   label: &quot;QQ 音乐绿&quot; },
  kuwo:   { id: &quot;kuwo&quot;,   name: &quot;酷我黄&quot;, label: &quot;酷我琥珀黄&quot; },
  kugou:   { id: &quot;kugou&quot;,   name: &quot;酷狗蓝&quot;, label: &quot;酷狗音乐蓝&quot; },
  ytmusic: { id: &quot;ytmusic&quot;, name: &quot;油管红&quot;, label: &quot;YouTube Music&quot; },
  netease: { id: &quot;netease&quot;, name: &quot;网易红&quot;, label: &quot;网易云音乐&quot; }
};
var THEME_ORDER = [&quot;apple&quot;, &quot;qq&quot;, &quot;kuwo&quot;, &quot;kugou&quot;, &quot;ytmusic&quot;, &quot;netease&quot;];
var _themeBeforeNe = null;

function applyTheme(id, silent){
  if (!THEME_META[id]) id = &quot;apple&quot;;
  state.theme = id;
  storeSet(&quot;theme&quot;, id);
  document.documentElement.setAttribute(&quot;data-theme&quot;, id);
  var hint = $(&quot;#logoHint&quot;);
  if (hint){
    hint.textContent = THEME_META[id].label;
  }
  // 无专辑取色时，氛围背景跟随主题色
  try {
    var playing = state.queue &amp;&amp; state.queue[state.queueIndex];
    if (!playing &amp;&amp; typeof applyAmbient === &quot;function&quot; &amp;&amp; typeof themeAmbientColors === &quot;function&quot;){
      applyAmbient(themeAmbientColors(), themeLightAmbientColors());
    }
  } catch(e) {}
  if (!silent){
    toast(&quot;主题 · &quot; + THEME_META[id].label, 1400);
    var mark = $(&quot;#brandMark&quot;);
    if (mark){
      mark.classList.add(&quot;show-hint&quot;);
      clearTimeout(applyTheme._hintTm);
      applyTheme._hintTm = setTimeout(function(){ mark.classList.remove(&quot;show-hint&quot;); }, 1600);
    }
  }
}
function cycleTheme(){
  var idx = THEME_ORDER.indexOf(state.theme);
  if (idx &lt; 0) idx = 0;
  applyTheme(THEME_ORDER[(idx + 1) % THEME_ORDER.length], false);
}

function applyUiMode(mode, silent){
  var allowed = { light:1, dark:1, neon:1 };
  mode = allowed[mode] ? mode : &quot;light&quot;;
  state.uiMode = mode;
  storeSet(&quot;uiMode&quot;, mode);
  document.documentElement.setAttribute(&quot;data-mode&quot;, mode);
  var labels = { light:&quot;明亮模式&quot;, dark:&quot;暗色模式&quot;, neon:&quot;赛博霓虹&quot; };
  var toasts = { light:&quot;已切换明亮模式&quot;, dark:&quot;已切换暗色模式&quot;, neon:&quot;已切换赛博霓虹&quot; };
  var hint = $(&quot;#logoHint&quot;);
  if (hint){ hint.textContent = labels[mode] || &quot;明亮模式&quot;; }
  if (!silent){
    toast(toasts[mode] || &quot;已切换模式&quot;, 1200);
    var mark = $(&quot;#brandMark&quot;);
    if (mark){
      mark.classList.add(&quot;show-hint&quot;);
      clearTimeout(applyUiMode._hintTm);
      applyUiMode._hintTm = setTimeout(function(){ mark.classList.remove(&quot;show-hint&quot;); }, 1400);
    }
  }
}
function toggleUiMode(){
  // 明亮 → 暗色 → 赛博霓虹 → 明亮
  var order = [&quot;light&quot;, &quot;dark&quot;, &quot;neon&quot;];
  var idx = order.indexOf(state.uiMode);
  if (idx &lt; 0) idx = 0;
  applyUiMode(order[(idx + 1) % order.length], false);
}

document.documentElement.classList.toggle(&quot;tv-mode&quot;, !!state.isTv);
// 启动时应用已保存主题与明暗模式（静默）
try { applyTheme(state.theme || &quot;apple&quot;, true); } catch(e) {}
try { applyUiMode(state.uiMode || &quot;light&quot;, true); } catch(e2) {}
// 收藏列表迁移：纯 mid 字符串保留，新收藏写完整对象
try {
  if (Array.isArray(state.favorites)) {
    var migrated = false;
    state.favorites = state.favorites.map(function(it){
      if (typeof it === &quot;string&quot;) { migrated = true; return it; }
      if (it &amp;&amp; it.songmid) return it;
      return it;
    }).filter(function(it){ return !!favMidOf(it); });
    if (migrated) storeSet(&quot;favorites&quot;, state.favorites);
  } else {
    state.favorites = [];
  }
} catch(eFav) {}


/* ============================================================
   § 3. QQ音乐接口封装
   ------------------------------------------------------------
   公开只读端点（c.y.qq.com / u.y.qq.com），Referer: y.qq.com。
   接口状态（2026）：
   ✅ musicu.fcg
      - 歌手列表 Music.SingerListServer.get_singer_list
      - 歌手热门 musichall.song_list_server.GetSingerSongList
      - 专辑歌曲 music.musichallAlbum.AlbumSongList.GetAlbumSongList
      - 排行榜 / 歌单详情 / 每日推荐 / 播放 vkey / MV
   ✅ client_search_cp（搜索：t=0单曲/9歌手/8专辑；歌单用 smartbox 补充）
   ✅ smartbox_new / gethotkey / fcg_get_diss_by_tag
   ✅ fcg_v8_singer_album（歌手专辑）
   ✅ fcg_query_lyric_new（歌词，nobase64=1）
   ✅ fcg_ucc_getcdinfo_byids_cp（歌单详情，失败回退 musicu）
   ⚠ v8.fcg channel=singer 仅作歌手列表回退（字段 Fsinger_*）
   ❌ fcg_v8_singer_track_cp 已 404，勿再用
   ============================================================ */
var QQ_HEADERS = {
  &quot;Referer&quot;: &quot;https://y.qq.com/&quot;,
  &quot;Origin&quot;: &quot;https://y.qq.com&quot;,
  &quot;User-Agent&quot;: &quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36&quot;
};
/** 组装请求头：有登录 Cookie 才写入 Cookie 字段；不要传空 Cookie 覆盖 WebView 登录态 */
function withCookie(h){
  var hh = Object.assign({}, QQ_HEADERS, h||{});
  if (state.user &amp;&amp; state.user.cookie){
    hh.Cookie = state.user.cookie;
  } else {
    // 显式删除可能被合并进来的空 Cookie，让 credentials:include 使用 WebView CookieManager
    try{ delete hh.Cookie; }catch(e){ hh.Cookie = undefined; }
  }
  return hh;
}


var API = {};

/* kugou · 酷狗（搜索走酷狗接口，取流走洛雪 kg） */
API.kugouSearch = function(kw, page){
  kw = (kw || &quot;&quot;).trim();
  page = page || 1;
  if (!kw) return Promise.resolve({ list: [], singers: [] });
  var hdr = {
    &quot;User-Agent&quot;: &quot;Mozilla/5.0 (Linux; Android 11) AppleWebKit/537.36 Chrome/122.0.0.0 Mobile Safari/537.36&quot;,
    &quot;Referer&quot;: &quot;https://www.kugou.com/&quot;,
    &quot;Accept&quot;: &quot;application/json, text/plain, */*&quot;
  };
  var songUrl = &quot;https://mobilecdn.kugou.com/api/v3/search/song?format=json&amp;keyword=&quot; +
    encodeURIComponent(kw) + &quot;&amp;page=&quot; + page + &quot;&amp;pagesize=20&amp;showtype=1&quot;;
  var songUrl2 = &quot;https://songsearch.kugou.com/song_search_v2?keyword=&quot; +
    encodeURIComponent(kw) + &quot;&amp;page=&quot; + page + &quot;&amp;pagesize=20&amp;userid=-1&amp;clientver=&amp;platform=WebFilter&amp;filter=2&amp;iscorrection=1&amp;privilege_filter=0&quot;;
  var artistUrl = &quot;https://mobilecdn.kugou.com/api/v3/search/singer?format=json&amp;keyword=&quot; +
    encodeURIComponent(kw) + &quot;&amp;page=1&amp;pagesize=12&quot;;

  function mapSong(it){
    if (!it) return null;
    var hash = it.FileHash || it.filehash || it.HQFileHash || it.hash || it.Hash || &quot;&quot;;
    var name = it.SongName || it.songname || it.songName || it.name || &quot;&quot;;
    // 去掉热词高亮
    name = String(name).replace(/&lt;[^&gt;]+&gt;/g, &quot;&quot;);
    var singer = it.SingerName || it.singername || it.singerName || it.choricSinger || it.singer || &quot;&quot;;
    singer = String(singer).replace(/&lt;[^&gt;]+&gt;/g, &quot;&quot;);
    var album = it.AlbumName || it.album_name || it.albumName || &quot;&quot;;
    album = String(album).replace(/&lt;[^&gt;]+&gt;/g, &quot;&quot;);
    var dur = Number(it.Duration || it.duration || it.timeLength || 0) || 0;
    if (dur &gt; 10000) dur = Math.round(dur / 1000);
    var img = it.img || it.Image || it.album_img || it.trans_param &amp;&amp; it.trans_param.union_cover || &quot;&quot;;
    if (img){
      img = String(img).replace(/\{size\}/g, &quot;240&quot;).replace(/^http:/, &quot;https:&quot;);
    }
    if (!hash || !name) return null;
    return {
      songmid: &quot;kg_&quot; + hash,
      media_mid: hash,
      hash: hash,
      kgHash: hash,
      name: name,
      singer: singer || &quot;酷狗&quot;,
      albumname: album,
      cover: fixCover(img),
      interval: dur,
      isVip: false,
      playUrl: &quot;&quot;,
      source: &quot;kugou&quot;
    };
  }

  function fetchSongs(){
    return ADAPTER_request(songUrl, { headers: hdr, timeout: 12, credentials: &quot;omit&quot; }).then(function(txt){
      var d = jsonp_safeParse(txt);
      var list = (d &amp;&amp; d.data &amp;&amp; (d.data.info || d.data.lists || d.data.list)) || [];
      var out = (list || []).map(mapSong).filter(Boolean);
      if (out.length) return out;
      return ADAPTER_request(songUrl2, { headers: hdr, timeout: 12, credentials: &quot;omit&quot; }).then(function(txt2){
        var d2 = jsonp_safeParse(txt2);
        var list2 = (d2 &amp;&amp; d2.data &amp;&amp; (d2.data.lists || d2.data.list || d2.data.info)) || [];
        return (list2 || []).map(mapSong).filter(Boolean);
      });
    }).catch(function(){
      return ADAPTER_request(songUrl2, { headers: hdr, timeout: 12, credentials: &quot;omit&quot; }).then(function(txt2){
        var d2 = jsonp_safeParse(txt2);
        var list2 = (d2 &amp;&amp; d2.data &amp;&amp; (d2.data.lists || d2.data.list || d2.data.info)) || [];
        return (list2 || []).map(mapSong).filter(Boolean);
      }).catch(function(){ return []; });
    });
  }

  function fetchArtists(){
    return ADAPTER_request(artistUrl, { headers: hdr, timeout: 10, credentials: &quot;omit&quot; }).then(function(txt){
      var d = jsonp_safeParse(txt);
      var list = (d &amp;&amp; d.data &amp;&amp; (d.data.info || d.data.list)) || [];
      return (list || []).map(function(it){
        var name = it.singername || it.SingerName || it.name || &quot;&quot;;
        name = String(name).replace(/&lt;[^&gt;]+&gt;/g, &quot;&quot;);
        var id = it.singerid || it.SingerId || it.id || name;
        var pic = it.imgurl || it.image || it.img || &quot;&quot;;
        if (pic) pic = String(pic).replace(/\{size\}/g, &quot;240&quot;).replace(/^http:/, &quot;https:&quot;);
        if (!name) return null;
        return { mid: &quot;kg_ar_&quot; + id, name: name, cover: fixCover(pic), source: &quot;kugou&quot; };
      }).filter(Boolean);
    }).catch(function(){ return []; });
  }

  function singersFromSongs(songs){
    var seen = {}, out = [];
    (songs || []).forEach(function(s){
      var n = ((s.singer || &quot;&quot;).split(/[\/、,&amp;]/)[0] || &quot;&quot;).trim();
      if (!n || seen[n]) return;
      seen[n] = 1;
      out.push({ mid: &quot;kg_ar_&quot; + n, name: n, cover: s.cover || &quot;&quot;, source: &quot;kugou&quot;, fromSong: true });
    });
    return out;
  }

  return Promise.all([fetchSongs(), fetchArtists()]).then(function(arr){
    var list = arr[0] || [];
    var singers = arr[1] || [];
    if (singers.length &lt; 3){
      var extra = singersFromSongs(list);
      var seen = {};
      singers.forEach(function(a){ if (a.name) seen[a.name] = 1; });
      extra.forEach(function(a){ if (!seen[a.name]){ seen[a.name] = 1; singers.push(a); } });
    }
    return { list: list, singers: singers.slice(0, 12) };
  }).catch(function(){ return { list: [], singers: [] }; });
}

/** 酷狗取流：直接走洛雪 kg 源 */
API.kugouUrl = function(song){
  if (!song) return Promise.resolve(null);
  var s = Object.assign({}, song, { source: &quot;kugou&quot; });
  if (!s.hash &amp;&amp; !s.kgHash){
    var h = String(s.songmid || &quot;&quot;).replace(/^kg_/, &quot;&quot;);
    if (h) { s.hash = h; s.kgHash = h; }
  }
  // 长青 ∥ 洛雪
  return API.cqOrLxUrl(s).catch(function(){ return null; });
}

API.kugouLyric = function(song){
  // 酷狗官方歌词：lyrics.kugou.com/search → download(fmt=lrc) → 失败再按歌名走 QQ
  var hash = String((song &amp;&amp; (song.hash || song.kgHash)) || &quot;&quot;).replace(/^kg_/i, &quot;&quot;).trim();
  var name = (song &amp;&amp; song.name) || &quot;&quot;;
  var singer = (song &amp;&amp; song.singer) || &quot;&quot;;
  var durMs = 0;
  try {
    var sec = Number(song &amp;&amp; song.interval) || 0;
    if (sec &gt; 0) durMs = Math.round(sec * 1000);
  } catch(eD) {}
  var hdr = {
    &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;],
    &quot;Referer&quot;: &quot;https://www.kugou.com/&quot;,
    &quot;Accept&quot;: &quot;application/json, text/plain, */*&quot;
  };

  function decodeKgContent(content){
    if (!content) return &quot;&quot;;
    var raw = String(content);
    // 官方 download fmt=lrc 时 content 多为 base64
    if (raw.indexOf(&quot;[&quot;) === -1){
      try {
        var bin = atob(raw);
        try { raw = decodeURIComponent(escape(bin)); }
        catch(e1){ raw = bin; }
      } catch(e2) {}
    }
    return String(raw || &quot;&quot;).trim();
  }

  function downloadById(id, accesskey){
    if (!id || !accesskey) return Promise.resolve(&quot;&quot;);
    var url = &quot;https://lyrics.kugou.com/download?ver=1&amp;client=pc&amp;id=&quot; +
      encodeURIComponent(id) + &quot;&amp;accesskey=&quot; + encodeURIComponent(accesskey) +
      &quot;&amp;fmt=lrc&amp;charset=utf8&quot;;
    return ADAPTER_request(url, { headers: hdr, timeout: 12, credentials: &quot;omit&quot; }).then(function(txt){
      var d = jsonp_safeParse(txt);
      var content = (d &amp;&amp; (d.content || d.lyric || d.lrc)) || &quot;&quot;;
      return decodeKgContent(content);
    }).catch(function(){ return &quot;&quot;; });
  }

  function pickCandidate(d){
    var cands = (d &amp;&amp; d.candidates) || (d &amp;&amp; d.data &amp;&amp; d.data.candidates) || [];
    if (!cands.length) return null;
    return cands[0];
  }

  function searchByHash(){
    if (!hash) return Promise.resolve(null);
    var url = &quot;https://lyrics.kugou.com/search?ver=1&amp;man=yes&amp;client=pc&amp;hash=&quot; +
      encodeURIComponent(hash);
    return ADAPTER_request(url, { headers: hdr, timeout: 12, credentials: &quot;omit&quot; }).then(function(txt){
      return pickCandidate(jsonp_safeParse(txt));
    }).catch(function(){ return null; });
  }

  function searchByKeyword(){
    var kw = (name + (singer ? (&quot; - &quot; + ((singer.split(/[\/、,&amp;]/)[0] || &quot;&quot;).trim())) : &quot;&quot;)).trim();
    if (!kw) return Promise.resolve(null);
    var url = &quot;https://lyrics.kugou.com/search?ver=1&amp;man=yes&amp;client=pc&amp;keyword=&quot; +
      encodeURIComponent(kw) + (durMs ? (&quot;&amp;duration=&quot; + durMs) : &quot;&quot;);
    return ADAPTER_request(url, { headers: hdr, timeout: 12, credentials: &quot;omit&quot; }).then(function(txt){
      return pickCandidate(jsonp_safeParse(txt));
    }).catch(function(){ return null; });
  }

  return searchByHash().then(function(c){
    if (c &amp;&amp; c.id &amp;&amp; c.accesskey) return downloadById(c.id, c.accesskey);
    return searchByKeyword().then(function(c2){
      if (c2 &amp;&amp; c2.id &amp;&amp; c2.accesskey) return downloadById(c2.id, c2.accesskey);
      return &quot;&quot;;
    });
  }).then(function(lrc){
    if (lrc &amp;&amp; lrc.replace(/\s+/g, &quot;&quot;).length &gt; 4) return { lyric: lrc, trans: &quot;&quot; };
    // 兜底：按歌名匹配 QQ 歌词
    if (typeof API.lyricByMeta === &quot;function&quot; &amp;&amp; name){
      return API.lyricByMeta(name, singer);
    }
    return { lyric: &quot;&quot;, trans: &quot;&quot; };
  }).catch(function(){
    if (typeof API.lyricByMeta === &quot;function&quot; &amp;&amp; name) return API.lyricByMeta(name, singer);
    return { lyric: &quot;&quot;, trans: &quot;&quot; };
  });
};


/* kuwo */
function _parseKuwoBody(txt){
  if (!txt) return null;
  txt = String(txt).trim();
  var d = jsonp_safeParse(txt);
  if (d) return d;
  try { return JSON.parse(txt); } catch(e){}
  // 偶发单引号伪 JSON
  try {
    var fixed = txt.replace(/'/g, '&quot;');
    return JSON.parse(fixed);
  } catch(e2){}
  return null;
}
function _mapKuwoList(list){
  return (list || []).map(function(it){
    var rid = String(it.MUSICRID || it.rid || it.DC_TARGETID || it.id || &quot;&quot;).replace(/^MUSIC_/i, &quot;&quot;);
    var name = String(it.SONGNAME || it.NAME || it.name || it.songname || &quot;&quot;).replace(/&amp;nbsp;/g, &quot; &quot;).trim();
    var artist = String(it.ARTIST || it.artist || it.ARTISTNAME || &quot;&quot;).replace(/&amp;nbsp;/g, &quot; &quot;).trim();
    var album = String(it.ALBUM || it.album || &quot;&quot;).replace(/&amp;nbsp;/g, &quot; &quot;).trim();
    var dur = parseInt(it.DURATION || it.duration || 0, 10) || 0;
    var pic = it.web_albumpic_short || it.albumpic || it.pic || it.hts_MVPIC || &quot;&quot;;
    if (pic &amp;&amp; pic.indexOf(&quot;http&quot;) !== 0){
      pic = &quot;https://img1.kuwo.cn/star/albumcover/&quot; + pic;
    }
    if (pic) pic = String(pic).replace(/^http:/, &quot;https:&quot;);
    return {
      songmid: &quot;kw_&quot; + rid,
      media_mid: rid,
      rid: rid,
      name: name,
      singer: artist,
      albumname: album,
      albummid: String(it.ALBUMID || &quot;&quot;),
      cover: pic,
      interval: dur,
      isVip: false,
      playUrl: &quot;&quot;,
      source: &quot;kuwo&quot;
    };
  }).filter(function(s){ return s.rid &amp;&amp; s.name; });
}
/** 酷我歌词：优先 songinfoandlrc（带时间轴），失败再试 lyric 文本接口 */
API.kuwoLyric = function(song){
  var rid = (song &amp;&amp; (song.rid || String(song.songmid || &quot;&quot;).replace(/^kw_/, &quot;&quot;))) || &quot;&quot;;
  rid = String(rid).replace(/^MUSIC_/i, &quot;&quot;).trim();
  if (!rid) return Promise.resolve({ lyric: &quot;&quot;, trans: &quot;&quot; });

  function lrclistToLrc(list){
    if (!list || !list.length) return &quot;&quot;;
    var lines = [];
    for (var i = 0; i &lt; list.length; i++){
      var it = list[i] || {};
      var text = String(it.lineLyric || it.line_lyric || it.lyric || it.text || &quot;&quot;).trim();
      if (!text || text === &quot;null&quot;) continue;
      var t = parseFloat(it.time != null ? it.time : (it.startTime != null ? it.startTime : 0));
      if (isNaN(t)) t = 0;
      // 酷我 time 多为秒（可带小数）；偶发毫秒
      if (t &gt; 10000) t = t / 1000;
      var m = Math.floor(t / 60);
      var s = t - m * 60;
      var ss = s.toFixed(2);
      if (ss.length &lt; 5) ss = (s &lt; 10 ? &quot;0&quot; : &quot;&quot;) + ss;
      var mm = (m &lt; 10 ? &quot;0&quot; : &quot;&quot;) + m;
      lines.push(&quot;[&quot; + mm + &quot;:&quot; + ss + &quot;]&quot; + text);
    }
    return lines.join(&quot;\n&quot;);
  }

  function extractLrc(txt){
    if (!txt) return &quot;&quot;;
    var d = _parseKuwoBody(txt);
    if (!d) {
      // 纯 LRC 文本
      if (String(txt).indexOf(&quot;[&quot;) !== -1 &amp;&amp; /\[\d{1,2}:\d{2}/.test(txt)) return String(txt);
      return &quot;&quot;;
    }
    // songinfoandlrc
    var data = d.data || d;
    if (data &amp;&amp; data.lrclist &amp;&amp; data.lrclist.length){
      return lrclistToLrc(data.lrclist);
    }
    if (data &amp;&amp; data.lrc &amp;&amp; data.lrc.list){
      return lrclistToLrc(data.lrc.list);
    }
    // 直接字符串字段
    var raw = (data &amp;&amp; (data.lyric || data.lrc || data.lrcContent || data.lyricContent)) ||
              d.lyric || d.lrc || &quot;&quot;;
    if (typeof raw === &quot;string&quot; &amp;&amp; raw.trim()) return raw.trim();
    if (Array.isArray(raw)) return lrclistToLrc(raw);
    return &quot;&quot;;
  }

  var urls = [
    // 较新的 openapi
    &quot;https://kuwo.cn/openapi/v1/www/lyric/getlyric?musicId=&quot; + encodeURIComponent(rid),
    &quot;https://www.kuwo.cn/openapi/v1/www/lyric/getlyric?musicId=&quot; + encodeURIComponent(rid),
    &quot;https://m.kuwo.cn/newh5/singles/songinfoandlrc?musicId=&quot; + encodeURIComponent(rid) + &quot;&amp;httpsStatus=1&quot;,
    &quot;https://kuwo.cn/newh5/singles/songinfoandlrc?musicId=&quot; + encodeURIComponent(rid) + &quot;&amp;httpsStatus=1&quot;,
    &quot;https://mobi.kuwo.cn/mobi.s?f=web&amp;type=lyric_txt&amp;rid=MUSIC_&quot; + encodeURIComponent(rid)
  ];

  function tryOne(i){
    if (i &gt;= urls.length) return Promise.resolve({ lyric: &quot;&quot;, trans: &quot;&quot; });
    return ADAPTER_request(urls[i], {
      headers: {
        &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;],
        &quot;Referer&quot;: &quot;https://www.kuwo.cn/&quot;,
        &quot;Accept&quot;: &quot;application/json, text/plain, */*&quot;
      },
      timeout: 12,
      credentials: &quot;omit&quot;
    }).then(function(txt){
      var lrc = extractLrc(txt);
      if (lrc) return { lyric: lrc, trans: &quot;&quot; };
      return tryOne(i + 1);
    }).catch(function(){ return tryOne(i + 1); });
  }
  return tryOne(0);
};


/* ---- 各音源专辑搜索 / 专辑歌曲（供歌手页展开） ---- */
API.kuwoSearchAlbums = function(kw){
  kw = (kw || &quot;&quot;).trim();
  if (!kw) return Promise.resolve([]);
  var url = &quot;https://search.kuwo.cn/r.s?all=&quot; + encodeURIComponent(kw) +
    &quot;&amp;ft=album&amp;rn=30&amp;pn=0&amp;rformat=json&amp;encoding=utf8&amp;mobi=1&quot;;
  return ADAPTER_request(url, {
    headers: { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Referer&quot;: &quot;https://www.kuwo.cn/&quot;, &quot;Accept&quot;: &quot;application/json&quot; },
    timeout: 12, credentials: &quot;omit&quot;
  }).then(function(txt){
    var d = _parseKuwoBody(txt);
    var list = (d &amp;&amp; (d.albumlist || d.abslist)) || [];
    return (list || []).map(function(it){
      var id = String(it.albumid || it.id || it.ALBUMID || &quot;&quot;);
      var name = it.name || it.ALBUM || it.album || &quot;&quot;;
      var artist = it.artist || it.ARTIST || it.aartist || &quot;&quot;;
      var pic = it.hts_img || it.img || it.pic || &quot;&quot;;
      if (pic &amp;&amp; String(pic).indexOf(&quot;http&quot;) !== 0) pic = &quot;https://img1.kuwo.cn/star/albumcover/&quot; + String(pic).replace(/^\//, &quot;&quot;);
      return {
        mid: id,
        albumId: id,
        name: name,
        singer: artist,
        cover: fixCover(pic),
        pubTime: it.pub || it.showtime || it.releaseDate || &quot;&quot;,
        company: it.company || &quot;&quot;,
        source: &quot;kuwo&quot;
      };
    }).filter(function(a){ return a.mid &amp;&amp; a.name; });
  }).catch(function(){ return []; });
};

API.kuwoAlbumSongs = function(albumId){
  albumId = String(albumId || &quot;&quot;).replace(/^kw_al_/, &quot;&quot;);
  if (!albumId) return Promise.resolve({ songs: [] });
  var url = &quot;https://wapi.kuwo.cn/api/www/album/albumInfo?albumId=&quot; + encodeURIComponent(albumId) + &quot;&amp;pn=1&amp;rn=50&quot;;
  return ADAPTER_request(url, {
    headers: { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Referer&quot;: &quot;https://www.kuwo.cn/&quot;, &quot;Accept&quot;: &quot;application/json&quot; },
    timeout: 12, credentials: &quot;omit&quot;
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var data = (d &amp;&amp; d.data) || d || {};
    var list = data.musicList || data.list || [];
    var songs = _mapKuwoList(list);
    return { songs: songs, info: { title: data.album || data.name || &quot;&quot;, cover: fixCover(data.pic || data.img || &quot;&quot;) } };
  }).catch(function(){ return { songs: [] }; });
};





API.kuwoSearch = function(kw, page){
  kw = (kw || &quot;&quot;).trim();
  page = page || 1;
  if (!kw) return Promise.resolve({ list: [], singers: [] });
  var pn = Math.max(0, page - 1);
  var hdr = {
    &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;],
    &quot;Referer&quot;: &quot;https://www.kuwo.cn/&quot;,
    &quot;Accept&quot;: &quot;application/json, text/plain, */*&quot;
  };
  var songUrls = [
    &quot;https://search.kuwo.cn/r.s?all=&quot; + encodeURIComponent(kw) +
      &quot;&amp;ft=music&amp;rn=20&amp;pn=&quot; + pn + &quot;&amp;rformat=json&amp;encoding=utf8&amp;mobi=1&amp;vipver=1&quot;,
    &quot;https://search.kuwo.cn/r.s?all=&quot; + encodeURIComponent(kw) +
      &quot;&amp;ft=music&amp;itemset=web_2013&amp;client=kt&amp;pn=&quot; + pn + &quot;&amp;rn=20&amp;rformat=json&amp;encoding=utf8&quot;
  ];
  var artistUrl = &quot;https://search.kuwo.cn/r.s?all=&quot; + encodeURIComponent(kw) +
    &quot;&amp;ft=artist&amp;rn=12&amp;pn=0&amp;rformat=json&amp;encoding=utf8&amp;mobi=1&quot;;

  function trySongs(url){
    return ADAPTER_request(url, { headers: hdr, timeout: 12, credentials: &quot;omit&quot; }).then(function(txt){
      var d = _parseKuwoBody(txt);
      var list = (d &amp;&amp; d.abslist) || (d &amp;&amp; d.data &amp;&amp; d.data.list) || [];
      return _mapKuwoList(list);
    }).catch(function(){ return []; });
  }
  function fetchArtists(){
    return ADAPTER_request(artistUrl, { headers: hdr, timeout: 10, credentials: &quot;omit&quot; }).then(function(txt){
      var d = _parseKuwoBody(txt);
      var list = (d &amp;&amp; d.abslist) || (d &amp;&amp; d.artistlist) || (d &amp;&amp; d.data &amp;&amp; d.data.list) || [];
      return (list || []).map(function(it){
        var name = it.ARTIST || it.artist || it.name || it.NAME || &quot;&quot;;
        var id = String(it.ARTISTID || it.artistid || it.id || it.DC_TARGETID || name);
        var pic = it.hts_PIC || it.PIC || it.pic || it.img || it.image || &quot;&quot;;
        if (pic &amp;&amp; String(pic).indexOf(&quot;http&quot;) !== 0){
          pic = &quot;https://img1.kuwo.cn/star/starheads/&quot; + String(pic).replace(/^\//, &quot;&quot;);
        }
        if (!name) return null;
        return {
          mid: &quot;kw_ar_&quot; + id,
          name: name,
          cover: fixCover(pic),
          source: &quot;kuwo&quot;
        };
      }).filter(Boolean);
    }).catch(function(){ return []; });
  }
  function singersFromSongs(songs){
    var seen = {}, out = [];
    (songs || []).forEach(function(s){
      var n = ((s.singer || &quot;&quot;).split(/[\/、,&amp;]/)[0] || &quot;&quot;).trim();
      if (!n || seen[n]) return;
      seen[n] = 1;
      out.push({ mid: &quot;kw_ar_&quot; + n, name: n, cover: s.cover || &quot;&quot;, source: &quot;kuwo&quot;, fromSong: true });
    });
    return out;
  }

  return Promise.all([
    trySongs(songUrls[0]).then(function(list){
      if (list &amp;&amp; list.length) return list;
      return trySongs(songUrls[1]);
    }),
    fetchArtists()
  ]).then(function(arr){
    var list = arr[0] || [];
    var singers = arr[1] || [];
    if (singers.length &lt; 3){
      var extra = singersFromSongs(list);
      var seen = {};
      singers.forEach(function(a){ if (a.name) seen[a.name] = 1; });
      extra.forEach(function(a){ if (!seen[a.name]){ seen[a.name] = 1; singers.push(a); } });
    }
    return { list: list, singers: singers.slice(0, 12) };
  }).catch(function(){ return { list: [], singers: [] }; });
};
API.kuwoUrl = function(song){
  var rid = (song &amp;&amp; (song.rid || String(song.songmid || &quot;&quot;).replace(/^kw_/, &quot;&quot;))) || &quot;&quot;;
  if (!rid) return Promise.resolve(null);
  rid = String(rid).replace(/^MUSIC_/i, &quot;&quot;);

  function norm(u){
    if (!u || typeof u !== &quot;string&quot;) return null;
    u = u.trim().replace(/^[&quot;']|[&quot;']$/g, &quot;&quot;);
    if (u.indexOf(&quot;http&quot;) !== 0) return null;
    u = u.replace(/^http:/, &quot;https:&quot;);
    // 仅过滤明确的提示音文件，避免误杀
    if (/588957081\.mp3|M5000004Gmy54cGDqK/i.test(u)) return null;
    if (/kuwo\.cn\/(download|app\/download)/i.test(u)) return null;
    return u;
  }
  function req(url){
    return ADAPTER_request(url, {
      headers: {
        &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;],
        &quot;Referer&quot;: &quot;https://www.kuwo.cn/&quot;,
        &quot;Accept&quot;: &quot;*/*&quot;
      },
      timeout: 14,
      credentials: &quot;omit&quot;
    });
  }
  function pick(txt){
    if (!txt) return null;
    txt = String(txt).trim();
    // 纯链接
    var n = norm(txt);
    if (n) return n;
    // JSON
    var d = _parseKuwoBody(txt);
    if (d){
      var data = d.data || d;
      // 提示音：bitrate=1 且很短
      if (data &amp;&amp; Number(data.bitrate) === 1 &amp;&amp; Number(data.duration || 0) &gt; 0 &amp;&amp; Number(data.duration) &lt; 20){
        return null;
      }
      var u = (data &amp;&amp; data.url) || d.url || &quot;&quot;;
      if (!u &amp;&amp; d.mp3base &amp;&amp; d.mp3url) u = String(d.mp3base) + String(d.mp3url);
      n = norm(u);
      if (n) return n;
    }
    // 文本中抽链接
    var m = /https?:\/\/[^\s&quot;'&lt;&gt;]+/i.exec(txt);
    return m ? norm(m[0]) : null;
  }

  var endpoints = [
    &quot;https://antiserver.kuwo.cn/anti.s?type=convert_url&amp;rid=MUSIC_&quot; + encodeURIComponent(rid) + &quot;&amp;format=mp3&amp;response=url&quot;,
    &quot;https://antiserver.kuwo.cn/anti.s?type=convert_url&amp;rid=&quot; + encodeURIComponent(rid) + &quot;&amp;format=mp3&amp;response=url&quot;,
    &quot;https://mobi.kuwo.cn/mobi.s?f=web&amp;type=convert_url_with_sign&amp;rid=&quot; + encodeURIComponent(rid) + &quot;&amp;format=mp3&quot;,
    &quot;https://mobi.kuwo.cn/mobi.s?f=web&amp;type=convert_url_with_sign&amp;source=jiakong&amp;rid=&quot; + encodeURIComponent(rid) + &quot;&amp;format=mp3&amp;br=128kmp3&quot;,
    &quot;https://nmobi.kuwo.cn/mobi.s?f=web&amp;type=convert_url_with_sign&amp;source=jiakong&amp;rid=&quot; + encodeURIComponent(rid) + &quot;&amp;format=mp3&amp;br=128kmp3&quot;
  ];

  var chain = Promise.resolve(null);
  endpoints.forEach(function(ep){
    chain = chain.then(function(got){
      if (got) return got;
      return req(ep).then(pick).catch(function(){ return null; });
    });
  });
  return chain;
};

API.fallbackViaQQ = function(song){
  var name = (song &amp;&amp; song.name) || &quot;&quot;;
  var singer = (song &amp;&amp; song.singer) || &quot;&quot;;
  if (!name) return Promise.resolve(null);
  var kw = (name + &quot; &quot; + singer.split(/[\/、,&amp;]/)[0]).trim();
  return API._searchByType(kw, 0, 1, 8).then(function(songRes){
    var list = (((songRes || {}).data || {}).song || {}).list || [];
    if (!list.length) return null;
    var best = null, bestScore = -1;
    list.forEach(function(it){
      var n = normalizeSongFromSearch(it);
      var score = 0;
      if (n.name === name) score += 5;
      else if (n.name &amp;&amp; name &amp;&amp; n.name.indexOf(name) &gt;= 0) score += 3;
      else if (n.name &amp;&amp; name &amp;&amp; name.indexOf(n.name) &gt;= 0) score += 2;
      if (singer &amp;&amp; n.singer &amp;&amp; n.singer.indexOf(singer.split(/[\/、]/)[0]) &gt;= 0) score += 3;
      if (score &gt; bestScore){ bestScore = score; best = n; }
    });
    if (!best || bestScore &lt; 2) best = normalizeSongFromSearch(list[0]);
    if (!best || !best.songmid) return null;
    return API.songUrl(best).then(function(url){
      if (url) return url;
      return null;
    });
  }).catch(function(){ return null; });
};



/* ============================================================
   YouTube Music · Innertube (WEB_REMIX / ANDROID)
   搜索走 music.youtube.com；取流优先 ANDROID player，失败再走公共代理
   可配置 state.ytmApi 自定义代理（?q= &amp;id=）
   ============================================================ */
var YTM_KEY = &quot;AIzaSyC9XL3ZjWddXya6X74dJePRLRv-usBAqMw&quot;;
var YTM_HDR = {
  &quot;Content-Type&quot;: &quot;application/json&quot;,
  &quot;User-Agent&quot;: &quot;Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36&quot;,
  &quot;Origin&quot;: &quot;https://music.youtube.com&quot;,
  &quot;Referer&quot;: &quot;https://music.youtube.com/&quot;
};
function _ytmContext(client){
  client = client || &quot;web&quot;;
  if (client === &quot;android&quot;){
    return {
      client: {
        clientName: &quot;ANDROID&quot;,
        clientVersion: &quot;19.28.35&quot;,
        androidSdkVersion: 30,
        hl: &quot;en&quot;,
        gl: &quot;US&quot;,
        userAgent: &quot;com.google.android.youtube/19.28.35 (Linux; U; Android 11) gzip&quot;
      }
    };
  }
  if (client === &quot;android_music&quot;){
    return {
      client: {
        clientName: &quot;ANDROID_MUSIC&quot;,
        clientVersion: &quot;7.27.52&quot;,
        androidSdkVersion: 30,
        hl: &quot;en&quot;,
        gl: &quot;US&quot;
      }
    };
  }
  return {
    client: {
      clientName: &quot;WEB_REMIX&quot;,
      clientVersion: &quot;1.20250310.01.00&quot;,
      hl: &quot;en&quot;,
      gl: &quot;US&quot;
    }
  };
}
function _ytmPost(path, body, client){
  var ctx = _ytmContext(client);
  body = body || {};
  body.context = ctx;
  var payload = JSON.stringify(body);
  var hosts = client === &quot;android&quot; || client === &quot;android_music&quot;
    ? [&quot;https://music.youtube.com&quot;, &quot;https://www.youtube.com&quot;]
    : [&quot;https://music.youtube.com&quot;, &quot;https://www.youtube.com&quot;];
  var chain = Promise.resolve(null);
  hosts.forEach(function(host){
    chain = chain.then(function(got){
      if (got) return got;
      var url = host + &quot;/youtubei/v1/&quot; + path + &quot;?prettyPrint=false&amp;key=&quot; + encodeURIComponent(YTM_KEY);
      return ADAPTER_request(url, {
        method: &quot;POST&quot;,
        headers: {
          &quot;Content-Type&quot;: &quot;application/json&quot;,
          &quot;User-Agent&quot;: YTM_HDR[&quot;User-Agent&quot;],
          &quot;Origin&quot;: host,
          &quot;Referer&quot;: host + &quot;/&quot;
        },
        body: payload,
        timeout: 16,
        credentials: &quot;omit&quot;
      }).then(function(txt){
        if (!txt || !String(txt).trim()) return null;
        var d = null;
        try { d = JSON.parse(txt); } catch(e){ d = jsonp_safeParse(txt); }
        // 空结果（只有找不到）跳过
        if (!d) return null;
        var s = &quot;&quot;;
        try { s = JSON.stringify(d); } catch(e2){}
        if (s.indexOf(&quot;videoId&quot;) &lt; 0 &amp;&amp; s.indexOf(&quot;musicResponsiveListItemRenderer&quot;) &lt; 0 &amp;&amp; path === &quot;search&quot;){
          return null;
        }
        return d;
      }).catch(function(){ return null; });
    });
  });
  return chain;
}
function _ytmParseDuration(s){
  if (!s) return 0;
  if (typeof s === &quot;number&quot;) return Math.round(s);
  var parts = String(s).split(&quot;:&quot;).map(function(x){ return parseInt(x, 10) || 0; });
  if (parts.length === 3) return parts[0]*3600 + parts[1]*60 + parts[2];
  if (parts.length === 2) return parts[0]*60 + parts[1];
  return parts[0] || 0;
}
function _ytmThumb(thumbs){
  if (!thumbs) return &quot;&quot;;
  if (typeof thumbs === &quot;string&quot;) return thumbs.replace(/^http:/, &quot;https:&quot;);
  if (Array.isArray(thumbs) &amp;&amp; thumbs.length){
    var t = thumbs[thumbs.length - 1];
    return (t.url || t) ? String(t.url || t).replace(/^http:/, &quot;https:&quot;) : &quot;&quot;;
  }
  return &quot;&quot;;
}
function _ytmWalkRuns(runs){
  if (!runs || !runs.length) return &quot;&quot;;
  return runs.map(function(r){ return r.text || &quot;&quot;; }).join(&quot;&quot;);
}
function _ytmCollectSongs(node, out, depth){
  if (!node || depth &gt; 12) return;
  out = out || [];
  depth = depth || 0;
  if (Array.isArray(node)){
    node.forEach(function(n){ _ytmCollectSongs(n, out, depth+1); });
    return out;
  }
  if (typeof node !== &quot;object&quot;) return out;
  // musicResponsiveListItemRenderer
  var r = node.musicResponsiveListItemRenderer;
  if (r){
    var vid = &quot;&quot;;
    try {
      vid = (r.playlistItemData &amp;&amp; r.playlistItemData.videoId) ||
        (r.overlay &amp;&amp; r.overlay.musicItemThumbnailOverlayRenderer &amp;&amp;
          r.overlay.musicItemThumbnailOverlayRenderer.content &amp;&amp;
          r.overlay.musicItemThumbnailOverlayRenderer.content.musicPlayButtonRenderer &amp;&amp;
          r.overlay.musicItemThumbnailOverlayRenderer.content.musicPlayButtonRenderer.playNavigationEndpoint &amp;&amp;
          r.overlay.musicItemThumbnailOverlayRenderer.content.musicPlayButtonRenderer.playNavigationEndpoint.watchEndpoint &amp;&amp;
          r.overlay.musicItemThumbnailOverlayRenderer.content.musicPlayButtonRenderer.playNavigationEndpoint.watchEndpoint.videoId) || &quot;&quot;;
    } catch(e0){}
    if (!vid &amp;&amp; r.navigationEndpoint &amp;&amp; r.navigationEndpoint.watchEndpoint){
      vid = r.navigationEndpoint.watchEndpoint.videoId || &quot;&quot;;
    }
    var title = &quot;&quot;, artist = &quot;&quot;, album = &quot;&quot;, dur = 0, cover = &quot;&quot;;
    try {
      var cols = r.flexColumns || [];
      if (cols[0]){
        var tRuns = (((cols[0].musicResponsiveListItemFlexColumnRenderer || {}).text) || {}).runs || [];
        title = _ytmWalkRuns(tRuns);
      }
      if (cols[1]){
        var aRuns = (((cols[1].musicResponsiveListItemFlexColumnRenderer || {}).text) || {}).runs || [];
        var parts = aRuns.map(function(x){ return x.text || &quot;&quot;; }).filter(function(x){ return x &amp;&amp; x !== &quot; • &quot; &amp;&amp; x !== &quot;•&quot;; });
        // 常见：歌手 · 专辑 · 时长
        if (parts.length){
          artist = parts[0] || &quot;&quot;;
          if (parts.length &gt;= 2 &amp;&amp; !/^\d+:\d+/.test(parts[1])) album = parts[1] || &quot;&quot;;
          var last = parts[parts.length - 1] || &quot;&quot;;
          if (/^\d+:\d+/.test(last)) dur = _ytmParseDuration(last);
        }
      }
      var th = (r.thumbnail &amp;&amp; r.thumbnail.musicThumbnailRenderer &amp;&amp; r.thumbnail.musicThumbnailRenderer.thumbnail &amp;&amp; r.thumbnail.musicThumbnailRenderer.thumbnail.thumbnails) || [];
      cover = _ytmThumb(th);
    } catch(e1){}
    if (vid &amp;&amp; title){
      out.push({
        songmid: &quot;yt_&quot; + vid,
        videoId: vid,
        media_mid: vid,
        name: title,
        singer: artist || &quot;YouTube Music&quot;,
        albumname: album || &quot;&quot;,
        cover: cover,
        interval: dur,
        isVip: false,
        playUrl: &quot;&quot;,
        source: &quot;ytmusic&quot;
      });
    }
  }
  // musicTwoRowItemRenderer（卡片）
  var two = node.musicTwoRowItemRenderer;
  if (two){
    var vid2 = &quot;&quot;;
    try {
      vid2 = (two.navigationEndpoint &amp;&amp; two.navigationEndpoint.watchEndpoint &amp;&amp; two.navigationEndpoint.watchEndpoint.videoId) || &quot;&quot;;
    } catch(e2){}
    var title2 = _ytmWalkRuns(((two.title || {}).runs) || []);
    var sub2 = _ytmWalkRuns(((two.subtitle || {}).runs) || []);
    var th2 = (two.thumbnailRenderer &amp;&amp; two.thumbnailRenderer.musicThumbnailRenderer &amp;&amp; two.thumbnailRenderer.musicThumbnailRenderer.thumbnail &amp;&amp; two.thumbnailRenderer.musicThumbnailRenderer.thumbnail.thumbnails) || [];
    if (vid2 &amp;&amp; title2){
      out.push({
        songmid: &quot;yt_&quot; + vid2,
        videoId: vid2,
        media_mid: vid2,
        name: title2,
        singer: sub2 || &quot;YouTube Music&quot;,
        albumname: &quot;&quot;,
        cover: _ytmThumb(th2),
        interval: 0,
        isVip: false,
        playUrl: &quot;&quot;,
        source: &quot;ytmusic&quot;
      });
    }
  }
  Object.keys(node).forEach(function(k){
    if (k === &quot;musicResponsiveListItemRenderer&quot; || k === &quot;musicTwoRowItemRenderer&quot;) return;
    var v = node[k];
    if (v &amp;&amp; typeof v === &quot;object&quot;) _ytmCollectSongs(v, out, depth+1);
  });
  return out;
}
function _ytmDedup(list){
  var seen = {}, out = [];
  (list || []).forEach(function(s){
    if (!s || !s.videoId || seen[s.videoId]) return;
    seen[s.videoId] = 1;
    out.push(s);
  });
  return out;
}
function _ytmCollectArtists(node, out, depth){
  if (!node || depth &gt; 12) return out || [];
  out = out || [];
  depth = depth || 0;
  if (Array.isArray(node)){
    node.forEach(function(n){ _ytmCollectArtists(n, out, depth+1); });
    return out;
  }
  if (typeof node !== &quot;object&quot;) return out;
  var r = node.musicResponsiveListItemRenderer || node.musicTwoRowItemRenderer;
  if (r){
    var browseId = &quot;&quot;;
    var title = &quot;&quot;;
    var cover = &quot;&quot;;
    try {
      var ne = r.navigationEndpoint || {};
      browseId = (ne.browseEndpoint &amp;&amp; ne.browseEndpoint.browseId) || &quot;&quot;;
      // 歌手 browseId 一般以 UC 开头，或含 artist
      if (!browseId &amp;&amp; r.overlay){
        // ignore play overlay
      }
      if (r.title &amp;&amp; r.title.runs) title = _ytmWalkRuns(r.title.runs);
      if (!title &amp;&amp; r.flexColumns &amp;&amp; r.flexColumns[0]){
        title = _ytmWalkRuns((((r.flexColumns[0].musicResponsiveListItemFlexColumnRenderer||{}).text)||{}).runs||[]);
      }
      var th = (r.thumbnail &amp;&amp; r.thumbnail.musicThumbnailRenderer &amp;&amp; r.thumbnail.musicThumbnailRenderer.thumbnail &amp;&amp; r.thumbnail.musicThumbnailRenderer.thumbnail.thumbnails)
        || (r.thumbnailRenderer &amp;&amp; r.thumbnailRenderer.musicThumbnailRenderer &amp;&amp; r.thumbnailRenderer.musicThumbnailRenderer.thumbnail &amp;&amp; r.thumbnailRenderer.musicThumbnailRenderer.thumbnail.thumbnails)
        || [];
      cover = _ytmThumb(th);
      // subtitle 含 &quot;艺人/Artist/歌手&quot;
      var sub = &quot;&quot;;
      if (r.subtitle &amp;&amp; r.subtitle.runs) sub = _ytmWalkRuns(r.subtitle.runs);
      if (r.flexColumns &amp;&amp; r.flexColumns[1]){
        sub = sub || _ytmWalkRuns((((r.flexColumns[1].musicResponsiveListItemFlexColumnRenderer||{}).text)||{}).runs||[]);
      }
      var isArtist = /^UC/.test(browseId) || /艺人|Artist|歌手|channel/i.test(sub) || (browseId &amp;&amp; !r.playlistItemData &amp;&amp; !((ne.watchEndpoint)||{}).videoId);
      if (isArtist &amp;&amp; title &amp;&amp; browseId){
        out.push({ mid: browseId, browseId: browseId, name: title, cover: cover, source: &quot;ytmusic&quot; });
      }
    } catch(e){}
  }
  Object.keys(node).forEach(function(k){
    if (k === &quot;musicResponsiveListItemRenderer&quot; || k === &quot;musicTwoRowItemRenderer&quot;) return;
    if (node[k] &amp;&amp; typeof node[k] === &quot;object&quot;) _ytmCollectArtists(node[k], out, depth+1);
  });
  return out;
}
function _ytmDedupArtists(list){
  var seen = {}, out = [];
  (list || []).forEach(function(a){
    if (!a || !a.browseId || seen[a.browseId]) return;
    seen[a.browseId] = 1;
    out.push(a);
  });
  return out;
}

API.ytmusicSearch = function(kw, page){
  kw = (kw || &quot;&quot;).trim();
  page = page || 1;
  if (!kw) return Promise.resolve({ list: [], total: 0 });
  // 自定义代理优先
  var base = (state.ytmApi || &quot;&quot;).replace(/\/$/, &quot;&quot;);
  if (base){
    var u = base + (base.indexOf(&quot;?&quot;) &gt;= 0 ? &quot;&amp;&quot; : &quot;?&quot;) + &quot;q=&quot; + encodeURIComponent(kw) + &quot;&amp;page=&quot; + page;
    return ADAPTER_request(u, { headers: { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;] }, timeout: 14 }).then(function(txt){
      var d = null;
      try { d = JSON.parse(txt); } catch(e){ d = jsonp_safeParse(txt); }
      var arr = (d &amp;&amp; (d.list || d.data || d.results || d.items)) || (Array.isArray(d) ? d : []);
      var list = (arr || []).map(function(it, i){
        var vid = it.videoId || it.id || it.video_id || &quot;&quot;;
        if (!vid &amp;&amp; it.url){ var mm = /[?&amp;]v=([\w-]{6,})/.exec(it.url); if (mm) vid = mm[1]; }
        if (!vid) return null;
        return {
          songmid: &quot;yt_&quot; + vid,
          videoId: vid,
          media_mid: vid,
          name: it.title || it.name || it.song || &quot;&quot;,
          singer: it.artist || it.singer || it.author || it.channel || &quot;YouTube Music&quot;,
          albumname: it.album || &quot;&quot;,
          cover: fixCover(it.thumbnail || it.cover || it.thumb || (&quot;https://i.ytimg.com/vi/&quot; + vid + &quot;/hqdefault.jpg&quot;)),
          interval: _ytmParseDuration(it.duration || it.interval || 0),
          isVip: false,
          playUrl: it.url || it.playUrl || it.music || &quot;&quot;,
          source: &quot;ytmusic&quot;
        };
      }).filter(Boolean);
      return { list: list, total: list.length };
    }).catch(function(){ return { list: [], total: 0 }; });
  }

  function fromInnertube(){
    // 不要带 songs filter params（部分地区/版本会直接空结果）
    function pack(d){
      if (!d) return { list: [], singers: [] };
      return {
        list: _ytmDedup(_ytmCollectSongs(d, [], 0)),
        singers: _ytmDedupArtists(_ytmCollectArtists(d, [], 0))
      };
    }
    return _ytmPost(&quot;search&quot;, { query: kw }, &quot;web&quot;).then(function(d){
      var p = pack(d);
      if (p.list.length || p.singers.length) return p;
      return _ytmPost(&quot;search&quot;, { query: kw }, &quot;android_music&quot;).then(pack);
    });
  }

  function fromYoutubeWeb(){
    // 普通 YouTube 搜索兜底（结构不同）
    var url = &quot;https://www.youtube.com/youtubei/v1/search?prettyPrint=false&amp;key=&quot; + encodeURIComponent(YTM_KEY);
    var body = JSON.stringify({
      context: { client: { clientName: &quot;WEB&quot;, clientVersion: &quot;2.20250312.00.00&quot;, hl: &quot;en&quot;, gl: &quot;US&quot; } },
      query: kw
    });
    return ADAPTER_request(url, {
      method: &quot;POST&quot;,
      headers: {
        &quot;Content-Type&quot;: &quot;application/json&quot;,
        &quot;User-Agent&quot;: YTM_HDR[&quot;User-Agent&quot;],
        &quot;Origin&quot;: &quot;https://www.youtube.com&quot;,
        &quot;Referer&quot;: &quot;https://www.youtube.com/&quot;
      },
      body: body,
      timeout: 16,
      credentials: &quot;omit&quot;
    }).then(function(txt){
      if (!txt) return [];
      var d = null;
      try { d = JSON.parse(txt); } catch(e){ d = jsonp_safeParse(txt); }
      if (!d) return [];
      var out = [];
      function walk(node, depth){
        if (!node || depth &gt; 14) return;
        if (Array.isArray(node)){ node.forEach(function(n){ walk(n, depth+1); }); return; }
        if (typeof node !== &quot;object&quot;) return;
        var vr = node.videoRenderer || node.playlistVideoRenderer;
        if (vr &amp;&amp; vr.videoId){
          var title = _ytmWalkRuns(((vr.title || {}).runs) || []) || (vr.title &amp;&amp; vr.title.simpleText) || &quot;&quot;;
          var author = &quot;&quot;;
          try {
            author = _ytmWalkRuns(((((vr.ownerText || vr.shortBylineText) || {}).runs) || []));
          } catch(e){}
          var dur = 0;
          try {
            var ds = (vr.lengthText &amp;&amp; (vr.lengthText.simpleText || _ytmWalkRuns(vr.lengthText.runs || []))) || &quot;&quot;;
            dur = _ytmParseDuration(ds);
          } catch(e2){}
          var cover = &quot;&quot;;
          try {
            var th = (vr.thumbnail &amp;&amp; vr.thumbnail.thumbnails) || [];
            cover = _ytmThumb(th) || (&quot;https://i.ytimg.com/vi/&quot; + vr.videoId + &quot;/hqdefault.jpg&quot;);
          } catch(e3){}
          if (title){
            out.push({
              songmid: &quot;yt_&quot; + vr.videoId,
              videoId: vr.videoId,
              media_mid: vr.videoId,
              name: title,
              singer: author || &quot;YouTube&quot;,
              albumname: &quot;&quot;,
              cover: cover,
              interval: dur,
              isVip: false,
              playUrl: &quot;&quot;,
              source: &quot;ytmusic&quot;
            });
          }
        }
        Object.keys(node).forEach(function(k){
          if (k === &quot;videoRenderer&quot; || k === &quot;playlistVideoRenderer&quot;) return;
          if (node[k] &amp;&amp; typeof node[k] === &quot;object&quot;) walk(node[k], depth+1);
        });
      }
      walk(d, 0);
      return _ytmDedup(out);
    }).catch(function(){ return []; });
  }

  function withSingers(list, singers){
    list = list || [];
    singers = singers || [];
    if (singers.length &lt; 3 &amp;&amp; list.length){
      var seen = {};
      singers.forEach(function(a){ if (a.name) seen[a.name] = 1; });
      list.forEach(function(s){
        var n = (s.singer || &quot;&quot;).split(/[\/、,&amp;]/)[0].trim();
        if (!n || seen[n] || /YouTube/i.test(n)) return;
        seen[n] = 1;
        singers.push({
          mid: &quot;yt_artist_&quot; + n,
          browseId: &quot;&quot;,
          name: n,
          cover: s.cover || &quot;&quot;,
          source: &quot;ytmusic&quot;,
          fromSong: true
        });
      });
    }
    return { list: list.slice(0, 30), total: list.length, singers: singers.slice(0, 12) };
  }

  // 并行：YT Music Innertube + 普通 YouTube 搜索，谁先有结果用谁
  return Promise.all([
    fromInnertube().catch(function(){ return { list: [], singers: [] }; }),
    fromYoutubeWeb().catch(function(){ return []; })
  ]).then(function(arr){
    var pack = arr[0] || { list: [], singers: [] };
    var webList = arr[1] || [];
    var list = (pack.list &amp;&amp; pack.list.length) ? pack.list : webList;
    var singers = pack.singers || [];
    // Innertube 有歌手但没歌时，用 web 补歌
    if ((!list || !list.length) &amp;&amp; webList.length) list = webList;
    return withSingers(list, singers);
  }).catch(function(){
    return fromYoutubeWeb().then(function(list2){
      return withSingers(list2 || [], []);
    }).catch(function(){ return { list: [], total: 0, singers: [] }; });
  });
};

/** 从 player 响应提取最佳音频直链 */
function _ytmPickAudio(d){
  if (!d) return null;
  var formats = [];
  try {
    var sf = (d.streamingData &amp;&amp; d.streamingData.adaptiveFormats) || [];
    var f2 = (d.streamingData &amp;&amp; d.streamingData.formats) || [];
    formats = sf.concat(f2);
  } catch(e){}
  var best = null, bestBr = -1;
  formats.forEach(function(f){
    if (!f || !f.url) return;
    var mime = String(f.mimeType || &quot;&quot;);
    // 只要纯音频
    if (mime.indexOf(&quot;audio/&quot;) &lt; 0 &amp;&amp; !(f.audioQuality || f.audioSampleRate)) return;
    if (mime.indexOf(&quot;video/&quot;) &gt;= 0 &amp;&amp; !(f.audioQuality)) return;
    var br = Number(f.bitrate || f.averageBitrate || 0);
    if (br &gt; bestBr){ bestBr = br; best = f; }
  });
  if (best &amp;&amp; best.url) return String(best.url).replace(/^http:/, &quot;https:&quot;);
  // 部分响应只有 signatureCipher，浏览器端难解，跳过
  return null;
}

API.ytmusicUrl = function(song){
  var vid = (song &amp;&amp; (song.videoId || String(song.songmid || &quot;&quot;).replace(/^yt_/, &quot;&quot;))) || &quot;&quot;;
  if (!vid) return Promise.resolve(null);
  // 仅复用仍新鲜的直链（googlevideo 过期极快）
  if (song.playUrl &amp;&amp; isPlayUrlFresh(song) &amp;&amp;
      /^https?:\/\//i.test(song.playUrl) &amp;&amp;
      /googlevideo\.com|youtube\.com|piped|invidious|ytimg/i.test(song.playUrl)){
    return Promise.resolve(song.playUrl);
  }

  // 自定义代理：优先（用户自建最稳）
  var base = (state.ytmApi || &quot;&quot;).replace(/\/$/, &quot;&quot;);
  function fromCustomProxy(){
    if (!base) return Promise.resolve(null);
    var tries = [
      base + (base.indexOf(&quot;?&quot;) &gt;= 0 ? &quot;&amp;&quot; : &quot;?&quot;) + &quot;id=&quot; + encodeURIComponent(vid),
      base + (base.indexOf(&quot;?&quot;) &gt;= 0 ? &quot;&amp;&quot; : &quot;?&quot;) + &quot;v=&quot; + encodeURIComponent(vid),
      base.replace(/\/$/, &quot;&quot;) + &quot;/stream/&quot; + encodeURIComponent(vid),
      base.replace(/\/$/, &quot;&quot;) + &quot;/streams/&quot; + encodeURIComponent(vid)
    ];
    var chain = Promise.resolve(null);
    tries.forEach(function(u){
      chain = chain.then(function(got){
        if (got) return got;
        return ADAPTER_request(u, { headers: { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;] }, timeout: 14 }).then(function(txt){
          if (!txt) return null;
          if (/^https?:\/\//i.test(String(txt).trim())) return String(txt).trim().replace(/^http:/, &quot;https:&quot;);
          var d = null;
          try { d = JSON.parse(txt); } catch(e){ d = jsonp_safeParse(txt); }
          if (!d) return null;
          var url = d.url || d.playUrl || d.music || d.stream || d.audioUrl ||
            (d.data &amp;&amp; (d.data.url || d.data.playUrl || d.data.stream)) || &quot;&quot;;
          // 部分代理返回 audioStreams 数组
          if (!url &amp;&amp; d.audioStreams &amp;&amp; d.audioStreams[0]) url = d.audioStreams[0].url;
          return url ? String(url).replace(/^http:/, &quot;https:&quot;) : null;
        }).catch(function(){ return null; });
      });
    });
    return chain;
  }

  function pickAudio(d){
    if (!d) return null;
    var status = (d.playabilityStatus &amp;&amp; d.playabilityStatus.status) || &quot;&quot;;
    if (status &amp;&amp; status !== &quot;OK&quot; &amp;&amp; status !== &quot;LIVE_STREAM_OFFLINE&quot;){
      // UNPLAYABLE / LOGIN_REQUIRED 等直接放弃该 client
      return null;
    }
    var formats = [];
    try {
      var sf = (d.streamingData &amp;&amp; d.streamingData.adaptiveFormats) || [];
      var f2 = (d.streamingData &amp;&amp; d.streamingData.formats) || [];
      formats = sf.concat(f2);
    } catch(e){}
    var best = null, bestBr = -1;
    formats.forEach(function(f){
      if (!f) return;
      // 优先明文 url；cipher 无法在无解签器时使用
      var raw = f.url || &quot;&quot;;
      if (!raw &amp;&amp; f.signatureCipher){
        try {
          var sp = String(f.signatureCipher);
          var um = /(?:^|&amp;)url=([^&amp;]+)/.exec(sp);
          if (um) raw = decodeURIComponent(um[1]);
        } catch(eC) {}
      }
      if (!raw || !/^https?:\/\//i.test(raw)) return;
      var mime = String(f.mimeType || &quot;&quot;);
      var isAudio = mime.indexOf(&quot;audio/&quot;) &gt;= 0 || !!f.audioQuality || !!f.audioSampleRate;
      if (!isAudio) return;
      var br = Number(f.bitrate || f.averageBitrate || 0);
      if (br &gt; bestBr){ bestBr = br; best = raw; }
    });
    return best ? String(best).replace(/^http:/, &quot;https:&quot;) : null;
  }

  function playerTry(clientName, clientVersion, host, extraClient){
    var client = Object.assign({
      clientName: clientName,
      clientVersion: clientVersion,
      hl: &quot;zh-CN&quot;,
      gl: &quot;US&quot;
    }, extraClient || {});
    var body = {
      context: { client: client },
      videoId: vid,
      contentCheckOk: true,
      racyCheckOk: true,
      playbackContext: {
        contentPlaybackContext: { html5Preference: &quot;HTML5_PREF_WANTS&quot; }
      }
    };
    var url = host + &quot;/youtubei/v1/player?prettyPrint=false&amp;key=&quot; + encodeURIComponent(YTM_KEY);
    return ADAPTER_request(url, {
      method: &quot;POST&quot;,
      headers: {
        &quot;Content-Type&quot;: &quot;application/json&quot;,
        &quot;User-Agent&quot;: (clientName.indexOf(&quot;ANDROID&quot;) &gt;= 0)
          ? (&quot;com.google.android.youtube/&quot; + clientVersion + &quot; (Linux; U; Android 11) gzip&quot;)
          : YTM_HDR[&quot;User-Agent&quot;],
        &quot;Origin&quot;: host,
        &quot;Referer&quot;: host + &quot;/watch?v=&quot; + encodeURIComponent(vid)
      },
      body: JSON.stringify(body),
      timeout: 11,
      credentials: &quot;omit&quot;
    }).then(function(txt){
      if (!txt) return null;
      var d = null;
      try { d = JSON.parse(txt); } catch(e){ d = jsonp_safeParse(txt); }
      return pickAudio(d);
    }).catch(function(){ return null; });
  }

  function parseProxyStreams(txt){
    if (!txt) return null;
    var d = null;
    try { d = JSON.parse(txt); } catch(e){ return null; }
    if (!d) return null;
    // Piped
    var audio = d.audioStreams || [];
    if (audio.length){
      audio = audio.slice().sort(function(a,b){ return (b.bitrate||0)-(a.bitrate||0); });
      for (var i = 0; i &lt; audio.length; i++){
        var u2 = audio[i] &amp;&amp; audio[i].url;
        if (u2) return String(u2).replace(/^http:/, &quot;https:&quot;);
      }
    }
    // Invidious / 通用
    if (d.adaptiveFormats || d.formatStreams){
      var af = [].concat(d.adaptiveFormats || [], d.formatStreams || []);
      var best = null, bestBr = -1;
      af.forEach(function(f){
        var t = String(f.type || f.mimeType || &quot;&quot;);
        if (t.indexOf(&quot;audio&quot;) &lt; 0 &amp;&amp; !f.audioSampleRate) return;
        var br = Number(f.bitrate || 0);
        var fu = f.url || &quot;&quot;;
        if (fu &amp;&amp; br &gt;= bestBr){ bestBr = br; best = fu; }
      });
      if (best) return String(best).replace(/^http:/, &quot;https:&quot;);
    }
    // Cobalt 等
    var one = d.url || d.audio || d.stream || d.audioUrl ||
      (d.data &amp;&amp; (d.data.url || d.data.audio)) || &quot;&quot;;
    if (one &amp;&amp; /^https?:\/\//i.test(String(one))) return String(one).replace(/^http:/, &quot;https:&quot;);
    return null;
  }

  function fromPublicProxies(){
    var endpoints = [
      &quot;https://pipedapi.kavin.rocks/streams/&quot; + encodeURIComponent(vid),
      &quot;https://pipedapi.adminforge.de/streams/&quot; + encodeURIComponent(vid),
      &quot;https://api.piped.private.coffee/streams/&quot; + encodeURIComponent(vid),
      &quot;https://pipedapi.leptons.xyz/streams/&quot; + encodeURIComponent(vid),
      &quot;https://invidious.jing.rocks/api/v1/videos/&quot; + encodeURIComponent(vid),
      &quot;https://inv.nadeko.net/api/v1/videos/&quot; + encodeURIComponent(vid),
      &quot;https://yt.artemislena.eu/api/v1/videos/&quot; + encodeURIComponent(vid),
      &quot;https://invidious.fdn.fr/api/v1/videos/&quot; + encodeURIComponent(vid)
    ];
    // 并行竞速：谁先返回可用音频链用谁（总等待封顶约 12s）
    return new Promise(function(resolve){
      var settled = false;
      var left = endpoints.length;
      if (!left){ resolve(null); return; }
      var timer = setTimeout(function(){
        if (!settled){ settled = true; resolve(null); }
      }, 12000);
      endpoints.forEach(function(mu){
        ADAPTER_request(mu, {
          headers: { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Accept&quot;: &quot;application/json&quot; },
          timeout: 10,
          credentials: &quot;omit&quot;
        }).then(function(txt){
          var u = parseProxyStreams(txt);
          if (u &amp;&amp; !settled){
            settled = true;
            clearTimeout(timer);
            resolve(u);
          }
        }).catch(function(){}).then(function(){
          left--;
          if (left &lt;= 0 &amp;&amp; !settled){
            settled = true;
            clearTimeout(timer);
            resolve(null);
          }
        });
      });
    });
  }

  function fromCobalt(){
    // Cobalt 公共 API：只要音频
    var body = JSON.stringify({
      url: &quot;https://www.youtube.com/watch?v=&quot; + vid,
      downloadMode: &quot;audio&quot;,
      audioFormat: &quot;mp3&quot;,
      filenameStyle: &quot;basic&quot;
    });
    return ADAPTER_request(&quot;https://api.cobalt.tools/&quot;, {
      method: &quot;POST&quot;,
      headers: {
        &quot;Content-Type&quot;: &quot;application/json&quot;,
        &quot;Accept&quot;: &quot;application/json&quot;,
        &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;]
      },
      body: body,
      timeout: 12,
      credentials: &quot;omit&quot;
    }).then(function(txt){
      return parseProxyStreams(txt);
    }).catch(function(){ return null; });
  }

  // 顺序：自定义代理 → 多 client player → 公共代理竞速 → Cobalt
  return fromCustomProxy().then(function(u0){
    if (u0) return u0;
    var clients = [
      function(){ return playerTry(&quot;ANDROID&quot;, &quot;19.17.34&quot;, &quot;https://www.youtube.com&quot;, { androidSdkVersion: 30 }); },
      function(){ return playerTry(&quot;ANDROID_MUSIC&quot;, &quot;7.27.52&quot;, &quot;https://music.youtube.com&quot;, { androidSdkVersion: 30 }); },
      function(){ return playerTry(&quot;IOS&quot;, &quot;19.09.3&quot;, &quot;https://www.youtube.com&quot;, { deviceMake: &quot;Apple&quot;, deviceModel: &quot;iPhone16,2&quot; }); },
      function(){ return playerTry(&quot;TVHTML5_SIMPLY&quot;, &quot;1.0&quot;, &quot;https://www.youtube.com&quot;, {}); },
      function(){ return playerTry(&quot;WEB&quot;, &quot;2.20250312.00.00&quot;, &quot;https://www.youtube.com&quot;, {}); },
      function(){ return playerTry(&quot;WEB_REMIX&quot;, &quot;1.20250312.01.00&quot;, &quot;https://music.youtube.com&quot;, {}); }
    ];
    var chain = Promise.resolve(null);
    clients.forEach(function(fn){
      chain = chain.then(function(got){ return got || fn(); });
    });
    return chain.then(function(u1){
      if (u1) return u1;
      return fromPublicProxies().then(function(u2){
        if (u2) return u2;
        return fromCobalt();
      });
    });
  });
};

/** 清洗 YT 标题，便于 QQ/酷我跨源匹配 */
API.ytCleanTitle = function(song){
  var raw = (song &amp;&amp; song.name) || &quot;&quot;;
  var singer = (song &amp;&amp; song.singer) || &quot;&quot;;
  // 书名号优先
  var book = /[《「]([^」》]+)[」》]/.exec(raw);
  if (book &amp;&amp; book[1]) return book[1].trim();
  var name = String(raw)
    .replace(/\s*[\(（\[]?\s*Official\s*(Music\s*)?Video\s*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*[\(（\[]?\s*Official\s*Audio\s*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*[\(（\[]?\s*Official\s*Lyric\s*Video\s*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*[\(（\[]?\s*Lyrics?\s*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*[\(（\[]?\s*Audio\s*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*[\(（\[]?\s*MV\s*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*[\(（\[]?\s*HD\s*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*[\(（\[]?\s*4K\s*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*[\(（\[]?\s*Live\s*(Performance|Session|at)[^\)）\]]*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*[\(（\[]?\s*Topic\s*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*[\(（\[]?\s*Color\s*Coded[^\)）\]]*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*[\(（\[]?\s*feat\.?[^\)）\]]*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*[\(（\[]?\s*ft\.?[^\)）\]]*[\)）\]]?/ig, &quot;&quot;)
    .replace(/\s*\|\s*Official.*$/ig, &quot;&quot;)
    .replace(/\s*【[^】]*】/g, &quot;&quot;)
    .replace(/\s*\[[^\]]*\]/g, &quot;&quot;)
    .replace(/Joker\s*Xue/ig, &quot;&quot;)
    .replace(/\s+[-–—]\s+(Official|Audio|Video|Lyrics|MV).*$/ig, &quot;&quot;)
    .replace(/\s+/g, &quot; &quot;)
    .trim();
  if (singer){
    var s0 = singer.split(/[\/、,&amp;]/)[0].trim();
    if (s0 &amp;&amp; name.toLowerCase().indexOf(s0.toLowerCase()) === 0){
      name = name.slice(s0.length).replace(/^[\s\-–—_:：]+/, &quot;&quot;).trim();
    }
  }
  return name || raw;
};

API.ytmusicLyric = function(videoId){
  if (!videoId) return Promise.resolve({ lyric: &quot;&quot;, trans: &quot;&quot; });
  // next → watchNext → lyrics browseId
  return _ytmPost(&quot;next&quot;, {
    enablePersistentPlaylistPanel: true,
    isAudioOnly: true,
    tunerSettingValue: &quot;AUTOMIX_SETTING_NORMAL&quot;,
    videoId: videoId
  }, &quot;web&quot;).then(function(d){
    if (!d) return { lyric: &quot;&quot;, trans: &quot;&quot; };
    var browseId = &quot;&quot;;
    try {
      var tabs = (((((d.contents || {}).singleColumnMusicWatchNextResultsRenderer || {}).tabbedRenderer || {}).tabbedSearchResultsRenderer || {}).tabs) ||
        (((((d.contents || {}).singleColumnMusicWatchNextResultsRenderer || {}).tabbedRenderer || {}).watchNextTabbedResultsRenderer || {}).tabs) || [];
      // 结构多变，深度找 lyrics
      function findLyricsId(node, depth){
        if (!node || depth &gt; 14) return &quot;&quot;;
        if (Array.isArray(node)){
          for (var i=0;i&lt;node.length;i++){ var x=findLyricsId(node[i], depth+1); if (x) return x; }
          return &quot;&quot;;
        }
        if (typeof node !== &quot;object&quot;) return &quot;&quot;;
        if (node.browseId &amp;&amp; String(node.browseId).indexOf(&quot;MPLYt&quot;) === 0) return node.browseId;
        if (node.endpoint &amp;&amp; node.endpoint.browseEndpoint &amp;&amp; node.endpoint.browseEndpoint.browseId){
          var bid = node.endpoint.browseEndpoint.browseId;
          if (String(bid).indexOf(&quot;MPLYt&quot;) === 0) return bid;
        }
        if (node.browseEndpoint &amp;&amp; node.browseEndpoint.browseId){
          var bid2 = node.browseEndpoint.browseId;
          if (String(bid2).indexOf(&quot;MPLYt&quot;) === 0) return bid2;
        }
        var keys = Object.keys(node);
        for (var k=0;k&lt;keys.length;k++){
          var v = node[keys[k]];
          if (v &amp;&amp; typeof v === &quot;object&quot;){
            var f = findLyricsId(v, depth+1);
            if (f) return f;
          }
        }
        return &quot;&quot;;
      }
      browseId = findLyricsId(d, 0);
    } catch(e){}
    if (!browseId) return { lyric: &quot;&quot;, trans: &quot;&quot; };
    return _ytmPost(&quot;browse&quot;, { browseId: browseId }, &quot;web&quot;).then(function(bd){
      if (!bd) return { lyric: &quot;&quot;, trans: &quot;&quot; };
      var lines = [];
      function collectLines(node, depth){
        if (!node || depth &gt; 12) return;
        if (Array.isArray(node)){ node.forEach(function(n){ collectLines(n, depth+1); }); return; }
        if (typeof node !== &quot;object&quot;) return;
        if (node.lyricsLineRenderer){
          var t = _ytmWalkRuns((((node.lyricsLineRenderer || {}).runs) || (node.lyricsLineRenderer &amp;&amp; node.lyricsLineRenderer.text &amp;&amp; node.lyricsLineRenderer.text.runs) || []));
          // 另一结构
          if (!t &amp;&amp; node.lyricsLineRenderer.text) t = _ytmWalkRuns(node.lyricsLineRenderer.text.runs || []);
          if (t) lines.push(t);
        }
        if (node.description &amp;&amp; node.description.runs){
          var full = _ytmWalkRuns(node.description.runs);
          if (full &amp;&amp; full.length &gt; 20) lines.push(full);
        }
        Object.keys(node).forEach(function(k){
          if (node[k] &amp;&amp; typeof node[k] === &quot;object&quot;) collectLines(node[k], depth+1);
        });
      }
      collectLines(bd, 0);
      // 去重保序
      var seen = {}, out = [];
      lines.forEach(function(l){ if (l &amp;&amp; !seen[l]){ seen[l]=1; out.push(l); } });
      // 无时间轴：包成简单 LRC（每行 +3s 估）
      var lrc = out.map(function(line, i){
        var sec = i * 3;
        var m = Math.floor(sec/60), s = sec%60;
        return &quot;[&quot; + (m&lt;10?&quot;0&quot;:&quot;&quot;)+m + &quot;:&quot; + (s&lt;10?&quot;0&quot;:&quot;&quot;)+s + &quot;.00]&quot; + line;
      }).join(&quot;\n&quot;);
      return { lyric: lrc, trans: &quot;&quot; };
    });
  }).catch(function(){ return { lyric: &quot;&quot;, trans: &quot;&quot; }; });
};


/** 精简参数的分类搜索（多参数会导致单曲 list 被清空） */
API._searchByType = function(kw, t, page, n){
  var url = &quot;https://c.y.qq.com/soso/fcgi-bin/client_search_cp?w=&quot;+encodeURIComponent(kw)+
    &quot;&amp;format=json&amp;p=&quot;+(page||1)+&quot;&amp;n=&quot;+(n||20)+&quot;&amp;new_json=1&amp;cr=1&amp;g_tk=5381&amp;aggr=1&amp;catZhida=1&amp;t=&quot;+t;
  return ADAPTER_request(url, {headers:withCookie({&quot;Referer&quot;:&quot;https://y.qq.com/&quot;})}).then(function(txt){
    return jsonp_safeParse(txt);
  }).catch(function(){ return null; });
};

function _normSingers(list){
  return (list || []).map(function(s){
    var mid = s.singerMID || s.singer_mid || s.mid || s.singerMid || &quot;&quot;;
    var name = s.singerName || s.singer_name || s.name || &quot;&quot;;
    var pic = s.singerPic || s.singer_pic || s.pic || (mid ? coverUrl(mid, &quot;singer&quot;) : &quot;&quot;);
    return {
      mid: mid, name: name,
      singer_mid: mid, singer_name: name,
      singer_pic: pic, pic: pic,
      song_num: s.songNum || s.song_num || s.music_num || 0
    };
  }).filter(function(s){ return s.name; });
}
function _normAlbums(list){
  return (list || []).map(function(a){
    var mid = a.albumMID || a.album_mid || a.mid || &quot;&quot;;
    var name = a.albumName || a.album_name || a.name || &quot;&quot;;
    return {
      mid: mid, albumMID: mid, name: name, albumName: name,
      singerName: a.singerName || a.singer_name || &quot;&quot;,
      pic: a.albumPic || a.pic || (mid ? coverUrl(mid) : &quot;&quot;),
      albumPic: a.albumPic || a.pic || &quot;&quot;
    };
  }).filter(function(a){ return a.name; });
}
function _normPlaylists(list){
  return (list || []).map(function(p){
    if (!p || typeof p !== &quot;object&quot;) return null;
    // 兼容 SearchCgi / songlist / diss_by_tag 多种字段
    var id = String(
      p.dissid || p.disstid || p.diss_id || p.tid || p.content_id || p.contentId ||
      p.id || p.playlist_id || p.playlistId || (p.basic &amp;&amp; (p.basic.tid || p.basic.dissid)) || &quot;&quot;
    ).replace(/^0+/, &quot;&quot;) || String(p.dissid || p.id || &quot;&quot;);
    var title = p.dissname || p.title || p.name || p.diss_name || p.playlist_name ||
      (p.basic &amp;&amp; (p.basic.title || p.basic.dissname)) || &quot;&quot;;
    var cover = p.imgurl || p.logo || p.picurl || p.cover || p.pic || p.img_url || p.cover_url ||
      p.pic_url || p.introduction || (p.basic &amp;&amp; (p.basic.cover || p.basic.pic)) || &quot;&quot;;
    if (cover &amp;&amp; typeof cover === &quot;string&quot;) cover = cover.replace(/http:\/\//, &quot;https://&quot;);
    var nick = p.nickname || p.creator_name || p.author ||
      (p.creator &amp;&amp; (p.creator.name || p.creator.nickname || p.creator.nick)) ||
      (p.u &amp;&amp; (p.u.name || p.u.nickname)) || &quot;&quot;;
    if (!id || !title) return null;
    return {
      dissid: id, id: id, dissname: title, title: title,
      imgurl: cover,
      logo: p.logo || cover,
      cover: cover,
      creator: p.creator || { name: nick },
      nickname: nick,
      source: p.source || &quot;qq&quot;
    };
  }).filter(function(p){ return !!p; });
}

/** QQ 歌单搜索：musicu SearchCgiService search_type=3
 *  实测：Desktop + yqq.json 的 songlist.list 常为空；
 *  必须用 Mobile 方法 + 移动端 comm（ct:11 / platform:h5）→ body.item_songlist
 */
API.searchPlaylists = function(kw, page){
  kw = (kw || &quot;&quot;).trim();
  page = page || 1;
  if (!kw) return Promise.resolve([]);
  var pn = Math.max(1, page|0);
  var hdr = withCookie({
    &quot;Referer&quot;: &quot;https://y.qq.com/&quot;,
    &quot;Origin&quot;: &quot;https://y.qq.com&quot;,
    &quot;Content-Type&quot;: &quot;application/json;charset=utf-8&quot;,
    &quot;User-Agent&quot;: &quot;Mozilla/5.0 (iPhone; CPU iPhone OS 16_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148&quot;
  });
  var uin = &quot;0&quot;;
  try {
    if (state.user &amp;&amp; state.user.uin) uin = String(state.user.uin).replace(/^o0*/, &quot;&quot;) || &quot;0&quot;;
  } catch(eU) {}

  function digList(d){
    if (!d || typeof d !== &quot;object&quot;) return [];
    var node = d.req || d.req_1 || d.req_0 || d[&quot;music.search.SearchCgiService&quot;] || d;
    var data = (node &amp;&amp; node.data) ? node.data : node;
    if (data &amp;&amp; data.data) data = data.data;
    var body = (data &amp;&amp; data.body) ? data.body : data;
    if (!body || typeof body !== &quot;object&quot;) return [];

    var raw =
      body.item_songlist ||
      body.songlist ||
      body.diss ||
      body.playlist ||
      body.list ||
      null;
    var items = [];
    if (Array.isArray(raw)) items = raw;
    else if (raw &amp;&amp; typeof raw === &quot;object&quot;){
      items = raw.list || raw.item_list || raw.songlist || raw.disslist || [];
    }
    if ((!items || !items.length) &amp;&amp; Array.isArray(body.list)) items = body.list;

    items = (items || []).map(function(it){
      if (!it || typeof it !== &quot;object&quot;) return it;
      var x = it.doc || it.playlist || it.diss || it;
      if (x &amp;&amp; x.basic){
        try { x = Object.assign({}, x, x.basic); } catch(eM) { x = x.basic || x; }
      }
      if (x &amp;&amp; !x.dissid &amp;&amp; (x.tid || x.content_id || x.docid || x.diss_id)){
        x.dissid = String(x.tid || x.content_id || x.docid || x.diss_id);
      }
      if (x &amp;&amp; !x.imgurl &amp;&amp; !x.logo){
        x.imgurl = x.picurl || x.cover || x.pic || x.img_url || x.logo || &quot;&quot;;
      }
      if (x &amp;&amp; !x.dissname &amp;&amp; !x.title){
        x.dissname = x.name || x.title || x.diss_name || &quot;&quot;;
      }
      return x;
    });
    return _normPlaylists(items);
  }

  function postSearch(methodName, mobileComm){
    var payload = {
      comm: mobileComm ? {
        ct: 11,
        cv: 10030020,
        g_tk: 5381,
        uin: uin,
        format: &quot;json&quot;,
        platform: &quot;h5&quot;,
        needNewCode: 1
      } : {
        ct: 24,
        cv: 0,
        g_tk: 5381,
        uin: uin,
        format: &quot;json&quot;,
        platform: &quot;yqq.json&quot;
      },
      req: {
        method: methodName,
        module: &quot;music.search.SearchCgiService&quot;,
        param: {
          grp: 1,
          num_per_page: 20,
          page_num: pn,
          query: kw,
          search_type: 3,
          highlight: 0,
          nqc_flag: 0,
          searchid: String(Date.now()) + String(Math.floor(Math.random() * 1e6))
        }
      }
    };
    payload.req_1 = payload.req;

    var url = &quot;https://u.y.qq.com/cgi-bin/musicu.fcg?_=&quot; + Date.now();
    return ADAPTER_request(url, {
      method: &quot;POST&quot;,
      headers: hdr,
      body: payload,
      timeout: 16
    }).then(function(txt){
      var d = jsonp_safeParse(txt);
      return digList(d);
    }).catch(function(){ return []; });
  }

  // 优先 Mobile+h5（实测有数据）；Desktop 作兜底
  return postSearch(&quot;DoSearchForQQMusicMobile&quot;, true).then(function(list){
    if (list &amp;&amp; list.length) return list;
    return postSearch(&quot;DoSearchForQQMusicDesktop&quot;, false).then(function(list2){
      if (list2 &amp;&amp; list2.length) return list2;
      return postSearch(&quot;DoSearchForQQMusicMobile&quot;, false);
    });
  }).then(function(out){
    var seen = {}, uniq = [];
    (out || []).forEach(function(p){
      if (!p || !p.dissid || seen[p.dissid]) return;
      seen[p.dissid] = 1;
      uniq.push(p);
    });
    return uniq;
  }).catch(function(){ return []; });
};

/** 网易云歌单搜索 type=1000 */
API.neteaseSearchPlaylists = function(kw, page){
  kw = (kw || &quot;&quot;).trim();
  page = page || 1;
  if (!kw) return Promise.resolve([]);
  var offset = (page - 1) * 20;
  var url = &quot;https://music.163.com/api/search/get?s=&quot; + encodeURIComponent(kw) +
    &quot;&amp;type=1000&amp;limit=20&amp;offset=&quot; + offset;
  return ADAPTER_request(url, {
    headers: { &quot;User-Agent&quot;: QQ_HEADERS[&quot;User-Agent&quot;], &quot;Referer&quot;: &quot;https://music.163.com/&quot; },
    timeout: 12
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.result &amp;&amp; d.result.playlists) || [];
    return (list || []).map(function(p){
      var id = String(p.id || &quot;&quot;);
      var cover = p.coverImgUrl || p.picUrl || &quot;&quot;;
      return {
        dissid: &quot;ne_pl_&quot; + id, id: id, dissname: p.name || &quot;&quot;, title: p.name || &quot;&quot;,
        imgurl: cover ? String(cover).replace(/^http:/, &quot;https:&quot;) : &quot;&quot;,
        logo: cover ? String(cover).replace(/^http:/, &quot;https:&quot;) : &quot;&quot;,
        cover: cover ? String(cover).replace(/^http:/, &quot;https:&quot;) : &quot;&quot;,
        nickname: (p.creator &amp;&amp; p.creator.nickname) || &quot;&quot;,
        creator: p.creator || {},
        source: &quot;netease&quot;
      };
    }).filter(function(p){ return p.id &amp;&amp; p.title; });
  }).catch(function(){ return []; });
};

/** 酷狗歌单搜索 */
API.kugouSearchPlaylists = function(kw, page){
