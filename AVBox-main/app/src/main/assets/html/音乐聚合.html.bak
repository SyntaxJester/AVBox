  var url = &quot;https://mobilecdn.kugou.com/api/v3/search/special?format=json&amp;keyword=&quot; +
    encodeURIComponent(kw) + &quot;&amp;page=&quot; + page + &quot;&amp;pagesize=20&quot;;
