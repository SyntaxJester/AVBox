var _channelTab = &quot;hot&quot;;
var _channelPlayingName = &quot;&quot;; // 当前正在播的频道名

function currentChannelList(){
  return CHANNEL_MAP[_channelTab] || CHANNEL_MAP.hot || [];
}


var _voiceCache = { free: null, trial: null, xm: null, all: null };

/** 合并网易免费/限免 + 喜马拉雅，按 id 去重 */
function mergeVoiceLists(free, trial, xm){
  var seen = {}, out = [];
  function push(list, defTrial){
    (list || []).forEach(function(x){
      if (!x || !x.id || seen[x.id]) return;
      seen[x.id] = 1;
      var item = Object.assign({}, x);
      if (item.trial == null) item.trial = !!defTrial;
      out.push(item);
    });
  }
  // 喜马：相声评书/段子/娱乐靠前，再网易，再其它
  var xmFunny = [], xmOther = [];
  (xm || []).forEach(function(x){
    if (!x) return;
    if (x.badgeCls === &quot;funny&quot; || /相声|评书|段子|娱乐/.test(String(x.badge || x.category || &quot;&quot;))) xmFunny.push(x);
    else xmOther.push(x);
  });
  push(xmFunny, false);
  push(free, false);
  push(trial, true);
  push(xmOther, false);
  return out;
}

function ensureVoiceCache(){
  if (_voiceCache.all) return Promise.resolve(_voiceCache.all);
  var freeP = _voiceCache.free
    ? Promise.resolve(_voiceCache.free)
    : API.neteaseVoiceFree().then(function(list){ _voiceCache.free = list || []; return _voiceCache.free; })
        .catch(function(){ _voiceCache.free = []; return []; });
  var trialP = _voiceCache.trial
    ? Promise.resolve(_voiceCache.trial)
    : API.neteaseVoiceTrial().then(function(list){ _voiceCache.trial = list || []; return _voiceCache.trial; })
        .catch(function(){ _voiceCache.trial = []; return []; });
  var xmP = _voiceCache.xm
    ? Promise.resolve(_voiceCache.xm)
    : API.ximalayaVoiceFree().then(function(list){ _voiceCache.xm = list || []; return _voiceCache.xm; })
        .catch(function(){ _voiceCache.xm = []; return []; });
  return Promise.all([freeP, trialP, xmP]).then(function(parts){
    _voiceCache.all = mergeVoiceLists(parts[0], parts[1], parts[2]);
    return _voiceCache.all;
  });
}

function fillHomeVoiceBooks(){
  var sec = $(&quot;#homeVoiceSec&quot;);
  var listEl = $(&quot;#homeVoiceList&quot;);
  if (!sec || !listEl) return;

  if (_homePlSrc !== &quot;netease&quot;){
    sec.style.display = &quot;none&quot;;
    sec.classList.remove(&quot;is-ne&quot;);
    return;
  }
  sec.style.display = &quot;block&quot;;
  sec.classList.add(&quot;is-ne&quot;);

  var allBtn = $(&quot;#homeVoiceAll&quot;);
  if (allBtn &amp;&amp; !allBtn._bound){
    allBtn._bound = true;
    allBtn.onclick = function(){ openVoiceAll(); };
  }

  if (!_voiceCache.all){
    listEl.innerHTML = '&lt;div style=&quot;padding:16px 8px;color:var(--text-2);font-size:13px&quot;&gt;加载听书内容…&lt;/div&gt;';
  }
  ensureVoiceCache().then(function(){ renderVoiceList(); });
}

function voiceCardHtml(v, i){
  var badgeCls = &quot;free&quot;;
  var badgeText = &quot;免费&quot;;
  if (v.source === &quot;ximalaya&quot;){
    badgeCls = v.badgeCls || &quot;xm&quot;;
    badgeText = v.badge || &quot;喜马&quot;;
  } else if (v.trial){
    badgeCls = &quot;trial&quot;;
    badgeText = &quot;限免&quot;;
  }
  return '&lt;div class=&quot;voice-card&quot; data-i=&quot;'+i+'&quot; role=&quot;button&quot;&gt;'+
    '&lt;div class=&quot;voice-cover&quot;&gt;&lt;span class=&quot;voice-badge '+badgeCls+'&quot;&gt;'+esc(badgeText)+'&lt;/span&gt;'+safeImg(v.cover)+'&lt;/div&gt;'+
    '&lt;div class=&quot;voice-name&quot;&gt;'+esc(v.title||&quot;&quot;)+'&lt;/div&gt;'+
    '&lt;div class=&quot;voice-sub&quot;&gt;'+esc(v.dj || v.desc || v.category || &quot;&quot;)+'&lt;/div&gt;&lt;/div&gt;';
}

function renderVoiceList(){
  var listEl = $(&quot;#homeVoiceList&quot;);
  if (!listEl) return;
  var list = (_voiceCache.all || []).slice(0, 18);
  if (!list.length){
    listEl.innerHTML = '&lt;div style=&quot;padding:16px 8px;color:var(--text-2);font-size:13px&quot;&gt;暂无听书内容，稍后再试&lt;/div&gt;';
    return;
  }
  listEl.innerHTML = list.map(voiceCardHtml).join(&quot;&quot;);
  $all(&quot;.voice-card&quot;, listEl).forEach(function(el){
    el.onclick = function(){
      var item = list[+el.dataset.i];
      if (item) openHomeVoice(item);
    };
  });
}

function openVoiceAll(){
  switchView(&quot;detail&quot;, { type: &quot;voiceAll&quot;, title: &quot;听书&quot; });
}

function openHomeVoice(item){
  if (!item || !item.id) return;
  // 离开「查看全部」前记住当前 tab / 列表，返回时恢复
  try {
    if (window._qqmVoiceAllState){
      var st = window._qqmVoiceAllState;
      window._qqmVoiceAllRemember = {
        tab: st.tab || &quot;all&quot;,
        page: st.page || 1,
        list: (st.list || []).slice(),
        seen: Object.assign({}, st.seen || {}),
        hasMore: !!st.hasMore,
        scrollTop: 0
      };
      var dv = document.getElementById(&quot;view-detail&quot;);
      if (dv) window._qqmVoiceAllRemember.scrollTop = dv.scrollTop || 0;
    }
  } catch(eMem) {}
  toast(&quot;加载节目…&quot;);
  // 喜马拉雅专辑
  if (item.source === &quot;ximalaya&quot; || item.xmAlbumId || String(item.id).indexOf(&quot;xm_&quot;) === 0){
    var aid = item.xmAlbumId || String(item.id).replace(/^xm_/, &quot;&quot;);
    // 并行拉前 2 页（mobwsa 每页约 20 条），接近官方秒开体验
    Promise.all([
      API.ximalayaAlbumTracks(aid, 1, 50),
      API.ximalayaAlbumTracks(aid, 2, 50)
    ]).then(function(parts){
      var seen = {}, songs = [];
      parts.forEach(function(res){
        ((res &amp;&amp; res.songs) || []).forEach(function(s){
          if (!s || !s.xmTrackId || seen[s.xmTrackId]) return;
          seen[s.xmTrackId] = 1;
          songs.push(s);
        });
      });
      if (!songs.length){
        toast(&quot;该内容暂无节目或需会员&quot;);
        return;
      }
      // 补封面：节目没封面时用专辑封面
      if (item.cover){
        songs.forEach(function(s){ if (s &amp;&amp; !s.cover) s.cover = item.cover; });
      }
      // 首屏两页；实际接口常约 20 条/页，约 40 集。继续上拉加载更多
      var likelyMore = songs.length &gt;= 30;
      switchView(&quot;detail&quot;, {
        type: &quot;album&quot;,
        id: &quot;xm-voice-&quot; + aid,
        title: item.title || &quot;听书&quot;,
        cover: item.cover || (songs[0] &amp;&amp; songs[0].cover) || &quot;&quot;,
        songs: songs,
        source: &quot;ximalaya&quot;,
        queueTag: &quot;xm-voice-&quot; + aid,
        isVoiceBook: true,
        voiceRadioId: aid,
        voiceAlbumId: aid,
        voiceAsc: true,
        voiceSource: &quot;ximalaya&quot;,
        voicePage: 2,
        voiceHasMore: likelyMore,
        fromVoiceAll: true
      });
    }).catch(function(err){
      console.warn(&quot;[xm] tracks fail&quot;, err);
      toast(&quot;加载失败，请稍后重试&quot;);
    });
    return;
  }
  // 网易电台
  var rid = String(item.id).replace(/^ne-voice-/, &quot;&quot;);
  API.neteaseDjPrograms(rid, 80, false).then(function(res){
    var songs = (res &amp;&amp; res.songs) || [];
    if (!songs.length){
      toast(&quot;该内容暂无节目&quot;);
      return;
    }
    switchView(&quot;detail&quot;, {
      type: &quot;album&quot;,
      id: &quot;ne-voice-&quot; + rid,
      title: item.title || &quot;听书&quot;,
      cover: item.cover || &quot;&quot;,
      songs: songs,
      source: &quot;netease&quot;,
      queueTag: &quot;ne-voice-&quot; + rid,
      isVoiceBook: true,
      voiceRadioId: rid,
      voiceAsc: false,
      voiceSource: &quot;netease&quot;,
      fromVoiceAll: true
    });
  }).catch(function(){ toast(&quot;加载失败&quot;); });
}

function fillHomeChannels(){
  var wrap = $(&quot;#homeChannelGrid&quot;);
  var tabsEl = $(&quot;#homeChannelTabs&quot;);
  if (!wrap) return;

  // 网易模式：展示官方排行榜，不再用 QQ 频道
  if (_homePlSrc === &quot;netease&quot;){
    fillHomeNeCharts();
    return;
  }

  // 分类 Tab
  if (tabsEl){
    tabsEl.innerHTML = CHANNEL_TABS.map(function(t){
      return '&lt;button type=&quot;button&quot; class=&quot;channel-tab'+(_channelTab===t.id?&quot; active&quot;:&quot;&quot;)+'&quot; data-tab=&quot;'+esc(t.id)+'&quot;&gt;'+esc(t.name)+'&lt;/button&gt;';
    }).join(&quot;&quot;);
    $all(&quot;.channel-tab&quot;, tabsEl).forEach(function(btn){
      btn.onclick = function(e){
        e.preventDefault();
        e.stopPropagation();
        var id = btn.getAttribute(&quot;data-tab&quot;);
        if (!id || id === _channelTab) return;
        _channelTab = id;
        $all(&quot;.channel-tab&quot;, tabsEl).forEach(function(b){
          b.classList.toggle(&quot;active&quot;, b.getAttribute(&quot;data-tab&quot;) === id);
        });
        renderChannelGrid();
        try { enhanceHomeChannelCovers(); } catch(eC) {}
      };
    });
  }
  renderChannelGrid();
  try { updateHomeChannelSecTitle(); } catch(eT) {}
}

/** 更新首页频道区标题：QQ=频道 / 网易=排行榜 */
function updateHomeChannelSecTitle(){
  var sec = $(&quot;#homeChannelSec&quot;);
  if (!sec) return;
  var title = sec.querySelector(&quot;.sec-title&quot;);
  if (title){
    title.innerHTML = '&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;' + (_homePlSrc === &quot;netease&quot; ? &quot;排行榜&quot; : &quot;频道&quot;);
  }
}

/** 网易云官方榜：填入频道区网格 */
function fillHomeNeCharts(){
  var wrap = $(&quot;#homeChannelGrid&quot;);
  var tabsEl = $(&quot;#homeChannelTabs&quot;);
  if (!wrap) return;
  try { updateHomeChannelSecTitle(); } catch(eT) {}
  if (tabsEl) tabsEl.innerHTML = &quot;&quot;;
  wrap.innerHTML = '&lt;div class=&quot;empty-state&quot; style=&quot;grid-column:1/-1;padding:20px 0;color:var(--text-2);font-size:13px&quot;&gt;加载网易云榜单…&lt;/div&gt;';

  var NE_COLORS = [
    { g1: &quot;#E8356A&quot;, g2: &quot;#FF5C8A&quot; },
    { g1: &quot;#3D5BDB&quot;, g2: &quot;#5B8CFF&quot; },
    { g1: &quot;#B83020&quot;, g2: &quot;#E85A4A&quot; },
    { g1: &quot;#6B3FA0&quot;, g2: &quot;#B14DFF&quot; },
    { g1: &quot;#1A9E5C&quot;, g2: &quot;#31C27C&quot; },
    { g1: &quot;#C45C12&quot;, g2: &quot;#FF9A4A&quot; },
    { g1: &quot;#2C3E6B&quot;, g2: &quot;#5A7AB0&quot; },
    { g1: &quot;#8A2040&quot;, g2: &quot;#E8457A&quot; },
    { g1: &quot;#0E7A8A&quot;, g2: &quot;#2EC4D4&quot; },
    { g1: &quot;#5A4A3A&quot;, g2: &quot;#C4A46A&quot; },
    { g1: &quot;#3A1A6A&quot;, g2: &quot;#7B5CFF&quot; },
    { g1: &quot;#1A3A5A&quot;, g2: &quot;#4A90C8&quot; }
  ];

  API.neteaseToplistOverview().then(function(list){
    list = (list || []).slice(0, 12);
    if (!list.length){
      wrap.innerHTML = '&lt;div class=&quot;empty-state&quot; style=&quot;grid-column:1/-1&quot;&gt;&lt;div class=&quot;e-title&quot;&gt;暂无榜单&lt;/div&gt;&lt;/div&gt;';
      return;
    }
    wrap.innerHTML = list.map(function(t, i){
      var c = NE_COLORS[i % NE_COLORS.length];
      var mark = (t.name || &quot;榜&quot;).replace(/榜|云音乐|网易|排行/g, &quot;&quot;).slice(0, 3) || &quot;榜&quot;;
      if (mark.length &gt; 2) mark = mark.slice(0, 2);
      var bg = &quot;linear-gradient(145deg, &quot;+c.g1+&quot; 0%, &quot;+c.g2+&quot; 100%)&quot;;
      var cover = t.cover || &quot;&quot;;
      try { if (cover &amp;&amp; typeof mediaUrl === &quot;function&quot;) cover = mediaUrl(cover) || cover; } catch(eM) {}
      var art = '&lt;div class=&quot;ch-art&quot;&gt;&lt;div class=&quot;ch-art-ring2&quot;&gt;&lt;/div&gt;&lt;div class=&quot;ch-art-ring&quot;&gt;&lt;/div&gt;'+
        '&lt;div class=&quot;ch-art-mark&quot;&gt;'+esc(mark)+'&lt;/div&gt;&lt;div class=&quot;ch-art-sub&quot;&gt;CHART&lt;/div&gt;&lt;/div&gt;';
      var coverHtml = cover
        ? ('&lt;img src=&quot;'+esc(cover)+'&quot; alt=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer&quot; '+
           'onerror=&quot;this.style.display=\'none\';var p=this.parentNode;if(p){p.classList.remove(\'has-cover\');}&quot;/&gt;'+art)
        : art;
      return '&lt;div class=&quot;channel-item&quot; data-i=&quot;'+i+'&quot; role=&quot;button&quot;&gt;'+
        '&lt;div class=&quot;channel-avatar'+(cover?&quot; has-cover&quot;:&quot;&quot;)+'&quot; style=&quot;background:'+bg+'&quot;&gt;'+coverHtml+'&lt;/div&gt;'+
        '&lt;div class=&quot;channel-name&quot;&gt;'+esc(t.name||&quot;榜单&quot;)+'&lt;/div&gt;&lt;/div&gt;';
    }).join(&quot;&quot;);
    $all(&quot;.channel-item&quot;, wrap).forEach(function(el){
      el.onclick = function(){
        var board = list[+el.dataset.i];
        if (!board) return;
        openHomeNeChart(board);
      };
    });
    // 异步补封面（接口未带图时）
    list.forEach(function(board, i){
      if (board.cover) return;
      API.neteasePlaylistDetail(board.id, 0, 1).then(function(res){
        var info = (res &amp;&amp; res.info) || {};
        var c = info.cover || info.coverImgUrl || &quot;&quot;;
        if (!c) return;
        board.cover = c;
        var av = wrap.querySelector('.channel-item[data-i=&quot;'+i+'&quot;] .channel-avatar');
        if (!av) return;
        try { c = mediaUrl(c) || c; } catch(e) {}
        av.classList.add(&quot;has-cover&quot;);
        var img = document.createElement(&quot;img&quot;);
        img.src = c; img.alt = &quot;&quot;; img.loading = &quot;lazy&quot;;
        img.referrerPolicy = &quot;no-referrer&quot;;
        img.onerror = function(){ this.style.display = &quot;none&quot;; };
        av.insertBefore(img, av.firstChild);
      }).catch(function(){});
    });
  }).catch(function(){
    wrap.innerHTML = '&lt;div class=&quot;empty-state&quot; style=&quot;grid-column:1/-1&quot;&gt;&lt;div class=&quot;e-title&quot;&gt;榜单加载失败&lt;/div&gt;&lt;/div&gt;';
  });
}

/** 打开网易云榜单：进详情列表（可播） */
function openHomeNeChart(board){
  if (!board || !board.id) return;
  toast(&quot;加载中…&quot;);
  API.neteasePlaylistDetail(board.id, 0, 50).then(function(res){
    var songs = (res &amp;&amp; res.songs) || [];
    var info = (res &amp;&amp; res.info) || {};
    var cover = board.cover || info.cover || &quot;&quot;;
    if (!songs.length){ toast(&quot;榜单暂无歌曲&quot;); return; }
    switchView(&quot;detail&quot;, {
      type: &quot;album&quot;,
      id: &quot;ne-toplist-&quot; + board.id,
      title: board.name || info.title || &quot;榜单&quot;,
      cover: cover,
      songs: songs,
      source: &quot;netease&quot;,
      queueTag: &quot;ne-chart-&quot; + board.id
    });
  }).catch(function(){ toast(&quot;加载失败&quot;); });
}

function channelArtBg(ch){
  var g1 = ch.g1 || ch.color || &quot;#5B7CFF&quot;;
  var g2 = ch.g2 || ch.color || &quot;#3D5BDB&quot;;
  return &quot;linear-gradient(145deg, &quot;+g1+&quot; 0%, &quot;+g2+&quot; 100%)&quot;;
}
function channelArtHtml(ch){
  var mark = ch.mark || (ch.name ? ch.name.slice(0, 2) : &quot;乐&quot;);
  return '&lt;div class=&quot;ch-art&quot;&gt;'+
    '&lt;div class=&quot;ch-art-ring2&quot;&gt;&lt;/div&gt;&lt;div class=&quot;ch-art-ring&quot;&gt;&lt;/div&gt;'+
    '&lt;div class=&quot;ch-art-mark&quot;&gt;'+esc(mark)+'&lt;/div&gt;'+
    '&lt;div class=&quot;ch-art-sub&quot;&gt;CHANNEL&lt;/div&gt;&lt;/div&gt;';
}
function renderChannelGrid(){
  var wrap = $(&quot;#homeChannelGrid&quot;);
  if (!wrap) return;
  var list = currentChannelList();
  wrap.innerHTML = list.map(function(ch, i){
    // 全部频道统一设计底，不套网络图
    var src = &quot;&quot;;
    try {
      if (src &amp;&amp; typeof mediaUrl === &quot;function&quot;) src = mediaUrl(src) || src;
    } catch(eM) {}
    var playing = _channelPlayingName &amp;&amp; ch.name === _channelPlayingName;
    var bg = channelArtBg(ch);
    var art = channelArtHtml(ch);
    var coverHtml;
    var hasCover = !!src;
    if (src){
      coverHtml =
        '&lt;img src=&quot;'+esc(src)+'&quot; alt=&quot;&quot; loading=&quot;lazy&quot; referrerpolicy=&quot;no-referrer&quot; '+
        'onerror=&quot;this.style.display=\'none\';var p=this.parentNode;if(p){p.classList.remove(\'has-cover\');var f=p.querySelector(\'.ch-art\');if(f)f.style.display=\'flex\';}&quot;/&gt;'+
        art;
    } else {
      coverHtml = art;
    }
    var playBadge = playing
      ? '&lt;div class=&quot;ch-playing&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot;&gt;&lt;path d=&quot;M8 5v14l11-7z&quot;/&gt;&lt;/svg&gt;&lt;/div&gt;'
      : '';
    return '&lt;div class=&quot;channel-item'+(playing?&quot; is-playing&quot;:&quot;&quot;)+'&quot; data-i=&quot;'+i+'&quot; role=&quot;button&quot;&gt;'+
      '&lt;div class=&quot;channel-avatar'+(hasCover?&quot; has-cover&quot;:&quot;&quot;)+'&quot; style=&quot;background:'+bg+'&quot;&gt;'+coverHtml+playBadge+'&lt;/div&gt;'+
      '&lt;div class=&quot;channel-name&quot;&gt;'+esc(ch.name)+'&lt;/div&gt;&lt;/div&gt;';
  }).join(&quot;&quot;);
  $all(&quot;.channel-item&quot;, wrap).forEach(function(el){
    el.onclick = function(){
      var list2 = currentChannelList();
      var ch = list2[+el.dataset.i];
      if (!ch) return;
      openHomeChannel(ch);
    };
  });
}

function setChannelPlaying(name){
  _channelPlayingName = name || &quot;&quot;;
  $all(&quot;#homeChannelGrid .channel-item&quot;).forEach(function(el){
    var nm = el.querySelector(&quot;.channel-name&quot;);
    var on = nm &amp;&amp; nm.textContent === _channelPlayingName;
    el.classList.toggle(&quot;is-playing&quot;, !!on);
  });
}

/** 频道封面：全部使用渐变设计底，风格统一（不再套榜单/分类头图） */
function enhanceHomeChannelCovers(){
  // 故意留空：热歌等也不再替换为榜单照片，避免和其它频道不是一套
}


function applyChannelCover(i, ch, cover, gen){
  // 已统一设计底，忽略外部封面写入
  return;
}


/** 频道点开即播：拉分类歌单/榜单歌曲直接进播放队列 */
function openHomeChannel(ch){
  if (!ch) return;
  var cat = ch.cat;
  var tag = &quot;channel-&quot; + String(ch.name || cat || &quot;play&quot;);

  function startPlay(songs, label){
    songs = (songs || []).filter(function(s){ return s &amp;&amp; s.songmid; });
    if (!songs.length){
      toast((label || ch.name) + &quot;暂时没有可播歌曲&quot;);
      return;
    }
    try {
      if (songs.length &gt; 8){
        for (var i = songs.length - 1; i &gt; 0; i--){
          var j = Math.floor(Math.random() * (i + 1));
          var t = songs[i]; songs[i] = songs[j]; songs[j] = t;
        }
      }
    } catch(eSh) {}
    setChannelPlaying(ch.name);
    playQueue(songs, 0, tag);
    toast(&quot;正在播放 · &quot; + (label || ch.name));
  }

  if (cat === &quot;hot&quot; || cat === &quot;billboard&quot;){
    toast(&quot;加载中…&quot;);
    var topId = cat === &quot;billboard&quot; ? 108 : 26;
    API.toplistDetail(topId).then(function(d){
      var songs = (d &amp;&amp; d.songs) || [];
      if (songs.length){ startPlay(songs, ch.name); return null; }
      return API.toplistDetail(26);
    }).then(function(d2){
      if (!d2) return;
      startPlay((d2 &amp;&amp; d2.songs) || [], ch.name);
    }).catch(function(){ toast(&quot;加载失败&quot;); });
    return;
  }

  toast(&quot;加载中…&quot;);
  var catId = (cat == null || cat === &quot;&quot;) ? 10000000 : cat;
  API.playlistsByTagPage(catId, 3, Math.floor(Math.random() * 3) * 10, 8).then(function(list){
    list = list || [];
    if (!list.length) return API.playlistsByTagPage(10000000, 3, 0, 8);
    return list;
  }).then(function(list){
    list = list || [];
    if (!list.length){ toast(ch.name + &quot;暂无内容&quot;); return; }
    var picks = list.slice(0, 3);
    return Promise.all(picks.map(function(p){
      return API.playlistDetail(p.dissid, 0, 40).then(function(res){
        return (res &amp;&amp; res.songs) || [];
      }).catch(function(){ return []; });
    })).then(function(parts){
      var merged = [];
      var seen = {};
      (parts || []).forEach(function(arr){
        (arr || []).forEach(function(s){
          if (!s || !s.songmid || seen[s.songmid]) return;
          seen[s.songmid] = 1;
          merged.push(s);
        });
      });
      startPlay(merged, ch.name);
    });
  }).catch(function(){ toast(&quot;加载失败，请稍后重试&quot;); });
}


/** 首页下拉刷新：日推 / 歌单 / 频道 / 榜单 */
function bindHomePullRefresh(viewEl){
  if (!viewEl || viewEl._homePtrBound) return;
  viewEl._homePtrBound = true;
  var ptr = document.createElement(&quot;div&quot;);
  ptr.className = &quot;home-ptr&quot;;
  ptr.innerHTML = '&lt;div class=&quot;home-ptr-inner&quot;&gt;&lt;span class=&quot;home-ptr-spinner&quot;&gt;&lt;/span&gt;&lt;span class=&quot;home-ptr-text&quot;&gt;下拉刷新&lt;/span&gt;&lt;/div&gt;';
  // 插到内容最前，不随滚动跑走：用 sticky 替代 absolute 在滚动容器内
  ptr.style.position = &quot;sticky&quot;;
  ptr.style.top = &quot;0&quot;;
  ptr.style.marginBottom = &quot;0&quot;;
  viewEl.insertBefore(ptr, viewEl.firstChild);

  var startY = 0, startX = 0, pulling = false, armed = false, loading = false;
  var dy = 0;
  var THRESHOLD = 64;
  var MAX = 96;
  var textEl = ptr.querySelector(&quot;.home-ptr-text&quot;);

  function setPull(px){
    dy = Math.max(0, Math.min(MAX, px));
    var show = dy &gt; 6;
    ptr.classList.toggle(&quot;show&quot;, show);
    ptr.classList.toggle(&quot;ready&quot;, dy &gt;= THRESHOLD);
    ptr.style.height = (show ? Math.max(28, dy * 0.55) : 0) + &quot;px&quot;;
    if (textEl){
      textEl.textContent = loading ? &quot;刷新中…&quot; : (dy &gt;= THRESHOLD ? &quot;松开刷新&quot; : &quot;下拉刷新&quot;);
    }
  }
  function resetPtr(){
    pulling = false; armed = false; dy = 0;
    viewEl.classList.remove(&quot;ptr-pulling&quot;);
    if (!loading){
      ptr.classList.remove(&quot;show&quot;, &quot;ready&quot;);
      ptr.style.height = &quot;0px&quot;;
      if (textEl) textEl.textContent = &quot;下拉刷新&quot;;
    }
  }
  function doRefresh(){
    if (loading) return;
    loading = true;
    ptr.classList.add(&quot;loading&quot;, &quot;show&quot;);
    ptr.style.height = &quot;40px&quot;;
    if (textEl) textEl.textContent = &quot;刷新中…&quot;;
    viewEl.classList.remove(&quot;ptr-pulling&quot;);
    try {
      window.__qqmForceDaily = true;
      _dailyCache.key = &quot;&quot;;
      _dailyCache.recSongs = [];
      _dailyCache.d30Songs = [];
      _dailyCache.loading = false;
    } catch(e0) {}
    var tasks = [];
    try { loadDailySections(true); } catch(e1) {}
    try { fillHomePlaylists(true); } catch(e2) {}
    try { fillHomeChannels(); } catch(e3) {}
    try { _voiceCache = { free: null, trial: null, xm: null, all: null }; fillHomeVoiceBooks(); } catch(eVb) {}
    try { if (typeof fillHomeToplist === &quot;function&quot;) fillHomeToplist(); } catch(e4) {}
    try { if (typeof enhanceHomeChannelCovers === &quot;function&quot;) enhanceHomeChannelCovers(); } catch(e5) {}
    // 给请求一点时间；不阻塞 UI 收起指示器
    setTimeout(function(){
      loading = false;
      ptr.classList.remove(&quot;loading&quot;, &quot;ready&quot;, &quot;show&quot;);
      ptr.style.height = &quot;0px&quot;;
      if (textEl) textEl.textContent = &quot;下拉刷新&quot;;
      try { toast(&quot;已刷新&quot;, 1200); } catch(eT) {}
    }, 900);
  }

  function onStart(e){
    if (loading) return;
    if (state.view &amp;&amp; state.view !== &quot;home&quot;) return;
    if (viewEl.scrollTop &gt; 2) return;
    var tch = e.touches ? e.touches[0] : e;
    if (!tch) return;
    startY = tch.clientY; startX = tch.clientX;
    pulling = false; armed = true; dy = 0;
  }
  function onMove(e){
    if (!armed || loading) return;
    if (state.view &amp;&amp; state.view !== &quot;home&quot;) return;
    var tch = e.touches ? e.touches[0] : e;
    if (!tch) return;
    var ady = tch.clientY - startY;
    var adx = tch.clientX - startX;
    if (!pulling){
      if (viewEl.scrollTop &gt; 2){ armed = false; return; }
      if (Math.abs(adx) &gt; Math.abs(ady) &amp;&amp; Math.abs(adx) &gt; 10){ armed = false; return; }
      if (ady &lt; 8) return;
      pulling = true;
      viewEl.classList.add(&quot;ptr-pulling&quot;);
    }
    if (!pulling) return;
    // 阻尼
    var damp = Math.pow(Math.min(ady, 180) / 180, 0.85) * MAX;
    setPull(damp);
    if (e.cancelable) e.preventDefault();
  }
  function onEnd(){
    if (!armed &amp;&amp; !pulling) return;
    var should = pulling &amp;&amp; dy &gt;= THRESHOLD &amp;&amp; !loading;
    if (should) doRefresh();
    else resetPtr();
    armed = false;
  }

  viewEl.addEventListener(&quot;touchstart&quot;, onStart, { passive: true });
  viewEl.addEventListener(&quot;touchmove&quot;, onMove, { passive: false });
  viewEl.addEventListener(&quot;touchend&quot;, onEnd, { passive: true });
  viewEl.addEventListener(&quot;touchcancel&quot;, onEnd, { passive: true });
}


function renderHome(){
  var v = $(&quot;#view-home&quot;);
  if (v.dataset.loaded){
    maybeRefreshDaily(false);
    try { bindHomePullRefresh(v); } catch(ePtr0) {}
    try { fillHomeVoiceBooks(); } catch(eVb0) {}
    return;
  }
  v.dataset.loaded = &quot;1&quot;;
  var period0 = getDailyPeriodInfo();
  var isNe0 = _homePlSrc === &quot;netease&quot;;
  var plTitle = isNe0 ? &quot;网易云歌单&quot; : &quot;推荐歌单&quot;;
  var neCls = isNe0 ? &quot; ne-skin&quot; : &quot;&quot;;
  var periodCls = &quot; period-&quot; + ((period0 &amp;&amp; period0.period) || &quot;evening&quot;);
  v.innerHTML =
    '&lt;div class=&quot;sec&quot; style=&quot;margin-top:6px&quot;&gt;&lt;div class=&quot;sec-head&quot;&gt;&lt;div class=&quot;sec-title&quot;&gt;今日推荐&lt;/div&gt;&lt;/div&gt;'+
    '&lt;div class=&quot;daily-row&quot; id=&quot;dailyRow&quot;&gt;'+
      '&lt;div class=&quot;daily-card'+neCls+periodCls+'&quot; id=&quot;dailyRecCard&quot;&gt;'+
        '&lt;div class=&quot;dc-body&quot;&gt;&lt;div&gt;&lt;div class=&quot;dc-title&quot;&gt;'+esc(period0.title)+'&lt;/div&gt;&lt;div class=&quot;dc-sub&quot;&gt;'+period0.subRec+'&lt;/div&gt;&lt;/div&gt;'+
        '&lt;button class=&quot;dc-play&quot; type=&quot;button&quot; id=&quot;dailyRecPlay&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-play&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;&lt;/div&gt;'+
        '&lt;div class=&quot;dc-art&quot;&gt;&lt;div class=&quot;dc-vinyl&quot;&gt;&lt;/div&gt;&lt;div class=&quot;dc-art-inner&quot; id=&quot;dailyRecCover&quot;&gt;&lt;/div&gt;&lt;/div&gt;'+
      '&lt;/div&gt;'+
      '&lt;div class=&quot;daily-card daily30'+neCls+periodCls+'&quot; id=&quot;daily30Card&quot;&gt;'+
        '&lt;div class=&quot;dc-body&quot;&gt;&lt;div&gt;&lt;div class=&quot;dc-title&quot;&gt;Daily 30 · '+esc(period0.short)+'&lt;/div&gt;&lt;div class=&quot;dc-sub&quot;&gt;'+period0.sub30+'&lt;/div&gt;&lt;/div&gt;'+
        '&lt;button class=&quot;dc-play&quot; type=&quot;button&quot; id=&quot;daily30Play&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-play&quot;/&gt;&lt;/svg&gt;&lt;/button&gt;&lt;/div&gt;'+
        '&lt;div class=&quot;dc-art&quot;&gt;&lt;div class=&quot;dc-vinyl&quot;&gt;&lt;/div&gt;&lt;div class=&quot;dc-art-inner&quot; id=&quot;daily30Cover&quot;&gt;&lt;/div&gt;&lt;/div&gt;'+
      '&lt;/div&gt;'+
    '&lt;/div&gt;'+
    '&lt;div class=&quot;daily-foot&quot; id=&quot;dailyFoot&quot;&gt;'+
      '&lt;div class=&quot;df-item&quot; id=&quot;dailyRecMeta&quot;&gt;&lt;div class=&quot;df-name&quot;&gt;加载中…&lt;/div&gt;&lt;div class=&quot;df-sub&quot;&gt;每日推荐&lt;/div&gt;&lt;/div&gt;'+
      '&lt;div class=&quot;df-item&quot; id=&quot;daily30Meta&quot;&gt;&lt;div class=&quot;df-name&quot;&gt;加载中…&lt;/div&gt;&lt;div class=&quot;df-sub&quot;&gt;每日30首&lt;/div&gt;&lt;/div&gt;'+
    '&lt;/div&gt;&lt;/div&gt;'+
    '&lt;div class=&quot;sec&quot; style=&quot;margin-bottom:8px&quot;&gt;&lt;div class=&quot;sec-head&quot;&gt;'+
      '&lt;div class=&quot;sec-title&quot; id=&quot;homePlTitle&quot; role=&quot;button&quot; title=&quot;点击切换 QQ / 网易云&quot; style=&quot;cursor:pointer;-webkit-user-select:none;user-select:none&quot;&gt;'+
        '&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;'+esc(plTitle)+
      '&lt;/div&gt;'+
      '&lt;div style=&quot;display:flex;align-items:center;gap:12px&quot;&gt;'+
        '&lt;button type=&quot;button&quot; id=&quot;homePlRefresh&quot; style=&quot;font-size:13px;color:var(--text-1);padding:4px 10px;border-radius:100px;background:rgba(118,118,128,.16)&quot;&gt;换一批&lt;/button&gt;'+
        '&lt;div class=&quot;sec-more&quot; id=&quot;homePlAll&quot;&gt;查看全部 ›&lt;/div&gt;'+
      '&lt;/div&gt;'+
    '&lt;/div&gt;'+
    '&lt;div class=&quot;grid-cols&quot; id=&quot;homeRecPl&quot;&gt;'+skeletonCards(6)+'&lt;/div&gt;&lt;/div&gt;'+
    '&lt;div class=&quot;sec&quot; id=&quot;homeVoiceSec&quot;&gt;'+
      '&lt;div class=&quot;sec-head&quot; style=&quot;align-items:center&quot;&gt;'+
        '&lt;div class=&quot;sec-title&quot;&gt;&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;听书&lt;/div&gt;'+
        '&lt;div class=&quot;sec-more&quot; id=&quot;homeVoiceAll&quot;&gt;查看全部 ›&lt;/div&gt;'+
      '&lt;/div&gt;'+
      '&lt;div class=&quot;voice-hscroll&quot; id=&quot;homeVoiceList&quot;&gt;&lt;/div&gt;'+
    '&lt;/div&gt;'+
    '&lt;div class=&quot;sec&quot; id=&quot;homeChannelSec&quot; style=&quot;margin-bottom:4px&quot;&gt;'+
      '&lt;div class=&quot;channel-sec-head&quot;&gt;'+
        '&lt;div class=&quot;sec-title&quot;&gt;&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;频道&lt;/div&gt;'+
        '&lt;div class=&quot;channel-tabs&quot; id=&quot;homeChannelTabs&quot;&gt;&lt;/div&gt;'+
      '&lt;/div&gt;'+
      '&lt;div class=&quot;channel-grid&quot; id=&quot;homeChannelGrid&quot;&gt;&lt;/div&gt;'+
    '&lt;/div&gt;'+
    '&lt;div class=&quot;sec&quot; id=&quot;homeToplistSec&quot; style=&quot;margin-bottom:4px&quot;&gt;&lt;div class=&quot;sec-head&quot;&gt;&lt;div class=&quot;sec-title&quot;&gt;&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;官方榜单&lt;/div&gt;&lt;div class=&quot;sec-more&quot; data-goto=&quot;toplist&quot;&gt;查看全部 ›&lt;/div&gt;&lt;/div&gt;'+
    '&lt;div class=&quot;rank-grid&quot; id=&quot;homeToplist&quot;&gt;&lt;/div&gt;&lt;/div&gt;';

  $all(&quot;[data-goto]&quot;, v).forEach(function(b){ b.onclick = function(){ switchView(b.dataset.goto); }; });
  applyHomeSrcTheme();
  loadDailySections(true);
  fillHomePlaylists(false);
  fillHomeChannels();
  try { fillHomeVoiceBooks(); } catch(eVb) {}
  try { updateHomeChannelSecTitle(); } catch(eTs) {}
  try { enhanceHomeChannelCovers(); } catch(eCh) {}
  try { bindHomePullRefresh(v); } catch(ePtr1) {}

  var titleBtn = $(&quot;#homePlTitle&quot;);
  if (titleBtn){
    titleBtn.onclick = function(){
      _homePlSrc = (_homePlSrc === &quot;netease&quot;) ? &quot;qq&quot; : &quot;netease&quot;;
      try { storeSet(&quot;homePlSrc&quot;, _homePlSrc); } catch(e) {}
      _homeNeOffset = 0;
      titleBtn.innerHTML = '&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;' + (_homePlSrc === &quot;netease&quot; ? &quot;网易云歌单&quot; : &quot;推荐歌单&quot;);
      applyHomeSrcTheme();
      fillHomePlaylists(false);
      fillHomeChannels();
      try { _voiceCache = { free: null, trial: null, xm: null, all: null }; fillHomeVoiceBooks(); } catch(eVb) {}
      try { fillHomeToplist(); } catch(eTl) {}
      loadDailySections(true);
      toast(_homePlSrc === &quot;netease&quot; ? &quot;已切换到网易云&quot; : &quot;已切换到 QQ 音乐&quot;, 1200);
    };
  }
  var allBtn = $(&quot;#homePlAll&quot;);
  if (allBtn){
    allBtn.onclick = function(){
      // 查看全部：跟随当前首页源进入歌单广场
      switchView(&quot;playlists&quot;, { source: _homePlSrc === &quot;netease&quot; ? &quot;netease&quot; : &quot;qq&quot; });
    };
  }
  var refreshBtn = $(&quot;#homePlRefresh&quot;);
  if (refreshBtn){
    refreshBtn.onclick = function(e){
      e.preventDefault();
      e.stopPropagation();
      fillHomePlaylists(true);
      toast(&quot;已换一批推荐&quot;);
    };
  }

  fillHomeToplist();
}

function fillHomeToplist(){
  var wrap = $(&quot;#homeToplist&quot;);
  var tlSec = $(&quot;#homeToplistSec&quot;);
  // 网易模式：排行榜已放在「频道」区，底部官方榜隐藏以免重复
  if (_homePlSrc === &quot;netease&quot;){
    if (tlSec) tlSec.style.display = &quot;none&quot;;
    if (wrap) wrap.innerHTML = &quot;&quot;;
    return;
  }
  if (tlSec) tlSec.style.display = &quot;&quot;;
  if (typeof API.toplistOverview !== &quot;function&quot;) return;
  API.toplistOverview().then(function(list){
    if (!wrap) return;
    var boards = (list || []).slice(0, 9);
    if (!boards.length){ wrap.innerHTML=&quot;&quot;; return; }
    wrap.className = &quot;grid-cols&quot;;
    wrap.innerHTML = boards.map(function(t){
      return '&lt;div class=&quot;card&quot;&gt;&lt;div class=&quot;card-cover&quot;&gt;'+safeImg(t.frontPicUrl||t.pic||&quot;&quot;)+
        '&lt;div class=&quot;play-fab&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-play&quot;/&gt;&lt;/svg&gt;&lt;/div&gt;&lt;/div&gt;'+
        '&lt;div class=&quot;card-name&quot;&gt;'+esc(t.topTitle||t.title||&quot;&quot;)+'&lt;/div&gt;'+
        '&lt;div class=&quot;card-sub&quot;&gt;'+esc(t.update_key||t.intro||&quot;&quot;)+'&lt;/div&gt;&lt;/div&gt;';
    }).join(&quot;&quot;);
    $all(&quot;.card&quot;, wrap).forEach(function(c,i){
      c.onclick = function(){
        var board = boards[i] || {};
        if (isMvChartBoard(board)){
          switchView(&quot;mv&quot;, { title: board.topTitle || board.title || &quot;MV榜&quot;, topId: board.topId || board.id });
          return;
        }
        switchView(&quot;detail&quot;, {type:&quot;toplist&quot;, id: board.topId||board.id, title: board.topTitle||board.title});
      };
    });
  }).catch(function(){});
}

function fillHomePlaylists(isRefresh){
  var wrap = $(&quot;#homeRecPl&quot;);
  if (!wrap) return;
  wrap.innerHTML = skeletonCards(6);
  var tlSec = $(&quot;#homeToplistSec&quot;);
  if (tlSec) tlSec.style.display = (_homePlSrc === &quot;netease&quot;) ? &quot;none&quot; : &quot;&quot;;

  if (_homePlSrc === &quot;netease&quot;){
    // 首次进入也随机 offset（与 QQ「换一批」同思路），避免每次都是同一批
    if (isRefresh){
      _homeNeOffset += 18 + Math.floor(Math.random() * 12);
      if (_homeNeOffset &gt; 200) _homeNeOffset = Math.floor(Math.random() * 10) * 18;
    } else {
      _homeNeOffset = Math.floor(Math.random() * 12) * 18; // 0 / 18 / … / 198
    }
    // 随机混入一个常见分类，进一步打散
    var neCats = [&quot;全部&quot;, &quot;全部&quot;, &quot;全部&quot;, &quot;华语&quot;, &quot;流行&quot;, &quot;电子&quot;, &quot;民谣&quot;, &quot;轻音乐&quot;];
    var neCat = neCats[Math.floor(Math.random() * neCats.length)];
    API.neteaseHotPlaylists(neCat, 24, _homeNeOffset).then(function(list){
      if (!list.length){
        // 回退到「全部」offset 0 再试一次
        return API.neteaseHotPlaylists(&quot;全部&quot;, 24, 0).then(function(list2){
          return list2 || [];
        });
      }
      return list;
    }).then(function(list){
      list = list || [];
      if (!list.length){
        wrap.innerHTML = '&lt;div class=&quot;empty-state&quot; style=&quot;grid-column:1/-1&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-empty&quot;/&gt;&lt;/svg&gt;&lt;div class=&quot;e-title&quot;&gt;暂时没有获取到网易云歌单&lt;/div&gt;&lt;div class=&quot;e-sub&quot;&gt;请检查网络后点「换一批」重试&lt;/div&gt;&lt;/div&gt;';
        return;
      }
      // 前端再洗牌一次，同 offset 两次展示也不同
      for (var i = list.length - 1; i &gt; 0; i--){
        var j = Math.floor(Math.random() * (i + 1));
        var tmp = list[i]; list[i] = list[j]; list[j] = tmp;
      }
      list = list.slice(0, 18);
      wrap.innerHTML = list.map(playlistCardHtml).join(&quot;&quot;);
      bindCardClicks(wrap, list, &quot;playlist&quot;);
    }).catch(function(){
      wrap.innerHTML = '&lt;div class=&quot;empty-state&quot; style=&quot;grid-column:1/-1&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-empty&quot;/&gt;&lt;/svg&gt;&lt;div class=&quot;e-title&quot;&gt;网易云歌单加载失败&lt;/div&gt;&lt;div class=&quot;e-sub&quot;&gt;请稍后再试&lt;/div&gt;&lt;/div&gt;';
    });
    return;
  }
  API.recommendPlaylists(null, 5, 18, !!isRefresh).then(function(list){
    if (!list.length){
      wrap.innerHTML = '&lt;div class=&quot;empty-state&quot; style=&quot;grid-column:1/-1&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-empty&quot;/&gt;&lt;/svg&gt;&lt;div class=&quot;e-title&quot;&gt;暂时没有获取到推荐内容&lt;/div&gt;&lt;div class=&quot;e-sub&quot;&gt;请检查网络后下拉刷新，或稍后再试&lt;/div&gt;&lt;/div&gt;';
      return;
    }
    wrap.innerHTML = list.map(playlistCardHtml).join(&quot;&quot;);
    bindCardClicks(wrap, list, &quot;playlist&quot;);
  });
}
var heroTimer=null, heroIdx=0, heroCount=0;
function goHero(i){
  if (!heroCount) return;
  heroIdx = (i + heroCount) % heroCount;
  var track = $(&quot;#heroTrack&quot;);
  if (track){
    track.style.transition = &quot;transform .35s var(--ease)&quot;;
    track.style.transform = &quot;translateX(-&quot;+(heroIdx*100)+&quot;%)&quot;;
  }
  $all(&quot;.hero-dot&quot;).forEach(function(d,j){ d.classList.toggle(&quot;active&quot;, j===heroIdx); });
}
function startHeroAuto(n){
  heroCount = n; heroIdx = 0;
  clearInterval(heroTimer);
  if (n &lt;= 1) return;
  heroTimer = setInterval(function(){ goHero(heroIdx + 1); }, 5000);
}
function initHeroSwipe(n){
  var box = $(&quot;#heroBox&quot;);
  if (!box || !n) return;
  if (box._swipeBound) return;
  box._swipeBound = true;
  startHeroAuto(n);
  var startX=0, startY=0, dx=0, dragging=false, locked=false;
  function onStart(e){
    if (!heroCount) return;
    var t = e.touches ? e.touches[0] : e;
    startX = t.clientX; startY = t.clientY; dx = 0; dragging = true; locked = false;
    clearInterval(heroTimer);
    var track = $(&quot;#heroTrack&quot;);
    if (track) track.style.transition = &quot;none&quot;;
  }
  function onMove(e){
    if (!dragging) return;
    var t = e.touches ? e.touches[0] : e;
    var adx = t.clientX - startX, ady = t.clientY - startY;
    if (!locked){
      if (Math.abs(ady) &gt; Math.abs(adx) &amp;&amp; Math.abs(ady) &gt; 8){ dragging = false; return; }
      if (Math.abs(adx) &gt; 8) locked = true;
    }
    if (!locked) return;
    dx = adx;
    var track = $(&quot;#heroTrack&quot;);
    if (track){
      var pct = heroIdx * 100 - (dx / box.clientWidth * 100);
      track.style.transform = &quot;translateX(-&quot;+pct+&quot;%)&quot;;
    }
    if (e.cancelable) e.preventDefault();
  }
  function onEnd(){
    if (!dragging &amp;&amp; !locked){ startHeroAuto(heroCount); return; }
    dragging = false;
    if (Math.abs(dx) &gt; box.clientWidth * 0.18) goHero(heroIdx + (dx &lt; 0 ? 1 : -1));
    else goHero(heroIdx);
    startHeroAuto(heroCount);
  }
  box.addEventListener(&quot;touchstart&quot;, onStart, { passive: true });
  box.addEventListener(&quot;touchmove&quot;, onMove, { passive: false });
  box.addEventListener(&quot;touchend&quot;, onEnd, { passive: true });
  box.addEventListener(&quot;touchcancel&quot;, onEnd, { passive: true });
  // 点击圆点切换
  box.addEventListener(&quot;click&quot;, function(e){
    var dot = e.target.closest(&quot;.hero-dot&quot;);
    if (!dot) return;
    var dots = $all(&quot;.hero-dot&quot;);
    var i = dots.indexOf(dot);
    if (i &gt;= 0){ clearInterval(heroTimer); goHero(i); startHeroAuto(heroCount); }
  });
}

function playlistCardHtml(p){
  return '&lt;div class=&quot;card&quot;&gt;&lt;div class=&quot;card-cover&quot;&gt;'+safeImg(p.cover)+
    '&lt;div class=&quot;plays&quot;&gt;&lt;svg width=&quot;9&quot; height=&quot;9&quot; viewBox=&quot;0 0 24 24&quot;&gt;&lt;path d=&quot;M8 5v14l11-7z&quot; fill=&quot;currentColor&quot;/&gt;&lt;/svg&gt;'+fmtCount(p.playCount)+'&lt;/div&gt;'+
    '&lt;div class=&quot;play-fab&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-play&quot;/&gt;&lt;/svg&gt;&lt;/div&gt;&lt;/div&gt;'+
    '&lt;div class=&quot;card-name&quot;&gt;'+esc(p.title)+'&lt;/div&gt;&lt;/div&gt;';
}
function mvCardHtml(m){
  return '&lt;div class=&quot;mv-card&quot;&gt;&lt;div class=&quot;mv-cover&quot;&gt;'+safeImg(m.cover)+
    '&lt;div class=&quot;mv-play-fab&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot;&gt;&lt;use href=&quot;#i-play-fill&quot;/&gt;&lt;/svg&gt;&lt;/div&gt;'+
    '&lt;div class=&quot;mv-dur&quot;&gt;'+fmtTime(m.duration)+'&lt;/div&gt;&lt;/div&gt;'+
    '&lt;div class=&quot;mv-title&quot;&gt;'+esc(m.title)+'&lt;/div&gt;&lt;div class=&quot;mv-sub&quot;&gt;'+esc(m.singer)+'&lt;/div&gt;&lt;/div&gt;';
}
function bindCardClicks(wrap, list, type){
  $all(&quot;.card&quot;, wrap).forEach(function(c,i){
    c.onclick = function(){
      var item = list[i] || {};
      var opts = { type: type, id: item.dissid || item.id };
      if (item.source) opts.source = item.source;
      if (item.title || item.dissname) opts.title = item.title || item.dissname;
      if (item.cover) opts.cover = item.cover;
      switchView(&quot;detail&quot;, opts);
    };
  });
}

/* ============================================================
   § 6. 渲染：排行榜 / 歌单广场 / 歌手 / MV / 电台 / 我的
   ============================================================ */
function renderToplist(){
  var v = $(&quot;#view-toplist&quot;);
  v.innerHTML = '&lt;div class=&quot;sec-head&quot; style=&quot;margin-top:16px&quot;&gt;&lt;div class=&quot;sec-title&quot;&gt;&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;全部排行榜&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;grid-cols&quot; id=&quot;toplistGrid&quot;&gt;'+skeletonCards(8)+'&lt;/div&gt;';
  API.toplistOverview().then(function(list){
    var wrap = $(&quot;#toplistGrid&quot;);
    if (!list.length){ wrap.innerHTML = emptyHtml(&quot;排行榜数据获取失败&quot;,&quot;请检查网络或稍后再试&quot;); return; }
    wrap.innerHTML = list.map(function(t){
      return '&lt;div class=&quot;card&quot;&gt;&lt;div class=&quot;card-cover&quot;&gt;'+safeImg(t.frontPicUrl||t.pic||&quot;&quot;)+
        '&lt;div class=&quot;play-fab&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-play&quot;/&gt;&lt;/svg&gt;&lt;/div&gt;&lt;/div&gt;'+
        '&lt;div class=&quot;card-name&quot;&gt;'+esc(t.topTitle||t.title||&quot;&quot;)+'&lt;/div&gt;&lt;div class=&quot;card-sub&quot;&gt;'+esc(t.update_key||t.intro||&quot;&quot;)+'&lt;/div&gt;&lt;/div&gt;';
    }).join(&quot;&quot;);
    $all(&quot;.card&quot;, wrap).forEach(function(c,i){
      c.onclick=function(){
        var board = list[i] || {};
        if (isMvChartBoard(board)){
          switchView(&quot;mv&quot;, { title: board.topTitle || board.title || &quot;MV榜&quot;, topId: board.topId || board.id });
          return;
        }
        switchView(&quot;detail&quot;,{type:&quot;toplist&quot;, id:board.topId||board.id, title: board.topTitle||board.title});
      };
    });
  });
}

/* QQ 歌单分类：与官方 fcg_get_diss_tag_conf 对齐（错误 ID 会导致空/串类） */
var PL_TABS = [
  { id: 6, name: &quot;流行&quot; },
  { id: 11, name: &quot;摇滚&quot; },
  { id: 28, name: &quot;民谣&quot; },
  { id: 153, name: &quot;嘻哈&quot; },
  { id: 24, name: &quot;电子&quot; },
  { id: 8, name: &quot;R&amp;B&quot; },
  { id: 15, name: &quot;轻音乐&quot; },
  { id: 21, name: &quot;爵士&quot; },
  { id: 27, name: &quot;古典&quot; },
  { id: 22, name: &quot;蓝调&quot; },
  { id: 18, name: &quot;乡村&quot; },
  { id: 39, name: &quot;ACG&quot; },
  { id: 194, name: &quot;古风&quot; },
  { id: 133, name: &quot;影视&quot; },
  { id: 136, name: &quot;经典&quot; },
  { id: 146, name: &quot;网络&quot; },
  { id: 165, name: &quot;华语&quot; },
  { id: 166, name: &quot;粤语&quot; },
  { id: 167, name: &quot;英语&quot; },
  { id: 168, name: &quot;韩语&quot; },
  { id: 169, name: &quot;日语&quot; },
  { id: 122, name: &quot;安静&quot; },
  { id: 52, name: &quot;伤感&quot; },
  { id: 116, name: &quot;治愈&quot; },
  { id: 99, name: &quot;运动&quot; },
  { id: 101, name: &quot;学习&quot; },
  { id: 78, name: &quot;睡前&quot; },
  { id: 85, name: &quot;开车&quot; }
];
/* 启动后用官方配置刷新，避免 ID 再过期 */
var _plTabsReady = false;
API.qqPlaylistCategories = function(){
  var url = &quot;https://c.y.qq.com/splcloud/fcgi-bin/fcg_get_diss_tag_conf.fcg?format=json&amp;inCharset=utf8&amp;outCharset=utf-8&amp;g_tk=5381&amp;loginUin=0&amp;hostUin=0&amp;notice=0&amp;platform=yqq.json&amp;needNewCode=0&quot;;
  return ADAPTER_request(url, { headers: withCookie({ &quot;Referer&quot;: &quot;https://y.qq.com/&quot; }) }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var groups = (d &amp;&amp; d.data &amp;&amp; d.data.categories) || [];
    var out = [];
    var seen = { &quot;10000000&quot;: 1 };
    // 优先常用分组顺序
    var prefer = [&quot;流派&quot;, &quot;主题&quot;, &quot;语种&quot;, &quot;心情&quot;, &quot;场景&quot;];
    var ordered = [];
    prefer.forEach(function(name){
      groups.forEach(function(g){
        if (g &amp;&amp; g.categoryGroupName === name) ordered.push(g);
      });
    });
    groups.forEach(function(g){
      if (ordered.indexOf(g) &lt; 0) ordered.push(g);
    });
    ordered.forEach(function(g){
      if (!g || g.categoryGroupName === &quot;热门&quot;) return;
      (g.items || []).forEach(function(it){
        var id = it &amp;&amp; it.categoryId;
        if (id == null || seen[String(id)]) return;
        // usable===0 且不是全部 的跳过
        if (it.usable === 0 &amp;&amp; Number(id) !== 10000000) return;
        seen[String(id)] = 1;
        var name = String(it.categoryName || &quot;&quot;).replace(/&amp;amp;/g, &quot;&amp;&quot;).replace(/&amp;#38;/g, &quot;&amp;&quot;).trim();
        if (!name) return;
        out.push({ id: id, name: name });
      });
    });
    return out;
  }).catch(function(){ return []; });
};
function ensurePlTabs(){
  if (_plTabsReady) return Promise.resolve(PL_TABS);
  return API.qqPlaylistCategories().then(function(list){
    if (list &amp;&amp; list.length &gt;= 8){
      // 保留一份精选常用 + 官方全量去重合并（Tab 太多会难滑，先取精选）
      var preferIds = [6,11,28,153,24,8,15,21,27,39,194,133,136,146,165,166,167,168,169,122,52,116,99,101,78,85];
      var byId = {};
      list.forEach(function(t){ byId[String(t.id)] = t; });
      var curated = [];
      preferIds.forEach(function(id){
        if (byId[String(id)]) curated.push(byId[String(id)]);
      });
      // 官方名「国语」在客户端常称「华语」，展示统一
      curated.forEach(function(t){
        if (String(t.id) === &quot;165&quot; &amp;&amp; /国语/.test(t.name)) t.name = &quot;华语&quot;;
      });
      // 补足其它官方类，最多约 36 个
      list.forEach(function(t){
        if (curated.length &gt;= 36) return;
        if (!preferIds.some(function(id){ return String(id) === String(t.id); })){
          curated.push(t);
        }
      });
      if (curated.length){
        PL_TABS = curated;
        _plTabsReady = true;
      }
    }
    return PL_TABS;
  }).catch(function(){ return PL_TABS; });
}
/** 网易云歌单分类（与 QQ 标签对齐） */
var NE_PL_TABS = [
  {id:&quot;全部&quot;,name:&quot;全部&quot;},
  {id:&quot;流行&quot;,name:&quot;流行&quot;},
  {id:&quot;摇滚&quot;,name:&quot;摇滚&quot;},
  {id:&quot;民谣&quot;,name:&quot;民谣&quot;},
  {id:&quot;说唱&quot;,name:&quot;说唱&quot;},
  {id:&quot;电子&quot;,name:&quot;电子&quot;},
  {id:&quot;R&amp;B/Soul&quot;,name:&quot;R&amp;B&quot;},
  {id:&quot;轻音乐&quot;,name:&quot;轻音乐&quot;},
  {id:&quot;影视原声&quot;,name:&quot;影视&quot;},
  {id:&quot;ACG&quot;,name:&quot;ACG&quot;},
  {id:&quot;古风&quot;,name:&quot;古风&quot;},
  {id:&quot;华语&quot;,name:&quot;华语&quot;},
  {id:&quot;日语&quot;,name:&quot;日语&quot;},
  {id:&quot;韩语&quot;,name:&quot;韩语&quot;},
  {id:&quot;爵士&quot;,name:&quot;爵士&quot;},
  {id:&quot;古典&quot;,name:&quot;古典&quot;},
  {id:&quot;蓝调&quot;,name:&quot;蓝调&quot;},
  {id:&quot;乡村&quot;,name:&quot;乡村&quot;},
  {id:&quot;清新&quot;,name:&quot;清新&quot;},
  {id:&quot;运动&quot;,name:&quot;运动&quot;},
  {id:&quot;经典&quot;,name:&quot;经典&quot;},
  {id:&quot;粤语&quot;,name:&quot;粤语&quot;},
  {id:&quot;欧美&quot;,name:&quot;欧美&quot;}
];
function renderPlaylists(params){
  params = params || {};
  var v = $(&quot;#view-playlists&quot;);
  var isNe = (params.source === &quot;netease&quot;) || (_homePlSrc === &quot;netease&quot; &amp;&amp; params.source !== &quot;qq&quot;);
  var pageTitle = isNe ? &quot;网易云歌单&quot; : &quot;歌单广场&quot;;
  // 先出骨架，QQ 源异步对齐官方分类后再铺 Tab
  v.innerHTML = '&lt;div class=&quot;sec-head&quot; style=&quot;margin-top:16px&quot;&gt;&lt;div class=&quot;sec-title&quot;&gt;&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;'+esc(pageTitle)+'&lt;/div&gt;'+
    '&lt;button type=&quot;button&quot; id=&quot;plRefreshBtn&quot; style=&quot;font-size:13px;color:var(--text-1);padding:4px 12px;border-radius:100px;background:rgba(118,118,128,.16)&quot;&gt;换一批&lt;/button&gt;&lt;/div&gt;'+
    '&lt;div class=&quot;hscroll&quot; id=&quot;plTabs&quot; style=&quot;margin-bottom:18px;align-items:center&quot;&gt;&lt;/div&gt;'+
    '&lt;div class=&quot;grid-cols&quot; id=&quot;plGrid&quot;&gt;'+skeletonCards(12)+'&lt;/div&gt;'+
    '&lt;div id=&quot;plLoadMore&quot; style=&quot;text-align:center;padding:14px 0 6px;font-size:12px;color:var(--text-2)&quot;&gt;&lt;/div&gt;';

  function buildTabsList(){
    if (isNe){
      return [{ id: &quot;全部&quot;, name: &quot;热门&quot; }].concat(NE_PL_TABS.filter(function(t){ return t.id !== &quot;全部&quot;; }));
    }
    return [{ id: &quot;smart&quot;, name: &quot;智能推荐&quot; }].concat(PL_TABS);
  }
  var tabs = buildTabsList();
  // 频道入口可带 categoryId，预选对应 Tab
  var preferCat = params.categoryId != null ? params.categoryId : null;
  function resolveInitIdx(list){
    var initIdx = 0;
    if (preferCat != null){
      for (var ti = 0; ti &lt; list.length; ti++){
        if (String(list[ti].id) === String(preferCat)){ initIdx = ti; break; }
      }
    }
    return initIdx;
  }
  var initIdx = resolveInitIdx(tabs);
  var currentCat = tabs[initIdx] ? tabs[initIdx].id : (isNe ? &quot;全部&quot; : &quot;smart&quot;);
  function paintTabs(list, activeIdx){
    tabs = list;
    initIdx = activeIdx;
    currentCat = tabs[initIdx] ? tabs[initIdx].id : currentCat;
    var tabsEl = $(&quot;#plTabs&quot;);
    if (!tabsEl) return;
    tabsEl.innerHTML = tabs.map(function(t,i){
      return '&lt;div class=&quot;sr-tab'+(i===initIdx?&quot; active&quot;:&quot;&quot;)+'&quot; data-id=&quot;'+esc(String(t.id))+'&quot;&gt;'+esc(t.name)+'&lt;/div&gt;';
    }).join(&quot;&quot;);
    $all(&quot;.sr-tab&quot;, v).forEach(function(tabEl){
      tabEl.onclick = function(){
        var id = tabEl.dataset.id;
        var idx = 0;
        for (var i = 0; i &lt; tabs.length; i++){
          if (String(tabs[i].id) === String(id)){ idx = i; break; }
        }
        activatePlTab(idx, { smooth: true });
      };
    });
  }
  paintTabs(tabs, initIdx);
  var plState = { list: [], sin: 0, loading: false, hasMore: true, seen: {}, source: isNe ? &quot;netease&quot; : &quot;qq&quot; };
  function renderPlGrid(append){
    var wrap = $(&quot;#plGrid&quot;);
    if (!wrap) return;
    if (!append){
      if (!plState.list.length){ wrap.innerHTML = emptyHtml(&quot;暂无歌单&quot;,&quot;换个分类试试&quot;); return; }
      wrap.innerHTML = plState.list.map(playlistCardHtml).join(&quot;&quot;);
    } else {
      var start = plState.list.length - (plState._lastAppend || 0);
      var chunk = plState.list.slice(start);
      wrap.insertAdjacentHTML(&quot;beforeend&quot;, chunk.map(playlistCardHtml).join(&quot;&quot;));
    }
    bindCardClicks(wrap, plState.list, &quot;playlist&quot;);
    var tip = $(&quot;#plLoadMore&quot;);
    if (tip) tip.textContent = plState.hasMore ? &quot;上拉加载更多&quot; : (plState.list.length ? &quot;已加载全部&quot; : &quot;&quot;);
  }
  function load(cat, isRefresh, isMore){
    currentCat = String(cat);
    if (plState.loading) return;
    if (isMore &amp;&amp; !plState.hasMore) return;
    plState.loading = true;
    var wrap = $(&quot;#plGrid&quot;);
    var tip = $(&quot;#plLoadMore&quot;);
    if (!isMore){
      plState.list = [];
      plState.sin = isRefresh ? (plState.sin + 24) : 0;
      if (plState.sin &gt; 200) plState.sin = 0;
      plState.hasMore = true;
      plState.seen = {};
      if (wrap) wrap.innerHTML = skeletonCards(12);
      if (tip) tip.textContent = &quot;&quot;;
    } else {
      if (tip) tip.textContent = &quot;加载中…&quot;;
    }
    var pageSize = 24;
    var req;
    if (isNe){
      var neOffset = isMore ? plState.sin : (isRefresh ? plState.sin : 0);
      if (!isMore &amp;&amp; isRefresh) neOffset = plState.sin;
      if (!isMore &amp;&amp; !isRefresh) neOffset = 0;
      req = API.neteaseHotPlaylists(currentCat || &quot;全部&quot;, pageSize, neOffset).then(function(list){
        plState.sin = neOffset + pageSize;
        plState.hasMore = !!(list &amp;&amp; list._neMore);
        return list;
      });
    } else {
      var isSmart = (currentCat === &quot;smart&quot; || currentCat === &quot;10000000&quot;);
      if (isSmart){
        req = API.recommendPlaylists(null, 3, pageSize, true);
      } else {
        var sin = isMore ? plState.sin : (isRefresh ? (Math.floor(Math.random()*6)*pageSize) : 0);
        req = API.playlistsByTagPage(currentCat, 3, sin, pageSize).then(function(list){
          plState.sin = sin + pageSize;
          return list;
        });
      }
    }
    req.then(function(list){
      plState.loading = false;
      list = list || [];
      var added = [];
      list.forEach(function(p){
        if (!p || !p.dissid || plState.seen[p.dissid]) return;
        plState.seen[p.dissid] = 1;
        plState.list.push(p);
        added.push(p);
      });
      plState._lastAppend = added.length;
      if (!isNe){
        var isSmart2 = (currentCat === &quot;smart&quot; || currentCat === &quot;10000000&quot;);
        if (isSmart2){
          plState.hasMore = added.length &gt; 0;
          if (isMore &amp;&amp; !added.length) plState.hasMore = false;
        } else {
          plState.hasMore = list.length &gt;= pageSize;
        }
      } else if (typeof plState.hasMore === &quot;undefined&quot;){
        plState.hasMore = list.length &gt;= pageSize;
      }
      if (!isMore){
        if (!plState.list.length &amp;&amp; !isNe){
          // 不再用「混杂推荐」顶替，避免点了摇滚却出流行；仅再试一次本分类第 0 页
          return API.playlistsByTagPage(currentCat, 3, 0, pageSize).then(function(list2){
            (list2||[]).forEach(function(p){
              if (!p || !p.dissid || plState.seen[p.dissid]) return;
              plState.seen[p.dissid]=1; plState.list.push(p);
            });
            renderPlGrid(false);
            if (!plState.list.length){
              var tipEl = $(&quot;#plLoadMore&quot;);
              if (tipEl) tipEl.textContent = &quot;该分类暂无歌单&quot;;
            }
          });
        }
        renderPlGrid(false);
      } else {
        if (added.length) renderPlGrid(true);
        else if (tip) tip.textContent = &quot;已加载全部&quot;;
      }
    }).catch(function(){
      plState.loading = false;
      if (!isMore){
        if (wrap) wrap.innerHTML = emptyHtml(&quot;加载失败&quot;,&quot;请稍后重试&quot;);
      } else if (tip) tip.textContent = &quot;加载失败，上拉重试&quot;;
    });
  }
  function activatePlTab(idx, opts){
    opts = opts || {};
    if (idx &lt; 0 || idx &gt;= tabs.length) return false;
    var tabEls = $all(&quot;.sr-tab&quot;, v);
    if (!tabEls.length) return false;
    tabEls.forEach(function(x){ x.classList.remove(&quot;active&quot;); });
    var el = tabEls[idx];
    if (el) el.classList.add(&quot;active&quot;);
    var catId = tabs[idx].id;
    plState.sin = 0;
    load(catId, false, false);
    try {
      if (el &amp;&amp; el.scrollIntoView){
        el.scrollIntoView({ inline: &quot;center&quot;, block: &quot;nearest&quot;, behavior: opts.smooth ? &quot;smooth&quot; : &quot;instant&quot; });
      }
    } catch(eSc2) {}
    return true;
  }
  function currentPlTabIndex(){
    var tabEls = $all(&quot;.sr-tab&quot;, v);
    for (var i = 0; i &lt; tabEls.length; i++){
      if (tabEls[i].classList.contains(&quot;active&quot;)) return i;
    }
    for (var j = 0; j &lt; tabs.length; j++){
      if (String(tabs[j].id) === String(currentCat)) return j;
    }
    return 0;
  }
  $all(&quot;.sr-tab&quot;, v).forEach(function(t){
    t.onclick = function(){
      var id = t.dataset.id;
      var idx = 0;
      for (var i = 0; i &lt; tabs.length; i++){
        if (String(tabs[i].id) === String(id)){ idx = i; break; }
      }
      activatePlTab(idx, { smooth: true });
    };
  });
  var rb = $(&quot;#plRefreshBtn&quot;);
  if (rb) rb.onclick = function(e){
    e.preventDefault();
    e.stopPropagation();
    load(currentCat, true, false);
    toast(&quot;已换一批&quot;);
  };
  window._qqmPlLoadMore = function(){ load(currentCat, false, true); };
  window._qqmPlState = plState;
  if (!v._plScrollBound){
    v._plScrollBound = true;
    v.addEventListener(&quot;scroll&quot;, function(){
      if (state.view !== &quot;playlists&quot;) return;
      var st = window._qqmPlState;
      if (!st || st.loading || !st.hasMore) return;
      var remain = v.scrollHeight - v.scrollTop - v.clientHeight;
      if (remain &lt; 180){
        try { window._qqmPlLoadMore &amp;&amp; window._qqmPlLoadMore(); } catch(e) {}
      }
    }, { passive: true });
  }

  // 左右滑动切换分类（与纵向滚动、Tab 横滑互不抢）
  (function bindPlCategorySwipe(){
    // 每次 render 重新绑定时，先用命名空间清掉旧监听（通过替换节点更干净）
    if (v._plSwipeBound){
      try {
        v.removeEventListener(&quot;touchstart&quot;, v._plSwipeStart, { passive: true });
        v.removeEventListener(&quot;touchmove&quot;, v._plSwipeMove, { passive: false });
        v.removeEventListener(&quot;touchend&quot;, v._plSwipeEnd, { passive: true });
        v.removeEventListener(&quot;touchcancel&quot;, v._plSwipeEnd, { passive: true });
      } catch(eRm) {}
    }
    var sx = 0, sy = 0, axis = null, locked = false;
    var EDGE = 28; // 左边缘留给系统返回
    function onStart(e){
      if (state.view !== &quot;playlists&quot;) return;
      var t = e.touches ? e.touches[0] : e;
      if (!t) return;
      // 系统侧滑返回区域不接管
      if (t.clientX &lt;= EDGE){ axis = &quot;cancel&quot;; return; }
      // Tab 条本身横向滚动：不在这里抢，避免切分类与滚 Tab 打架
      if (e.target &amp;&amp; e.target.closest &amp;&amp; e.target.closest(&quot;#plTabs&quot;)){
        axis = &quot;cancel&quot;;
        return;
      }
      sx = t.clientX; sy = t.clientY;
      axis = null;
      locked = false;
    }
    function onMove(e){
      if (axis === &quot;cancel&quot; || locked) return;
      if (state.view !== &quot;playlists&quot;) return;
      var t = e.touches ? e.touches[0] : e;
      if (!t) return;
      var dx = t.clientX - sx;
      var dy = t.clientY - sy;
      if (axis == null){
        if (Math.abs(dx) &lt; 10 &amp;&amp; Math.abs(dy) &lt; 10) return;
        // 明显纵向 → 交给页面滚动
        if (Math.abs(dy) &gt; Math.abs(dx)){
          axis = &quot;v&quot;;
          return;
        }
        axis = &quot;h&quot;;
      }
      if (axis === &quot;h&quot;){
        // 锁定横向，避免页面跟着斜滑
        if (e.cancelable) e.preventDefault();
      }
    }
    function onEnd(e){
      if (locked || axis === &quot;cancel&quot; || axis === &quot;v&quot;){
        axis = null;
        return;
      }
      if (state.view !== &quot;playlists&quot;){ axis = null; return; }
      var t = (e.changedTouches &amp;&amp; e.changedTouches[0]) || e;
      if (!t){ axis = null; return; }
      var dx = t.clientX - sx;
      var dy = t.clientY - sy;
      axis = null;
      // 阈值：水平位移够大，且明显大于垂直
      if (Math.abs(dx) &lt; 56) return;
      if (Math.abs(dx) &lt; Math.abs(dy) * 1.2) return;
      if (plState.loading) return;
      var idx = currentPlTabIndex();
      // 左滑 → 下一分类；右滑 → 上一分类
      if (dx &lt; 0){
        if (idx &gt;= tabs.length - 1){
          try { toast(&quot;已是最后一个分类&quot;, 900); } catch(eT) {}
          return;
        }
        locked = true;
        activatePlTab(idx + 1, { smooth: true });
      } else {
        if (idx &lt;= 0){
          try { toast(&quot;已是第一个分类&quot;, 900); } catch(eT2) {}
          return;
        }
        locked = true;
        activatePlTab(idx - 1, { smooth: true });
      }
      setTimeout(function(){ locked = false; }, 320);
    }
    v._plSwipeStart = onStart;
    v._plSwipeMove = onMove;
    v._plSwipeEnd = onEnd;
    v.addEventListener(&quot;touchstart&quot;, onStart, { passive: true });
    v.addEventListener(&quot;touchmove&quot;, onMove, { passive: false });
    v.addEventListener(&quot;touchend&quot;, onEnd, { passive: true });
    v.addEventListener(&quot;touchcancel&quot;, onEnd, { passive: true });
    v._plSwipeBound = true;
  })();

  // 频道跳转：把选中的分类 Tab 滚到可视区
  try {
    var actTab = $(&quot;#plTabs .sr-tab.active&quot;);
    if (actTab &amp;&amp; actTab.scrollIntoView) actTab.scrollIntoView({ inline: &quot;center&quot;, block: &quot;nearest&quot;, behavior: &quot;instant&quot; });
  } catch(eSc) {}

  load(currentCat, false, false);

  // QQ：后台拉官方分类表，修正错误 ID（不打断当前已加载内容）
  if (!isNe){
    try {
      ensurePlTabs().then(function(){
        if (state.view !== &quot;playlists&quot;) return;
        var next = buildTabsList();
        var idx = resolveInitIdx(next);
        // 若当前 cat 仍在新表中，保持选中
        for (var i = 0; i &lt; next.length; i++){
          if (String(next[i].id) === String(currentCat)){ idx = i; break; }
        }
        paintTabs(next, idx);
      });
    } catch(eEt) {}
  }
}

function renderSingers(){
  var v = $(&quot;#view-singers&quot;);
  v.innerHTML = '&lt;div class=&quot;sec-head&quot; style=&quot;margin-top:16px&quot;&gt;&lt;div class=&quot;sec-title&quot;&gt;&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;热门歌手&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;grid-cols&quot; id=&quot;singerGrid&quot;&gt;'+skeletonCards(12,&quot;card round&quot;)+'&lt;/div&gt;';
  API.singerList().then(function(list){
    var wrap = $(&quot;#singerGrid&quot;);
    if (!list.length){ wrap.innerHTML = emptyHtml(&quot;歌手数据获取失败&quot;,&quot;&quot;); return; }
    wrap.innerHTML = list.map(function(s){
      return '&lt;div class=&quot;card round&quot;&gt;&lt;div class=&quot;card-cover&quot;&gt;'+safeImg(s.cover)+'&lt;/div&gt;&lt;div class=&quot;card-name&quot; style=&quot;text-align:center&quot;&gt;'+esc(s.name)+'&lt;/div&gt;&lt;/div&gt;';
    }).join(&quot;&quot;);
    $all(&quot;.card&quot;, wrap).forEach(function(c,i){ c.onclick=function(){ switchView(&quot;singerDetail&quot;,{mid:list[i].mid, name:list[i].name}); }; });
  });
}
function renderSingerDetail(params){
  var v = $(&quot;#view-singerDetail&quot;);
  var mid = params.mid || &quot;&quot;;
  var name = params.name || &quot;&quot;;
  var src = params.source || &quot;qq&quot;;
  v.innerHTML = '&lt;div class=&quot;skeleton&quot; style=&quot;height:120px;border-radius:20px;margin-top:16px&quot;&gt;&lt;/div&gt;';

  function loadParts(){
    // QQ 原生
    if (src === &quot;qq&quot; || (!params.source &amp;&amp; mid &amp;&amp; !/^(kg_|kw_|ne_|yt_)/i.test(mid))){
      return Promise.all([
        API.singerSongs(mid),
        API.singerAlbums(mid)
      ]).then(function(parts){
        return {
          songs: (parts[0] &amp;&amp; parts[0].songs) || [],
          total: (parts[0] &amp;&amp; parts[0].total) || 0,
          info: (parts[0] &amp;&amp; parts[0].info) || {},
          albums: parts[1] || [],
          albumSongLoader: function(a){ return API.albumSongs(a.mid); }
        };
      });
    }
    // 其它音源：搜索热门曲 + 专辑列表
    var searchFn = src === &quot;kuwo&quot; ? API.kuwoSearch
      : src === &quot;netease&quot; ? API.neteaseSearch
      : src === &quot;kugou&quot; ? API.kugouSearch
      : src === &quot;ytmusic&quot; ? API.ytmusicSearch
      : null;
    var albumFn = src === &quot;kuwo&quot; ? API.kuwoSearchAlbums
      : src === &quot;netease&quot; ? API.neteaseSearchAlbums
      : src === &quot;kugou&quot; ? API.kugouSearchAlbums
      : null;
    var albumSongFn = src === &quot;kuwo&quot; ? API.kuwoAlbumSongs
      : src === &quot;netease&quot; ? API.neteaseAlbumSongs
      : src === &quot;kugou&quot; ? API.kugouAlbumSongs
      : null;

    var q = name || mid;
    return Promise.all([
      searchFn ? searchFn(q, 1) : Promise.resolve({ list: [] }),
      albumFn ? albumFn(q) : Promise.resolve([])
    ]).then(function(parts){
      var res = parts[0] || { list: [] };
      var albums = parts[1] || [];
      var songs = res.list || [];
      // 优先歌手名匹配的歌曲
      songs = songs.slice().sort(function(a,b){
        var sa = (a.singer &amp;&amp; name &amp;&amp; a.singer.indexOf(name) &gt;= 0) ? 1 : 0;
        var sb = (b.singer &amp;&amp; name &amp;&amp; b.singer.indexOf(name) &gt;= 0) ? 1 : 0;
        return sb - sa;
      });
      // 专辑优先本歌手
      albums = (albums || []).filter(function(a){
        if (!name) return true;
        if (a.singer &amp;&amp; a.singer.indexOf(name) &gt;= 0) return true;
        if (a.name &amp;&amp; name &amp;&amp; a.name.indexOf(name) &gt;= 0) return true;
        return false;
      });
      // 若过滤后太少，回退全部
      if (albums.length &lt; 2 &amp;&amp; (parts[1] || []).length){
        albums = parts[1];
      }
      var cover = (res.singers &amp;&amp; res.singers[0] &amp;&amp; res.singers[0].cover) || (songs[0] &amp;&amp; songs[0].cover) || (albums[0] &amp;&amp; albums[0].cover) || &quot;&quot;;
      return {
        songs: songs,
        total: songs.length,
        info: { name: name, cover: cover },
        albums: albums,
        albumSongLoader: function(a){
          if (!albumSongFn) return Promise.resolve({ songs: [] });
          return albumSongFn(a.albumId || a.mid);
        }
      };
    });
  }

  loadParts().then(function(parts){
    parts = parts || {};
    var songRes = { songs: parts.songs || [], total: parts.total || 0, info: parts.info || {} };
    var albums = parts.albums || [];
    var songs = songRes.songs || [];
    var albumSongLoader = parts.albumSongLoader || function(a){ return API.albumSongs(a.mid); };
    var cover = (songRes.info &amp;&amp; songRes.info.cover) || (src === &quot;qq&quot; ? coverUrl(mid, &quot;singer&quot;) : &quot;&quot;) || (songs[0] &amp;&amp; songs[0].cover) || &quot;&quot;;
    var displayName = name || (songRes.info &amp;&amp; songRes.info.name) || &quot;歌手&quot;;

    v.innerHTML =
      '&lt;div class=&quot;sec-head&quot; style=&quot;margin-top:8px&quot;&gt;&lt;button type=&quot;button&quot; id=&quot;singerBackBtn&quot; style=&quot;padding:6px 12px;border-radius:10px;background:rgba(118,118,128,0.16);color:var(--text-0);font-size:14px&quot;&gt;‹ 返回&lt;/button&gt;&lt;/div&gt;'+
      '&lt;div class=&quot;mine-header&quot;&gt;'+
        '&lt;div class=&quot;mine-avatar&quot; style=&quot;border-radius:50%&quot;&gt;'+safeImg(cover)+'&lt;/div&gt;'+
        '&lt;div&gt;&lt;div class=&quot;mine-name&quot;&gt;'+esc(displayName)+'&lt;/div&gt;'+
        '&lt;div class=&quot;mine-uin&quot;&gt;'+(songRes.total || songs.length)+' 首热门 · '+albums.length+' 张专辑&lt;/div&gt;&lt;/div&gt;'+
        '&lt;button class=&quot;hero-play&quot; id=&quot;playAllSinger&quot; style=&quot;margin-left:auto&quot;&gt;&lt;svg&gt;&lt;use href=&quot;#i-play&quot;/&gt;&lt;/svg&gt;播放全部&lt;/button&gt;'+
      '&lt;/div&gt;'+
      '&lt;div class=&quot;sr-tabs&quot; id=&quot;singerTabs&quot; style=&quot;margin:12px 0;gap:10px&quot;&gt;'+
        '&lt;div class=&quot;sr-tab active&quot; data-tab=&quot;hot&quot;&gt;热门歌曲&lt;/div&gt;'+
        '&lt;div class=&quot;sr-tab&quot; data-tab=&quot;album&quot;&gt;专辑&lt;/div&gt;'+
      '&lt;/div&gt;'+
      '&lt;div id=&quot;singerBody&quot;&gt;&lt;/div&gt;';

    var body = $(&quot;#singerBody&quot;);
    function showHot(){
      if (!songs.length){
        body.innerHTML = emptyHtml(&quot;暂无热门歌曲&quot;, &quot;可切换到「专辑」浏览&quot;);
        return;
      }
      body.innerHTML = '&lt;div class=&quot;song-list&quot; id=&quot;singerSongs&quot;&gt;&lt;/div&gt;';
      renderSongList($(&quot;#singerSongs&quot;), songs);
    }
    function showAlbums(){
      if (!albums.length){
        body.innerHTML = emptyHtml(&quot;暂无专辑&quot;, &quot;&quot;);
        return;
      }
      // 每个专辑下方自带展开面板，点击就地展开，不跳到底部
      body.innerHTML = albums.map(function(a, i){
        return '&lt;div class=&quot;album-block&quot; data-i=&quot;'+i+'&quot;&gt;'+
          '&lt;div class=&quot;song-row singer-album&quot; data-i=&quot;'+i+'&quot;&gt;'+
            '&lt;div class=&quot;song-cover&quot;&gt;'+safeImg(a.cover)+'&lt;/div&gt;'+
            '&lt;div class=&quot;song-meta&quot;&gt;'+
              '&lt;div class=&quot;song-title&quot;&gt;'+esc(a.name)+'&lt;/div&gt;'+
              '&lt;div class=&quot;song-sub&quot;&gt;'+(a.pubTime ? esc(String(a.pubTime).slice(0,10)) : &quot;专辑&quot;)+(a.company &amp;&amp; a.company !== &quot;未确定&quot; ? &quot; · &quot;+esc(a.company) : &quot;&quot;)+'&lt;/div&gt;'+
            '&lt;/div&gt;'+
            '&lt;span class=&quot;album-chevron&quot; style=&quot;color:var(--text-2);font-size:16px;padding-right:8px;transition:transform .2s&quot;&gt;›&lt;/span&gt;'+
          '&lt;/div&gt;'+
          '&lt;div class=&quot;album-panel&quot; data-i=&quot;'+i+'&quot; style=&quot;display:none;padding:0 0 8px 12px;border-left:2px solid rgba(var(--accent-rgb),.35);margin:0 12px 6px 18px&quot;&gt;&lt;/div&gt;'+
        '&lt;/div&gt;';
      }).join(&quot;&quot;);

      $all(&quot;.singer-album&quot;, body).forEach(function(row){
        row.onclick = function(){
          var i = Number(row.dataset.i);
          var a = albums[i];
          if (!a) return;
          var block = row.closest(&quot;.album-block&quot;) || row.parentNode;
          var panel = block.querySelector(&quot;.album-panel&quot;);
          var chev = row.querySelector(&quot;.album-chevron&quot;);
          if (!panel) return;

          // 已展开：收起
          if (panel.style.display === &quot;block&quot;){
            panel.style.display = &quot;none&quot;;
            panel.innerHTML = &quot;&quot;;
            row.style.background = &quot;&quot;;
            if (chev) chev.style.transform = &quot;&quot;;
            return;
          }

          // 收起其它已展开项
          $all(&quot;.album-panel&quot;, body).forEach(function(p){
            if (p !== panel){ p.style.display = &quot;none&quot;; p.innerHTML = &quot;&quot;; }
          });
          $all(&quot;.singer-album&quot;, body).forEach(function(x){ x.style.background = &quot;&quot;; });
          $all(&quot;.album-chevron&quot;, body).forEach(function(c){ c.style.transform = &quot;&quot;; });

          row.style.background = &quot;rgba(var(--accent-rgb),.1)&quot;;
          if (chev) chev.style.transform = &quot;rotate(90deg)&quot;;
          panel.style.display = &quot;block&quot;;
          panel.innerHTML =
            '&lt;div style=&quot;display:flex;align-items:center;justify-content:space-between;padding:6px 4px 4px&quot;&gt;'+
              '&lt;span style=&quot;font-size:12px;color:var(--text-2)&quot;&gt;加载中…&lt;/span&gt;'+
              '&lt;button type=&quot;button&quot; class=&quot;play-album-btn sec-more&quot; style=&quot;border:none;background:none;font-size:13px&quot;&gt;播放专辑&lt;/button&gt;'+
            '&lt;/div&gt;'+
            '&lt;div class=&quot;song-list album-song-list&quot;&gt;'+skeletonRows(4)+'&lt;/div&gt;';

          albumSongLoader(a).then(function(res){
            // 面板可能已被收起/切换
            if (panel.style.display !== &quot;block&quot;) return;
            var list = (res &amp;&amp; res.songs) || [];
            var head = panel.querySelector(&quot;span&quot;);
            var wrap = panel.querySelector(&quot;.album-song-list&quot;);
            var pb = panel.querySelector(&quot;.play-album-btn&quot;);
            if (head) head.textContent = list.length ? (list.length + &quot; 首&quot;) : &quot;暂无歌曲&quot;;
            if (!wrap) return;
            if (!list.length){ wrap.innerHTML = emptyHtml(&quot;专辑暂无歌曲&quot;,&quot;&quot;); return; }
            // 统一标记音源，方便播放
            list.forEach(function(s){ if (!s.source) s.source = src; });
            renderSongList(wrap, list);
            if (pb) pb.onclick = function(e){ e.stopPropagation(); playQueue(list, 0); };
          });
        };
      });
    }

    showHot();
    $all(&quot;#singerTabs .sr-tab&quot;).forEach(function(t){
      t.onclick = function(){
        $all(&quot;#singerTabs .sr-tab&quot;).forEach(function(x){ x.classList.remove(&quot;active&quot;); });
        t.classList.add(&quot;active&quot;);
        if (t.dataset.tab === &quot;album&quot;) showAlbums();
        else showHot();
      };
    });
    var playAll = $(&quot;#playAllSinger&quot;);
    if (playAll) playAll.onclick = function(){ if (songs.length) playQueue(songs, 0); else toast(&quot;暂无可播放歌曲&quot;); };
    var sb = $(&quot;#singerBackBtn&quot;);
    if (sb) sb.onclick = function(){ handleBack(); };
  }).catch(function(){
    v.innerHTML = emptyHtml(&quot;加载歌手失败&quot;, &quot;请返回重试&quot;);
  });
}

function renderMv(params){
  params = params || {};
  var v = $(&quot;#view-mv&quot;);
  if (!v) return;
  var pageTitle = params.title || params.topTitle || &quot;巅峰榜 · MV&quot;;
  v.innerHTML =
    '&lt;div class=&quot;sec-head&quot; style=&quot;margin-top:16px&quot;&gt;'+
      '&lt;div class=&quot;sec-title&quot;&gt;&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;'+esc(pageTitle)+'&lt;/div&gt;'+
      '&lt;div class=&quot;sec-more&quot; style=&quot;color:var(--text-2);font-size:12px&quot;&gt;点击即可播放&lt;/div&gt;'+
    '&lt;/div&gt;'+
    '&lt;div class=&quot;mv-grid&quot; id=&quot;mvGrid&quot;&gt;'+skeletonCards(8,&quot;mv-card&quot;)+'&lt;/div&gt;';
  API.mvList({ topId: params.topId || params.id || 0, title: pageTitle }).then(function(list){
    var wrap = $(&quot;#mvGrid&quot;);
    if (!wrap) return;
    if (!list || !list.length){
      wrap.innerHTML = emptyHtml(&quot;MV榜数据获取失败&quot;,&quot;请检查网络后重试&quot;);
      return;
    }
    wrap.innerHTML = list.map(function(m, i){
      var rank = i + 1;
      var rankCls = rank === 1 ? &quot;top1&quot; : rank === 2 ? &quot;top2&quot; : rank === 3 ? &quot;top3&quot; : &quot;&quot;;
      var dur = m.duration ? fmtTime(m.duration) : &quot;&quot;;
      var plays = m.playCount ? fmtCount(m.playCount) : &quot;&quot;;
      return '&lt;div class=&quot;mv-card&quot; data-i=&quot;'+i+'&quot;&gt;'+
        '&lt;div class=&quot;mv-cover&quot;&gt;'+
          safeImg(m.cover)+
          '&lt;div class=&quot;mv-play-fab&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot;&gt;&lt;path d=&quot;M8 5v14l11-7z&quot;/&gt;&lt;/svg&gt;&lt;/div&gt;'+
          (dur ? '&lt;div class=&quot;mv-dur&quot;&gt;'+dur+'&lt;/div&gt;' : '')+
          '&lt;div class=&quot;mv-rank-badge '+rankCls+'&quot;&gt;'+rank+'&lt;/div&gt;'+
        '&lt;/div&gt;'+
        '&lt;div class=&quot;mv-title&quot;&gt;'+esc(m.title||&quot;&quot;)+'&lt;/div&gt;'+
        '&lt;div class=&quot;mv-sub&quot;&gt;'+esc(m.singer||&quot;&quot;)+(plays ? &quot; · &quot;+plays : &quot;&quot;)+'&lt;/div&gt;'+
      '&lt;/div&gt;';
    }).join(&quot;&quot;);
    $all(&quot;.mv-card&quot;, wrap).forEach(function(c){
      c.onclick = function(){
        var i = +c.getAttribute(&quot;data-i&quot;);
        if (list[i]) openMv(list[i]);
      };
    });
  }).catch(function(){
    var wrap = $(&quot;#mvGrid&quot;);
    if (wrap) wrap.innerHTML = emptyHtml(&quot;MV榜加载失败&quot;,&quot;&quot;);
  });
}

function renderRadio(){
  var v = $(&quot;#view-radio&quot;);
  v.innerHTML = '&lt;div class=&quot;sec-head&quot; style=&quot;margin-top:16px&quot;&gt;&lt;div class=&quot;sec-title&quot;&gt;&lt;span class=&quot;dot&quot;&gt;&lt;/span&gt;精选电台歌单&lt;/div&gt;&lt;/div&gt;'+
    '&lt;div class=&quot;grid-cols&quot; id=&quot;radioGrid&quot; style=&quot;grid-template-columns:repeat(auto-fill,minmax(132px,1fr))&quot;&gt;'+skeletonCards(10,&quot;radio-card&quot;)+'&lt;/div&gt;'+
    '&lt;div class=&quot;empty-state&quot; style=&quot;margin-top:10px&quot;&gt;&lt;div class=&quot;e-sub&quot;&gt;提示：官方个性化「私人漫游」电台依赖登录态与用户行为数据，此处以精选主题歌单代替持续播放体验&lt;/div&gt;&lt;/div&gt;';
  API.radioList().then(function(list){
    var wrap = $(&quot;#radioGrid&quot;);
    if (!list.length){ wrap.innerHTML = emptyHtml(&quot;电台数据获取失败&quot;,&quot;&quot;); return; }
    wrap.innerHTML = list.map(function(r){
      return '&lt;div class=&quot;radio-card&quot;&gt;&lt;div class=&quot;radio-cover&quot;&gt;'+safeImg(r.cover)+'&lt;/div&gt;&lt;div class=&quot;radio-name&quot;&gt;'+esc(r.title)+'&lt;/div&gt;&lt;/div&gt;';
    }).join(&quot;&quot;);
    $all(&quot;.radio-card&quot;, wrap).forEach(function(c,i){ c.onclick=function(){ switchView(&quot;detail&quot;,{type:&quot;playlist&quot;, id:list[i].dissid}); }; });
  });
}


/** Cookie 派生 g_tk（QQ 登录态签名） */
function getGtk(){
  try {
    var ck = (state.user &amp;&amp; state.user.cookie) || &quot;&quot;;
    var map = typeof parseCookieStr === &quot;function&quot; ? parseCookieStr(ck) : {};
    var skey = map.p_skey || map.skey || map.qqmusic_key || map.qm_keyst || &quot;&quot;;
    var hash = 5381;
    for (var i = 0; i &lt; skey.length; i++){
      hash += (hash &lt;&lt; 5) + skey.charCodeAt(i);
      hash = hash &amp; hash;
    }
    return hash &amp; 0x7fffffff;
  } catch(e) { return 5381; }
}

/**
 * QQ 云端「我喜欢」歌曲
 * 多路兜底：CgiGetDiss(dirid=201) → PlaylistDetailRead → 自建「我喜欢」tid
 */
API.qqCloudFavSongs = function(begin, num){
  if (!state.user || !state.user.uin) return Promise.resolve({ songs: [], total: 0 });
  begin = Math.max(0, begin || 0);
  num = num || 200;
  var uin = String(state.user.uin).replace(/^o0*/, &quot;&quot;);
  var gtk = getGtk();
  var authst = state.user.qqmusic_key || state.user.qm_keyst || &quot;&quot;;
  var hdr = withCookie({
    &quot;Content-Type&quot;: &quot;application/json&quot;,
    &quot;Referer&quot;: &quot;https://y.qq.com/&quot;,
    &quot;Origin&quot;: &quot;https://y.qq.com&quot;
  });

  function mapTrack(it){
    if (!it) return null;
    try {
      var track = it.songInfo || it.track || it.song || it;
      if (track &amp;&amp; track.track) track = track.track;
      // 部分接口包在 {songInfo:{...}} / {base:{...}}
      if (track.base) track = Object.assign({}, track, track.base);
      var n = null;
      try { n = normalizeSongFromPlaylist(track); } catch(e0) {}
      if (!n || !n.songmid){
        try { n = normalizeSongFromSearch(track); } catch(e1) {}
      }
      if (!n || !n.songmid){
        var mid = track.mid || track.songmid || track.song_mid || track.songMid || it.mid || it.songmid || &quot;&quot;;
        if (!mid) return null;
        var singers = track.singer || track.singer_list || [];
        var singer = Array.isArray(singers)
          ? singers.map(function(a){ return (a &amp;&amp; (a.name || a.title || a.singer_name)) || &quot;&quot;; }).filter(Boolean).join(&quot;/&quot;)
          : (track.singername || track.singer_name || track.singerName || &quot;&quot;);
        var album = track.album || {};
        n = {
          songmid: String(mid),
          media_mid: (track.file &amp;&amp; (track.file.media_mid || track.file.mediaMid)) || track.media_mid || track.strMediaMid || mid,
          name: track.name || track.title || track.songname || track.song_name || mid,
          singer: singer || &quot;未知&quot;,
          albummid: album.mid || album.pmid || track.albummid || track.albumMid || &quot;&quot;,
          albumname: album.name || track.albumname || track.album_name || &quot;&quot;,
          interval: Number(track.interval || track.time || track.pay_time || 0) || 0,
          cover: &quot;&quot;,
          isVip: !!(track.pay &amp;&amp; (track.pay.pay_play || track.pay.pay_month)),
          source: &quot;qq&quot;
        };
      }
      n.source = &quot;qq&quot;;
      if (!n.cover &amp;&amp; n.albummid) n.cover = coverUrl(n.albummid);
      return n;
    } catch(e) { return null; }
  }
  function mapList(list){
    return (list || []).map(mapTrack).filter(function(s){ return s &amp;&amp; s.songmid; });
  }
  function pickSongs(data){
    if (!data) return { songs: [], total: 0 };
    var list = data.songlist || data.songList || data.tracks || data.list ||
      data.song_list || data.v_songinfo || data.songInfoList || [];
    // 有时在 data.detail / data.playlist
    if (!list.length &amp;&amp; data.detail){
      list = data.detail.songlist || data.detail.songList || [];
    }
    var total = data.total_song_num || data.totalNum || data.songNum || data.total ||
      data.songlist_size || data.song_num || list.length || 0;
    return { songs: mapList(list), total: Number(total) || list.length };
  }

  // 路径1：srfDissInfo.DissInfo / CgiGetDiss（官方收藏最稳）
  function viaCgiGetDiss(){
    var body = JSON.stringify({
      comm: {
        uin: Number(uin) || 0,
        format: &quot;json&quot;,
        ct: 24,
        cv: 0,
        g_tk: gtk,
        authst: authst
      },
      req_0: {
        module: &quot;music.srfDissInfo.DissInfo&quot;,
        method: &quot;CgiGetDiss&quot;,
        param: {
          disstid: 0,
          dirid: 201,
          song_begin: begin,
          song_num: num,
          song_order: 0,
          userinfo: 1,
          tag: 1,
          orderlist: 1,
          onlysonglist: 0,
          enc_host_uin: &quot;&quot;
        }
      }
    });
    // 旧模块名兼容
    var body2 = JSON.stringify({
      comm: { uin: Number(uin) || 0, format: &quot;json&quot;, ct: 24, cv: 0, g_tk: gtk, authst: authst },
      req_0: {
        module: &quot;srf_diss_info.DissInfoServer&quot;,
        method: &quot;CgiGetDiss&quot;,
        param: {
          disstid: 0,
          dir_id: 201,
          dirid: 201,
          song_begin: begin,
          song_num: num,
          num: num,
          page_no: 0,
          orderlist: 1,
          onlysonglist: 0,
          enc_host_uin: &quot;&quot;
        }
      }
    });
    function post(b){
      return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
        method: &quot;POST&quot;, headers: hdr, body: b, credentials: &quot;include&quot;, timeout: 20
      }).then(function(txt){
        var d = jsonp_safeParse(txt);
        var data = d &amp;&amp; d.req_0 &amp;&amp; d.req_0.data;
        var code = d &amp;&amp; d.req_0 &amp;&amp; d.req_0.code;
        if (code !== 0 &amp;&amp; code !== undefined &amp;&amp; code !== null &amp;&amp; Number(code) !== 0) return null;
        var r = pickSongs(data);
        return r.songs.length ? r : null;
      }).catch(function(){ return null; });
    }
    return post(body).then(function(r){ return r || post(body2); });
  }

  // 路径2：PlaylistDetailRead
  function viaPlaylistDetailRead(){
    var body = JSON.stringify({
      comm: { uin: Number(uin) || 0, format: &quot;json&quot;, ct: 24, cv: 0, g_tk: gtk, authst: authst },
      req_0: {
        module: &quot;music.musicasset.PlaylistDetailRead&quot;,
        method: &quot;GetPlaylistDetail&quot;,
        param: { dirId: 201, tid: 0, songBegin: begin, songNum: num, order: 0 }
      }
    });
    return ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
      method: &quot;POST&quot;, headers: hdr, body: body, credentials: &quot;include&quot;, timeout: 20
    }).then(function(txt){
      var d = jsonp_safeParse(txt);
      var data = d &amp;&amp; d.req_0 &amp;&amp; d.req_0.data;
      var r = pickSongs(data);
      return r.songs.length ? r : null;
    }).catch(function(){ return null; });
  }

  // 路径3：从自建歌单里找「我喜欢」tid，再拉详情
  function viaMyLikeTid(){
    var createdUrl = &quot;https://c.y.qq.com/rsc/fcgi-bin/fcg_user_created_diss?&quot; +
      &quot;hostUin=0&amp;format=json&amp;inCharset=utf8&amp;outCharset=utf-8&amp;notice=0&amp;platform=yqq.json&amp;needNewCode=0&quot; +
      &quot;&amp;cid=205360838&amp;g_tk=&quot; + gtk + &quot;&amp;uin=&quot; + encodeURIComponent(uin) + &quot;&amp;loginUin=&quot; + encodeURIComponent(uin);
    return ADAPTER_request(createdUrl, {
      headers: withCookie({ &quot;Referer&quot;: &quot;https://y.qq.com/&quot; }),
      credentials: &quot;include&quot;,
      timeout: 15
    }).then(function(txt){
      var d = jsonp_safeParse(txt);
      var list = (d &amp;&amp; d.data &amp;&amp; (d.data.disslist || d.data.list)) || [];
      var hit = null;
      for (var i = 0; i &lt; list.length; i++){
        var p = list[i] || {};
        var dirId = Number(p.dirid || p.dirId || p.dir_id || 0);
        var name = p.dissname || p.title || p.name || &quot;&quot;;
        if (dirId === 201 || /我喜欢/.test(name)){
          hit = p;
          break;
        }
      }
      if (!hit) return null;
      var tid = String(hit.dissid || hit.disstid || hit.tid || &quot;&quot;).replace(/\D/g, &quot;&quot;) || hit.dissid;
      if (!tid) return null;
      // 用已有歌单详情接口
      return API.playlistDetail(tid, 0, Math.min(num, 200)).then(function(res){
        var songs = (res &amp;&amp; res.songs) || [];
        if (!songs.length) return null;
        return { songs: songs, total: (res.info &amp;&amp; res.info.songCount) || songs.length };
      });
    }).catch(function(){ return null; });
  }

  // 路径4：老版 fav 接口
  function viaOldFav(){
    var url = &quot;https://c.y.qq.com/splcloud/fcgi-bin/fcg_music_custom_get_fav_songlist.fcg?&quot; +
      &quot;g_tk=&quot; + gtk + &quot;&amp;uin=&quot; + encodeURIComponent(uin) + &quot;&amp;loginUin=&quot; + encodeURIComponent(uin) +
      &quot;&amp;hostUin=0&amp;format=json&amp;inCharset=utf8&amp;outCharset=utf-8&amp;notice=0&amp;platform=yqq.json&amp;needNewCode=0&quot; +
      &quot;&amp;cid=205361558&amp;reqtype=1&amp;dirid=201&amp;from=1&amp;song_begin=&quot; + begin + &quot;&amp;song_num=&quot; + num;
    return ADAPTER_request(url, {
      headers: withCookie({ &quot;Referer&quot;: &quot;https://y.qq.com/&quot; }),
      credentials: &quot;include&quot;,
      timeout: 15
    }).then(function(txt){
      var d = jsonp_safeParse(txt);
      var data = (d &amp;&amp; d.data) || d;
      var r = pickSongs(data);
      if (!r.songs.length &amp;&amp; data &amp;&amp; data.songlist) r = pickSongs({ songlist: data.songlist, total: data.total_song_num });
      return r.songs.length ? r : null;
    }).catch(function(){ return null; });
  }

  // 串行尝试：谁先有数据用谁
  return viaCgiGetDiss().then(function(r){
    if (r &amp;&amp; r.songs.length) return r;
    return viaPlaylistDetailRead();
  }).then(function(r){
    if (r &amp;&amp; r.songs.length) return r;
    return viaMyLikeTid();
  }).then(function(r){
    if (r &amp;&amp; r.songs.length) return r;
    return viaOldFav();
  }).then(function(r){
    return r || { songs: [], total: 0 };
  });
};

/** 同步官方「我喜欢」：有官方数据时以官方为准覆盖本地 QQ 收藏 */
function syncQQCloudFavorites(){
  if (!state.user || !state.user.uin) return Promise.resolve(false);
  return API.qqCloudFavSongs(0, 300).then(function(res){
    var remote = (res &amp;&amp; res.songs) || [];
    if (!remote.length){
      console.warn(&quot;[qqm] cloud fav empty&quot;);
      return false;
    }
    // 保留本地非 QQ 源收藏，QQ 源以官方列表为准
    var localExtra = (state.favorites || []).filter(function(it){
      var src = (typeof it === &quot;object&quot; &amp;&amp; it.source) ? it.source : &quot;qq&quot;;
      var mid = favMidOf(it);
      if (!mid) return false;
      if (src &amp;&amp; src !== &quot;qq&quot;) return true;
      // 官方已有则丢弃本地重复
      return false;
    }).map(function(it){ return typeof it === &quot;object&quot; ? it : { songmid: it, source: &quot;qq&quot; }; });

    var cloud = remote.map(function(s){
      return slimSong(s) || s;
    });
    // 官方顺序在前，本地其它源在后
    var seen = {};
    var merged = [];
    cloud.forEach(function(s){
      if (!s || !s.songmid || seen[s.songmid]) return;
      seen[s.songmid] = 1;
      merged.push(s);
    });
    localExtra.forEach(function(s){
      var m = favMidOf(s);
      if (!m || seen[m]) return;
      seen[m] = 1;
      merged.push(s);
    });
    state.favorites = merged;
    storeSet(&quot;favorites&quot;, state.favorites);
    console.log(&quot;[qqm] synced fav&quot;, merged.length, &quot;from cloud&quot;, remote.length);
    return true;
  }).catch(function(e){
    console.warn(&quot;[qqm] sync fav fail&quot;, e);
    return false;
  });
}

/**
 * QQ 云端歌单：自建 + 收藏
 * 返回 { created: [], collected: [] } 每项 { dissid, title, cover, songCount, creator }
 */
API.qqCloudPlaylists = function(){
  if (!state.user || !state.user.uin) return Promise.resolve({ created: [], collected: [] });
  var uin = String(state.user.uin).replace(/^o0*/, &quot;&quot;);
  var gtk = getGtk();
  var hdr = withCookie({
    &quot;Referer&quot;: &quot;https://y.qq.com/&quot;,
    &quot;Origin&quot;: &quot;https://y.qq.com&quot;
  });

  function normPl(p, kind){
    if (!p) return null;
    var id = String(
      p.dissid || p.disstid || p.tid || p.content_id || p.id || p.dirId || &quot;&quot;
    ).replace(/\D/g, &quot;&quot;) || String(p.dissid || p.disstid || p.tid || &quot;&quot;);
    if (!id || id === &quot;0&quot;) return null;
    var title = p.dissname || p.title || p.name || p.dirName || &quot;未命名歌单&quot;;
    // 跳过系统「我喜欢」占位（dirid 201 另拉）
    if (kind === &quot;created&quot; &amp;&amp; (Number(p.dirId) === 201 || /我喜欢/.test(title))) {
      // still include as entry but mark
    }
    var cover = p.logo || p.picurl || p.pic || p.cover || p.dir_pic_url2 || p.pic_url || &quot;&quot;;
    return {
      dissid: id,
      title: title,
      cover: fixCover(cover),
      songCount: Number(p.songnum || p.song_cnt || p.songNum || p.num0 || p.diss_song_num || 0) || 0,
      creator: p.nickname || p.hostname || p.creator || (state.user.nickname || &quot;&quot;),
      kind: kind || &quot;created&quot;
    };
  }

  // 自建歌单
  var createdUrl = &quot;https://c.y.qq.com/rsc/fcgi-bin/fcg_user_created_diss?&quot; +
    &quot;hostUin=0&amp;format=json&amp;inCharset=utf8&amp;outCharset=utf-8&amp;notice=0&amp;platform=yqq.json&amp;needNewCode=0&quot; +
    &quot;&amp;cid=205360838&amp;g_tk=&quot; + gtk + &quot;&amp;uin=&quot; + encodeURIComponent(uin) + &quot;&amp;loginUin=&quot; + encodeURIComponent(uin);

  // 收藏歌单（reqtype=3）
  var collectedUrl = &quot;https://c.y.qq.com/fav/fcgi-bin/fcg_get_profile_order_asset.fcg?&quot; +
    &quot;loginUin=&quot; + encodeURIComponent(uin) + &quot;&amp;hostUin=0&amp;format=json&amp;inCharset=utf8&amp;outCharset=utf-8&quot; +
    &quot;&amp;notice=0&amp;platform=yqq.json&amp;needNewCode=0&amp;ct=20&amp;cid=205360956&amp;userid=&quot; + encodeURIComponent(uin) +
    &quot;&amp;reqtype=3&amp;sin=0&amp;ein=49&amp;g_tk=&quot; + gtk;

  // 备用 musicu 自建/收藏
  var bodyMu = JSON.stringify({
    comm: { uin: Number(uin) || 0, format: &quot;json&quot;, ct: 24, cv: 0 },
    req_0: {
      module: &quot;music.playlist.PlaylistSquare&quot;,
      method: &quot;GetSelfCreatedPlaylist&quot;,
      param: { uin: uin, offset: 0, size: 50 }
    },
    req_1: {
      module: &quot;music.playlist.PlaylistSquare&quot;,
      method: &quot;GetSelfCollectedPlaylist&quot;,
      param: { uin: uin, offset: 0, size: 50 }
    }
  });

  var pCreated = ADAPTER_request(createdUrl, { headers: hdr, credentials: &quot;include&quot;, timeout: 15 }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.data &amp;&amp; (d.data.disslist || d.data.list)) || (d &amp;&amp; d.disslist) || [];
    return (list || []).map(function(p){ return normPl(p, &quot;created&quot;); }).filter(Boolean);
  }).catch(function(){ return []; });

  var pCollected = ADAPTER_request(collectedUrl, { headers: hdr, credentials: &quot;include&quot;, timeout: 15 }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var list = (d &amp;&amp; d.data &amp;&amp; (d.data.cdlist || d.data.list || d.data.mymusic || d.data.disslist)) || [];
    if (!list.length &amp;&amp; d &amp;&amp; d.data &amp;&amp; d.data.orderlist) list = d.data.orderlist;
    return (list || []).map(function(p){ return normPl(p, &quot;collected&quot;); }).filter(Boolean);
  }).catch(function(){ return []; });

  var pMu = ADAPTER_request(&quot;https://u.y.qq.com/cgi-bin/musicu.fcg&quot;, {
    method: &quot;POST&quot;,
    headers: withCookie({ &quot;Content-Type&quot;: &quot;application/json&quot;, &quot;Referer&quot;: &quot;https://y.qq.com/&quot; }),
    body: bodyMu,
    credentials: &quot;include&quot;,
    timeout: 15
  }).then(function(txt){
    var d = jsonp_safeParse(txt);
    var c0 = (d &amp;&amp; d.req_0 &amp;&amp; d.req_0.data &amp;&amp; (d.req_0.data.v_playlist || d.req_0.data.list || d.req_0.data.disslist)) || [];
    var c1 = (d &amp;&amp; d.req_1 &amp;&amp; d.req_1.data &amp;&amp; (d.req_1.data.v_playlist || d.req_1.data.list || d.req_1.data.disslist)) || [];
    return {
      created: (c0 || []).map(function(p){ return normPl(p, &quot;created&quot;); }).filter(Boolean),
      collected: (c1 || []).map(function(p){ return normPl(p, &quot;collected&quot;); }).filter(Boolean)
    };
  }).catch(function(){ return { created: [], collected: [] }; });

  return Promise.all([pCreated, pCollected, pMu]).then(function(parts){
    var created = parts[0] || [];
    var collected = parts[1] || [];
    if (!created.length &amp;&amp; parts[2] &amp;&amp; parts[2].created) created = parts[2].created;
    if (!collected.length &amp;&amp; parts[2] &amp;&amp; parts[2].collected) collected = parts[2].collected;
    // 去重
    function dedupe(arr){
      var seen = {};
      return (arr || []).filter(function(p){
        if (!p || !p.dissid || seen[p.dissid]) return false;
        seen[p.dissid] = 1;
        return true;
      });
    }
    return { created: dedupe(created), collected: dedupe(collected) };
  });
};

/** 登录后同步官方收藏歌曲到本地 favorites（合并，不丢本地） */
function syncQQCloudFavorites(){
  if (!state.user || !state.user.uin) return Promise.resolve(false);
  return API.qqCloudFavSongs(0, 200).then(function(res){
    var remote = (res &amp;&amp; res.songs) || [];
    if (!remote.length) return false;
    var map = {};
    (state.favorites || []).forEach(function(it){
      var m = favMidOf(it);
      if (m) map[m] = typeof it === &quot;object&quot; ? it : { songmid: m };
    });
    remote.forEach(function(s){
      if (!s || !s.songmid) return;
      var slim = slimSong(s) || s;
      map[s.songmid] = Object.assign({}, map[s.songmid] || {}, slim);
    });
    state.favorites = Object.keys(map).map(function(k){ return map[k]; });
    storeSet(&quot;favorites&quot;, state.favorites);
    return true;
  }).catch(function(){ return false; });
}

